# Required
OCTOPUS_DOMAIN=thulu.example.com
OCTOPUS_JWT_SECRET=   # generate with: openssl rand -hex 32

# Key that encrypts stored credentials (Git tokens, LLM keys, webhook
# secrets). `thulu init` generates one and keeps it on reruns. Without it
# they are encrypted with a key derived from OCTOPUS_JWT_SECRET, so rotating
# that secret would make them unreadable. Set it once and keep it: at the next
# start the daemon re-encrypts existing values under it. To rotate, move the
# old value to OCTOPUS_SECRETBOX_PREVIOUS_KEYS (comma-separated) and set a new
# one. OCTOPUS_SECRETBOX_KEY_FILE reads it from a file instead.
# Generate with: openssl rand -hex 32
# OCTOPUS_SECRETBOX_KEY=

# Optional — SSO (OIDC). Any OIDC provider: Okta, Microsoft Entra ID,
# Keycloak, Google (https://accounts.google.com), Auth0.
# OCTOPUS_OIDC_ISSUER=https://your-idp.example.com
# OCTOPUS_OIDC_CLIENT_ID=
# OCTOPUS_OIDC_CLIENT_SECRET=
# OCTOPUS_OIDC_NAME=Google
# Where new SSO users land: an existing workspace slug they join (with
# OCTOPUS_SSO_DEFAULT_ROLE, viewer by default). Unset, a newcomer gets a
# personal workspace only where OCTOPUS_ALLOW_PERSONAL_WORKSPACES permits it,
# which with OIDC it does not by default; otherwise they wait for an admin to
# add them. Provisioning fails if the slug doesn't match any workspace.
# OCTOPUS_SSO_DEFAULT_WORKSPACE=
# Map IdP groups to roles. When set, the IdP is the source of truth: the
# mapped role is applied on every SSO login (highest match wins). Format is
# comma-separated group:role pairs; roles are viewer|developer|admin|owner.
# OCTOPUS_OIDC_GROUP_ROLE_MAP=octopus-admins:admin,octopus-devs:developer
# ID-token claim that carries the user's groups (default "groups"; use
# "roles" for Entra ID app roles).
# OCTOPUS_OIDC_GROUPS_CLAIM=groups
# Who may sign in at all. Domains need the IdP to mark the email verified;
# groups need at least one match. Unset = anyone the IdP authenticates, which
# on a multi-tenant IdP (Google, Entra's common endpoint) is anyone with an
# account there.
# OCTOPUS_SSO_ALLOWED_DOMAINS=acme.com
# OCTOPUS_SSO_ALLOWED_GROUPS=octopus-users
# Role newcomers get in OCTOPUS_SSO_DEFAULT_WORKSPACE: viewer (default),
# developer or admin. The group map above raises it.
# OCTOPUS_SSO_DEFAULT_ROLE=viewer
# Whether a newcomer may found a workspace of their own. Unset = off when OIDC
# is configured, on otherwise.
# OCTOPUS_ALLOW_PERSONAL_WORKSPACES=0

# Who operates this install and who hosts it, shown on /legal/terms/ and
# /legal/privacy/ and returned by GET /auth/config. Unset, the pages say it is
# not configured.
# OCTOPUS_LEGAL_ENTITY=
# OCTOPUS_LEGAL_CONTACT=
# OCTOPUS_LEGAL_HOSTING=
# OCTOPUS_LEGAL_HOSTING_REGION=

# Optional — GitHub OAuth
# OCTOPUS_GITHUB_CLIENT_ID=
# OCTOPUS_GITHUB_CLIENT_SECRET=

# Optional — GitHub Enterprise Server. Unset = github.com. Login, App tokens,
# git and agents follow it; thulu-github reads OCTOPUS_GITHUB_API_URL, so set
# both (`thulu init` does, deriving <url>/api/v3).
# OCTOPUS_GITHUB_URL=https://ghe.acme.example
# OCTOPUS_GITHUB_API_URL=https://ghe.acme.example/api/v3
# Let the daemon push branches that add or change .github/workflows/. Off by
# default: a workflow pushed to any branch runs with the repository's secrets.
# OCTOPUS_GITHUB_ALLOW_WORKFLOW_WRITES=0

# SAML is not configured here: Thulu speaks OIDC only. A SAML-only IdP
# (ADFS, Shibboleth) goes through a broker that speaks both, such as Keycloak
# or Microsoft Entra ID, and OCTOPUS_OIDC_ISSUER points at the broker.

# Optional — sandbox config
# OCTOPUS_SANDBOX_MEMORY_BYTES=6GB
# OCTOPUS_PUBLIC_HOST=thulu.example.com

# Optional — security hardening
# Trust X-Forwarded-For and X-Forwarded-Proto only from these proxies (the
# second decides whether the browser is on https: Secure cookies and the SSO
# callback URL). Explicit IPs/CIDRs, or
# "private" (loopback + RFC1918/ULA). Defaults: docker-compose.yml trusts only
# its edge network, where Caddy is the one peer; the standalone stack trusts
# nobody. Avoid "private" in any stack that runs agents: they sit on a private
# network too and could then forge the client address.
# OCTOPUS_TRUSTED_PROXIES=
# Subnet of the Caddy-to-daemon network in docker-compose.yml. Change it only
# if it collides with a network the host already routes.
# OCTOPUS_EDGE_SUBNET=10.85.85.0/28
# Allow SSO logins to attach to an existing password account with the same
# (provider-verified) email. Off by default: auto-linking is an account-
# takeover vector with multi-tenant IdPs.
# OCTOPUS_ALLOW_SSO_AUTOLINK=0
# Static bearer token for GET /metrics (Prometheus). When set, scrapes must
# send `Authorization: Bearer <token>` — in prometheus.yml:
#   authorization: { type: Bearer, credentials: <token> }
# When unset, /metrics needs an admin session in the operator workspace
# (OCTOPUS_OPERATOR_WORKSPACE): the series cover every workspace.
# Generate with: openssl rand -hex 32
# OCTOPUS_METRICS_TOKEN=
# Also write every audit entry here, besides Postgres: stdout, stderr or
# file:/data/audit.log (for a log shipper).
# OCTOPUS_AUDIT_SINK=
# Longest lifetime of an operator API key: a Go duration or a day count.
# Default 90d; "0" allows keys without an expiry.
# OCTOPUS_API_KEY_MAX_TTL=90d
# Access-token TTL (Go duration). Shorter = smaller window for a stolen
# access token; the SPA refreshes transparently. Default 30m.
# OCTOPUS_ACCESS_TTL=30m
# Absolute session lifetime (Go duration): a continuously-refreshed session
# is forced to re-login after this long. Default 720h (30 days).
# OCTOPUS_SESSION_MAX_LIFETIME=720h

# Local development ONLY — no logins: the browser that opens the link with
# OCTOPUS_DEV_TOKEN is the owner, anyone else gets 401. The daemon refuses to
# start with this set unless it listens on loopback. Never set in production.
# OCTOPUS_DEV_MODE=0
# The token that link carries (`openssl rand -hex 32`; `thulu init` writes
# one). Unset, the daemon keeps one in its data dir and prints the link.
# OCTOPUS_DEV_TOKEN=

# Stripe billing webhook signing secret (whsec_…). When set, POST
# /billing/stripe/webhook applies subscription events to workspace plans.
# Tenancy travels in Stripe metadata: set octopus_workspace_id (and optionally
# octopus_plan) on the Checkout Session / Subscription.
# OCTOPUS_STRIPE_WEBHOOK_SECRET=

# Managed-SaaS mode. Unset/0 (default) → self-hosted: every workspace gets the
# unlimited plan and the EE license governs features. Set to 1 to start each
# workspace on the 30-day trial (seat, agent and agent-hour limits), upgraded via the
# entitlements API / billing. It also makes a GitHub App install prove its
# installer: a workspace claims a new installation only from the OAuth callback,
# so the App needs "Request user authorization (OAuth) during installation".
# This compose stack runs agents on Docker, so SaaS mode also needs
# OCTOPUS_ALLOW_DOCKER_SAAS=1, which puts every tenant's agents on one kernel
# and one network: never for real tenants.
# OCTOPUS_SAAS_MODE=0

# Storage backend. Postgres is required. The docker-compose files ship a `pg`
# service that the daemon connects to by default; for production, point at a
# managed Postgres and remove the in-compose `pg` service.
# OCTOPUS_DATABASE_URL=postgres://user:pass@host:5432/octopus?sslmode=require
# OCTOPUS_PG_USER=octopus
# OCTOPUS_PG_DB=octopus
# Password of the bundled `pg` service. Required: every compose file refuses
# to start without it. `thulu init` generates one. By hand:
# openssl rand -hex 24. The bundled Postgres is published on 127.0.0.1:5433
# only, for `thulu init` and backups from the host.
# OCTOPUS_PG_PASSWORD=
# Host port of the bundled Postgres. `thulu init` sets it on a new install when
# 5433 is taken.
# OCTOPUS_PG_HOST_PORT=5433

# Which release runs. `thulu init` sets OCTOPUS_VERSION to the release it
# downloaded; `thulu update -version X` moves it and `thulu apply` brings
# the install to whatever it names. docker-compose.standalone.yml has no
# fallback and refuses to start without it; docker-compose.yml builds from the
# checkout when it is unset.
# OCTOPUS_VERSION=1.4.0
#
# `thulu apply` writes a managed block at the end of this file, between
# "# >>> octopus apply" and "# <<< octopus apply": every image by digest
# (OCTOPUS_IMAGE, OCTOPUS_MCP_<NAME>_IMAGE, OCTOPUS_AGENT_<ENGINE>_IMAGE,
# OCTOPUS_SANDBOX_IMAGE, OCTOPUS_PG_IMAGE, OCTOPUS_CADDY_IMAGE), taken from the
# signed release manifest, and the kept versions (OCTOPUS_KEPT_VERSIONS,
# OCTOPUS_KEPT_SNAPSHOTS, OCTOPUS_KEPT_IMAGES). It is rewritten whole on every
# apply; a line setting one of those keys elsewhere is commented out. Change
# the stack itself in deploy/docker-compose.override.yml, which no release
# writes and every compose command reads.
#
# Each run starts the agent image of its engine. To run every engine on one
# image of yours (e.g. built FROM ghcr.io/misterdonnuts/octopus-agent, which
# carries the three CLIs), set it outside the block:
# OCTOPUS_AGENT_IMAGE=registry.example.com/octopus-agent-acme:1
#
# Registry prefix for every image: <registry>/<image>@<digest>. Point it at
# the registry `octopus mirror <version> -to <registry>` copied a release into;
# the digests stay the signed ones.
# OCTOPUS_IMAGE_REGISTRY=ghcr.io/misterdonnuts
# owner/repo whose GitHub releases `thulu init` downloads from. Default
# MisterDonnuts/thulu.
# OCTOPUS_RELEASE_REPO=MisterDonnuts/thulu
# Where a mirror holds the chart (Kubernetes installs). Default
# <OCTOPUS_IMAGE_REGISTRY>/charts.
# OCTOPUS_CHART_REGISTRY=oci://registry.example.com/octopus/charts
#
# Where releases are looked up: github (default), the https URL of a mirror
# directory written by `octopus mirror -dir`, file:///path to the same on a
# disk, or off. Whatever the source, every manifest is checked against the
# release key before anything in it is used.
# OCTOPUS_UPDATE_SOURCE=github
# Channels offered: stable always; add prerelease, and preview for builds of
# a branch (signed by the preview workflow, not the release key).
# OCTOPUS_UPDATE_CHANNELS=stable
# Token for release lookups against a private repository (read-only, contents
# and packages). Never logged.
# OCTOPUS_UPDATE_GITHUB_TOKEN=
# How often the daemon checks the source (minimum 1h). Off with
# OCTOPUS_UPDATE_SOURCE=off.
# OCTOPUS_UPDATE_INTERVAL=12h
#
# How many versions a Docker install keeps for going back without a
# registry, the running one included (minimum 2): their images stay on the
# host and the snapshot taken when leaving each stays in backups/.
# `thulu update -kept` lists them, -keep X pins one.
# OCTOPUS_KEEP_VERSIONS=3
# How many pre-update snapshots stay in backups/ (the kept versions' are
# always spared).
# OCTOPUS_BACKUP_KEEP=5
#
# API key `thulu update` and `thulu apply` use to read the daemon's
# version and report each result to its audit log on an install with logins
# (`thulu keys mint` with settings:write). The CLI also takes
# -api-key-file. A failed report never fails an update.
# OCTOPUS_API_KEY=

# MCP servers. Each one is a compose profile, so COMPOSE_PROFILES decides which
# containers start; `thulu init` writes these from its checklist.
# OCTOPUS_MCP_SERVERS lists the choice ("none" when nothing is ticked), each
# MCP_<NAME>_URL is what the daemon forwards to agents, and
# OCTOPUS_MCP_FORWARD_CREDENTIAL names the servers that receive the run's own
# API key. thulu-cloud and thulu-figma are off unless ticked. thulu-sandbox is
# always on: the daemon serves it.
# OCTOPUS_MCP_SERVERS=octopus-api,thulu-github,thulu-browser
# COMPOSE_PROFILES=octopus-api,thulu-github,thulu-browser
# MCP_OCTOPUS_API_URL=http://octopus-api:3000/sse
# MCP_THULU_GITHUB_URL=http://thulu-github:3000/sse
# MCP_THULU_BROWSER_URL=http://thulu-browser:3000/sse
# OCTOPUS_MCP_FORWARD_CREDENTIAL=octopus-api,thulu-github,thulu-browser

# Docker network agent containers are launched on. The compose stacks create
# it and put the daemon and the MCP servers on it (Postgres stays off), so an
# agent reaches http://thulu-github:3000/sse and http://octopus:8585 by name.
# Unset, agents land on Docker's default bridge, where those names resolve to
# nothing.
# OCTOPUS_AGENT_NETWORK=octopus-agents
# OCTOPUS_AGENT_BASE_URL=http://octopus:8585

# Local git remotes. By default a project's repo_url must be https://. With a
# root set, bare repositories under it (after symlinks) may be registered as
# file:///<root>/<name>.git; nothing else on the disk can, including project
# checkouts and worktrees. docker-compose.dev.yml and docker-compose.daemon.yml
# set /data/sources. OCTOPUS_GIT_ALLOW_LOCAL_REMOTES=1 lifts every limit
# (any path, loopback hosts); single-user development only.
# OCTOPUS_GIT_LOCAL_REMOTE_ROOT=/data/sources

# Host address docker-compose.standalone.yml (and the dev stack) publish the
# daemon on. Nothing terminates TLS in those stacks, and with
# OCTOPUS_DEV_MODE=1 only the dev token stands between the port and an
# owner, so this is their whole network posture. Loopback unless you put a reverse proxy in front.
# OCTOPUS_BIND=127.0.0.1

# Group that owns /var/run/docker.sock on the Docker host. The daemon container
# runs as an unprivileged user and the socket is mode 660, so it has to be in
# that group to launch agent containers at all. Required: there is no default,
# because 0 would put the daemon in the root group. `octopus
# init` discovers it; by hand it is `stat -c %g /var/run/docker.sock` on the
# host (inside the VM on macOS). Set 0 explicitly only if the socket really is
# root-group. Irrelevant in Kubernetes mode, which never mounts a socket.
# OCTOPUS_DOCKER_GID=999
