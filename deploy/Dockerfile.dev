# Pinned to match the `go` directive in ../go.mod. Bump both together.
FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc

ARG AIR_VERSION=v1.67.4
RUN for attempt in 1 2 3; do \
      apk add --no-cache git curl ca-certificates tzdata \
      && go install "github.com/air-verse/air@${AIR_VERSION}" && break; \
      [ "$attempt" = 3 ] && exit 1; echo "install failed, retry $attempt/2" >&2; sleep $((attempt * 15)); \
    done

WORKDIR /workspace

EXPOSE 8585

CMD ["air", "-c", ".air.toml"]
