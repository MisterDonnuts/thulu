# Thulu — environment variables
# Copy this to .env and fill in the values.
#
# Note: listen address, agents dir and data dir are CLI flags, not env vars:
#   thulu serve -addr :8585 -agents-dir <dir> -data <dir>

# ── Core ────────────────────────────────────────────────────────────────────
# Postgres DSN. REQUIRED — the daemon refuses to start without it.
# Example: postgres://octopus:octopus@localhost:5432/octopus?sslmode=disable
OCTOPUS_DATABASE_URL=

# Structured JSON request logs (production). Unset = human-readable text.
OCTOPUS_LOG_FORMAT=json

# Dev mode: set to 1 to disable ALL auth checks. Only honored on loopback
# binds — never in production.
OCTOPUS_DEV_MODE=

# ── Security ─────────────────────────────────────────────────────────────────
# Optional perimeter key. When set, every request must also carry it via
# Authorization: Bearer <key> or X-API-Key: <key>; it grants no workspace
# access, so a session or an oct_ API key is still required. Unset, there is no
# perimeter and sign-in still applies.
OCTOPUS_API_KEY=

# JWT signing secret (minimum 16 characters). Required outside dev mode: the
# daemon refuses to start without it. Generate: openssl rand -hex 32
OCTOPUS_JWT_SECRET=

# Access-token TTL (Go duration, default 15m) and absolute session lifetime
# (default 720h = 30 days; a continuously-refreshed session is forced back to
# login past this).
OCTOPUS_ACCESS_TTL=
OCTOPUS_SESSION_MAX_LIFETIME=

# Comma-separated list of allowed CORS origins (default: localhost dev ports).
# Set to "*" only for fully-local deployments.
OCTOPUS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For and
# X-Forwarded-Proto are trusted: client IP for rate limiting and audit logs,
# and https for the session cookies and the SSO callback URL.
OCTOPUS_TRUSTED_PROXIES=

# Static bearer token for GET /metrics (Prometheus scrapes). When set, the
# endpoint only accepts `Authorization: Bearer <token>`; when unset it
# requires a normal authenticated session (viewer role).
# Generate: openssl rand -hex 32
OCTOPUS_METRICS_TOKEN=

# Run agent containers as uid 1000 instead of root.
# Requires the container image to have uid 1000 configured (octopus-docker does).
OCTOPUS_ROOTLESS_AGENTS=false

# ── SSO (optional) ────────────────────────────────────────────────────────────
# OIDC provider (issuer + client credentials; name/redirect/groups optional).
OCTOPUS_OIDC_ISSUER=
OCTOPUS_OIDC_CLIENT_ID=
OCTOPUS_OIDC_CLIENT_SECRET=
OCTOPUS_OIDC_NAME=
OCTOPUS_OIDC_REDIRECT_URI=
OCTOPUS_OIDC_GROUPS_CLAIM=
OCTOPUS_OIDC_GROUP_ROLE_MAP=

# GitHub OAuth (shorthand SSO provider).
OCTOPUS_GITHUB_CLIENT_ID=
OCTOPUS_GITHUB_CLIENT_SECRET=

# Where new SSO users land. Unset (default): each gets their own personal
# workspace. Set to an existing workspace slug
# to have new SSO users join that workspace as developer instead.
OCTOPUS_SSO_DEFAULT_WORKSPACE=

# Set to 1 to auto-link an SSO identity to an existing same-email account
# (requires provider-verified email). Off by default.
OCTOPUS_ALLOW_SSO_AUTOLINK=

# Frontend origin override for post-SSO redirects (dev: separate Astro server).
OCTOPUS_FRONTEND_ORIGIN=

# ── Licensing / billing (EE) ──────────────────────────────────────────────────
# Offline license key gating EE features and the boot gate.
OCTOPUS_LICENSE_KEY=

# Stripe webhook signing secret for POST /billing/stripe/webhook.
OCTOPUS_STRIPE_WEBHOOK_SECRET=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per second per IP (default 100). Set to 0 to disable.
OCTOPUS_RATE_LIMIT_RPS=100
# Burst capacity (default 200).
OCTOPUS_RATE_LIMIT_BURST=200

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Memory cap per sandbox container. Examples: 6GB, 4096MB, 0 (disables cap).
OCTOPUS_SANDBOX_MEMORY_BYTES=6GB

# Hostname reported in preview_url.human_url (what you open in a browser).
OCTOPUS_PUBLIC_HOST=localhost

# ── Kubernetes runtime (multi-node) ────────────────────────────────────
# Set to "kubernetes" to run agent + sandbox workloads as pods instead of
# Docker containers. All OCTOPUS_KUBE_*/pod vars below only apply then.
OCTOPUS_AGENT_RUNTIME=

# Cluster access: in-cluster service account, or an explicit kubeconfig.
OCTOPUS_KUBE_INCLUSTER=
OCTOPUS_KUBECONFIG=
OCTOPUS_KUBE_CONTEXT=

# RuntimeClass for workload pods (e.g. kata for microVM isolation).
OCTOPUS_RUNTIME_CLASS=

# Images the pods pull (published out-of-band; see Makefile kube-agent-image /
# sandbox-image targets). A run starts its engine's agent image;
# OCTOPUS_AGENT_IMAGE, when set, is the image of every engine.
OCTOPUS_AGENT_CLAUDE_CODE_IMAGE=
OCTOPUS_AGENT_CODEX_IMAGE=
OCTOPUS_AGENT_OPENCODE_IMAGE=
OCTOPUS_AGENT_IMAGE=
OCTOPUS_SANDBOX_IMAGE=

# Namespace for sandbox pods.
OCTOPUS_SANDBOX_NAMESPACE=

# Multi-tenant mode (1/true): enables tenant-scoped behavior. Needs
# OCTOPUS_AGENT_RUNTIME=kubernetes; the daemon refuses to start on the Docker
# runtime unless OCTOPUS_ALLOW_DOCKER_SAAS=1 (tenants then share one kernel
# and one network: for demos only). Git remotes on private addresses are
# refused unless listed in OCTOPUS_GIT_ALLOWED_PRIVATE_HOSTS.
OCTOPUS_SAAS_MODE=
OCTOPUS_ALLOW_DOCKER_SAAS=
OCTOPUS_GIT_ALLOWED_PRIVATE_HOSTS=

# Base URL agent pods use to reach the daemon's git transport (/git/) and API.
OCTOPUS_GIT_BASE_URL=
OCTOPUS_AGENT_BASE_URL=

# MCP tool servers. The daemon forwards every MCP_<NAME>_URL set here into each
# agent's env. `thulu init` writes the ones you tick (compose service names,
# http://<name>:3000/sse); the Helm chart sets them from mcp.<server>.enabled.
# thulu-sandbox is NOT listed here: the daemon serves it itself at
# <AGENT_BASE_URL>/sandbox/sse. See docs/enterprise-setup.md.
MCP_THULU_GITHUB_URL=
MCP_THULU_BROWSER_URL=
MCP_OCTOPUS_API_URL=
# Read-only cloud observability (CloudWatch). Resolves per-environment
# credentials server-side; agents never see a cloud key.
MCP_THULU_CLOUD_URL=

# Docker named volume holding worktrees/data when the daemon itself runs in a
# container. A daemon in a container finds it on its own; set this only if that
# fails (for example with a custom `hostname:`).
OCTOPUS_DATA_VOLUME=

# ── LLM egress gateway ─────────────────────────────────────────────────
# When set, an egress proxy listens here; sandbox pods reach it instead of the
# provider so BYOK keys never enter the sandbox.
OCTOPUS_LLM_GATEWAY_ADDR=
# Upstream provider (default https://api.anthropic.com).
OCTOPUS_LLM_UPSTREAM=

# ── Docker ───────────────────────────────────────────────────────────────────
# Docker socket path (default: auto-detect via DOCKER_HOST env or /var/run/docker.sock).
# With Colima on macOS: unix:///Users/<you>/.colima/default/docker.sock
# DOCKER_HOST=

# ── Claude OAuth ─────────────────────────────────────────────────────────────
# The supported way to run Thulu is an Anthropic API key, Amazon Bedrock or
# Google Vertex AI, set per workspace in Settings. Leave this empty. A token
# here has to comply with the terms of your Claude account.
CLAUDE_CODE_OAUTH_TOKEN=

# ── CLI ───────────────────────────────────────────────────────────────────────
# Daemon address for `octopus status|logs|stop` (default http://localhost:8585).
OCTOPUS_URL=

# ── Frontend ─────────────────────────────────────────────────────────────────
# No env vars needed — the Astro frontend reads from window.location at runtime.
