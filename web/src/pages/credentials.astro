---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import Callout from "../components/Callout.astro";
import Check from "../components/Check.astro";
import CheckGroup from "../components/CheckGroup.astro";
import Count from "../components/Count.astro";
import Disclosure from "../components/Disclosure.astro";
import EmptyState from "../components/EmptyState.astro";
import Facts from "../components/Facts.astro";
import Fact from "../components/Fact.astro";
import Field from "../components/Field.astro";
import FormError from "../components/FormError.astro";
import FormSection from "../components/FormSection.astro";
import Modal from "../components/Modal.astro";
import PageHead from "../components/PageHead.astro";
import Panel from "../components/Panel.astro";
import SearchInput from "../components/SearchInput.astro";
import Table from "../components/Table.astro";
import { t, tParts, SLOT } from "../i18n";
import { CRED_TABLE, credentialColumns, decisionColumns, installColumns } from "../lib/credentials";

const APP_ID_SAMPLE = "123456";
const PEM_SAMPLE = "-----BEGIN RSA PRIVATE KEY-----";
const NAME_SAMPLE = "prod-aws";
const APP_ID_ENV = "OCTOPUS_GITHUB_APP_ID";

const envParts = tParts("credentials.ghapp.env_note", { var: SLOT });
const nameHintParts = tParts("credentials.add.name_hint", { example: SLOT });
---

<Layout title={t("credentials.title")}>
  <main class="page cred-page" style="--page-max: 1100px">
    <PageHead subMax={620} title={t("credentials.title")} subtitle={t("credentials.subtitle")}>
      <Fragment slot="actions">
        <Button
          id="btn-refresh"
          iconOnly
          icon="refresh"
          size="lg"
          label={t("common.buttons.refresh")}
        />
        <Button id="btn-add" icon="plus" variant="primary" size="md"
          >{t("credentials.buttons.new_credential")}</Button
        >
      </Fragment>
    </PageHead>

    {
      /* The other half of "keys": the ones the model runs on. The script fills it (catalog HTML). */
    }
    <Callout id="cred-cross" icon="info" class="cred-cross"
      ><span id="cred-cross-text"></span></Callout
    >

    <div class="panel-stack">
      <Panel id="cred-panel" icon="tt-shield" title={t("credentials.panels.stored")} flush>
        <Count n="" pill id="cred-count" slot="status" hidden />
        <Callout id="cred-stale" tone="warn" icon="clock" band role="status" hidden
          ><span id="cred-stale-text"></span></Callout
        >

        <EmptyState
          id="cred-error"
          tone="danger"
          icon="alert"
          title={t("credentials.errors.load_title")}
          bodyId="cred-error-text"
          hidden
        >
          <Button id="btn-retry" slot="action">{t("credentials.buttons.retry")}</Button>
        </EmptyState>

        <EmptyState
          id="cred-empty"
          icon="tt-shield"
          title={t("credentials.empty.credentials_title")}
          hidden
        >
          {t("credentials.empty.credentials")}
          <Button id="btn-add-empty" slot="action" icon="plus"
            >{t("credentials.buttons.new_credential")}</Button
          >
        </EmptyState>

        <Table
          cols={credentialColumns()}
          {...CRED_TABLE}
          class="cred-table"
          id="cred-table"
          bodyId="cred-list"
          loading
        />
      </Panel>

      <Panel id="ghapp-panel" icon="github" title={t("credentials.ghapp.title")} pad="md">
        <span class="ghapp-state" id="ghapp-state" slot="status">
          <Badge tone="muted">{t("common.status.loading")}</Badge>
        </span>

        <FormError id="ghapp-error" />

        <div id="ghapp-off" class="ghapp-off" hidden>
          <p class="ghapp-lede">{t("credentials.ghapp.lede")}</p>
          <span class="ghapp-off-actions">
            <Button id="ghapp-create" icon="github" variant="primary"
              >{t("credentials.ghapp.create")}</Button
            >
            <Button id="ghapp-connect">{t("credentials.ghapp.connect")}</Button>
          </span>
        </div>
        <Callout
          id="ghapp-perm-warn"
          tone="warn"
          icon="warn"
          class="ghapp-perm-warn"
          role="status"
          hidden><span id="ghapp-perm-warn-text"></span></Callout
        >

        <div id="ghapp-on" hidden>
          <div class="ghapp-summary">
            <Facts layout="inline">
              <Fact
                label={t("credentials.ghapp.fact_app")}
                value=""
                valueAttrs={{ id: "ghapp-slug" }}
              />
              <Fact
                label={t("credentials.ghapp.app_id")}
                value=""
                mono
                valueAttrs={{ id: "ghapp-appid" }}
              />
              <Fact
                id="ghapp-client-fact"
                label={t("credentials.ghapp.client_id")}
                value=""
                mono
                valueAttrs={{ id: "ghapp-clientid" }}
              />
            </Facts>
            <div class="ghapp-actions">
              <Button id="ghapp-forget" variant="danger">{t("common.buttons.remove")}</Button>
              <Button id="ghapp-install">{t("credentials.ghapp.install")}</Button>
            </div>
          </div>
          <p id="ghapp-env" class="ghapp-env" hidden>
            {
              envParts.map((part, i) =>
                i % 2 ? <code class="code-inline">{APP_ID_ENV}</code> : part,
              )
            }
          </p>

          <div class="ghapp-installs">
            <h3 class="sub-head">
              {t("credentials.ghapp.installations")}
              <Count n="" pill id="ghapp-install-count" hidden />
            </h3>
            <div id="ghapp-installs-note" hidden></div>
            <div class="installs-wrap" id="ghapp-installs-wrap" hidden>
              <Table cols={installColumns()} {...CRED_TABLE} bodyId="ghapp-installs" />
            </div>
          </div>
        </div>
      </Panel>

      <Panel id="dec-panel" icon="list" title={t("credentials.panels.decisions")} flush>
        <Check slot="actions" id="denies-only" label={t("credentials.decisions.refusals_only")} />
        <Table
          cols={decisionColumns()}
          {...CRED_TABLE}
          class="dec-table"
          bodyId="decision-list"
          loading
        />
      </Panel>
    </div>

    <Modal id="add-modal" title={t("credentials.add.title")} icon="tt-shield" size="md" closable>
      <form id="add-form" class="form-stack" novalidate>
        <Field
          label={t("credentials.columns.name")}
          for="add-name"
          errorId="add-name-error"
          id="add-name-row"
        >
          <input
            id="add-name"
            placeholder={NAME_SAMPLE}
            autocomplete="off"
            spellcheck="false"
            aria-describedby="add-name-hint"
          />
          <p class="field-help" id="add-name-hint">
            {
              nameHintParts.map((part, i) =>
                i % 2 ? <code class="code-inline">{NAME_SAMPLE}</code> : part,
              )
            }
          </p>
        </Field>

        <div class="form-row cred-pair">
          <Field label={t("credentials.columns.provider")} for="add-provider">
            <select id="add-provider"></select>
          </Field>
          <Field label={t("credentials.add.type")} for="add-kind" id="add-kind-row">
            <select id="add-kind"></select>
          </Field>
        </div>
        <p id="add-provider-help" class="field-help provider-help"></p>
        <FormError id="add-providers-error" />

        <div id="add-oauth" class="form-stack" hidden>
          <Field
            label={t("credentials.oauth.server")}
            for="add-oauth-server"
            help={t("credentials.oauth.server_help")}
            helpId="add-oauth-server-help"
          >
            <select id="add-oauth-server"></select>
          </Field>
          <p class="field-help" id="add-oauth-redirect"></p>
          <FormError id="add-oauth-error" />
        </div>

        <div id="add-fields" class="form-stack"></div>

        <FormSection legend={t("credentials.add.access")} group>
          <p class="field-help">{t("credentials.add.grants_hint")}</p>
          <CheckGroup id="add-grants" layout="list" />
        </FormSection>

        <FormError id="add-error" />
        <Callout icon="tt-shield">{t("credentials.add.hint")}</Callout>
      </form>

      <div id="add-done" class="add-done" role="status" hidden>
        <p class="add-done-title" id="add-done-title"></p>
        <Facts id="add-result" boxed />
        <Callout id="add-done-warn" tone="warn" icon="warn" class="add-done-warn" hidden>
          {t("credentials.toasts.saved_no_grants")}
        </Callout>
        <div id="add-done-use" class="add-done-use" hidden>
          <p class="field-help">{t("credentials.add.use_in_project")}</p>
          <ul id="add-done-projects" class="add-done-projects"></ul>
        </div>
      </div>

      <Fragment slot="actions">
        <Button id="add-cancel">{t("common.buttons.cancel")}</Button>
        <Button id="add-again" hidden>{t("credentials.buttons.add_another")}</Button>
        <Button id="add-submit" variant="primary" type="submit" form="add-form"
          >{t("credentials.buttons.validate_save")}</Button
        >
        <Button id="add-finish" variant="primary" hidden>{t("credentials.buttons.done")}</Button>
      </Fragment>
    </Modal>

    <Modal
      id="detail-modal"
      title={t("credentials.columns.credential")}
      icon="tt-shield"
      size="xl"
      closable
    >
      <div class="detail-top">
        <span id="detail-badges" class="detail-badges"></span>
        <span class="detail-top-actions">
          <Button id="detail-revalidate" icon="refresh">{t("credentials.buttons.recheck")}</Button>
          <Button id="detail-rename">{t("credentials.buttons.rename")}</Button>
          <Button id="detail-rotate">{t("credentials.buttons.rotate")}</Button>
          <Button id="detail-reconnect" icon="link" hidden
            >{t("credentials.oauth.reconnect")}</Button
          >
          <Button id="detail-disconnect" variant="danger" hidden
            >{t("credentials.oauth.disconnect")}</Button
          >
          <Button id="detail-disable">{t("credentials.buttons.disable")}</Button>
        </span>
      </div>
      {
        /*
        Renaming and rotating are their own small form: they save on their own
        (PATCH), so their inputs stay out of the unsaved-changes check of the
        grants and tools below (data-no-dirty).
      */
      }
      <form id="detail-edit" class="detail-edit form-stack" data-no-dirty novalidate hidden>
        <Field label={t("credentials.columns.name")} for="detail-new-name" id="detail-name-field">
          <input id="detail-new-name" autocomplete="off" spellcheck="false" />
        </Field>
        <div id="detail-rotate-fields" class="form-stack"></div>
        <p class="field-help" id="detail-rotate-hint">{t("credentials.detail.rotate_hint")}</p>
        <FormError id="detail-edit-error" />
        <span class="form-actions">
          <Button id="detail-edit-cancel">{t("common.buttons.cancel")}</Button>
          <Button id="detail-edit-save" variant="primary" type="submit" form="detail-edit"
            >{t("common.buttons.save")}</Button
          >
        </span>
      </form>
      <Facts id="detail-summary" layout="grid" boxed />
      <FormError id="detail-error" />

      <section class="detail-section">
        <h4 id="detail-tools-title">{t("credentials.columns.tools")}</h4>
        <p class="field-help">{t("credentials.detail.tools_hint")}</p>
        <Callout id="detail-tools-note" tone="warn" icon="warn" role="note" hidden>
          {t("credentials.detail.permissions_unknown")}
        </Callout>
        <SearchInput
          id="detail-tools-search"
          class="tool-search"
          type="search"
          kbd={false}
          data-no-dirty
          placeholder={t("credentials.detail.tools_search")}
          label={t("credentials.detail.tools_search")}
        />
        <div id="detail-tools"></div>
      </section>

      <FormSection class="detail-section">
        <h4 slot="legend">{t("credentials.add.access")}</h4>
        <p class="field-help">{t("credentials.detail.grants_hint")}</p>
        <CheckGroup id="detail-grants" layout="list" />
      </FormSection>

      <FormError id="detail-save-error" />

      <Button slot="actions-start" id="detail-delete" variant="danger" icon="trash"
        >{t("common.buttons.delete")}</Button
      >
      <Fragment slot="actions">
        <Button id="detail-close">{t("common.buttons.close")}</Button>
        <Button id="detail-save" variant="primary" disabled
          >{t("credentials.buttons.save_changes")}</Button
        >
      </Fragment>
    </Modal>

    <Modal
      id="ghapp-modal"
      title={t("credentials.ghapp.modal_title")}
      icon="github"
      size="md"
      closable
      lede={t("credentials.ghapp.form_lede")}
    >
      <form id="ghapp-form" class="form-stack" novalidate>
        <Field
          label={t("credentials.ghapp.app_id")}
          for="ghapp-id"
          help={t("credentials.ghapp.app_id_hint")}
          helpId="ghapp-id-hint"
          errorId="ghapp-id-error"
        >
          <input
            id="ghapp-id"
            class="cred-short"
            inputmode="numeric"
            autocomplete="off"
            placeholder={APP_ID_SAMPLE}
            aria-describedby="ghapp-id-hint"
          />
        </Field>

        <Field
          label={t("credentials.ghapp.private_key")}
          for="ghapp-key"
          help={t("credentials.ghapp.private_key_hint")}
          helpId="ghapp-key-hint"
          errorId="ghapp-key-error"
        >
          <textarea
            id="ghapp-key"
            class="mono cred-pem"
            rows="5"
            spellcheck="false"
            placeholder={PEM_SAMPLE}
            aria-describedby="ghapp-key-hint"></textarea>
        </Field>

        <Disclosure variant="fields" summary={t("credentials.ghapp.more")} ruled id="ghapp-more">
          <div class="form-stack">
            <p class="field-help">{t("credentials.ghapp.more_hint")}</p>
            <Field label={t("credentials.ghapp.client_id")} for="ghapp-client-id">
              <input id="ghapp-client-id" autocomplete="off" spellcheck="false" />
            </Field>
            <div class="form-row cred-pair">
              <Field label={t("credentials.ghapp.client_secret")} for="ghapp-client-secret">
                <input id="ghapp-client-secret" type="password" autocomplete="off" />
              </Field>
              <Field label={t("credentials.ghapp.webhook_secret")} for="ghapp-webhook">
                <input id="ghapp-webhook" type="password" autocomplete="off" />
              </Field>
            </div>
          </div>
        </Disclosure>

        <FormError id="ghapp-result" />
      </form>

      <Fragment slot="actions">
        <Button id="ghapp-cancel">{t("common.buttons.cancel")}</Button>
        <Button id="ghapp-save" variant="primary" type="submit" form="ghapp-form"
          >{t("credentials.buttons.connect")}</Button
        >
      </Fragment>
    </Modal>

    <Modal
      id="ghapp-create-modal"
      title={t("credentials.ghapp.create_title")}
      icon="github"
      closable
      lede={t("credentials.ghapp.create_lede")}
    >
      <form id="ghapp-create-form" class="form-stack" novalidate>
        <Field
          label={t("credentials.ghapp.create_org")}
          for="ghapp-create-org"
          help={t("credentials.ghapp.create_org_hint")}
        >
          <input
            id="ghapp-create-org"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="ghapp-create-org-help"
          />
        </Field>
        <Check id="ghapp-create-deploy" label={t("credentials.ghapp.create_deploy")} />
        <p class="field-help ghapp-create-url" id="ghapp-create-url"></p>
        <Callout id="ghapp-create-private" tone="warn" icon="warn" role="status" hidden
          ><span id="ghapp-create-private-text"></span></Callout
        >
        <FormError id="ghapp-create-error" />
      </form>
      <Fragment slot="actions">
        <Button id="ghapp-create-cancel">{t("common.buttons.cancel")}</Button>
        <Button id="ghapp-create-go" variant="primary" type="submit" form="ghapp-create-form"
          >{t("credentials.ghapp.create_go")}</Button
        >
      </Fragment>
    </Modal>
  </main>

  <style is:global>
    /* The page frame, the header and the list tables come from styles/page.css
       and PageHead.astro. What is left here is what this page alone draws. */

    /* ── Stored credentials ───────────────────────────────────────── */
    /* The whole row opens the credential (the name button is the keyboard
       path). */
    .cred-table tr.cred-row {
      cursor: pointer;
    }
    .cred-open {
      padding: 0;
      border: 0;
      background: none;
      color: var(--fg);
      font: inherit;
      font-weight: 500;
      text-align: left;
      cursor: pointer;
    }
    .cred-open:hover {
      color: var(--accent);
    }
    .cred-hint,
    .cred-identity {
      font-family: var(--font-mono);
      font-size: var(--t-xs);
      color: var(--fg-3);
    }
    .cred-hint {
      display: block;
      margin-top: 2px;
    }
    /* Inside the cell on a phone, where the stacked card is narrower. */
    .cred-identity {
      display: inline-block;
      max-width: min(30ch, 100%);
      vertical-align: bottom;
    }
    .grant-chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-1);
    }

    /* ── GitHub App ───────────────────────────────────────────────── */
    .ghapp-state {
      display: inline-flex;
      gap: var(--s-2);
    }
    .ghapp-off {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-7);
    }
    .ghapp-lede {
      max-width: 72ch;
      color: var(--fg-2);
      font-size: var(--t-sm);
      line-height: var(--lh-loose);
    }
    .ghapp-off .btn {
      flex: none;
    }
    .ghapp-off-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3);
      flex: none;
    }
    .ghapp-perm-warn {
      margin-top: var(--s-4);
    }
    .cred-cross {
      margin: 0 0 var(--s-5);
    }
    .add-done-projects a {
      color: var(--accent);
    }
    .add-done-use {
      margin-top: var(--s-4);
    }
    .add-done-projects {
      margin: var(--s-2) 0 0;
      padding-left: var(--s-6);
      font-size: var(--t-sm);
    }
    .ghapp-create-url {
      overflow-wrap: anywhere;
    }
    .detail-edit {
      margin: var(--s-4) 0;
      padding: var(--s-5);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
    }
    .detail-edit > .form-actions {
      align-self: flex-end;
    }
    .ghapp-summary {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--s-5);
      flex-wrap: wrap;
    }
    .ghapp-actions {
      display: inline-flex;
      gap: var(--s-3);
    }
    .ghapp-env {
      margin-top: var(--s-4);
      max-width: 80ch;
      color: var(--fg-2);
      font-size: var(--t-sm);
      line-height: var(--lh-loose);
    }
    .ghapp-installs {
      margin-top: var(--s-7);
    }
    /* The installations table sits in its own box inside the App's panel. */
    .installs-wrap {
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      overflow: hidden;
    }

    /* ── Decision trail ───────────────────────────────────────────── */
    td.d-when {
      color: var(--fg-3);
    }
    .dec-task {
      font-size: var(--t-sm);
      color: var(--fg);
    }
    a.dec-task:hover {
      color: var(--accent);
      text-decoration: underline;
    }
    .dec-task.mono {
      font-family: var(--font-mono);
      font-size: var(--t-xs);
      color: var(--fg-2);
    }
    .dec-stage {
      display: block;
      margin-top: 2px;
      font-size: var(--t-xs);
      color: var(--fg-3);
    }
    td.dec-reason {
      color: var(--fg-2);
    }

    /* ── Forms in the modals ──────────────────────────────────────── */
    /* The fields, checks and lists are the primitives (form.css, check.css). */
    .cred-pair > .field {
      flex: 1 1 200px;
    }
    .provider-help:empty,
    #add-fields:empty {
      display: none;
    }
    .cred-short {
      max-width: 220px;
    }
    .cred-pem {
      min-height: 112px;
    }

    .add-done-title {
      margin-bottom: var(--s-4);
      font-size: var(--t-md);
      font-weight: 600;
      color: var(--fg);
    }
    .add-done-warn {
      margin: var(--s-4) 0 0;
    }

    .detail-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-4);
      flex-wrap: wrap;
      margin-bottom: var(--s-4);
    }
    .detail-badges,
    .detail-top-actions {
      display: inline-flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    #detail-error {
      margin-top: var(--s-4);
    }
    .detail-section {
      margin-top: var(--s-7);
    }
    .detail-section h4 {
      font-size: var(--t-md);
      font-weight: 600;
      color: var(--fg);
    }
    .detail-section > .field-help {
      margin: var(--s-1) 0 var(--s-3);
    }
    .tool-search {
      margin-bottom: var(--s-3);
    }
    /* The modal body already scrolls: the tool list grows with it instead of
       scrolling inside it. */
    #detail-tools {
      --check-list-max: none;
    }

    /* ── Phone ────────────────────────────────────────────────────── */
    @media (max-width: 760px) {
      .ghapp-off {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--s-5);
      }
      .cred-short {
        max-width: none;
      }

      .ghapp-actions {
        flex-wrap: wrap;
      }
    }
    /* On a phone each credential stacks into a card that opens the
       credential, whose detail has Re-check: the row leaves the button out. */
    @media (max-width: 640px) {
      .cred-table td.cred-check {
        display: none;
      }
    }
  </style>

  <script>
    import { requireAuth } from "../lib/auth";
    import { api, ApiError } from "../lib/api";
    import {
      $,
      calloutClasses,
      checkGroupHTML,
      checkHTML,
      confirmDialog,
      countHTML,
      emptyRowHTML,
      emptyStateHTML,
      esc,
      factHTML,
      factRows,
      isConfirmOpen,
      makeToast,
      setCount,
      setFieldError,
      setFormError,
      tableRowHTML,
      tableSpan,
      tagHTML,
      type Fact,
    } from "../lib/ui";
    import { safeUrl } from "../lib/safe-url";
    import { bindModal } from "../lib/modal";
    import { ago, fmtDate } from "../lib/time";
    import { badgeHTML, credentialStateBadge } from "../lib/badges";
    import { isOperatorRefusal, mayWriteInstallWide, showReadOnly } from "../lib/operator";
    import {
      CRED_TABLE,
      checkSummary,
      checkTone,
      credentialColumns,
      decisionColumns,
      installColumns,
      introspectNote,
      connectableServers,
      createCredential,
      fetchOAuthServers,
      isOAuth,
      oauthOutcome,
      oauthStatusText,
      OAUTH_DISCONNECTED,
      OAUTH_PROVIDER,
      startOAuth,
      type OAuthServers,
      fetchProviders,
      fieldInputs,
      groupTools,
      kindOptions,
      listCredentials,
      permissionsUndiscovered,
      providerOptions,
      reachableByGitHub,
      readPayload,
      type Credential,
      type Grant,
      type KindSpec,
      type ProviderSpec,
      type ToolGroupID,
      type ToolRow,
    } from "../lib/credentials";
    import { taskAnchor } from "../lib/test-cases";
    import { t } from "../i18n";
    import { onPage } from "../lib/page";

    onPage("/credentials", (signal) => {
      requireAuth();

      const toast = makeToast(3500);
      const errText = (e: unknown): string =>
        e instanceof Error ? e.message : String((e as any)?.message ?? e);

      interface DecisionRecord {
        id: string;
        credential_id?: string;
        task_id?: string;
        agent?: string;
        stage?: string;
        server?: string;
        tool?: string;
        allowed: boolean;
        reason?: string;
        created_at: string;
        task_title?: string;
        task_board_id?: string;
        stage_label?: string;
      }
      interface PermissionGap {
        name: string;
        want: string;
        has?: string;
        required: boolean;
      }
      interface Project {
        id: string;
        name: string;
      }
      interface Environment {
        id: string;
        name: string;
        is_production?: boolean;
      }

      interface GrantTarget {
        type: "project" | "environment" | "workspace";
        id: string;
        label: string;
        isProduction?: boolean;
        name?: string;
      }

      let providers: ProviderSpec[] = [];
      let providersFailed = false;
      let credentials: Credential[] = [];
      let credentialsLoaded = false;
      let credentialsLoadedAt = 0;
      let grantTargets: GrantTarget[] = [];
      let decisions: DecisionRecord[] = [];
      let decisionsError = "";
      let oauthServers: OAuthServers | null = null;
      let connectServer = "";
      let oauthReturn: "credentials" | "mcps" = "credentials";

      function snapshot(host: HTMLElement): string {
        return Array.from(
          host.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
            "input, select, textarea",
          ),
        )
          .filter((el) => !el.closest("[data-no-dirty]"))
          .map((el) =>
            el instanceof HTMLInputElement && el.type === "checkbox"
              ? el.checked
                ? "1"
                : "0"
              : el.value,
          )
          .join("\u0001");
      }

      interface Dialog {
        open: (focus?: HTMLElement | null) => void;
        close: () => void;
        isOpen: () => boolean;
        requestClose: () => Promise<void>;
      }

      function dialog(id: string, isDirty: () => boolean, onClose?: () => void): Dialog {
        const overlay = $(id);
        let returnTo: HTMLElement | null = null;
        // bindModal closes on [data-modal-close] without asking; strip it so the ✕ goes through
        // requestClose.
        const closers = Array.from(overlay.querySelectorAll<HTMLElement>("[data-modal-close]"));
        closers.forEach((el) => el.removeAttribute("data-modal-close"));
        const inner = bindModal(overlay, { dismissable: false });
        const close = () => {
          inner.close();
          onClose?.();
          returnTo?.focus();
          returnTo = null;
        };
        const requestClose = async () => {
          if (isDirty()) {
            const ok = await confirmDialog({
              title: t("credentials.confirm.discard_title"),
              message: t("credentials.confirm.discard_message"),
              confirmLabel: t("common.buttons.discard"),
              cancelLabel: t("credentials.buttons.keep_editing"),
              danger: true,
            });
            if (!ok) return;
          }
          close();
        };
        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) void requestClose();
        });
        closers.forEach((el) => el.addEventListener("click", () => void requestClose()));
        return {
          open: (focus) => {
            const active = document.activeElement;
            returnTo = active instanceof HTMLElement && active !== document.body ? active : null;
            inner.open(focus);
          },
          close,
          isOpen: inner.isOpen,
          requestClose,
        };
      }

      function setBusy(btn: HTMLButtonElement, busy: boolean, label?: string): void {
        btn.disabled = busy;
        if (label !== undefined) btn.textContent = label;
      }

      // Reason codes are stable and the API branches on them; wording lives here, not in the
      // daemon.
      const REASON_KEY: Record<string, string> = {
        ok: "credentials.reasons.ok",
        no_credential_needed: "credentials.reasons.no_credential_needed",
        no_credential: "credentials.reasons.no_credential",
        ambiguous_credential: "credentials.reasons.ambiguous_credential",
        provider_unsupported: "credentials.reasons.provider_unsupported",
        credential_disabled: "credentials.reasons.credential_disabled",
        credential_expired: "credentials.reasons.credential_expired",
        credential_invalid: "credentials.reasons.credential_invalid",
        tool_disabled_by_policy: "credentials.reasons.tool_disabled_by_policy",
        missing_capability: "credentials.reasons.missing_capability",
        tool_not_in_stage_allowlist: "credentials.reasons.tool_not_in_stage_allowlist",
      };

      function reasonText(reason?: string): string {
        const key = REASON_KEY[reason || ""];
        return key ? t(key) : (reason ?? "");
      }

      const STATE_KEY: Record<string, string> = {
        valid: "credentials.states.valid",
        expiring: "credentials.states.expiring",
        expired: "credentials.states.expired",
        invalid: "credentials.states.invalid",
        unknown: "credentials.states.unknown",
      };
      function stateText(state: string): string {
        const key = STATE_KEY[state];
        return key ? t(key) : state;
      }

      const stateBadge = (c: Credential): string => credentialStateBadge(c);

      function providerLabel(id: string): string {
        return providers.find((p) => p.id === id)?.label ?? id;
      }

      const GRANT_KIND_KEY: Record<GrantTarget["type"], string> = {
        project: "credentials.grants.kind_project",
        environment: "credentials.grants.kind_environment",
        workspace: "credentials.grants.kind_workspace",
      };

      function credentialName(id?: string): string {
        if (!id) return "—";
        return credentials.find((c) => c.id === id)?.name ?? id;
      }

      function grantChips(c: Credential): string {
        const grants = c.grants || [];
        if (!grants.length) {
          return tagHTML(t("credentials.grants.none"), { dashed: true });
        }
        return grants
          .map((g) => {
            if (g.subject_type === "workspace") {
              return tagHTML(t("credentials.grants.every_task"), { tone: "warn" });
            }
            const target = grantTargets.find(
              (x) => x.type === g.subject_type && x.id === g.subject_id,
            );
            const label = target?.label ?? g.subject_id ?? "?";
            return tagHTML(label, { title: label });
          })
          .join("");
      }

      function renderList(): void {
        const tbody = $("cred-list") as HTMLTableSectionElement;
        const count = $("cred-count");
        const empty = credentialsLoaded && !credentials.length;
        $("cred-empty").hidden = !empty;
        $("cred-error").hidden = true;
        $("cred-table").hidden = empty;
        setCount(count, credentials.length, { pill: true });
        count.hidden = !credentialsLoaded || empty;
        if (empty) {
          tbody.innerHTML = "";
          return;
        }
        const cols = credentialColumns();
        tbody.innerHTML = credentials
          .map((c) =>
            tableRowHTML(
              cols,
              {
                cls: "cred-row",
                attrs: { "data-id": c.id },
                cells: [
                  {
                    html:
                      `<button class="cred-open" type="button" data-act="open">${esc(c.name)}</button>` +
                      (c.hint ? `<span class="cred-hint">${esc(c.hint)}</span>` : ""),
                  },
                  providerLabel(c.provider),
                  {
                    html: `<span class="cred-identity truncate" title="${esc(c.identity || "")}">${esc(c.identity || "—")}</span>`,
                  },
                  { html: stateBadge(c) },
                  { html: `<span class="grant-chips">${grantChips(c)}</span>` },
                  {
                    actions: [
                      {
                        label: t("credentials.buttons.recheck_named", { name: c.name }),
                        title: t("credentials.buttons.recheck"),
                        icon: "refresh",
                        iconOnly: true,
                        attrs: { "data-act": "check" },
                      },
                    ],
                  },
                ],
              },
              CRED_TABLE,
            ),
          )
          .join("");
      }

      function showListError(msg: string): void {
        if (credentialsLoaded) {
          $("cred-stale-text").textContent = t("credentials.errors.stale", {
            time: ago(new Date(credentialsLoadedAt).toISOString()),
          });
          $("cred-stale").hidden = false;
          return;
        }
        $("cred-error-text").textContent = msg;
        $("cred-error").hidden = false;
        $("cred-table").hidden = true;
        $("cred-empty").hidden = true;
      }

      $("cred-list").addEventListener("click", (ev) => {
        const target = ev.target as HTMLElement;
        const tr = target.closest<HTMLElement>("tr.cred-row");
        if (!tr) return;
        const check = target.closest<HTMLButtonElement>("button[data-act=check]");
        if (check) {
          void revalidateRow(tr.dataset.id!, check);
          return;
        }
        void openDetail(tr.dataset.id!);
      });

      async function loadProviders(): Promise<void> {
        providers = await fetchProviders();
        providersFailed = providers.length === 0;
      }

      async function loadGrantTargets(): Promise<void> {
        const targets: GrantTarget[] = [
          { type: "workspace", id: "", label: t("credentials.grants.workspace") },
        ];
        let projects: Project[] = [];
        try {
          projects = (await api.get<Project[]>("/projects")) || [];
        } catch {
          grantTargets = targets;
          return;
        }
        for (const p of projects) {
          targets.push({
            type: "project",
            id: p.id,
            label: t("credentials.grants.project", { name: p.name }),
            name: p.name,
          });
        }
        const envLists = await Promise.all(
          projects.map(async (p) => {
            try {
              const envs = (await api.get<Environment[]>(`/projects/${p.id}/environments`)) || [];
              return envs.map((e) => ({
                type: "environment" as const,
                id: e.id,
                label: `${p.name} / ${e.name}`,
                isProduction: e.is_production,
              }));
            } catch {
              return [];
            }
          }),
        );
        grantTargets = targets.concat(...envLists);
      }

      async function loadCredentials(): Promise<void> {
        try {
          credentials = await listCredentials();
          credentialsLoaded = true;
          credentialsLoadedAt = Date.now();
          $("cred-stale").hidden = true;
          renderList();
        } catch (e) {
          showListError(errText(e));
        }
      }

      function renderDecisions(): void {
        const tbody = $("decision-list") as HTMLTableSectionElement;
        if (decisionsError) {
          tbody.innerHTML = emptyRowHTML(
            t("credentials.errors.decisions_failed", { error: decisionsError }),
            { cols: tableSpan(decisionColumns()), tone: "danger" },
          );
          return;
        }
        const deniesOnly = ($("denies-only") as HTMLInputElement).checked;
        const rows = deniesOnly ? decisions.filter((d) => !d.allowed) : decisions;
        if (!rows.length) {
          tbody.innerHTML = emptyRowHTML(
            deniesOnly ? t("credentials.empty.refusals") : t("credentials.empty.decisions"),
            { cols: tableSpan(decisionColumns()) },
          );
          return;
        }
        const cols = decisionColumns();
        tbody.innerHTML = rows
          .map((d) => {
            const verdict = d.allowed
              ? badgeHTML(t("credentials.decisions.allow"), "ok")
              : badgeHTML(t("credentials.decisions.deny"), "danger");
            const where = d.task_id ? decisionWhere(d) : `<span class="muted">—</span>`;
            const tool = `${d.server || "?"}/${d.tool || "?"}`;
            return tableRowHTML(
              cols,
              {
                cls: "dec-row",
                tone: d.allowed ? undefined : "danger",
                cells: [
                  {
                    text: t("credentials.decisions.ago", { time: ago(d.created_at) }),
                    attrs: { title: fmtDate(d.created_at) },
                  },
                  { html: verdict },
                  { text: tool, attrs: { title: tool } },
                  credentialName(d.credential_id),
                  { html: where },
                  reasonText(d.reason),
                ],
              },
              CRED_TABLE,
            );
          })
          .join("");
      }

      function decisionWhere(d: DecisionRecord): string {
        const id = d.task_id ?? "";
        const task = d.task_title
          ? `<a class="dec-task" href="${esc(taskAnchor(id, d.task_board_id ?? ""))}" title="${esc(id)}">${esc(d.task_title)}</a>`
          : `<span class="dec-task mono">${esc(id)}</span>`;
        const stage = d.stage_label || d.stage;
        return stage
          ? `${task}<span class="dec-stage">${esc(t("credentials.decisions.stage", { stage }))}</span>`
          : task;
      }

      async function loadDecisions(): Promise<void> {
        try {
          const resp = await api.get<{ decisions: DecisionRecord[] | null }>(
            "/credentials/decisions",
          );
          decisions = resp?.decisions ?? [];
          decisionsError = "";
        } catch (e) {
          if (!decisions.length) decisionsError = errText(e);
        }
        renderDecisions();
      }

      async function refresh(): Promise<void> {
        const btn = $("btn-refresh") as HTMLButtonElement;
        btn.disabled = true;
        btn.classList.add("is-busy");
        btn.setAttribute("aria-busy", "true");
        try {
          await Promise.all([loadCredentials(), loadDecisions(), loadGithubApp()]);
        } finally {
          btn.disabled = false;
          btn.classList.remove("is-busy");
          btn.removeAttribute("aria-busy");
        }
      }

      interface GithubAppStatus {
        configured: boolean;
        source?: string;
        app_id?: number;
        slug?: string;
        client_id?: string;
        install_url?: string;
      }
      interface GithubInstallation {
        installation_id: number;
        account_login: string;
        repository_selection?: string;
        suspended_at?: string;
      }

      // Setting or removing the App is operator-only (lib/operator.ts): one App serves every
      // workspace.
      let ghappLocked = false;
      let ghappLoaded = false;
      const ghappReady = mayWriteInstallWide().then((ok) => {
        ghappLocked = !ok;
      });
      function lockGithubApp(): void {
        ghappLocked = true;
        showReadOnly(
          $("ghapp-panel").querySelector<HTMLElement>(".panel-body")!,
          t("credentials.ghapp.read_only"),
          [$("ghapp-save"), $("ghapp-forget"), $("ghapp-connect"), $("ghapp-create")],
        );
        $("ghapp-connect").hidden = true;
        $("ghapp-create").hidden = true;
        $("ghapp-forget").hidden = true;
        if (ghappModal.isOpen()) ghappModal.close();
      }

      function ghappBadges(status: GithubAppStatus): string {
        if (!status.configured) {
          return badgeHTML(t("credentials.ghapp.state_unconfigured"), "muted", { dot: true });
        }
        const on = badgeHTML(t("credentials.ghapp.state_configured"), "ok", { dot: true });
        return status.source === "env"
          ? `${on}${badgeHTML(t("credentials.ghapp.state_env"), "neutral", { edge: "dashed" })}`
          : on;
      }

      async function loadGithubApp(): Promise<void> {
        await ghappReady;
        let status: GithubAppStatus = { configured: false };
        const errBox = $("ghapp-error");
        try {
          status = await api.get<GithubAppStatus>("/github/app");
          errBox.hidden = true;
        } catch (e) {
          // 503: the GitHub integration is not wired into this daemon.
          if (e instanceof ApiError && e.status === 503) {
            $("ghapp-panel").hidden = true;
            return;
          }
          errBox.textContent = t("credentials.errors.ghapp_load_failed", { error: errText(e) });
          errBox.hidden = false;
          if (!ghappLoaded) $("ghapp-state").innerHTML = "";
          return;
        }
        ghappLoaded = true;
        $("ghapp-panel").hidden = false;
        $("ghapp-state").innerHTML = ghappBadges(status);
        $("ghapp-off").hidden = status.configured;
        $("ghapp-on").hidden = !status.configured;

        if (!status.configured) {
          if (ghappLocked) lockGithubApp();
          return;
        }
        $("ghapp-slug").textContent = status.slug || t("credentials.ghapp.fallback_slug");
        $("ghapp-appid").textContent = String(status.app_id ?? "—");
        $("ghapp-clientid").textContent = status.client_id ?? "";
        $("ghapp-client-fact").hidden = !status.client_id;
        $("ghapp-env").hidden = status.source !== "env";
        $("ghapp-forget").hidden = status.source === "env" || ghappLocked;
        if (ghappLocked) lockGithubApp();
        await loadInstallations();
      }

      async function loadInstallations(): Promise<void> {
        const wrap = $("ghapp-installs-wrap");
        const note = $("ghapp-installs-note");
        const count = $("ghapp-install-count");
        const body = $("ghapp-installs");
        let installs: GithubInstallation[] = [];
        try {
          installs = (await api.get<GithubInstallation[]>("/github/installations")) || [];
        } catch (e) {
          note.innerHTML = emptyStateHTML({
            size: "inline",
            tone: "danger",
            icon: "alert",
            title: t("credentials.errors.installs_failed", { error: errText(e) }),
          });
          note.hidden = false;
          wrap.hidden = true;
          count.hidden = true;
          return;
        }
        setCount(count, installs.length, { pill: true, hideZero: true });
        $("ghapp-install").textContent = installs.length
          ? t("credentials.ghapp.install_other")
          : t("credentials.ghapp.install");
        wrap.hidden = installs.length === 0;
        note.hidden = installs.length > 0;
        note.innerHTML = emptyStateHTML({
          size: "inline",
          dashed: true,
          title: t("credentials.ghapp.installations_empty"),
        });
        const cols = installColumns();
        body.innerHTML = installs
          .map((i) =>
            tableRowHTML(
              cols,
              {
                cells: [
                  i.account_login,
                  i.repository_selection === "all"
                    ? t("credentials.ghapp.repos_all")
                    : t("credentials.ghapp.repos_selected"),
                  {
                    html: i.suspended_at
                      ? badgeHTML(t("credentials.ghapp.install_suspended"), "warn")
                      : badgeHTML(t("credentials.ghapp.install_active"), "ok"),
                  },
                  {
                    actions: [
                      {
                        label: t("credentials.buttons.unlink"),
                        variant: "danger",
                        attrs: {
                          "data-unlink": String(i.installation_id),
                          "data-org": i.account_login,
                        },
                      },
                    ],
                  },
                ],
              },
              CRED_TABLE,
            ),
          )
          .join("");
      }

      $("ghapp-installs").addEventListener("click", (ev) => {
        const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-unlink]");
        if (b) void unlinkInstallation(Number(b.dataset.unlink), b.dataset.org || "");
      });

      const ghappForm = $("ghapp-form") as HTMLFormElement;
      let ghappSnap = "";
      const ghappModal = dialog(
        "ghapp-modal",
        () => snapshot(ghappForm) !== ghappSnap,
        () => {
          // Don't leave the App's secrets in a hidden form for the rest of the session.
          ghappForm.reset();
        },
      );

      function openGithubApp(): void {
        if (ghappLocked) return;
        ghappForm.reset();
        ($("ghapp-more") as HTMLDetailsElement).open = false;
        setFieldError($("ghapp-id"), "");
        setFieldError($("ghapp-key"), "");
        $("ghapp-result").hidden = true;
        setBusy($("ghapp-save") as HTMLButtonElement, false, t("credentials.buttons.connect"));
        ghappSnap = snapshot(ghappForm);
        ghappModal.open($("ghapp-id"));
      }

      function validateGithubApp(): boolean {
        const idEl = $("ghapp-id") as HTMLInputElement;
        const keyEl = $("ghapp-key") as HTMLTextAreaElement;
        const idOk = /^\d+$/.test(idEl.value.trim());
        const keyOk = keyEl.value.trim() !== "";
        setFieldError(idEl, idOk ? "" : t("credentials.errors.ghapp_app_id"));
        setFieldError(keyEl, keyOk ? "" : t("credentials.errors.ghapp_key"));
        if (!idOk) idEl.focus();
        else if (!keyOk) keyEl.focus();
        return idOk && keyOk;
      }

      async function saveGithubApp(): Promise<void> {
        if (!validateGithubApp()) return;
        const result = $("ghapp-result");
        const btn = $("ghapp-save") as HTMLButtonElement;
        setBusy(btn, true, t("credentials.status.validating"));
        result.hidden = true;
        try {
          const resp = await api.put<{ missing_permissions?: PermissionGap[] }>("/github/app", {
            app_id: Number(($("ghapp-id") as HTMLInputElement).value.trim()),
            private_key: ($("ghapp-key") as HTMLTextAreaElement).value.trim(),
            client_id: ($("ghapp-client-id") as HTMLInputElement).value.trim(),
            client_secret: ($("ghapp-client-secret") as HTMLInputElement).value.trim(),
            webhook_secret: ($("ghapp-webhook") as HTMLInputElement).value.trim(),
          });
          ghappModal.close();
          toast(t("credentials.toasts.ghapp_saved"), "ok");
          showPermissionGaps(resp?.missing_permissions ?? []);
          await loadGithubApp();
        } catch (e) {
          if (isOperatorRefusal(e)) {
            lockGithubApp();
          } else {
            result.textContent = errText(e);
            result.hidden = false;
          }
        } finally {
          setBusy(btn, ghappLocked, t("credentials.buttons.connect"));
        }
      }

      function showPermissionGaps(gaps: PermissionGap[]): void {
        const box = $("ghapp-perm-warn");
        const list = (g: PermissionGap[]) =>
          g.map((x) => t("credentials.ghapp.perm_item", { name: x.name, want: x.want })).join(", ");
        const required = gaps.filter((g) => g.required);
        const rest = gaps.filter((g) => !g.required);
        const lines: string[] = [];
        if (required.length)
          lines.push(t("credentials.ghapp.perm_missing", { perms: list(required) }));
        if (rest.length) lines.push(t("credentials.ghapp.perm_recommended", { perms: list(rest) }));
        $("ghapp-perm-warn-text").textContent = lines.join(" ");
        box.className = calloutClasses({
          tone: required.length ? "danger" : "warn",
          cls: "ghapp-perm-warn",
        });
        box.hidden = lines.length === 0;
      }

      const ghappCreateForm = $("ghapp-create-form") as HTMLFormElement;
      const ghappCreateModal = dialog("ghapp-create-modal", () => false);

      function openCreateGithubApp(): void {
        if (ghappLocked) return;
        ghappCreateForm.reset();
        $("ghapp-create-error").hidden = true;
        const origin = window.location.origin;
        $("ghapp-create-url").textContent = t("credentials.ghapp.create_url", { url: origin });
        const unreachable = $("ghapp-create-private");
        $("ghapp-create-private-text").textContent = t("credentials.ghapp.create_url_private", {
          host: window.location.host,
        });
        unreachable.hidden = reachableByGitHub(origin);
        setBusy($("ghapp-create-go") as HTMLButtonElement, false, t("credentials.ghapp.create_go"));
        ghappCreateModal.open($("ghapp-create-org"));
      }

      // GitHub's manifest flow only accepts the manifest as a form field POSTed from the browser.
      async function createGithubApp(): Promise<void> {
        const btn = $("ghapp-create-go") as HTMLButtonElement;
        const errBox = $("ghapp-create-error");
        errBox.hidden = true;
        setBusy(btn, true, t("credentials.status.validating"));
        const q = new URLSearchParams({ base_url: window.location.origin });
        const org = ($("ghapp-create-org") as HTMLInputElement).value.trim();
        if (org) q.set("org", org);
        if (($("ghapp-create-deploy") as HTMLInputElement).checked) q.set("deploy", "1");
        try {
          const j = await api.get<{ post_url?: string; manifest?: string }>(
            `/github/app/manifest?${q}`,
          );
          const target = safeUrl(j.post_url);
          if (!target || !j.manifest) throw new Error(t("credentials.ghapp.manifest_errors.other"));
          const form = document.createElement("form");
          form.method = "post";
          form.action = target;
          form.hidden = true;
          const field = document.createElement("input");
          field.type = "hidden";
          field.name = "manifest";
          field.value = j.manifest;
          form.append(field);
          document.body.append(form);
          form.submit();
        } catch (e) {
          if (isOperatorRefusal(e)) {
            ghappCreateModal.close();
            lockGithubApp();
            return;
          }
          errBox.textContent = t("credentials.errors.manifest_failed", { error: errText(e) });
          errBox.hidden = false;
          setBusy(btn, false, t("credentials.ghapp.create_go"));
        }
      }

      // Must match the reasons handleGithubManifestCallback redirects with.
      const MANIFEST_REASONS: Record<string, string> = {
        unavailable: t("credentials.ghapp.manifest_errors.unavailable"),
        state: t("credentials.ghapp.manifest_errors.state"),
        configured: t("credentials.ghapp.manifest_errors.configured"),
        convert: t("credentials.ghapp.manifest_errors.convert"),
        validate: t("credentials.ghapp.manifest_errors.validate"),
        store: t("credentials.ghapp.manifest_errors.store"),
      };

      function announceManifestOutcome(): void {
        const q = new URLSearchParams(window.location.search);
        const outcome = q.get("ghapp");
        if (!outcome) return;
        if (outcome === "created") {
          toast(t("credentials.ghapp.created"), "ok", 8000);
        } else {
          const reason = q.get("reason") ?? "";
          const msg = Object.hasOwn(MANIFEST_REASONS, reason)
            ? MANIFEST_REASONS[reason]
            : t("credentials.ghapp.manifest_errors.other");
          toast(msg, "err", 10000);
        }
        q.delete("ghapp");
        q.delete("reason");
        const rest = q.toString();
        const url = `${window.location.pathname}${rest ? `?${rest}` : ""}${window.location.hash}`;
        history.replaceState(history.state, "", url);
      }

      async function installGithubApp(): Promise<void> {
        const btn = $("ghapp-install") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const j = await api.get<{ url?: string }>("/github/app/install-link");
          const url = safeUrl(j.url);
          if (!url) throw new Error(t("credentials.errors.no_install_url"));
          window.location.href = url;
        } catch (e) {
          toast(t("credentials.errors.install_failed", { error: errText(e) }), "err", 5000);
          btn.disabled = false;
        }
      }

      async function forgetGithubApp(): Promise<void> {
        const ok = await confirmDialog({
          title: t("credentials.confirm.ghapp_remove_title"),
          message: t("credentials.confirm.ghapp_remove_message"),
          confirmLabel: t("credentials.buttons.remove_app"),
          danger: true,
        });
        if (!ok) return;
        const btn = $("ghapp-forget") as HTMLButtonElement;
        btn.disabled = true;
        try {
          await api.del("/github/app");
          toast(t("credentials.toasts.ghapp_removed"), "ok");
          await loadGithubApp();
        } catch (e) {
          if (isOperatorRefusal(e)) lockGithubApp();
          else
            toast(t("credentials.errors.ghapp_remove_failed", { error: errText(e) }), "err", 5000);
        } finally {
          btn.disabled = ghappLocked;
        }
      }

      async function unlinkInstallation(id: number, org: string): Promise<void> {
        const ok = await confirmDialog({
          title: t("credentials.confirm.unlink_title", { org }),
          message: t("credentials.confirm.unlink_message"),
          confirmLabel: t("credentials.buttons.unlink"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/github/installations/${id}`);
          toast(t("credentials.toasts.unlinked", { org }), "ok");
          await loadInstallations();
        } catch (e) {
          toast(t("credentials.errors.unlink_failed", { error: errText(e) }), "err", 5000);
        }
      }

      function mergeCredential(updated: Credential): void {
        const i = credentials.findIndex((c) => c.id === updated.id);
        if (i >= 0) credentials[i] = updated;
        else credentials.push(updated);
      }

      async function revalidate(id: string): Promise<Credential | null> {
        try {
          const updated = await api.post<Credential>(`/credentials/${id}/validate`);
          mergeCredential(updated);
          renderList();
          toast(checkSummary(updated, providerLabel(updated.provider)), checkTone(updated), 5000);
          return updated;
        } catch (e) {
          toast(t("credentials.errors.recheck_failed", { error: errText(e) }), "err", 6000);
          return null;
        }
      }

      async function revalidateRow(id: string, btn: HTMLButtonElement): Promise<void> {
        btn.disabled = true;
        btn.classList.add("is-busy");
        btn.setAttribute("aria-busy", "true");
        await revalidate(id);
        btn.disabled = false;
        btn.classList.remove("is-busy");
        btn.removeAttribute("aria-busy");
      }

      function renderGrantPicker(host: HTMLElement, selected: Grant[]): void {
        if (grantTargets.length <= 1) {
          host.innerHTML =
            grantRows(selected) + emptyRowHTML(t("credentials.empty.projects"), { as: "div" });
          return;
        }
        host.innerHTML = grantRows(selected);
      }

      function grantRows(selected: Grant[]): string {
        const isOn = (target: GrantTarget) =>
          selected.some(
            (g) => g.subject_type === target.type && (g.subject_id ?? "") === target.id,
          );
        return grantTargets
          .map((target, i) =>
            checkHTML({
              label: target.label,
              checked: isOn(target),
              inputAttrs: { "data-idx": i },
              trailingHTML:
                (target.isProduction
                  ? badgeHTML(t("credentials.grants.production"), "danger") + " "
                  : "") + esc(t(GRANT_KIND_KEY[target.type])),
            }),
          )
          .join("");
      }

      function readGrantPicker(host: HTMLElement): Grant[] {
        const out: Grant[] = [];
        host.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((box) => {
          if (!box.checked) return;
          const g = grantTargets[Number(box.dataset.idx)];
          if (!g) return;
          out.push(
            g.type === "workspace"
              ? { subject_type: "workspace" }
              : { subject_type: g.type, subject_id: g.id },
          );
        });
        return out;
      }

      const addForm = $("add-form") as HTMLFormElement;
      let addSnap = "";
      let addSaved = false;
      const addModal = dialog(
        "add-modal",
        () => !addSaved && snapshot(addForm) !== addSnap,
        () => {
          // Don't leave secret fields in the DOM after close.
          $("add-fields").innerHTML = "";
        },
      );

      function currentProvider(): ProviderSpec | undefined {
        const id = ($("add-provider") as HTMLSelectElement).value;
        return providers.find((p) => p.id === id);
      }
      function currentKind(): KindSpec | undefined {
        const p = currentProvider();
        const id = ($("add-kind") as HTMLSelectElement).value;
        return p?.kinds.find((k) => k.id === id);
      }

      function renderKinds(): void {
        const p = currentProvider();
        const sel = $("add-kind") as HTMLSelectElement;
        sel.innerHTML = kindOptions(p);
        $("add-kind-row").hidden = (p?.kinds.length ?? 0) < 2;
        $("add-provider-help").textContent = p?.help ?? "";
        renderFields();
        syncConnectMode();
      }

      function syncConnectMode(): void {
        const connect = Boolean(currentProvider()?.connect);
        $("add-oauth").hidden = !connect;
        $("add-name-row").hidden = connect;
        ($("add-submit") as HTMLButtonElement).textContent = submitLabel();
        if (connect) void loadOAuthServers();
      }

      function submitLabel(): string {
        return currentProvider()?.connect
          ? t("credentials.oauth.connect")
          : t("credentials.buttons.validate_save");
      }

      async function loadOAuthServers(): Promise<void> {
        const sel = $("add-oauth-server") as HTMLSelectElement;
        const errBox = $("add-oauth-error");
        setFormError(errBox, "");
        try {
          oauthServers ??= await fetchOAuthServers();
        } catch (e) {
          setFormError(errBox, t("credentials.oauth.servers_failed", { error: errText(e) }));
          return;
        }
        const list = connectableServers(oauthServers.servers);
        sel.innerHTML = list
          .map(
            (s) =>
              `<option value="${esc(s.name)}">${esc(s.name)} · ${esc(oauthStatusText(s.credential))}</option>`,
          )
          .join("");
        if (connectServer && list.some((s) => s.name === connectServer)) sel.value = connectServer;
        if (!list.length) setFormError(errBox, t("credentials.oauth.no_servers"));
        $("add-oauth-redirect").innerHTML =
          esc(t("credentials.oauth.redirect_hint")) +
          ` <code class="code-inline">${esc(oauthServers.redirect_uri)}</code>`;
      }

      async function submitConnect(): Promise<void> {
        const server = ($("add-oauth-server") as HTMLSelectElement).value;
        const errBox = $("add-error");
        errBox.hidden = true;
        if (!server) {
          setFormError(errBox, t("credentials.oauth.no_servers"));
          return;
        }
        const payload = readPayload(currentKind(), "f-");
        const btn = $("add-submit") as HTMLButtonElement;
        setBusy(btn, true, t("credentials.oauth.redirecting"));
        try {
          await startOAuth({
            server,
            client_id: payload.client_id,
            client_secret: payload.client_secret,
            scope: payload.scope,
            grants: readGrantPicker($("add-grants")),
            return: oauthReturn,
          });
          addSaved = true;
        } catch (e) {
          errBox.textContent = t("credentials.oauth.start_failed", { error: errText(e) });
          errBox.hidden = false;
          setBusy(btn, false, submitLabel());
        }
      }

      function renderFields(): void {
        const host = $("add-fields");
        const kind = currentKind();
        host.innerHTML = fieldInputs(kind, "f-");
      }

      function showAddForm(): void {
        addSaved = false;
        addForm.hidden = false;
        $("add-done").hidden = true;
        $("add-cancel").hidden = false;
        $("add-submit").hidden = false;
        $("add-again").hidden = true;
        $("add-finish").hidden = true;
        ($("add-name") as HTMLInputElement).value = "";
        setFieldError($("add-name"), "");
        ($("add-provider") as HTMLSelectElement).innerHTML = providerOptions(providers);
        setFormError(
          $("add-providers-error"),
          providersFailed ? t("credentials.errors.providers_failed") : "",
        );
        renderKinds();
        renderGrantPicker($("add-grants"), []);
        $("add-error").hidden = true;
        setBusy($("add-submit") as HTMLButtonElement, providersFailed, submitLabel());
        addSnap = snapshot(addForm);
      }

      function openAdd(): void {
        showAddForm();
        addModal.open($("add-name"));
      }

      function renderCheckResult(c: Credential): void {
        const rows: Fact[] = [];
        const line = (label: string, value: string, mono = false): Fact => ({ label, value, mono });
        rows.push(line(t("credentials.check.state"), stateText(c.state)));
        if (c.identity) rows.push(line(t("credentials.check.identity"), c.identity, true));
        if (c.expires_at) rows.push(line(t("credentials.check.expires"), fmtDate(c.expires_at)));
        const caps = c.capabilities ?? [];
        rows.push(
          line(
            t("credentials.check.can_do"),
            caps.length
              ? t("credentials.check.permissions", { count: caps.length })
              : t("credentials.check.not_discoverable"),
          ),
        );
        if (c.introspect_error)
          rows.push(
            line(t("credentials.check.note"), introspectNote(c, providerLabel(c.provider))),
          );
        const tools = c.tools ?? [];
        if (tools.length) {
          const on = tools.filter((x) => x.decision.allowed).length;
          rows.push(
            line(
              t("credentials.check.tools"),
              t("credentials.check.tools_available", { on, total: tools.length }),
            ),
          );
        }
        $("add-result").innerHTML = factRows(rows).map(factHTML).join("");
      }

      function renderUseInProject(c: Credential, grants: Grant[]): void {
        const box = $("add-done-use");
        const projects = grantTargets.filter((g) => g.type === "project");
        if (c.provider !== "github" || c.state === "invalid" || !projects.length) {
          box.hidden = true;
          return;
        }
        const granted = new Set(
          grants.filter((g) => g.subject_type === "project").map((g) => g.subject_id),
        );
        const shown = granted.size ? projects.filter((p) => granted.has(p.id)) : projects;
        $("add-done-projects").innerHTML = shown
          .map(
            (p) =>
              `<li><a href="/project/?id=${encodeURIComponent(p.id)}#repo">${esc(p.name ?? p.label)}</a></li>`,
          )
          .join("");
        box.hidden = false;
      }

      async function submitAdd(): Promise<void> {
        if (currentProvider()?.connect) return submitConnect();
        const nameEl = $("add-name") as HTMLInputElement;
        const name = nameEl.value.trim();
        setFieldError(nameEl, name ? "" : t("credentials.errors.name_required"));
        if (!name) {
          nameEl.focus();
          return;
        }
        const provider = ($("add-provider") as HTMLSelectElement).value;
        const kind = ($("add-kind") as HTMLSelectElement).value;
        const payload = readPayload(currentKind(), "f-");
        const grants = readGrantPicker($("add-grants"));

        const btn = $("add-submit") as HTMLButtonElement;
        const errBox = $("add-error");
        errBox.hidden = true;
        setBusy(btn, true, t("credentials.status.checking"));
        try {
          const created = await createCredential({ name, provider, kind, payload, grants });
          mergeCredential(created);
          credentialsLoaded = true;
          renderList();
          renderCheckResult(created);
          addSaved = true;
          $("add-fields").innerHTML = "";
          addForm.hidden = true;
          $("add-done-title").textContent = t("credentials.add.saved_title", {
            name: created.name,
          });
          $("add-done-warn").hidden = grants.length > 0;
          renderUseInProject(created, grants);
          $("add-done").hidden = false;
          $("add-cancel").hidden = true;
          btn.hidden = true;
          $("add-again").hidden = false;
          $("add-finish").hidden = false;
          $("add-finish").focus();
        } catch (e) {
          errBox.textContent = t("credentials.errors.save_failed", { error: errText(e) });
          errBox.hidden = false;
        } finally {
          setBusy(btn, false, t("credentials.buttons.validate_save"));
        }
      }

      let detailID = "";
      let detailSnap = "";
      const detailBody = $("detail-modal").querySelector<HTMLElement>(".modal-body")!;
      const detailDirty = () => snapshot(detailBody) !== detailSnap;
      const detailModal = dialog("detail-modal", detailDirty, () => closeDetailEdit());

      function syncDetailSave(): void {
        ($("detail-save") as HTMLButtonElement).disabled = !detailDirty();
      }
      detailBody.addEventListener("change", syncDetailSave);

      async function openDetail(id: string): Promise<void> {
        try {
          const c = await api.get<Credential>(`/credentials/${id}`);
          mergeCredential(c);
          renderList();
          if (detailID !== id) closeDetailEdit();
          detailID = id;
          renderDetail(c);
          $("detail-save-error").hidden = true;
          if (!detailModal.isOpen()) detailModal.open($("detail-revalidate"));
        } catch (e) {
          toast(t("credentials.errors.open_failed", { error: errText(e) }), "err");
        }
      }

      function renderDetail(c: Credential): void {
        $("detail-modal-title").textContent = c.name;
        $("detail-badges").innerHTML = stateBadge(c) + badgeHTML(providerLabel(c.provider));
        const cell = (label: string, value: string, mono = false): Fact => ({ label, value, mono });
        $("detail-summary").innerHTML = factRows([
          cell(t("credentials.check.identity"), c.identity || "—", Boolean(c.identity)),
          cell(t("credentials.detail.key"), c.hint || "—", Boolean(c.hint)),
          cell(
            t("credentials.check.expires"),
            c.expires_at ? fmtDate(c.expires_at) : t("credentials.detail.no_expiry"),
          ),
          cell(
            t("credentials.detail.last_checked"),
            c.validated_at ? fmtDate(c.validated_at) : t("credentials.detail.never"),
          ),
        ])
          .map(factHTML)
          .join("");

        const errBox = $("detail-error");
        errBox.textContent = introspectNote(c, providerLabel(c.provider));
        errBox.hidden = !c.introspect_error;

        const oauth = isOAuth(c);
        $("detail-rotate").hidden = oauth;
        $("detail-reconnect").hidden = !oauth;
        $("detail-disconnect").hidden = !oauth || c.introspect_error === OAUTH_DISCONNECTED;

        renderToolMatrix(c);
        renderGrantPicker($("detail-grants"), c.grants || []);
        ($("detail-disable") as HTMLButtonElement).textContent = c.disabled
          ? t("credentials.buttons.enable")
          : t("credentials.buttons.disable");
        detailSnap = snapshot(detailBody);
        syncDetailSave();
      }

      function renderToolMatrix(c: Credential): void {
        const host = $("detail-tools");
        const tools = c.tools ?? [];
        const search = $("detail-tools-search") as HTMLInputElement;
        search.value = "";
        const searchBox = search.closest<HTMLElement>(".search");
        if (searchBox) searchBox.hidden = tools.length < 2;
        $("detail-tools-note").hidden = !permissionsUndiscovered(c);
        if (!tools.length) {
          host.innerHTML = emptyRowHTML(
            t("credentials.empty.tools", { provider: providerLabel(c.provider) }),
            { as: "div" },
          );
          return;
        }
        host.innerHTML =
          checkGroupHTML({
            layout: "list",
            labelledBy: "detail-tools-title",
            attrs: { "data-tool-list": true },
            itemsHTML: groupTools(tools)
              .map((g) => {
                const label = TOOL_GROUP_LABEL[g.id];
                return (
                  checkHTML({
                    head: true,
                    label,
                    inputAttrs: {
                      "data-group-toggle": g.id,
                      "aria-label": t("credentials.detail.group_toggle", { group: label }),
                    },
                    attrs: { "data-group-head": g.id, "data-no-dirty": true },
                    trailingHTML: countHTML(g.rows.length, { pill: true }),
                  }) + g.rows.map((x) => toolRowHTML(x, g.id)).join("")
                );
              })
              .join(""),
          }) +
          emptyRowHTML(t("credentials.detail.tools_none_match"), {
            as: "div",
            attrs: { "data-none-match": true, hidden: true },
          });
        syncGroupToggles();
      }

      const TOOL_GROUP_LABEL: Record<ToolGroupID, string> = {
        read: t("credentials.detail.groups.read"),
        write: t("credentials.detail.groups.write"),
        actions: t("credentials.detail.groups.actions"),
      };

      function toolRowHTML(x: ToolRow, group: ToolGroupID): string {
        const capped = x.decision.reason === "missing_capability";
        return checkHTML({
          labelHTML: `<span class="mono">${esc(x.server)}/${esc(x.tool)}</span>`,
          hint: x.summary || undefined,
          checked: x.decision.allowed,
          disabled: capped,
          reason: capped
            ? t("credentials.detail.tool_missing", {
                capabilities: (x.decision.missing || []).join(", "),
              })
            : undefined,
          inputAttrs: { "data-server": x.server, "data-tool": x.tool },
          attrs: { "data-key": `${x.server}/${x.tool}`, "data-group": group },
        });
      }

      function groupBoxes(group: string): HTMLInputElement[] {
        return Array.from(
          $("detail-tools").querySelectorAll<HTMLInputElement>(
            `[data-group="${CSS.escape(group)}"] input[data-tool]:not(:disabled)`,
          ),
        );
      }

      function syncGroupToggles(): void {
        $("detail-tools")
          .querySelectorAll<HTMLInputElement>("input[data-group-toggle]")
          .forEach((toggle) => {
            const rows = groupBoxes(toggle.dataset.groupToggle ?? "");
            const on = rows.filter((r) => r.checked).length;
            toggle.disabled = rows.length === 0;
            toggle.checked = rows.length > 0 && on === rows.length;
            toggle.indeterminate = on > 0 && on < rows.length;
          });
      }

      // Hide rows instead of removing them: readToolMatrix must still send filtered-out tools.
      function filterTools(): void {
        const c = credentials.find((x) => x.id === detailID);
        const host = $("detail-tools");
        const query = ($("detail-tools-search") as HTMLInputElement).value;
        const groups = groupTools(c?.tools ?? [], query);
        const visible = new Set(groups.flatMap((g) => g.rows.map((r) => `${r.server}/${r.tool}`)));
        host.querySelectorAll<HTMLElement>("[data-key]").forEach((row) => {
          row.hidden = !visible.has(row.dataset.key ?? "");
        });
        host.querySelectorAll<HTMLElement>("[data-group-head]").forEach((head) => {
          head.hidden = !groups.some((x) => x.id === head.dataset.groupHead);
        });
        const list = host.querySelector<HTMLElement>("[data-tool-list]");
        if (list) list.hidden = groups.length === 0;
        const none = host.querySelector<HTMLElement>("[data-none-match]");
        if (none) none.hidden = groups.length > 0;
      }

      function readToolMatrix(): { server: string; tool: string; enabled: boolean }[] {
        const out: { server: string; tool: string; enabled: boolean }[] = [];
        $("detail-tools")
          .querySelectorAll<HTMLInputElement>("input[data-tool]")
          .forEach((box) => {
            // Capability-blocked tools have no policy choice; sending them would persist a disable
            // the operator never made.
            if (box.disabled) return;
            out.push({
              server: box.dataset.server!,
              tool: box.dataset.tool!,
              enabled: box.checked,
            });
          });
        return out;
      }

      async function saveDetail(): Promise<void> {
        const btn = $("detail-save") as HTMLButtonElement;
        const errBox = $("detail-save-error");
        errBox.hidden = true;
        setBusy(btn, true, t("common.status.saving"));
        try {
          await api.put(`/credentials/${detailID}/grants`, {
            grants: readGrantPicker($("detail-grants")),
          });
          const updated = await api.put<Credential>(`/credentials/${detailID}/tools`, {
            tools: readToolMatrix(),
          });
          mergeCredential(updated);
          renderDetail(updated);
          renderList();
          toast(t("credentials.toasts.saved"), "ok");
        } catch (e) {
          errBox.textContent = t("credentials.errors.save_failed", { error: errText(e) });
          errBox.hidden = false;
        } finally {
          btn.textContent = t("credentials.buttons.save_changes");
          syncDetailSave();
        }
      }

      let editMode: "rename" | "rotate" = "rename";

      function detailKind(c: Credential): KindSpec | undefined {
        return providers.find((p) => p.id === c.provider)?.kinds.find((k) => k.id === c.kind);
      }

      function openDetailEdit(mode: "rename" | "rotate"): void {
        const c = credentials.find((x) => x.id === detailID);
        if (!c) return;
        editMode = mode;
        const form = $("detail-edit") as HTMLFormElement;
        $("detail-name-field").hidden = mode !== "rename";
        $("detail-rotate-hint").hidden = mode !== "rotate";
        const fields = $("detail-rotate-fields");
        if (mode === "rotate") {
          const kind = detailKind(c);
          fields.innerHTML = fieldInputs(kind, "r-");
        } else {
          fields.innerHTML = "";
          ($("detail-new-name") as HTMLInputElement).value = c.name;
        }
        $("detail-edit-error").hidden = true;
        form.hidden = false;
        const first = form.querySelector<HTMLElement>(
          mode === "rename"
            ? "#detail-new-name"
            : "#detail-rotate-fields input, #detail-rotate-fields textarea",
        );
        first?.focus();
      }

      function closeDetailEdit(): void {
        // Don't leave the rotated key in a hidden form.
        $("detail-rotate-fields").innerHTML = "";
        $("detail-edit").hidden = true;
      }

      async function saveDetailEdit(): Promise<void> {
        const c = credentials.find((x) => x.id === detailID);
        if (!c) return;
        const errBox = $("detail-edit-error");
        const fail = (msg: string) => {
          errBox.textContent = msg;
          errBox.hidden = false;
        };
        let body: { name?: string; payload?: Record<string, string> };
        if (editMode === "rename") {
          const name = ($("detail-new-name") as HTMLInputElement).value.trim();
          if (!name) return fail(t("credentials.errors.name_required"));
          if (name === c.name) return closeDetailEdit();
          body = { name };
        } else {
          const payload = readPayload(detailKind(c), "r-");
          if (!Object.values(payload).some((v) => v))
            return fail(t("credentials.errors.rotate_empty"));
          body = { payload };
        }
        const btn = $("detail-edit-save") as HTMLButtonElement;
        setBusy(
          btn,
          true,
          editMode === "rotate" ? t("credentials.status.checking") : t("common.status.saving"),
        );
        try {
          const updated = await api.patch<Credential>(`/credentials/${detailID}`, body);
          mergeCredential(updated);
          renderList();
          closeDetailEdit();
          if (detailDirty()) {
            $("detail-modal-title").textContent = updated.name;
            $("detail-badges").innerHTML =
              stateBadge(updated) + badgeHTML(providerLabel(updated.provider));
          } else {
            renderDetail(updated);
          }
          if (editMode === "rotate") {
            toast(checkSummary(updated, providerLabel(updated.provider)), checkTone(updated), 6000);
          } else {
            toast(t("credentials.toasts.renamed", { name: updated.name }), "ok");
          }
        } catch (e) {
          const error = errText(e);
          fail(
            editMode === "rotate"
              ? t("credentials.errors.rotate_failed", { error })
              : t("credentials.errors.rename_failed", { error }),
          );
        } finally {
          setBusy(btn, false, t("common.buttons.save"));
        }
      }

      async function toggleDisabled(): Promise<void> {
        const c = credentials.find((x) => x.id === detailID);
        if (!c) return;
        const btn = $("detail-disable") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const updated = await api.put<Credential>(`/credentials/${detailID}/disabled`, {
            disabled: !c.disabled,
          });
          mergeCredential(updated);
          $("detail-badges").innerHTML =
            stateBadge(updated) + badgeHTML(providerLabel(updated.provider));
          btn.textContent = updated.disabled
            ? t("credentials.buttons.enable")
            : t("credentials.buttons.disable");
          renderList();
          toast(
            updated.disabled
              ? t("credentials.toasts.disabled", { name: updated.name })
              : t("credentials.toasts.enabled", { name: updated.name }),
            "ok",
          );
        } catch (e) {
          toast(t("credentials.errors.toggle_failed", { error: errText(e) }), "err");
        } finally {
          btn.disabled = false;
        }
      }

      async function recheckDetail(): Promise<void> {
        const btn = $("detail-revalidate") as HTMLButtonElement;
        btn.disabled = true;
        const updated = await revalidate(detailID);
        btn.disabled = false;
        if (updated && !detailDirty()) void openDetail(detailID);
      }

      async function reconnectDetail(): Promise<void> {
        const btn = $("detail-reconnect") as HTMLButtonElement;
        btn.disabled = true;
        try {
          await startOAuth({ credential_id: detailID, return: "credentials" });
        } catch (e) {
          toast(t("credentials.oauth.start_failed", { error: errText(e) }), "err", 6000);
          btn.disabled = false;
        }
      }

      async function disconnectDetail(): Promise<void> {
        const c = credentials.find((x) => x.id === detailID);
        if (!c) return;
        const ok = await confirmDialog({
          title: t("credentials.oauth.disconnect_title", { name: c.name }),
          message: t("credentials.oauth.disconnect_message"),
          confirmLabel: t("credentials.oauth.disconnect"),
          danger: true,
        });
        if (!ok) return;
        const btn = $("detail-disconnect") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const updated = await api.post<Credential>(
            `/credentials/${detailID}/oauth/disconnect`,
            {},
          );
          mergeCredential(updated);
          renderList();
          renderDetail(updated);
          toast(t("credentials.oauth.disconnected", { name: c.name }), "ok");
        } catch (e) {
          toast(t("credentials.oauth.disconnect_failed", { error: errText(e) }), "err", 6000);
        } finally {
          btn.disabled = false;
        }
      }

      function takeOAuthParams(): { open?: string; connect?: string } {
        const q = new URLSearchParams(window.location.search);
        const outcome = oauthOutcome(q);
        if (outcome) toast(outcome.message, outcome.ok ? "ok" : "err", 10000);
        const connect = q.get("connect") ?? "";
        if (q.get("from") === "mcps") oauthReturn = "mcps";
        for (const k of ["mcp_oauth", "credential", "reason", "detail", "connect", "from"])
          q.delete(k);
        const rest = q.toString();
        const url = `${window.location.pathname}${rest ? `?${rest}` : ""}${window.location.hash}`;
        history.replaceState(history.state, "", url);
        return { open: outcome?.credential || undefined, connect: connect || undefined };
      }

      async function deleteDetail(): Promise<void> {
        const c = credentials.find((x) => x.id === detailID);
        if (!c) return;
        const ok = await confirmDialog({
          title: t("credentials.confirm.delete_title", { name: c.name }),
          message: t("credentials.confirm.delete_message", { provider: providerLabel(c.provider) }),
          confirmLabel: t("credentials.buttons.delete_credential"),
          danger: true,
        });
        if (!ok) return;
        const btn = $("detail-delete") as HTMLButtonElement;
        btn.disabled = true;
        try {
          await api.del(`/credentials/${detailID}`);
          credentials = credentials.filter((x) => x.id !== detailID);
          renderList();
          detailModal.close();
          toast(t("credentials.toasts.deleted", { name: c.name }), "ok");
        } catch (e) {
          toast(t("credentials.errors.delete_failed", { error: errText(e) }), "err", 6000);
        } finally {
          btn.disabled = false;
        }
      }

      $("btn-add").addEventListener("click", openAdd);
      $("btn-add-empty").addEventListener("click", openAdd);
      $("btn-refresh").addEventListener("click", () => void refresh());
      $("btn-retry").addEventListener("click", () => void refresh());

      addForm.addEventListener("submit", (e) => {
        e.preventDefault();
        void submitAdd();
      });
      $("add-provider").addEventListener("change", renderKinds);
      $("add-kind").addEventListener("change", renderFields);
      $("add-name").addEventListener("blur", () => {
        const el = $("add-name") as HTMLInputElement;
        if (el.value.trim()) setFieldError(el, "");
      });
      $("add-cancel").addEventListener("click", () => void addModal.requestClose());
      $("add-finish").addEventListener("click", () => addModal.close());
      $("add-again").addEventListener("click", () => {
        showAddForm();
        ($("add-name") as HTMLInputElement).focus();
      });
      $("denies-only").addEventListener("change", renderDecisions);

      $("detail-save").addEventListener("click", () => void saveDetail());
      $("detail-close").addEventListener("click", () => void detailModal.requestClose());
      $("detail-disable").addEventListener("click", () => void toggleDisabled());
      $("detail-delete").addEventListener("click", () => void deleteDetail());
      $("detail-revalidate").addEventListener("click", () => void recheckDetail());
      $("detail-rename").addEventListener("click", () => openDetailEdit("rename"));
      $("detail-rotate").addEventListener("click", () => openDetailEdit("rotate"));
      $("detail-reconnect").addEventListener("click", () => void reconnectDetail());
      $("detail-disconnect").addEventListener("click", () => void disconnectDetail());
      $("detail-edit-cancel").addEventListener("click", closeDetailEdit);
      $("detail-edit").addEventListener("submit", (e) => {
        e.preventDefault();
        void saveDetailEdit();
      });
      $("detail-tools-search").addEventListener("input", filterTools);
      $("detail-tools").addEventListener("change", (e) => {
        const toggle = (e.target as HTMLElement).closest<HTMLInputElement>(
          "input[data-group-toggle]",
        );
        if (toggle) {
          groupBoxes(toggle.dataset.groupToggle ?? "").forEach((box) => {
            box.checked = toggle.checked;
          });
        }
        syncGroupToggles();
      });

      ghappForm.addEventListener("submit", (e) => {
        e.preventDefault();
        void saveGithubApp();
      });
      $("ghapp-id").addEventListener("blur", () => {
        const el = $("ghapp-id") as HTMLInputElement;
        const v = el.value.trim();
        if (!v) return;
        setFieldError(el, /^\d+$/.test(v) ? "" : t("credentials.errors.ghapp_app_id"));
      });
      $("ghapp-cancel").addEventListener("click", () => void ghappModal.requestClose());
      $("ghapp-connect").addEventListener("click", openGithubApp);
      $("ghapp-create").addEventListener("click", openCreateGithubApp);
      $("ghapp-create-cancel").addEventListener("click", () => ghappCreateModal.close());
      ghappCreateForm.addEventListener("submit", (e) => {
        e.preventDefault();
        void createGithubApp();
      });
      $("ghapp-install").addEventListener("click", () => void installGithubApp());
      $("ghapp-forget").addEventListener("click", () => void forgetGithubApp());

      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Escape" || isConfirmOpen()) return;
          for (const m of [ghappCreateModal, ghappModal, addModal, detailModal]) {
            if (m.isOpen()) {
              e.preventDefault();
              void m.requestClose();
              return;
            }
          }
        },
        { signal },
      );

      $("cred-cross-text").innerHTML = t("credentials.cross_html");
      announceManifestOutcome();
      const oauthParams = takeOAuthParams();
      (async () => {
        await Promise.all([loadProviders(), loadGrantTargets()]);
        await refresh();
        if (oauthParams.open) void openDetail(oauthParams.open);
        if (oauthParams.connect && providers.some((p) => p.id === OAUTH_PROVIDER)) {
          connectServer = oauthParams.connect;
          openAdd();
          ($("add-provider") as HTMLSelectElement).value = OAUTH_PROVIDER;
          renderKinds();
          addSnap = snapshot(addForm);
          $("add-oauth-server").focus();
        }
      })();
    });
  </script>
</Layout>
