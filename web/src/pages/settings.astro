      async function downloadUpdatePackage(btn: HTMLButtonElement) {
        const to = btn.dataset.to ?? "";
        const format = btn.dataset.format === "json" ? "json" : "md";
        btn.disabled = true;
        try {
          const text = await api.getText(
            `/updates/package?to=${encodeURIComponent(to)}&format=${format}`,
          );
          const type = format === "json" ? "application/json" : "text/markdown";
          downloadBlob(new Blob([text], { type }), packageFilename(updCurrent, to, format));
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("settings.updates.download_failed"),
            "err",
          );
        } finally {
          btn.disabled = false;
        }
      }

