      async function loadUpdates() {
        const badge = $("upd-badge") as HTMLElement;
        try {
          renderUpdateStatus(await api.get<UpdateStatus>("/updates/status"));
        } catch (err) {
          setBadge(badge, t("settings.updates.status.unavailable"), "muted");
          ($("upd-check") as HTMLButtonElement).disabled = true;
          const msg = isOperatorRefusal(err)
            ? t("settings.updates.operator_only", { env: OPERATOR_ENV })
            : err instanceof ApiError
              ? err.message
              : t("common.status.daemon_offline");
          $("upd-summary").innerHTML = calloutHTML({
            tone: "warn",
            icon: "lock",
            body: msg,
            attrs: { role: "note" },
          });
          $("upd-releases").innerHTML = "";
          $("upd-advisories").hidden = true;
          return;
        }
        void loadUpdateVersions();
        void loadUpdateHistory();
        void loadBackups();
