      async function loadRetention() {
        const panel = $("retention-panel");
        if (!(await mayWriteInstallWide())) {
          panel.hidden = true;
          return;
        }
        try {
          const v = await api.get<RetentionView>("/infra/retention");
          panel.hidden = false;
          setText($("ret-sweep"), sweepLine(v));
          const disk = $("ret-disk");
          if (diskLow(v)) {
            disk.className = "";
            disk.innerHTML = calloutHTML({ tone: "danger", icon: "alert", body: diskLine(v) });
          } else {
            disk.className = "muted";
            setText(disk, diskLine(v));
          }
          $("ret-rows").innerHTML = retentionRowsHTML(v);
          $("ret-error").hidden = true;
        } catch {
          panel.hidden = true;
        }
      }

      function showRetentionProblems(problems: Record<string, string>) {
        for (const input of document.querySelectorAll<HTMLInputElement>("#ret-rows .ret-input")) {
          const msg = problems[input.dataset.key ?? ""];
          const line = document.getElementById(`${input.id}-error`);
          if (msg) input.setAttribute("aria-invalid", "true");
          else input.removeAttribute("aria-invalid");
          if (line) {
            line.hidden = !msg;
            setText(line, msg ?? "");
          }
        }
        const first = Object.keys(problems)[0];
        if (first)
          document
            .querySelector<HTMLInputElement>(
              `#ret-rows .ret-input[data-key="${CSS.escape(first)}"]`,
            )
            ?.focus();
      }

      $("ret-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const err = $("ret-error");
        const btn = $("ret-save") as HTMLButtonElement;
        const inputs = Array.from(
          document.querySelectorAll<HTMLInputElement>("#ret-rows .ret-input"),
        );
        const check = checkRetention(
          inputs.map((input) => ({
            key: input.dataset.key ?? "",
            raw: input.value,
            default: Number(input.dataset.default),
            value: Number(input.dataset.value),
          })),
        );
        err.hidden = true;
        if (!check.ok) {
          showRetentionProblems(
            Object.fromEntries(
              Object.entries(check.problems).map(([k, p]) => [k, retentionProblemText(p)]),
            ),
          );
          return;
        }
        showRetentionProblems({});
        const count = Object.keys(check.changes).length;
        if (count === 0) return;
        btn.disabled = true;
        try {
          // One PATCH: the daemon applies all changes or none, so don't split per row.
          await api.patch("/settings", check.changes);
          toast(t("settings.health.retention.saved", { count }), "ok");
          await loadRetention();
        } catch (e2) {
          const key =
            e2 instanceof ApiError
              ? refusedRetentionKey(
                  e2.body,
                  inputs.map((i) => i.dataset.key ?? ""),
                )
              : null;
          if (key && e2 instanceof ApiError) {
            showRetentionProblems({ [key]: e2.message });
          } else {
            err.hidden = false;
            setText(
              err,
              e2 instanceof ApiError ? e2.message : t("settings.health.retention.save_failed"),
            );
          }
        } finally {
          btn.disabled = false;
        }
      });

