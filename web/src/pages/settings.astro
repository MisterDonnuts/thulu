---
import Layout from "../layouts/Layout.astro";
import AccountLifecycle from "../components/AccountLifecycle.astro";
import Badge from "../components/Badge.astro";
import BoardsSection from "../components/board/BoardsSection.astro";
import Button from "../components/Button.astro";
import Callout from "../components/Callout.astro";
import Check from "../components/Check.astro";
import CheckGroup from "../components/CheckGroup.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Count from "../components/Count.astro";
import EmptyRow from "../components/EmptyRow.astro";
import EngineLogins from "../components/EngineLogins.astro";
import Field from "../components/Field.astro";
import FormError from "../components/FormError.astro";
import Icon from "../components/Icon.astro";
import Modal from "../components/Modal.astro";
import PageHead from "../components/PageHead.astro";
import GroupHead from "../components/GroupHead.astro";
import Panel from "../components/Panel.astro";
import Table from "../components/Table.astro";
import { locale, locales, t } from "../i18n";
import { AUDIT_TABLE, auditColumns } from "../lib/audit-view";
import { UPDATES_TABLE, historyColumns, versionsColumns } from "../lib/updates";

const AUDIT_KINDS = ["task", "agent", "project", "approval", "question", "flag", "webhook", "auth"];

const LANGUAGES = locales.map((code) => ({
  code,
  name: new Intl.DisplayNames([code], { type: "language" }).of(code) ?? code,
}));
---

<Layout title={t("settings.title")}>
  <main class="page" style="--page-max: 960px">
    {
      /* The title and the subtitle are rewritten per section — see
         lib/settings-sections.ts. What is here is what a settings page with
         no hash shows. */
    }
    <PageHead title={t("settings.title")} titleId="settings-title">
      <span slot="sub" id="settings-sub">{t("settings.subtitle")}</span>
    </PageHead>

    <div id="panel-denied" class="settings-section" hidden>
      <Callout tone="warn" icon="lock" role="note"><span id="denied-note"></span></Callout>
    </div>

    <div id="panel-webhooks" class="settings-section panel-stack" hidden>
      <Panel icon="plus" title={t("settings.webhooks.add.title")}>
        <form id="webhook-form" class="form-stack" novalidate>
          <Field label={t("settings.webhooks.labels.endpoint_url")} for="wh-url">
            <input
              type="url"
              id="wh-url"
              placeholder={t("settings.webhooks.placeholders.endpoint_url")}
              autocomplete="off"
            />
          </Field>
          <fieldset class="wh-events-pick">
            <legend class="field-label">{t("settings.webhooks.labels.events")}</legend>
            <Check
              id="wh-all-events"
              value="*"
              checked
              label={t("settings.webhooks.labels.all_events")}
              hint={t("settings.webhooks.labels.all_events_help")}
            />
            {
              /* Filled from GET /webhooks/events: the daemon's own
                 catalog, the one it validates a subscription against. */
            }
            <CheckGroup
              id="events-specific"
              layout="grid"
              wide
              label={t("settings.webhooks.labels.events")}
            />
          </fieldset>
          <FormError id="wh-error" />
          <div class="form-actions">
            <Button id="wh-submit" type="submit" variant="primary" icon="plus"
              >{t("settings.webhooks.add.submit")}</Button
            >
          </div>
        </form>
      </Panel>

      <Panel icon="link" title={t("settings.webhooks.endpoints.title")} flush>
        <Count n={0} pill id="wh-count" slot="status" />
        <Callout id="wh-legacy-note" tone="warn" icon="warn" band role="note" hidden
          ><span id="wh-legacy-note-text"></span></Callout
        >
        <div id="wh-secret-display" class="key-reveal wh-callout" hidden>
          <p class="muted small key-warning" id="wh-secret-label"></p>
          <CodeBlock
            textId="wh-secret-value"
            wrap
            copy
            label={t("settings.webhooks.endpoints.secret_name")}
          />
        </div>
        <div id="webhooks-list" class="row-list">
          <EmptyRow as="div" loading />
        </div>
      </Panel>
    </div>

    <div id="panel-boards" class="settings-section">
      <BoardsSection />
    </div>

    <div id="panel-audit" class="settings-section" hidden>
      <Panel icon="list" title={t("settings.audit.title")} flush>
        <Fragment slot="actions">
          <select id="audit-kind" class="select-sm" aria-label={t("settings.audit.kind_aria")}>
            <option value="">{t("settings.audit.all_events")}</option>
            {AUDIT_KINDS.map((kind) => <option value={kind}>{`${kind}.*`}</option>)}
          </select>
          <Button
            id="audit-export-csv"
            size="sm"
            icon="file"
            title={t("settings.audit.export.csv_title")}>{t("settings.audit.export.csv")}</Button
          >
          <Button
            id="audit-export-json"
            size="sm"
            icon="file"
            title={t("settings.audit.export.json_title")}>{t("settings.audit.export.json")}</Button
          >
          <Button
            id="audit-refresh"
            size="sm"
            iconOnly
            icon="refresh"
            label={t("common.buttons.refresh")}
          />
        </Fragment>
        <Callout id="audit-chain" icon="lock" band hidden>
          <span id="audit-chain-line">{t("settings.audit.chain.not_verified")}</span>
          <Fragment slot="actions">
            <Button id="audit-verify" size="sm" title={t("settings.audit.chain.verify_title")}
              >{t("settings.audit.chain.verify")}</Button
            >
            <Button id="audit-chain-goto" size="sm" hidden>{t("settings.audit.chain.goto")}</Button>
          </Fragment>
        </Callout>
        <Callout id="audit-export-ce" band role="note" hidden
          ><span id="audit-export-ce-text"></span></Callout
        >
        <div id="audit-table-wrap">
          {
            /* Cells at the top: the Summary column wraps to two or three
               lines while Time and Actor are one. On a phone each entry
               stacks into a card. */
          }
          <Table cols={auditColumns()} {...AUDIT_TABLE} bodyId="audit-tbody" />
          <EmptyRow as="div" id="audit-empty" hidden>{t("settings.audit.empty")}</EmptyRow>
          <div class="load-more-row">
            <Button id="audit-load-more" hidden>{t("settings.audit.load_more")}</Button>
          </div>
        </div>
      </Panel>
    </div>

    <div id="panel-api" class="settings-section" hidden>
      <div class="settings-grid">
        <Panel icon="file" title={t("settings.api.openapi.title")}>
          <p class="panel-lede">{t("settings.api.openapi.intro")}</p>
          <div class="control-row">
            <Button
              id="openapi-link"
              href="/openapi.json"
              target="_blank"
              rel="noopener"
              icon="file"
            >
              <!-- i18n-ignore the spec's file name, the same in every language -->
              openapi.json
              <Icon name="arrow-up-right" />
            </Button>
            <Button id="copy-openapi" icon="copy">{t("settings.api.openapi.copy_url")}</Button>
          </div>
        </Panel>

        <Panel id="ingest-panel" icon="zap" title={t("settings.api.ingest.title")}>
          <p class="panel-lede">{t("settings.api.ingest.intro")}</p>
          <Field label={t("settings.api.ingest.label")} for="ingest-url">
            <div class="control-row">
              <input
                id="ingest-url"
                type="url"
                placeholder={t("settings.api.ingest.placeholder")}
                aria-describedby="ingest-url-hint"
                style="flex:1; min-width:240px"
              />
              <Button id="ingest-url-save">{t("common.buttons.save")}</Button>
            </div>
            <p id="ingest-url-hint" class="field-help"></p>
          </Field>
        </Panel>

        <Panel icon="settings" title={t("settings.api.keys.title")} class="grid-span">
          <p class="panel-lede">{t("settings.api.keys.intro")}</p>
          <div class="form-row key-form">
            <Field label={t("settings.api.keys.name_label")} for="api-key-name" class="grow">
              <input
                id="api-key-name"
                type="text"
                placeholder={t("settings.api.keys.name_placeholder")}
              />
            </Field>
            <Field label={t("settings.labels.role")} for="api-key-role">
              <select id="api-key-role" title={t("settings.api.keys.role_title")}>
                <option value="viewer">{t("settings.roles.viewer")}</option>
                <option value="developer" selected>{t("settings.roles.developer")}</option>
                <option value="admin">{t("settings.roles.admin")}</option>
                <option value="owner">{t("settings.roles.owner")}</option>
              </select>
            </Field>
            <Field
              label={t("settings.api.keys.expires_aria")}
              for="api-key-expires"
              style="width:140px"
            >
              <input
                id="api-key-expires"
                type="number"
                min="1"
                step="1"
                placeholder={t("settings.api.keys.expires_placeholder")}
                aria-describedby="api-key-expiry-hint"
              />
            </Field>
            <Button id="gen-api-key" variant="primary" icon="plus"
              >{t("settings.api.keys.generate")}</Button
            >
          </div>
          <p id="api-key-expiry-hint" class="field-help control-help"></p>
          <div class="perm-picker">
            <div class="preset-row">
              <span class="muted preset-label">{t("settings.api.presets.label")}</span>
              <Button size="sm" class="preset-btn" data-preset="read-only"
                >{t("settings.api.presets.read_only")}</Button
              >
              <Button size="sm" class="preset-btn" data-preset="ci"
                >{t("settings.api.presets.ci")}</Button
              >
              <Button size="sm" class="preset-btn" data-preset="agent"
                >{t("settings.api.presets.agent")}</Button
              >
              <Button size="sm" class="preset-btn" data-preset="full"
                >{t("settings.api.presets.full")}</Button
              >
            </div>
            <CheckGroup
              id="api-key-perms"
              layout="grid"
              label={t("settings.api.presets.perms_aria")}
            />
          </div>
          <FormError id="api-key-error" class="key-error" />
          <div id="new-key-display" class="key-reveal" hidden>
            <p class="muted small key-warning">{t("settings.api.keys.copy_warning")}</p>
            <CodeBlock
              textId="new-key-value"
              wrap
              copy
              label={t("settings.api.keys.new_key_name")}
            />
            <p id="new-key-expiry" class="field-help control-help"></p>
          </div>
          <div id="api-keys-list" class="row-list"></div>
        </Panel>

        <Panel icon="clock" title={t("settings.api.run_keys.title")} class="grid-span">
          <p class="panel-lede">{t("settings.api.run_keys.intro")}</p>
          <div id="run-keys-list" class="row-list"></div>
        </Panel>
      </div>
    </div>

    <div id="panel-llm" class="settings-section" hidden>
      <p id="llm-intro" class="muted llm-intro"></p>
      <Callout id="llm-cross" icon="info" class="llm-cross"
        ><span id="llm-cross-text"></span></Callout
      >
      <div id="llm-engines" class="panel-stack">
        <EmptyRow as="div" loading />
      </div>
      <EngineLogins />

      {
        /* Run time limit: how long one agent run in this workspace may take
           (GET/PUT /workspace-settings). An admin chooses it up to the
           ceiling the operator sets; everyone else reads it. */
      }
      <Panel id="runlimit-panel" icon="clock" title={t("settings.run_limit.title")} hidden>
        <p class="panel-lede">{t("settings.run_limit.intro")}</p>
        <form id="runlimit-form" class="form-stack" novalidate>
          <Callout id="runlimit-readonly" icon="lock" hidden
            >{t("settings.run_limit.read_only")}</Callout
          >
          <Field
            label={t("settings.run_limit.label")}
            for="runlimit-minutes"
            hint={t("settings.run_limit.unit")}
            errorId="runlimit-minutes-error"
          >
            <input
              id="runlimit-minutes"
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              aria-describedby="runlimit-minutes-help"
            />
            <span slot="help" id="runlimit-help"></span>
          </Field>
          <p id="runlimit-now" class="muted"></p>
          <FormError id="runlimit-error" />
          <div class="form-actions">
            <Button id="runlimit-clear" size="sm">{t("settings.run_limit.use_default")}</Button>
            <Button id="runlimit-save" type="submit" variant="primary" size="sm" disabled
              >{t("common.buttons.save")}</Button
            >
          </div>
        </form>
      </Panel>

      {
        /*
          The banded skin. Modal.astro owns the head, body and foot bands, so the
          form lives inside the body and the footer's submit
          button reaches it through `form="profile-form"` — same submit, same
          Enter key, one less nesting level.

          The overlay keeps its `.overlay`/`.open` structure on purpose:
          dirty.hasOpenModal() looks for `.overlay.open` to stop the poller
          from refreshing under a half-filled form.
        */
      }
      <Modal
        id="prof-modal"
        title={t("settings.llm.modal.new_title")}
        icon="zap"
        size="md"
        cancel
        primary={{
          label: t("settings.llm.modal.create"),
          id: "prof-save-btn",
          type: "submit",
          form: "profile-form",
        }}
      >
        <p class="modal-lede" id="prof-engine-line"></p>
        <form id="profile-form" class="form-stack" novalidate>
          <Field label={t("settings.llm.labels.name")} for="prof-name">
            <input
              id="prof-name"
              type="text"
              placeholder={t("settings.llm.placeholders.name")}
              autocomplete="off"
              required
            />
          </Field>
          <Field
            label={t("settings.llm.labels.provider")}
            for="prof-provider"
            id="prof-provider-field"
          >
            <select id="prof-provider"></select>
          </Field>
          <div class="form-row">
            <Field label={t("settings.llm.labels.model")} for="prof-model" optional class="grow">
              <input id="prof-model" type="text" list="prof-models" autocomplete="off" />
              <datalist id="prof-models"></datalist>
            </Field>
            <Field
              label={t("settings.llm.labels.effort")}
              for="prof-effort"
              id="prof-effort-field"
              style="min-width:140px"
            >
              <select id="prof-effort">
                <option value="">{t("settings.llm.effort.cli_default")}</option>
                <option value="low">{t("settings.llm.effort.low")}</option>
                <option value="medium">{t("settings.llm.effort.medium")}</option>
                <option value="high">{t("settings.llm.effort.high")}</option>
              </select>
            </Field>
          </div>
          <Field
            label={t("settings.llm.labels.base_url")}
            for="prof-base-url"
            optional
            id="prof-base-url-field"
          >
            <input
              id="prof-base-url"
              type="url"
              placeholder={t("settings.llm.placeholders.base_url")}
              autocomplete="off"
            />
          </Field>
          <Field
            label={t("settings.llm.labels.auth_header")}
            for="prof-auth-header"
            id="prof-auth-header-field"
          >
            <select id="prof-auth-header">
              <option value="">{t("settings.llm.auth_header.x_api_key")}</option>
              <option value="bearer">{t("settings.llm.auth_header.bearer")}</option>
            </select>
          </Field>
          <div id="prof-cloud-fields" class="form-stack">
            <div class="form-row">
              <Field label={t("settings.llm.labels.region")} for="prof-region" class="grow">
                <input
                  id="prof-region"
                  type="text"
                  placeholder={t("settings.llm.placeholders.region")}
                  autocomplete="off"
                />
              </Field>
              <Field
                label={t("settings.llm.labels.project_id")}
                for="prof-project"
                id="prof-project-field"
                class="grow"
              >
                <input id="prof-project" type="text" autocomplete="off" />
              </Field>
            </div>
            <Field label={t("settings.llm.labels.small_model")} for="prof-small-model" optional>
              <input
                id="prof-small-model"
                type="text"
                placeholder={t("settings.llm.placeholders.small_model")}
                autocomplete="off"
              />
            </Field>
            <div id="prof-aws-fields" class="form-stack">
              <div class="form-row">
                <Field
                  label={t("settings.llm.labels.aws_key_id")}
                  for="prof-aws-key-id"
                  optional
                  class="grow"
                >
                  <input id="prof-aws-key-id" type="text" autocomplete="off" />
                </Field>
                <Field
                  label={t("settings.llm.labels.aws_secret")}
                  for="prof-aws-secret"
                  class="grow"
                >
                  <input id="prof-aws-secret" type="password" autocomplete="off" />
                </Field>
              </div>
              <Field label={t("settings.llm.labels.aws_session")} for="prof-aws-session" optional>
                <input id="prof-aws-session" type="password" autocomplete="off" />
              </Field>
            </div>
            <Field
              label={t("settings.llm.labels.gcp_sa")}
              for="prof-gcp-sa"
              optional
              id="prof-gcp-field"
            >
              <textarea id="prof-gcp-sa" class="mono" rows="4" autocomplete="off" spellcheck="false"
              ></textarea>
            </Field>
            <p class="field-help" id="prof-cloud-hint"></p>
            <div id="prof-clear-key-field">
              <Check id="prof-clear-key" label={t("settings.llm.labels.clear_key")} />
            </div>
          </div>
          <Field
            label={t("settings.llm.labels.org_id")}
            for="prof-org-id"
            optional
            id="prof-org-id-field"
          >
            <input
              id="prof-org-id"
              type="text"
              placeholder={t("settings.llm.placeholders.org_id")}
              autocomplete="off"
            />
          </Field>
          <div class="form-row">
            <Field
              label={t("settings.llm.labels.credential")}
              for="prof-kind"
              id="prof-kind-field"
              style="min-width:180px"
            >
              <select id="prof-kind"></select>
            </Field>
            <Field
              label={t("settings.llm.labels.key")}
              for="prof-key"
              id="prof-key-field"
              class="grow"
            >
              <input id="prof-key" type="password" autocomplete="off" />
            </Field>
          </div>
          <div id="prof-fed-fields" class="form-stack" hidden>
            <p class="field-help">{t("settings.llm.hints.federation")}</p>
            <div class="form-row">
              <Field label={t("settings.llm.labels.fed_rule")} for="prof-fed-rule" class="grow">
                <input
                  id="prof-fed-rule"
                  type="text"
                  class="mono"
                  placeholder={t("settings.llm.placeholders.fed_rule")}
                  autocomplete="off"
                />
              </Field>
              <Field
                label={t("settings.llm.labels.fed_service_account")}
                for="prof-fed-svac"
                class="grow"
              >
                <input
                  id="prof-fed-svac"
                  type="text"
                  class="mono"
                  placeholder={t("settings.llm.placeholders.fed_service_account")}
                  autocomplete="off"
                />
              </Field>
            </div>
            <div class="form-row">
              <Field label={t("settings.llm.labels.fed_org")} for="prof-fed-org" class="grow">
                <input
                  id="prof-fed-org"
                  type="text"
                  class="mono"
                  placeholder={t("settings.llm.placeholders.fed_org")}
                  autocomplete="off"
                />
              </Field>
              <Field
                label={t("settings.llm.labels.fed_workspace")}
                for="prof-fed-ws"
                optional
                class="grow"
              >
                <input
                  id="prof-fed-ws"
                  type="text"
                  class="mono"
                  placeholder={t("settings.llm.placeholders.fed_workspace")}
                  autocomplete="off"
                />
              </Field>
            </div>
            <Callout id="prof-fed-unconfigured" tone="warn" icon="warn" band role="note" hidden
              ><span id="prof-fed-unconfigured-text"></span></Callout
            >
            <div id="prof-fed-issuer" class="form-stack" hidden>
              <p class="field-help">{t("settings.llm.hints.federation_console")}</p>
              <CodeBlock
                textId="prof-fed-issuer-url"
                copy
                label={t("settings.llm.labels.fed_issuer")}
              />
              <CodeBlock
                textId="prof-fed-subject"
                copy
                label={t("settings.llm.labels.fed_subject")}
              />
              <p class="field-help">{t("settings.llm.hints.federation_jwks")}</p>
              <CodeBlock
                textId="prof-fed-jwks"
                multiline
                maxHeight="sm"
                copy
                label={t("settings.llm.labels.fed_jwks")}
              />
            </div>
          </div>
          <Check id="prof-default" label={t("settings.llm.labels.default_for_engine")} />
          <FormError id="prof-error" />
        </form>
      </Modal>
    </div>

    <div id="panel-health" class="settings-section panel-stack" hidden>
      <Panel icon="server" title={t("settings.health.title")} pad="md">
        <Badge id="health-badge" slot="status">{t("settings.health.checking")}</Badge>
        <Button
          slot="actions"
          id="health-refresh"
          size="sm"
          iconOnly
          icon="refresh"
          label={t("settings.health.refresh_aria")}
          title={t("common.buttons.refresh")}
        />
        <div id="health-grid">
          <EmptyRow as="div" loading />
        </div>
      </Panel>

      <Panel icon="settings" title={t("settings.health.license.title")} bodyClass="license-body">
        <Badge id="license-badge" slot="status">{t("settings.health.checking")}</Badge>
        <EmptyRow as="div" loading />
      </Panel>

      <Panel id="retention-panel" icon="trash" title={t("settings.health.retention.title")} hidden>
        <p class="panel-lede">{t("settings.health.retention.intro")}</p>
        <p id="ret-sweep" class="muted"></p>
        <div id="ret-disk" class="muted"></div>
        <form id="ret-form" novalidate>
          <div id="ret-rows" class="ret-rows"></div>
          <FormError id="ret-error" />
          <div class="form-actions">
            <Button id="ret-save" type="submit" variant="primary" size="sm"
              >{t("common.buttons.save")}</Button
            >
          </div>
        </form>
      </Panel>
    </div>

    {
      /* Read-only on purpose: the daemon never changes its own version. Every
         row ends in a command the operator runs on the install's host. */
    }
    <div id="panel-updates" class="settings-section panel-stack" hidden>
      <Panel icon="refresh" title={t("settings.updates.version.title")}>
        <Badge id="upd-badge" slot="status">{t("settings.updates.status.checking")}</Badge>
        <Button id="upd-check" slot="actions" size="sm" icon="refresh"
          >{t("settings.updates.version.check_now")}</Button
        >
        <div id="upd-summary">
          <EmptyRow as="div" loading />
        </div>
        <div id="upd-advisories" class="upd-advisories" hidden></div>
      </Panel>

      <Panel icon="arrow-up-right" title={t("settings.updates.available.title")}>
        <p class="panel-lede">{t("settings.updates.available.intro")}</p>
        <div id="upd-releases">
          <EmptyRow as="div" loading />
        </div>
      </Panel>

      <Panel id="upd-versions-panel" icon="list" title={t("settings.updates.going_back.title")}>
        <p id="upd-versions-lede" class="panel-lede">
          {t("settings.updates.going_back.lede_known")}
        </p>
        <Table cols={versionsColumns()} {...UPDATES_TABLE} bodyId="upd-versions" />
      </Panel>

      <Panel icon="file" title={t("settings.updates.backups.title")}>
        <div id="upd-backups">
          <EmptyRow as="div" loading />
        </div>
      </Panel>

      <Panel icon="clock" title={t("settings.updates.history.title")}>
