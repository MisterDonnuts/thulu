      // Read from the status file deploy/backup.sh leaves in the data dir; the daemon never sees
      // the archives.
      async function loadBackups() {
        const box = $("upd-backups");
        try {
          box.innerHTML = backupHTML(await api.get<BackupStatus>("/updates/backups"));
        } catch (err) {
          box.innerHTML = emptyRowHTML(
            err instanceof ApiError ? err.message : t("settings.updates.backups.load_failed"),
            { as: "div", tone: "danger" },
          );
        }
