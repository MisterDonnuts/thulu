      profForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const eng = profEngine;
        if (!eng) return;
        const editing = profEditing;
        const name = pf.name.value.trim();
        const provider = pf.provider.value || eng.provider;
        const cloud = isCloudProvider(provider);
        const fed = !cloud && federating();
        const key = provider === "vertex" || fed ? "" : pf.key.value.trim();
        const baseURL = eng.base_url && !cloud && !fed ? pf.baseURL.value.trim() : "";
        const cloudIn = {
          region: cloud ? pf.region.value.trim() : "",
          project_id: provider === "vertex" ? pf.project.value.trim() : "",
          small_fast_model: cloud ? pf.smallModel.value.trim() : "",
          aws_access_key_id: provider === "bedrock" ? pf.awsKeyID.value.trim() : "",
          aws_secret_access_key: provider === "bedrock" ? pf.awsSecret.value.trim() : "",
          aws_session_token: provider === "bedrock" ? pf.awsSession.value.trim() : "",
          gcp_service_account_json: provider === "vertex" ? pf.gcpSA.value.trim() : "",
        };
        const federation = {
          federation_rule_id: pf.fedRule.value.trim(),
          organization_id: pf.fedOrg.value.trim(),
          service_account_id: pf.fedSvac.value.trim(),
          workspace_id: pf.fedWS.value.trim(),
        };
        const problem = fed
          ? validateFederationForm(name, federation)
          : validateProfileForm({
              name,
              key,
              editing: Boolean(editing),
              prefix: pf.key.dataset.prefix ?? "",
              kindLabel: pf.kind.selectedOptions[0]?.textContent ?? "",
              provider,
              baseURL,
              region: cloudIn.region,
              projectID: cloudIn.project_id,
              awsAccessKeyID: cloudIn.aws_access_key_id,
              awsSecretAccessKey: cloudIn.aws_secret_access_key,
              providerChanged: Boolean(editing) && (editing?.provider || eng.provider) !== provider,
            });
        if (problem) return profileFormError(problem);
        // Send secret fields only when filled: an empty field keeps the stored credential.
        const body: Record<string, unknown> = {
          name,
          provider,
          model: pf.model.value.trim(),
          effort: eng.effort ? pf.effort.value : "",
          base_url: baseURL,
          org_id: eng.org_id && !cloud ? pf.orgID.value.trim() : "",
          auth_header: eng.auth_header && baseURL ? pf.authHeader.value : "",
          region: cloudIn.region,
          project_id: cloudIn.project_id,
          small_fast_model: cloudIn.small_fast_model,
        };
        for (const k of [
          "aws_access_key_id",
          "aws_secret_access_key",
          "aws_session_token",
          "gcp_service_account_json",
        ] as const) {
          if (cloudIn[k]) body[k] = cloudIn[k];
        }
        if (key) {
          body.key = key;
          if (pf.kind.value && !cloud) body.kind = pf.kind.value;
        }
        if (fed) {
          body.federation = federation;
          body.kind = pf.kind.value;
        }
        if (editing && cloud && pf.clearKey.checked) body.clear_key = true;
        pf.save.disabled = true;
        try {
          if (editing) {
            if (pf.isDefault.checked !== !!editing.is_default)
              body.is_default = pf.isDefault.checked;
            const saved = await api.patch<LLMProfile>(`/llm-profiles/${editing.id}`, body);
            toast(t("settings.llm.toasts.saved", { name }), "ok");
            if (key) keyCheckToast(name, saved);
          } else {
            body.engine = eng.name;
            body.is_default = pf.isDefault.checked;
            const saved = await api.post<LLMProfile>("/llm-profiles", body);
            toast(t("settings.llm.toasts.created", { name }), "ok");
            keyCheckToast(name, saved);
          }
          closeProfileModal();
          loadLLM();
        } catch (err: any) {
          profileFormError(err?.message ?? t("settings.llm.errors.save_failed"));
          pf.save.disabled = false;
        }
      });

