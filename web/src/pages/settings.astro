      // /info answers a lapsed token as no session (200 without licensee/features, never 401), so
      // confirm the session first: sessionInfo() refreshes once.
      let infoPromise: Promise<InfoResponse> | null = null;
      function fetchInfo(): Promise<InfoResponse> {
        infoPromise ??= sessionInfo()
          .then(() => fetch(`${API_BASE}/info`, { credentials: "include" }))
          .then((r) => (r.ok ? (r.json() as Promise<InfoResponse>) : Promise.reject(new Error())))
          .catch(() => ({}) as InfoResponse);
        return infoPromise;
      }

      async function applyEditionGate() {
        const info = await fetchInfo();
        const ee = isEE(info);
        const note = $("audit-export-ce");
        note.hidden = ee;
        if (!ee) $("audit-export-ce-text").innerHTML = t("settings.audit.export.ce_note_html");
        for (const format of ["csv", "json"] as const) {
          const btn = $(`audit-export-${format}`) as HTMLButtonElement;
          btn.disabled = !ee;
          if (ee) {
            delete btn.dataset.eeLocked;
            btn.title =
              format === "csv"
                ? t("settings.audit.export.csv_title")
                : t("settings.audit.export.json_title");
          } else {
            btn.dataset.eeLocked = "1";
            btn.title = t("settings.audit.export.needs_ee");
          }
        }
      }

