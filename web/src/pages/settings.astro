      function renderUpdateStatus(st: UpdateStatus) {
        updCurrent = st.version;
        const badge = $("upd-badge") as HTMLElement;
        const { label, tone } = updateBadge(st);
        setBadge(badge, label, tone);
        ($("upd-check") as HTMLButtonElement).disabled = st.source_off || !!st.source_error;

        const rejectedList = st.rejected
          .map((r) => `${esc(r.version)} (${esc(r.reason)})`)
          .join("; ");
        // Catalog text is trusted; versions and reasons were escaped above.
        const rejected = st.rejected.length
          ? calloutHTML({
              tone: "danger",
              icon: "alert",
              bodyHTML: t("settings.updates.rejected", { versions: rejectedList }),
              attrs: { role: "note" },
            })
          : "";
        const runtime =
          st.mode === "kubernetes"
            ? t("settings.updates.runtime.kubernetes")
            : t("settings.updates.runtime.docker");
        const lastError = lastErrorHTML(st);
        const facts = factsHTML(
          [
            { label: t("settings.updates.facts.running"), value: st.version, mono: true },
            {
              label: t("settings.updates.facts.channel"),
              value: st.channel || t("settings.updates.facts.unknown"),
            },
            { label: t("settings.updates.facts.runs_on"), value: runtime },
          ],
          { cls: "upd-facts" },
        );
        $("upd-summary").innerHTML = `
          ${facts}
          <p class="muted">${esc(sourceLine(st))}</p>
          ${lastError}
          ${rejected}`;

        const adv = $("upd-advisories") as HTMLElement;
        adv.innerHTML = advisoriesHTML(st.advisories);
        adv.hidden = st.advisories.length === 0;

        const rel = $("upd-releases") as HTMLElement;
        if (st.available.length) {
          rel.innerHTML = st.available.map((r) => releaseHTML(r, st.version)).join("");
        } else {
          rel.innerHTML = emptyRowHTML(noReleasesLine(st), { as: "div" });
        }
      }

      async function loadUpdateVersions() {
        const lede = $("upd-versions-lede") as HTMLElement;
        const body = $("upd-versions") as HTMLElement;
        const wrap = body.closest<HTMLElement>(".table-wrap")!;
        try {
