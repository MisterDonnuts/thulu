      sweepLine,
      type RetentionView,
    } from "../lib/retention";
    import { onPage, replaceURL } from "../lib/page";

    onPage("/settings", (signal) => {
      requireAuth();

      const API_BASE = apiBase();

      const toast = makeToast(3500);

      function elFrom(html: string): HTMLElement {
        const tpl = document.createElement("template");
        tpl.innerHTML = html;
        return tpl.content.firstElementChild as HTMLElement;
      }

      function bindError(el: HTMLElement) {
        return {
          show: (msg: string) => setFormError(el, msg),
          hide: () => setFormError(el, ""),
        };
      }

      const panels = Array.from(document.querySelectorAll<HTMLElement>(".settings-section"));
      let activeSection: string | null = null;

      function activateSection(tab: string) {
        activeSection = tab;
        panels.forEach((p) => {
          p.hidden = p.id !== `panel-${tab}`;
        });
        if (tab === "webhooks") loadWebhooks();
        if (tab === "audit") {
          loadAudit();
          applyEditionGate();
        }
        if (tab === "health") {
          loadHealth();
          loadLicense();
          void loadRetention();
        }
        if (tab === "api") {
          loadAPIKeys();
          loadRunKeys();
          loadIngestURL();
        }
        if (tab === "llm") {
          loadLLM();
          void loadEngineLogins();
          void loadRunLimit();
        }
        if (tab === "updates") loadUpdates();
        if (tab === "team") loadTeam();
        if (tab === "account") {
          loadAccount();
          loadSessions();
          void loadAccountLifecycle();
        }
      }

      // Trusted catalog HTML that carries its own markup; never route user data through here.
      $("llm-intro").innerHTML = t("settings.llm.intro_html");
      $("llm-cross-text").innerHTML = t("settings.llm.cross_html");

      $("locale-select").addEventListener("change", (e) => {
        switchLocale((e.target as HTMLSelectElement).value);
      });

      const headTitle = $("settings-title");
      const headSub = $("settings-sub");

      let shownSection = "";
      let workspaceName = "";
      function sectionSubtitle(key: string): string {
        if (key === "team" && workspaceName) {
          return t("lib.settings_sections.team.subtitle_named", { workspace: workspaceName });
        }
        return SETTINGS_SECTIONS[key].subtitle;
      }
      async function loadWorkspaceName() {
        try {
          const current = (await listMemberships()).find((m) => m.current);
          workspaceName = current?.name ?? "";
        } catch {
          return;
        }
        if (shownSection === "team") setText(headSub, sectionSubtitle("team"));
      }

      function showDenied(denial: SectionDenial, role: string | undefined) {
        activeSection = null;
        panels.forEach((p) => {
          p.hidden = p.id !== "panel-denied";
        });
        setText(
          $("denied-note"),
          denial === "operator"
            ? t("settings.updates.operator_only", { env: OPERATOR_ENV })
            : t("settings.denied.role", { role: roleLabel(role ?? "") }),
        );
      }

      async function syncSectionFromHash() {
        const asked = window.location.hash.slice(1);
        const key = resolveSection(asked, await authDisabled());
        if (asked && asked !== key) replaceURL(`#${key}`);
        const section = SETTINGS_SECTIONS[key];
        shownSection = key;
        setText(headTitle, section.title);
        setText(headSub, sectionSubtitle(key));
        document.title = t("settings.document_title", { section: section.title });
        const session = await sessionInfo();
        const denial = sectionDenial(key, session);
        if (denial) showDenied(denial, session?.role);
        else activateSection(key);
        document.dispatchEvent(new CustomEvent("octopus:settings-section", { detail: { key } }));
      }
      window.addEventListener("hashchange", () => void syncSectionFromHash(), { signal });

      async function loadIngestURL() {
        const input = $("ingest-url") as HTMLInputElement;
        try {
          const v = await api.get<string>("/settings/ingest.public_url");
          input.value = typeof v === "string" ? v : "";
        } catch {
          input.value = "";
        }
        showIngestHint();
      }

      function showIngestHint() {
        const input = $("ingest-url") as HTMLInputElement;
        const hint = $("ingest-url-hint");
        const v = input.value.trim().replace(/\/+$/, "");
        hint.textContent = v
          ? t("settings.api.ingest.hint_set", { url: `${v}/ingest` })
          : t("settings.api.ingest.hint_unset");
      }

      $("ingest-url").addEventListener("input", showIngestHint);

      let ingestLocked = false;
      function lockIngestURL() {
        ingestLocked = true;
        showReadOnly(
          $("ingest-panel").querySelector<HTMLElement>(".panel-body")!,
          t("settings.api.ingest.install_wide"),
          [$("ingest-url"), $("ingest-url-save")],
        );
      }
      void mayWriteInstallWide().then((ok) => {
        if (!ok) lockIngestURL();
      });

      $("ingest-url-save").addEventListener("click", async () => {
        const btn = $("ingest-url-save") as HTMLButtonElement;
        const input = $("ingest-url") as HTMLInputElement;
        btn.disabled = true;
        try {
          await api.put("/settings/ingest.public_url", input.value.trim());
          toast(
            input.value.trim() ? t("settings.api.ingest.saved") : t("settings.api.ingest.cleared"),
            "ok",
          );
          await loadIngestURL();
        } catch (e) {
          if (isOperatorRefusal(e)) {
            lockIngestURL();
            await loadIngestURL();
          } else {
            toast(
              e instanceof ApiError ? e.message : t("settings.api.ingest.save_failed"),
              "err",
              6000,
            );
          }
        } finally {
          btn.disabled = ingestLocked;
        }
      });

      const allCheckbox = $("wh-all-events") as HTMLInputElement;
      let specificCheckboxes: HTMLInputElement[] = [];

      async function loadWebhookEvents() {
        let events: string[] = [];
        try {
          events = await api.get<string[]>("/webhooks/events");
        } catch {
          return;
        }
        const host = $("events-specific");
        host.innerHTML = events
          .map((ev) =>
            checkHTML({
              value: ev,
              labelHTML: `<code>${esc(ev)}</code>`,
              hint: eventDescription(ev) || undefined,
            }),
          )
          .join("");
        specificCheckboxes = Array.from(host.querySelectorAll<HTMLInputElement>("input"));
        updateEventsPick();
      }

      function updateEventsPick() {
        const all = allCheckbox.checked;
        specificCheckboxes.forEach((c) => {
          if (all) c.checked = false;
          c.disabled = all;
        });
        $("events-specific").classList.toggle("is-dim", all);
      }

      allCheckbox.addEventListener("change", updateEventsPick);
      updateEventsPick();

      function getSelectedEvents(): string[] {
        if (allCheckbox.checked) return ["*"];
        return specificCheckboxes.filter((c) => c.checked).map((c) => c.value);
      }

      const whForm = $("webhook-form") as HTMLFormElement;
      const whUrl = $("wh-url") as HTMLInputElement;
      const whError = $("wh-error") as HTMLElement;
      const whSubmit = $("wh-submit") as HTMLButtonElement;

      const { show: showWhError, hide: hideWhError } = bindError(whError);

      whForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideWhError();
        const url = whUrl.value.trim();
        const events = getSelectedEvents();
        const problem = validateWebhookForm(url, events);
        if (problem) {
          showWhError(problem);
          return;
        }

        whSubmit.disabled = true;
        try {
          const created = await api.post<Webhook>("/webhooks", { url, events });
          showWebhookSecret(created, false);
          whUrl.value = "";
          allCheckbox.checked = true;
          updateEventsPick();
          toast(t("settings.webhooks.toasts.added"), "ok");
          await loadWebhooks();
        } catch (err) {
          showWhError(
            err instanceof ApiError ? err.message : t("settings.webhooks.errors.add_failed"),
          );
        } finally {
          whSubmit.disabled = false;
        }
      });

      interface Webhook {
        id: string;
        url: string;
        events: string[];
        created_at?: string;
        legacy_signing?: boolean;
        secret?: string;
      }

      function showWebhookSecret(wh: Webhook, rotated: boolean) {
        if (!wh.secret) return;
        setText($("wh-secret-label"), secretRevealLabel(wh.url, rotated));
        setText($("wh-secret-value"), wh.secret);
        $("wh-secret-display").hidden = false;
      }

      async function rotateWebhookSecret(wh: Webhook, btn: HTMLButtonElement) {
        const ok = await confirmDialog({
          title: t("settings.webhooks.confirm.rotate_title"),
          message: t("settings.webhooks.confirm.rotate_message", { url: wh.url }),
          confirmLabel: t("settings.webhooks.confirm.rotate"),
          danger: true,
        });
        if (!ok) return;
        btn.disabled = true;
        try {
          const rotated = await api.post<Webhook>(`/webhooks/${wh.id}/rotate-secret`);
          showWebhookSecret(rotated, true);
          toast(t("settings.webhooks.toasts.secret_rotated"), "ok");
          await loadWebhooks();
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("settings.webhooks.errors.rotate_failed"),
            "err",
            6000,
          );
        } finally {
          btn.disabled = false;
        }
      }

      function createWebhookRow(wh: Webhook): HTMLElement {
        const row = document.createElement("div");
        row.innerHTML =
          listRowHTML({
            title: wh.url,
            mono: true,
            badgesHTML: badgeHTML(t("settings.webhooks.row.legacy_signing"), "warn", {
              cls: "wh-legacy",
              title: LEGACY_SIGNING_TITLE,
              attrs: { hidden: true },
            }),
            meta: wh.events.join(", "),
            actions: [
              {
                label: t("settings.webhooks.row.test"),
                cls: "wh-test-btn",
                title: t("settings.webhooks.row.test_title"),
              },
              {
                label: t("settings.webhooks.row.deliveries"),
                cls: "wh-deliveries-btn",
                title: t("settings.webhooks.row.deliveries_title"),
                attrs: { "aria-expanded": "false" },
              },
              {
                label: t("settings.webhooks.row.rotate"),
                cls: "wh-rotate-btn",
                title: t("settings.webhooks.row.rotate_title"),
              },
              {
                label: t("settings.webhooks.row.delete_aria"),
                title: t("common.buttons.delete"),
                icon: "trash",
                iconOnly: true,
                variant: "danger",
                cls: "wh-delete-btn",
              },
            ],
          }) + `<div class="row-detail wh-deliveries" hidden></div>`;

        const deliveriesBox = row.querySelector<HTMLElement>(".wh-deliveries")!;
        const deliveriesBtn = row.querySelector<HTMLButtonElement>(".wh-deliveries-btn")!;
        let deliveriesFollow: ReturnType<typeof setTimeout> | undefined;
        async function loadDeliveries() {
          clearTimeout(deliveriesFollow);
          try {
            const list = await api.get<Delivery[]>(`/webhooks/${wh.id}/deliveries`);
            if (deliveriesBox.hidden) return;
            if (!list.length) {
              deliveriesBox.innerHTML = emptyStateHTML({
                size: "inline",
                title: t("settings.webhooks.deliveries.empty"),
              });
              return;
            }
            deliveriesBox.innerHTML = deliveriesTableHTML(list);
            deliveriesBox.querySelectorAll<HTMLButtonElement>(".wh-retry-btn").forEach((b) => {
              b.addEventListener("click", async () => {
                b.disabled = true;
                try {
                  await api.post(`/webhooks/${wh.id}/deliveries/${b.dataset.id}/retry`, {});
                  toast(t("settings.webhooks.deliveries.retried"), "ok");
                  await loadDeliveries();
                } catch (err) {
                  toast(
                    err instanceof ApiError
                      ? err.message
                      : t("settings.webhooks.deliveries.retry_failed"),
                    "err",
                  );
                  // 409: another retry won the race; reload so this row stops offering one.
                  if (err instanceof ApiError && err.status === 409) await loadDeliveries();
                  else b.disabled = false;
                }
              });
            });
            if (deliveriesPending(list))
              deliveriesFollow = setTimeout(() => void loadDeliveries(), 3000);
          } catch {
            deliveriesBox.innerHTML = emptyStateHTML({
              size: "inline",
              tone: "danger",
              icon: "alert",
              title: t("settings.webhooks.deliveries.load_failed"),
            });
          }
        }
        deliveriesBtn.addEventListener("click", () => {
          deliveriesBox.hidden = !deliveriesBox.hidden;
          deliveriesBtn.setAttribute("aria-expanded", String(!deliveriesBox.hidden));
          if (!deliveriesBox.hidden) {
            deliveriesBox.innerHTML = emptyStateHTML({ size: "inline", loading: true });
            void loadDeliveries();
          }
        });

        const rotateBtn = row.querySelector<HTMLButtonElement>(".wh-rotate-btn")!;
        // The row outlives polls: read the endpoint it was last drawn with, not the closure's wh.
        rotateBtn.addEventListener("click", () => {
          void rotateWebhookSecret(webhookByRow.get(row) ?? wh, rotateBtn);
        });

        const testBtn = row.querySelector<HTMLButtonElement>(".wh-test-btn")!;
        testBtn.addEventListener("click", async () => {
          testBtn.disabled = true;
          testBtn.textContent = "…";
          try {
            const result = await api.post<TestDelivery>(`/webhooks/${wh.id}/test`, {});
            const shown = testResultToast(result);
            toast(shown.text, shown.ok ? "ok" : "err", shown.ok ? 5000 : 8000);
            if (!deliveriesBox.hidden) void loadDeliveries();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : testResultToast({ success: false }).text,
              "err",
            );
          } finally {
            testBtn.disabled = false;
            testBtn.textContent = t("settings.webhooks.row.test");
          }
        });

        const deleteBtn = row.querySelector<HTMLButtonElement>(".wh-delete-btn")!;
        deleteBtn.addEventListener("click", async () => {
          deleteBtn.disabled = true;
          try {
            await api.del(`/webhooks/${wh.id}`);
            toast(t("settings.webhooks.toasts.deleted"), "ok");
            await loadWebhooks();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.webhooks.errors.delete_failed"),
              "err",
            );
            deleteBtn.disabled = false;
          }
        });

        updateWebhookRow(row, wh, null);
        return row;
      }

      const webhookByRow = new WeakMap<HTMLElement, Webhook>();

      function updateWebhookRow(el: HTMLElement, wh: Webhook, _prev: Webhook | null) {
        webhookByRow.set(el, wh);
        setText(el.querySelector(".row-title"), wh.url);
        setText(el.querySelector(".row-meta"), wh.events.join(", "));
        (el.querySelector(".wh-legacy") as HTMLElement).hidden = !wh.legacy_signing;
        const rotate = el.querySelector(".wh-rotate-btn");
        if (rotate) {
          rotate.className = buttonClasses({
            variant: wh.legacy_signing ? "primary" : "default",
            size: "sm",
            cls: "wh-rotate-btn",
          });
        }
      }

      function updateLegacyNote(whs: Webhook[]) {
        const note = $("wh-legacy-note");
        const text = legacySigningNote(whs.filter((w) => w.legacy_signing).length);
        note.hidden = !text;
        if (text) setText($("wh-legacy-note-text"), text);
      }

      // Fetched lazily on first open: below admin the daemon refuses /webhooks/events.
      let webhookEventsAsked = false;
      async function loadWebhooks() {
        if (!webhookEventsAsked) {
          webhookEventsAsked = true;
          void loadWebhookEvents();
        }
        try {
          const whs = await api.get<Webhook[]>("/webhooks");
          setCount($("wh-count"), whs.length, { pill: true });
          updateLegacyNote(whs);
          const ct = $("webhooks-list");
          const empty = ct.querySelector<HTMLElement>(".row-empty");
          if (whs.length === 0) {
            // The shipped .row-empty reads "Loading…"; test its text, not its presence, or an empty
            // install loads forever.
            const none = t("settings.webhooks.empty.none");
            if (empty?.textContent?.trim() !== none) {
              ct.innerHTML = emptyRowHTML(none, { as: "div" });
            }
            return;
          }
          if (empty) empty.remove();
          reconcile<Webhook>({
            container: ct,
            items: whs,
            key: (w) => w.id,
            create: createWebhookRow,
            update: updateWebhookRow,
          });
        } catch {
          const ct = $("webhooks-list");
          if (!ct.querySelector(".row-empty")) {
            ct.innerHTML = emptyRowHTML(t("settings.webhooks.empty.load_failed"), {
              as: "div",
              tone: "danger",
            });
          }
        }
      }

      interface AuditEntry extends AuditRow {
        id: string;
        created_at: string;
      }

      // Entries never change: redraw only when markup differs, so the "Go to the entry" tone mark
      // survives polls.
      const auditDrawn = new WeakMap<HTMLElement, string>();
      function createAuditRow(entry: AuditEntry): HTMLElement {
        const html = auditRowHTML(entry);
        const tr = elFrom(html);
        auditDrawn.set(tr, html);
        return tr;
      }

      function updateAuditRow(el: HTMLElement, entry: AuditEntry, _prev: AuditEntry | null) {
        const html = auditRowHTML(entry);
        if (auditDrawn.get(el) === html) return;
        el.innerHTML = elFrom(html).innerHTML;
        auditDrawn.set(el, html);
      }

      async function initAuditChain() {
        const box = $("audit-chain");
        if (!(await mayWriteInstallWide())) return;
        box.hidden = false;
      }
      void initAuditChain();

      let brokenRow = "";
      function auditRowOf(id: string): HTMLElement | null {
        if (!id) return null;
        return (
          Array.from($("audit-tbody").children).find(
            (tr): tr is HTMLElement => tr instanceof HTMLElement && tr.dataset.rckey === id,
          ) ?? null
        );
      }
      $("audit-chain-goto").addEventListener("click", () => {
        const tr = auditRowOf(brokenRow);
        if (!tr) return;
        tr.dataset.tone = "danger";
        tr.tabIndex = -1;
        tr.scrollIntoView({ block: "center" });
        tr.focus();
      });

      $("audit-verify").addEventListener("click", async () => {
        const btn = $("audit-verify") as HTMLButtonElement;
        const line = $("audit-chain-line");
        btn.disabled = true;
        setText(line, t("settings.audit.chain.verifying"));
        try {
          const report = await api.get<ChainReport>("/audit/verify");
          setText(line, chainLine(report));
          $("audit-chain").className = calloutClasses({
            tone: report.ok ? "ok" : "danger",
            band: true,
          });
          line.title = report.head ?? "";
          brokenRow = report.ok ? "" : (report.broken_at ?? "");
          // Verify covers the whole install's log; the table shows only this workspace, so the row
          // may be absent.
          $("audit-chain-goto").hidden = !auditRowOf(brokenRow);
        } catch (err) {
          setText(
            line,
            err instanceof ApiError ? err.message : t("settings.audit.chain.verify_failed"),
          );
          $("audit-chain").className = calloutClasses({ tone: "warn", band: true });
        } finally {
          btn.disabled = false;
        }
      });

      let auditEntries: AuditEntry[] = [];
      let auditHasMore = false;

      function fetchAudit(limit: number, offset: number): Promise<AuditEntry[]> {
        const kind = ($("audit-kind") as HTMLSelectElement).value;
        const params = new URLSearchParams({ limit: String(limit), offset: String(offset) });
        if (kind) params.set("kind", kind);
        return api.get<AuditEntry[]>(`/audit?${params}`);
      }

      function renderAudit() {
        const tbody = $("audit-tbody") as HTMLElement;
        const empty = $("audit-empty") as HTMLElement;
        ($("audit-load-more") as HTMLButtonElement).hidden = !auditHasMore;
        if (auditEntries.length === 0) {
          tbody.innerHTML = "";
          empty.hidden = false;
          return;
        }
        empty.hidden = true;
        reconcile<AuditEntry>({
          container: tbody,
          items: auditEntries,
          key: (e) => e.id,
          create: createAuditRow,
          update: updateAuditRow,
        });
      }

      async function loadAudit() {
        // Refetch the whole paged window so the poller doesn't collapse "Load more" back to page
        // one.
        const limit = auditWindowLimit(auditEntries.length);
        try {
          const entries = await fetchAudit(limit, 0);
          auditEntries = entries;
          auditHasMore = entries.length >= limit;
          renderAudit();
        } catch (err) {
          const tbody = $("audit-tbody") as HTMLElement;
          const msg = err instanceof ApiError ? err.message : t("settings.audit.load_failed");
          tbody.innerHTML = emptyRowHTML(msg, { cols: auditColumns().length, tone: "danger" });
          ($("audit-load-more") as HTMLButtonElement).hidden = true;
        }
      }

      async function loadMoreAudit() {
        const btn = $("audit-load-more") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const more = await fetchAudit(AUDIT_PAGE, auditEntries.length);
          auditEntries = mergeAuditPage(auditEntries, more);
          auditHasMore = more.length >= AUDIT_PAGE;
          renderAudit();
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("settings.audit.load_more_failed"),
            "err",
          );
        } finally {
          btn.disabled = false;
        }
      }

      ($("audit-kind") as HTMLSelectElement).addEventListener("change", () => {
        auditEntries = [];
        auditHasMore = false;
        loadAudit();
      });
      $("audit-refresh").addEventListener("click", () => loadAudit());
      $("audit-load-more").addEventListener("click", () => loadMoreAudit());

      async function exportAudit(format: "csv" | "json") {
        const btn = $(`audit-export-${format}`) as HTMLButtonElement;
        if (btn.dataset.eeLocked === "1") {
          toast(t("settings.audit.export.needs_ee"), "err");
          return;
        }
        btn.disabled = true;
        try {
          const params = auditExportParams(format, ($("audit-kind") as HTMLSelectElement).value);
          const resp = await fetch(`${API_BASE}/audit/export?${params}`, {
            method: "GET",
            credentials: "include",
          });
          if (resp.status === 403) {
            toast(t("settings.audit.export.needs_ee"), "err");
            return;
          }
          if (!resp.ok) {
            let msg = t("settings.audit.export.failed_status", { status: resp.status });
            try {
              const j = (await resp.json()) as { error?: string };
              if (j.error) msg = j.error;
            } catch {
              /* body may not be JSON */
            }
            toast(msg, "err");
            return;
          }
          const blob = await resp.blob();
          // format=json streams NDJSON from the daemon.
          const ext = format === "json" ? "ndjson" : "csv";
          const fallback = `audit-${new Date().toISOString().slice(0, 10)}.${ext}`;
          const filename = filenameFromDisposition(
            resp.headers.get("Content-Disposition"),
            fallback,
          );
          downloadBlob(blob, filename);
          toast(t("settings.audit.export.done", { format: ext.toUpperCase() }), "ok");
        } catch (err) {
          toast(err instanceof Error ? err.message : t("settings.audit.export.failed"), "err");
        } finally {
          btn.disabled = false;
        }
      }

      $("audit-export-csv").addEventListener("click", () => exportAudit("csv"));
      $("audit-export-json").addEventListener("click", () => exportAudit("json"));

      interface APIKey {
        id: string;
        name: string;
        prefix: string;
        created_by: string;
        created_by_email?: string;
        created_at: string;
        last_used_at?: string;
        revoked_at?: string;
        expires_at?: string;
        scope_task_id?: string;
        workspace_id?: string;
        role?: string;
        permissions?: string[];
        replaced_by?: string;
      }

      const KEY_STATE_TAG: Record<KeyState, string> = {
        live: "",
        grace: t("settings.api.keys.replaced"),
        replaced: t("settings.api.keys.replaced"),
        expired: t("settings.api.keys.expired"),
        revoked: t("settings.api.keys.revoked"),
        task_scoped: t("settings.api.keys.task_scoped"),
      };

      async function loadAPIKeys() {
        const list = $("api-keys-list");
        try {
          const keys = await api.get<APIKey[]>("/auth/api-keys");
          if (!keys || keys.length === 0) {
            list.innerHTML = emptyRowHTML(t("settings.api.keys.empty"), { as: "div" });
            return;
          }
          const now = new Date();
          list.innerHTML = keys
            .map((k) => {
              const state = keyState(k, now);
              const actions = keyActions(state);
              const tag = KEY_STATE_TAG[state];
              const working = state === "live" || state === "grace";
              const row = listRowHTML({
                title: k.name,
                badgesHTML:
                  `<code class="code-inline">${esc(k.prefix)}…</code>` +
                  (tag ? badgeHTML(tag, "muted") : ""),
                meta: keyDetails(k, now),
                dim: !working,
                actions: [
                  ...(actions.rotate
                    ? [
                        {
                          label: t("settings.api.keys.rotate"),
                          cls: "rotate-key-btn",
                          title: t("settings.api.keys.rotate_title"),
                        },
                      ]
                    : []),
                  ...(actions.revoke
                    ? [
                        {
                          label: t("settings.api.keys.revoke"),
                          variant: "danger" as const,
                          cls: "revoke-key-btn",
                          attrs: { "data-id": k.id, "data-name": k.name },
                        },
                      ]
                    : []),
                ],
              });
              return `<div class="key-row" data-key-id="${esc(k.id)}">${row}
                <div class="row-detail key-rotate" hidden>
                  ${fieldHTML({
                    label: t("settings.api.keys.rotate_grace"),
                    for: `rotate-grace-${k.id}`,
                    size: "sm",
                    control: `<select id="rotate-grace-${esc(k.id)}" class="rotate-grace">${ROTATE_GRACE_HOURS.map(
                      (h) =>
                        `<option value="${h}"${h === 24 ? " selected" : ""}>${esc(graceLabel(h))}</option>`,
                    ).join("")}</select>`,
                  })}
                  ${buttonHTML({ label: t("settings.api.keys.rotate_confirm"), variant: "primary", size: "sm", cls: "rotate-go-btn", attrs: { "data-id": k.id } })}
                  ${buttonHTML({ label: t("common.buttons.cancel"), size: "sm", cls: "rotate-cancel-btn" })}
                </div>
              </div>`;
            })
            .join("");
          list.querySelectorAll<HTMLButtonElement>(".revoke-key-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
              const ok = await confirmDialog({
                title: t("settings.api.keys.revoke_title", { name: btn.dataset.name }),
                message: t("settings.api.keys.revoke_message"),
                confirmLabel: t("settings.api.keys.revoke"),
                danger: true,
              });
              if (!ok) return;
              btn.disabled = true;
              try {
                await api.del(`/auth/api-keys/${btn.dataset.id}`);
                toast(t("settings.api.keys.revoked_toast"), "ok");
                loadAPIKeys();
              } catch (e: any) {
                toast(e?.message ?? t("settings.api.keys.revoke_failed"), "err");
                btn.disabled = false;
              }
            });
          });
          list.querySelectorAll<HTMLElement>(".key-row").forEach((row) => {
            const strip = row.querySelector<HTMLElement>(".key-rotate");
            const open = row.querySelector<HTMLButtonElement>(".rotate-key-btn");
            if (!strip || !open) return;
            open.addEventListener("click", () => {
              strip.hidden = !strip.hidden;
            });
            row.querySelector(".rotate-cancel-btn")?.addEventListener("click", () => {
              strip.hidden = true;
            });
            const go = row.querySelector<HTMLButtonElement>(".rotate-go-btn");
            go?.addEventListener("click", async () => {
              const grace = Number(
                row.querySelector<HTMLSelectElement>(".rotate-grace")?.value ?? 24,
              );
              go.disabled = true;
              keyError.hide();
              try {
                const result = await api.post<{
                  key: string;
                  expires_at?: string;
                  role?: string;
                  permissions?: string[];
                  old_expires_at?: string;
                }>(`/auth/api-keys/${go.dataset.id}/rotate`, { grace_hours: grace });
                revealKey(
                  result.key,
                  `${grantedLine(result.role, result.permissions ?? [], result.expires_at)} ${rotatedLine(result.old_expires_at)}`,
                );
                toast(t("settings.api.keys.rotated"), "ok");
                loadAPIKeys();
              } catch (e) {
                keyError.show(
                  e instanceof ApiError
                    ? t("settings.api.keys.rotate_refused", { error: e.message })
                    : t("settings.api.keys.rotate_failed"),
                );
                go.disabled = false;
              }
            });
          });
        } catch {
          list.innerHTML = emptyRowHTML(t("settings.api.keys.load_failed"), {
            as: "div",
            tone: "danger",
          });
        }
      }

      function revealKey(key: string, line: string) {
        setText($("new-key-value"), key);
        setText($("new-key-expiry"), line);
        const box = $("new-key-display");
        box.hidden = false;
        box.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }

      interface RunKey extends APIKey {
        scope_chat_id?: string;
        scope_agent?: string;
        scope_stage?: string;
        stage_label?: string;
        task_title?: string;
      }

      async function loadRunKeys() {
        const list = $("run-keys-list");
        try {
          const keys = await api.get<RunKey[]>("/auth/run-keys");
          if (!keys || keys.length === 0) {
            list.innerHTML = emptyRowHTML(t("settings.api.run_keys.empty"), { as: "div" });
            return;
          }
          const now = new Date();
          list.innerHTML = keys
            .map((k) => {
              const what = k.scope_task_id
                ? k.task_title || k.scope_task_id
                : k.scope_chat_id
                  ? t("settings.api.run_keys.chat")
                  : k.name;
              const who = [k.scope_agent, k.stage_label || k.scope_stage]
                .filter(Boolean)
                .join(" · ");
              return listRowHTML({
                title: what,
                titleHref: k.scope_task_id
                  ? `/tasks/#task-${encodeURIComponent(k.scope_task_id)}`
                  : undefined,
                meta: [who, expiresIn(k.expires_at, now)].filter(Boolean).join(" · "),
                actions: [
                  {
                    label: t("settings.api.keys.revoke"),
                    variant: "danger",
                    cls: "revoke-run-key-btn",
                    attrs: { "data-id": k.id },
                  },
                ],
              });
            })
            .join("");
          list.querySelectorAll<HTMLButtonElement>(".revoke-run-key-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
              const ok = await confirmDialog({
                title: t("settings.api.run_keys.revoke_title"),
                message: t("settings.api.run_keys.revoke_message"),
                confirmLabel: t("settings.api.keys.revoke"),
                danger: true,
              });
              if (!ok) return;
              btn.disabled = true;
              try {
                await api.del(`/auth/api-keys/${btn.dataset.id}`);
                toast(t("settings.api.keys.revoked_toast"), "ok");
                loadRunKeys();
              } catch (e: any) {
                toast(e?.message ?? t("settings.api.keys.revoke_failed"), "err");
                btn.disabled = false;
              }
            });
          });
        } catch {
          list.innerHTML = emptyRowHTML(t("settings.api.run_keys.load_failed"), {
            as: "div",
            tone: "danger",
          });
        }
      }

      $("api-key-perms").innerHTML = permissionChoices()
        .map((c) =>
          checkHTML({
            value: c.value,
            label: c.label,
            hint: c.hint || undefined,
            inputCls: "perm-box",
          }),
        )
        .join("");

      function permBoxes(): HTMLInputElement[] {
        return Array.from(document.querySelectorAll<HTMLInputElement>(".perm-box"));
      }

      function selectedPermissions(): string[] {
        return permBoxes()
          .filter((b) => b.checked)
          .map((b) => b.value);
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>(".preset-btn")) {
        btn.addEventListener("click", () => {
          const boxes = permBoxes();
          const wanted = new Set(
            presetSelection(
              btn.dataset.preset ?? "",
              boxes.map((b) => b.value),
            ),
          );
          for (const box of boxes) box.checked = wanted.has(box.value);
        });
      }

      const keyError = bindError($("api-key-error"));
      let keyMaxDays: number | null = null;

      async function initKeyForm() {
        const me = await sessionInfo();
        // A no-login install has no session; the public auth config carries the same cap.
        const capSeconds =
          me?.api_key_max_ttl_seconds ?? (await authConfig()).api_key_max_ttl_seconds;
        keyMaxDays = maxKeyDays(capSeconds);
        const expiresInput = $("api-key-expires") as HTMLInputElement;
        expiresInput.value = defaultKeyDays(keyMaxDays);
        if (keyMaxDays && keyMaxDays > 0) expiresInput.max = String(keyMaxDays);
        setText($("api-key-expiry-hint"), expiryHint(keyMaxDays, typeof capSeconds === "number"));
        const roleInput = $("api-key-role") as HTMLSelectElement;
        for (const opt of Array.from(roleInput.options)) {
          opt.disabled = !roleWithin(opt.value, me?.role);
        }
        if (roleInput.selectedOptions[0]?.disabled) {
          const allowed = Array.from(roleInput.options).filter((o) => !o.disabled);
          if (allowed.length) roleInput.value = allowed[allowed.length - 1].value;
        }
      }
      void initKeyForm();

      $("gen-api-key").addEventListener("click", async () => {
        const nameInput = $("api-key-name") as HTMLInputElement;
        const expiresInput = $("api-key-expires") as HTMLInputElement;
        const roleInput = $("api-key-role") as HTMLSelectElement;
        const name = nameInput.value.trim() || t("settings.api.keys.default_name");
        keyError.hide();
        const permissions = selectedPermissions();
        if (permissions.length === 0) {
          keyError.show(t("settings.api.keys.no_permissions_picked"));
          return;
        }
        const problem = expiryProblem(expiresInput.value, keyMaxDays);
        if (problem) {
          keyError.show(problem);
          return;
        }
        const body: {
          name: string;
          role: string;
          permissions: string[];
          expires_in_days?: number;
        } = { name, role: roleInput.value, permissions };
        const expiresDays = Number(expiresInput.value.trim());
        if (expiresInput.value.trim() && expiresDays > 0) {
          body.expires_in_days = expiresDays;
        }
        const btn = $("gen-api-key") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const result = await api.post<{
            id: string;
            name: string;
            prefix: string;
            key: string;
            expires_at?: string;
            role?: string;
            permissions?: string[];
          }>("/auth/api-keys", body);
          // Show what the server granted, which may differ from what was asked.
          revealKey(
            result.key,
            grantedLine(result.role, result.permissions ?? [], result.expires_at),
          );
          nameInput.value = "";
          expiresInput.value = defaultKeyDays(keyMaxDays);
          toast(t("settings.api.keys.generated"), "ok");
          loadAPIKeys();
        } catch (e) {
          keyError.show(
            e instanceof ApiError
              ? t("settings.api.keys.refused", { error: e.message })
              : t("settings.api.keys.generate_failed"),
          );
        } finally {
          btn.disabled = false;
        }
      });

      interface KeyKindView {
        id: string;
        label: string;
        prefix: string;
        federated?: boolean;
        owner_only?: boolean;
      }
      interface WorkloadIdentityView {
        configured: boolean;
        error?: string;
        issuer?: string;
        jwks?: unknown;
        subject_prefix?: string;
      }
      interface EngineInfo {
        name: string;
        label: string;
        provider: string;
        key_kinds: KeyKindView[];
        models?: string[];
        is_default?: boolean;
        effort?: boolean;
        base_url?: boolean;
        org_id?: boolean;
        auth_header?: boolean;
        providers?: string[];
        has_key: boolean;
        key_hint?: string;
        default_profile_id?: string;
        host_fallback?: boolean;
        fallback_model?: string;
      }

      let llmEngines: EngineInfo[] = [];
      let llmProfiles: LLMProfile[] = [];
      let llmAgents: AgentLite[] = [];

      async function loadLLM() {
        const box = $("llm-engines");
        try {
          const [e, p, agents] = await Promise.all([
            api.get<{ engines: EngineInfo[] }>("/engines"),
            api.get<{ profiles: LLMProfile[] | null }>("/llm-profiles"),
            api.get<AgentLite[]>("/types").catch((): AgentLite[] => []),
          ]);
          llmEngines = e?.engines ?? [];
          llmProfiles = p?.profiles ?? [];
          llmAgents = agents ?? [];
          renderLLM();
        } catch {
          box.innerHTML = emptyRowHTML(t("settings.llm.errors.load_failed"), {
            as: "div",
            tone: "danger",
          });
        }
      }

      let runLimit: RunLimit | null = null;
      let runLimitAdmin = false;

      async function loadRunLimit() {
        const panel = $("runlimit-panel");
        let view: WorkspaceSettings;
        try {
          view = await api.get<WorkspaceSettings>("/workspace-settings");
        } catch {
          // Older daemons have no /workspace-settings: keep the panel hidden.
          panel.hidden = true;
          return;
        }
        const limit = view?.[RUN_LIMIT_KEY];
        if (!limit) {
          panel.hidden = true;
          return;
        }
        runLimitAdmin = roleWithin("admin", (await sessionInfo())?.role);
        runLimit = limit;
        panel.hidden = false;
        renderRunLimit();
      }

      function renderRunLimit() {
        if (!runLimit) return;
        const input = $("runlimit-minutes") as HTMLInputElement;
        input.value = runLimit.value === null ? "" : String(runLimit.value);
        input.max = String(runLimit.ceiling);
        input.placeholder = runLimit.default > 0 ? String(runLimit.default) : "";
        input.disabled = !runLimitAdmin;
        setText($("runlimit-help"), runLimitHelp(runLimit));
        setText($("runlimit-now"), runLimitNow(runLimit));
        $("runlimit-readonly").hidden = runLimitAdmin;
        $("runlimit-save").hidden = !runLimitAdmin;
        $("runlimit-clear").hidden = !runLimitAdmin;
        setFieldError(input, "");
        setFormError($("runlimit-error"), "");
        paintRunLimit();
      }

      function paintRunLimit() {
        if (!runLimit) return;
        const raw = ($("runlimit-minutes") as HTMLInputElement).value.trim();
        const saved = runLimit.value === null ? "" : String(runLimit.value);
        ($("runlimit-save") as HTMLButtonElement).disabled =
          !runLimitAdmin || raw === "" || raw === saved;
        ($("runlimit-clear") as HTMLButtonElement).disabled =
          !runLimitAdmin || runLimit.value === null;
      }

      async function putRunLimit(minutes: number | null) {
        const view = await api.put<WorkspaceSettings>(RUN_LIMIT_PATH, minutes);
        const limit = view?.[RUN_LIMIT_KEY];
        if (limit) {
          runLimit = limit;
          renderRunLimit();
        } else {
          await loadRunLimit();
        }
      }

      $("runlimit-minutes").addEventListener("input", () => {
        setFieldError($("runlimit-minutes"), "");
        setFormError($("runlimit-error"), "");
        paintRunLimit();
      });
      $("runlimit-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!runLimit || !runLimitAdmin) return;
        const input = $("runlimit-minutes") as HTMLInputElement;
        const parsed = parseRunLimit(input.value, runLimit.ceiling);
        if ("error" in parsed) {
          setFieldError(input, parsed.error, { focus: true });
          return;
        }
        const btn = $("runlimit-save") as HTMLButtonElement;
        btn.disabled = true;
        try {
          await putRunLimit(parsed.minutes);
          toast(t("settings.run_limit.saved"), "ok");
        } catch (err) {
          setFieldError(
            input,
            err instanceof ApiError ? err.message : t("settings.run_limit.save_failed"),
          );
          paintRunLimit();
        }
      });
      $("runlimit-clear").addEventListener("click", async () => {
        if (!runLimit || !runLimitAdmin) return;
        const btn = $("runlimit-clear") as HTMLButtonElement;
        btn.disabled = true;
        try {
          await putRunLimit(null);
          toast(t("settings.run_limit.cleared"), "ok");
        } catch (err) {
          setFormError(
            $("runlimit-error"),
            err instanceof ApiError ? err.message : t("settings.run_limit.save_failed"),
          );
          paintRunLimit();
        }
      });

      function followers(engineName: string): string[] {
        return agentsOnDefault(engineName, llmProfiles, llmAgents, llmEngines);
      }

      function profileRowHTML(p: LLMProfile): string {
        const users = p.is_default ? followers(p.engine) : (p.bound_agents ?? []);
        const badge = keyBadge(p);
        const trouble = keyTrouble(p);
        // profileMeta() escapes its parts (some carry <code>), so it goes into metaHTML unescaped.
        const meta = profileMeta(
          p,
          llmEngines.find((e) => e.name === p.engine)?.fallback_model,
        ).join(" · ");
        const note = trouble?.text
          ? `<span class="prof-note text-${trouble.tone}">${esc(trouble.text)}</span>`
          : "";
        return listRowHTML({
          boxed: true,
          title: p.name,
          badgesHTML:
            (p.is_default ? badgeHTML(t("settings.llm.engine.default_badge"), "accent") : "") +
            (badge ? badgeHTML(badge.label, badge.tone, { title: badge.title || undefined }) : ""),
          metaHTML: `<span class="prof-line">${meta}</span>${note}<span class="prof-line prof-used">${esc(usedByText(users, !!p.is_default))}</span>`,
          actions: [
            ...(canRecheck(p)
              ? [{ label: t("settings.llm.buttons.recheck"), attrs: { "data-prof-check": p.id } }]
              : []),
            ...(p.is_default
              ? []
              : [
                  {
                    label: t("settings.buttons.make_default"),
                    attrs: { "data-prof-default": p.id },
                  },
                ]),
            { label: t("common.buttons.edit"), attrs: { "data-prof-edit": p.id } },
            {
              label: t("common.buttons.delete"),
              variant: "danger" as const,
              attrs: { "data-prof-del": p.id },
            },
          ],
        });
      }

      function renderLLM() {
        const box = $("llm-engines");
        if (llmEngines.length === 0) {
          box.innerHTML = emptyRowHTML(t("settings.llm.engine.none"), { as: "div" });
          return;
        }
        box.innerHTML = llmEngines
          .map((e) => {
            const mine = llmProfiles.filter((p) => p.engine === e.name);
            const def = mine.find((p) => p.is_default);
            const others = mine.filter((p) => !p.is_default);
            const waiting = followers(e.name).length;
            const defHTML = def
              ? profileRowHTML(def)
              : emptyStateHTML({
                  size: "inline",
                  dashed: true,
                  title: noDefaultText(e, waiting),
                  action: {
                    label: t("settings.llm.engine.set_default_key"),
                    variant: "primary",
                    size: "sm",
                    attrs: { "data-prof-new": e.name, "data-as-default": "1" },
                  },
                });
            const fallback = e.is_default
              ? badgeHTML(t("settings.llm.engine.fallback"), "neutral", {
                  title: t("settings.llm.engine.fallback_title"),
                })
              : "";
            const rest = others.length
              ? others.map(profileRowHTML).join("")
              : emptyStateHTML({ size: "inline", title: t("settings.llm.engine.others_none") });
            return panelHTML({
              icon: "zap",
              title: e.label,
              statusHTML: fallback || undefined,
              actionsHTML: buttonHTML({
                label: t("settings.llm.engine.new_profile"),
                icon: "plus",
                size: "sm",
                attrs: { "data-prof-new": e.name },
              }),
              pad: "md",
              bodyHTML:
                `<h3 class="sub-head">${esc(t("settings.llm.engine.default_label"))}</h3>${defHTML}` +
                `<h3 class="sub-head">${esc(t("settings.llm.engine.others_label"))}</h3>${rest}`,
            });
          })
          .join("");
      }

      $("llm-engines").addEventListener("click", (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("button");
        if (!btn) return;
        const d = btn.dataset;
        if (d.profNew) openProfileModal(d.profNew, null, d.asDefault === "1");
        const p = llmProfiles.find(
          (x) => x.id === (d.profEdit || d.profDefault || d.profDel || d.profCheck),
        );
        if (!p) return;
        if (d.profCheck) void recheckProfile(btn, p);
        if (d.profEdit) openProfileModal(p.engine, p, false);
        if (d.profDefault) void makeProfileDefault(btn, p);
        if (d.profDel) void deleteProfile(btn, p);
      });

      async function makeProfileDefault(btn: HTMLButtonElement, p: LLMProfile) {
        const n = followers(p.engine).length;
        const engine = engineLabel(llmEngines, p.engine);
        const ok = await confirmDialog({
          title: t("settings.llm.confirm.make_default_title", { name: p.name, engine }),
          message:
            n > 0
              ? p.model
                ? t("settings.llm.confirm.make_default_switch_model", { count: n })
                : t("settings.llm.confirm.make_default_switch", { count: n })
              : t("settings.llm.confirm.make_default_none"),
          confirmLabel: t("settings.buttons.make_default"),
        });
        if (!ok) return;
        btn.disabled = true;
        try {
          await api.patch(`/llm-profiles/${p.id}`, { is_default: true });
          toast(t("settings.llm.toasts.now_default", { name: p.name, engine }), "ok");
          loadLLM();
        } catch (err: any) {
          toast(err?.message ?? t("settings.llm.errors.default_failed"), "err");
          btn.disabled = false;
        }
      }

      function keyCheckToast(name: string, saved: LLMProfile | null) {
        if (saved?.key_state === "invalid")
          toast(t("settings.llm.toasts.key_invalid", { name }), "err", 6000);
        else if (saved?.key_state === "unreachable")
          toast(t("settings.llm.toasts.key_unreachable", { name }), "err", 6000);
      }

      async function recheckProfile(btn: HTMLButtonElement, p: LLMProfile) {
        btn.disabled = true;
        try {
          const out = await api.post<LLMProfile>(`/llm-profiles/${p.id}/check`, {});
          if (out?.key_state === "valid")
            toast(t("settings.llm.toasts.key_valid", { name: p.name }), "ok");
          else keyCheckToast(p.name, out);
          loadLLM();
        } catch (err: any) {
          toast(err?.message ?? t("settings.llm.errors.check_failed"), "err");
          btn.disabled = false;
        }
      }

      async function deleteProfile(btn: HTMLButtonElement, p: LLMProfile) {
        const bound = p.bound_agents ?? [];
        if (bound.length > 0) {
          toast(
            t("settings.llm.errors.profile_in_use", { name: p.name, agents: bound.join(", ") }),
            "err",
            5000,
          );
          return;
        }
        const ok = await confirmDialog({
          title: t("settings.llm.confirm.delete_title", { name: p.name }),
          message: p.is_default
            ? llmEngines.find((e) => e.name === p.engine)?.host_fallback
              ? t("settings.llm.confirm.delete_default", {
                  engine: engineLabel(llmEngines, p.engine),
                })
              : t("settings.llm.confirm.delete_default_blocked", {
                  engine: engineLabel(llmEngines, p.engine),
                })
            : t("settings.llm.confirm.delete_other"),
          confirmLabel: t("common.buttons.delete"),
          danger: true,
        });
        if (!ok) return;
        btn.disabled = true;
        try {
          await api.del(`/llm-profiles/${p.id}`);
          toast(t("settings.llm.toasts.deleted"), "ok");
          loadLLM();
        } catch (err: any) {
          toast(err?.message ?? t("settings.llm.errors.delete_failed"), "err");
          btn.disabled = false;
        }
      }

      const profModal = $("prof-modal");
      const profForm = $("profile-form") as HTMLFormElement;
      const pf = {
        name: $("prof-name") as HTMLInputElement,
        model: $("prof-model") as HTMLInputElement,
        effort: $("prof-effort") as HTMLSelectElement,
        baseURL: $("prof-base-url") as HTMLInputElement,
        orgID: $("prof-org-id") as HTMLInputElement,
        provider: $("prof-provider") as HTMLSelectElement,
        authHeader: $("prof-auth-header") as HTMLSelectElement,
        region: $("prof-region") as HTMLInputElement,
        project: $("prof-project") as HTMLInputElement,
        smallModel: $("prof-small-model") as HTMLInputElement,
        awsKeyID: $("prof-aws-key-id") as HTMLInputElement,
        awsSecret: $("prof-aws-secret") as HTMLInputElement,
        awsSession: $("prof-aws-session") as HTMLInputElement,
        gcpSA: $("prof-gcp-sa") as HTMLTextAreaElement,
        clearKey: $("prof-clear-key") as HTMLInputElement,
        kind: $("prof-kind") as HTMLSelectElement,
        key: $("prof-key") as HTMLInputElement,
        fedRule: $("prof-fed-rule") as HTMLInputElement,
        fedOrg: $("prof-fed-org") as HTMLInputElement,
        fedSvac: $("prof-fed-svac") as HTMLInputElement,
        fedWS: $("prof-fed-ws") as HTMLInputElement,
        isDefault: $("prof-default") as HTMLInputElement,
        error: $("prof-error"),
        save: $("prof-save-btn") as HTMLButtonElement,
      };
      let profEditing: LLMProfile | null = null;
      let profEngine: EngineInfo | null = null;

      // Escape is handled here because this page has no initKeyboard() Esc cascade.
      const profDialog = bindModal(profModal, {
        onClose: () => {
          profEditing = null;
          profEngine = null;
        },
      });
      document.addEventListener(
        "keydown",
        (ev) => {
          if (ev.key === "Escape" && profDialog.isOpen()) profDialog.close();
        },
        { signal },
      );

      function syncKeyPlaceholder() {
        const prefix = pf.kind.selectedOptions[0]?.dataset.prefix ?? "";
        pf.key.placeholder = keyPlaceholder(profEditing, prefix);
        pf.key.dataset.prefix = prefix;
      }
      pf.kind.addEventListener("change", () => {
        pf.error.hidden = true;
        syncKeyPlaceholder();
        syncProviderFields();
      });

      function federating(): boolean {
        return pf.kind.selectedOptions[0]?.dataset.federated === "1";
      }

      let workloadIdentity: Promise<WorkloadIdentityView | null> | null = null;
      async function showWorkloadIdentity() {
        workloadIdentity ??= api.get<WorkloadIdentityView>("/workload-identity").catch(() => null);
        const wi = await workloadIdentity;
        const ready = Boolean(wi?.configured);
        $("prof-fed-issuer").hidden = !ready;
        $("prof-fed-unconfigured").hidden = ready;
        setText(
          $("prof-fed-unconfigured-text"),
          ready ? "" : (wi?.error ?? t("settings.llm.errors.federation_unavailable")),
        );
        if (!ready || !wi) return;
        setText($("prof-fed-issuer-url"), wi.issuer ?? "");
        setText($("prof-fed-subject"), wi.subject_prefix ?? "");
        setText($("prof-fed-jwks"), JSON.stringify(wi.jwks ?? {}, null, 2));
      }

      function syncProviderFields() {
        const eng = profEngine;
        if (!eng) return;
        const provider = pf.provider.value || eng.provider;
        const cloud = isCloudProvider(provider);
        const vertex = provider === "vertex";
        $("prof-cloud-fields").hidden = !cloud;
        $("prof-project-field").hidden = !vertex;
        $("prof-aws-fields").hidden = provider !== "bedrock";
        $("prof-gcp-field").hidden = !vertex;
        $("prof-base-url-field").hidden = !eng.base_url || cloud;
        $("prof-org-id-field").hidden = !eng.org_id || cloud;
        $("prof-auth-header-field").hidden = !eng.auth_header || cloud || !pf.baseURL.value.trim();
        const fed = !cloud && federating();
        $("prof-key-field").hidden = vertex || fed;
        $("prof-kind-field").hidden = cloud || (eng.key_kinds ?? []).length <= 1;
        $("prof-fed-fields").hidden = !fed;
        if (fed) {
          $("prof-base-url-field").hidden = true;
          $("prof-auth-header-field").hidden = true;
          void showWorkloadIdentity();
        }
        setText(
          $("prof-key-field").querySelector(".field-label"),
          provider === "bedrock"
            ? t("settings.llm.labels.bedrock_key")
            : t("settings.llm.labels.key"),
        );
        if (cloud) {
          pf.key.placeholder = t("settings.llm.placeholders.cloud_key");
          pf.key.dataset.prefix = "";
        } else {
          syncKeyPlaceholder();
        }
        const stored = profEditing?.has_key && profEditing.provider === provider;
        $("prof-clear-key-field").hidden = !cloud || !stored;
        setText(
          $("prof-cloud-hint"),
          cloud
            ? stored
              ? t("settings.llm.hints.cloud_keep")
              : t("settings.llm.hints.cloud_identity")
            : "",
        );
      }
      pf.provider.addEventListener("change", () => {
        pf.error.hidden = true;
        syncEngineLine();
        syncProviderFields();
      });
      pf.baseURL.addEventListener("input", syncProviderFields);

      function syncEngineLine() {
        const eng = profEngine;
        if (!eng) return;
        setText(
          $("prof-engine-line"),
          t("settings.llm.modal.engine_line", {
            engine: eng.label,
            provider: providerLabel(pf.provider.value || eng.provider),
          }),
        );
      }

      function openProfileModal(engineName: string, p: LLMProfile | null, asDefault: boolean) {
        const eng = llmEngines.find((e) => e.name === engineName);
        if (!eng) return;
        profEditing = p;
        profEngine = eng;
        const hasDefault = llmProfiles.some((x) => x.engine === eng.name && x.is_default);

        setText($("prof-modal-title"), profileModalTitle(eng.label, p, asDefault, hasDefault));
        pf.name.value = prefilledProfileName(eng.name, llmProfiles, p, asDefault, hasDefault);

        pf.model.value = p?.model ?? "";
        const models = eng.models ?? [];
        pf.model.placeholder = modelPlaceholder(models);
        $("prof-models").innerHTML = models
          .map((m) => `<option value="${esc(m)}"></option>`)
          .join("");

        $("prof-effort-field").hidden = !eng.effort;
        pf.effort.value = p?.effort ?? "";
        pf.baseURL.value = p?.base_url ?? "";
        pf.orgID.value = p?.org_id ?? "";

        const providers = eng.providers?.length ? eng.providers : [eng.provider];
        pf.provider.innerHTML = providers
          .map((x) => `<option value="${esc(x)}">${esc(providerLabel(x))}</option>`)
          .join("");
        pf.provider.value = p?.provider || eng.provider;
        $("prof-provider-field").hidden = providers.length <= 1;
        pf.authHeader.value = p?.auth_header === "bearer" ? "bearer" : "";
        pf.region.value = p?.region ?? "";
        pf.project.value = p?.project_id ?? "";
        pf.smallModel.value = p?.small_fast_model ?? "";
        for (const el of [pf.awsKeyID, pf.awsSecret, pf.awsSession, pf.gcpSA]) el.value = "";
        pf.clearKey.checked = false;

        const kinds = eng.key_kinds ?? [];
        pf.kind.innerHTML = kinds
          .map(
            (k) =>
              `<option value="${esc(k.id)}" data-prefix="${esc(k.prefix)}"${k.federated ? ' data-federated="1"' : ""}>${esc(k.label)}</option>`,
          )
          .join("");
        const fedKind = kinds.find((k) => k.federated);
        if (p?.federation && fedKind) pf.kind.value = fedKind.id;
        pf.fedRule.value = p?.federation?.federation_rule_id ?? "";
        pf.fedOrg.value = p?.federation?.organization_id ?? "";
        pf.fedSvac.value = p?.federation?.service_account_id ?? "";
        pf.fedWS.value = p?.federation?.workspace_id ?? "";
        pf.key.value = "";
        syncEngineLine();
        syncKeyPlaceholder();
        syncProviderFields();

        // The current default can't be unticked: it stops being default only when another profile
        // takes over, else the engine falls back to the host credential.
        pf.isDefault.checked = p ? !!p.is_default : asDefault || !hasDefault;
        pf.isDefault.disabled = !!p?.is_default;
        setText(
          $("prof-default-label"),
          p?.is_default
            ? t("settings.llm.labels.default_for_locked", { engine: eng.label })
            : t("settings.llm.labels.default_for", { engine: eng.label }),
        );

        pf.error.hidden = true;
        setText(pf.save, p ? t("common.buttons.save") : t("settings.llm.modal.create"));
        pf.save.disabled = false;
        profDialog.open(p ? pf.model : pf.name);
      }

