  <style is:global>
    /* Page-owned styles.
       `is:global` because the pollers build most of the rows below with
       innerHTML, and a scoped rule never reaches markup no Astro template
       saw. Shared pieces live elsewhere: `.page` (styles/page.css), the
       `.page-head` trio (PageHead.astro), the tables (Table.astro), the list
       rows (ListRow, listRowHTML()) and `.panel-head-actions`, `.form-error`,
       `.code-inline`, `.select-sm` (styles/primitives/). */

    /* ── Prose ── */
    /* Secondary prose: the empty states, the one-line notes under a control.
       Also written on credentials.astro, which declares it nowhere — see
       COMPONENTS.md before promoting this to styles/base.css. */
    .small {
      font-size: var(--t-sm);
    }

    /* ── Form ── */
    /* The fields are the form primitives (styles/primitives/form.css). */
    /* styles/base.css already gives .grow its flex: 1. */
    .form-row .grow {
      min-width: 200px;
    }
    /* A help line under a row of controls that is not a field (the ingest
       address, the key form): the gap a field would give it. */
    .control-help {
      margin-top: var(--s-2);
    }
    /* An input and the button that acts on it, wrapping on a narrow panel. */
    .control-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }

    /* ── Events ── */
    .wh-events-pick {
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .wh-events-pick > legend {
      margin-bottom: var(--s-2);
    }
    /* The specific events sit under the wildcard; ticking it dims them. */
    #events-specific {
      margin-top: var(--s-3);
    }

    /* ── Webhook list ── */
    /* The endpoints panel is flush, so the secret shown above the list brings
       the row's own inset. */
    .wh-callout {
      margin: var(--s-3) var(--s-4);
    }

    /* ── Audit table ── */
    /* The quieter cells of the log (columns in lib/audit-view.ts). */
    td.audit-time {
      font-size: var(--t-xs);
      color: var(--fg-3);
    }
    td.audit-actor,
    td.audit-resource {
      font-size: var(--t-xs);
      color: var(--fg-2);
    }
    td.audit-summary {
      color: var(--fg-2);
      line-height: var(--lh-snug);
    }
    .load-more-row {
      display: flex;
      justify-content: center;
      padding: var(--s-3);
    }

    /* ── Settings grid ── */
    .settings-grid {
      display: grid;
      gap: var(--s-4);
      grid-template-columns: 1fr 1fr;
    }
    /* A panel whose rows carry a long second line (API keys, run keys) takes
       the grid's whole width instead of wrapping it into five. */
    .settings-grid > .grid-span {
      grid-column: 1 / -1;
    }
    @media (max-width: 700px) {
      .settings-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ── API keys ── */
    .key-form {
      margin-bottom: var(--s-3);
    }
    .perm-picker {
      margin-bottom: var(--s-3);
    }
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
      margin-bottom: var(--s-2);
    }
    .preset-label {
      font-size: var(--t-xs);
    }
    .key-reveal {
      margin-bottom: var(--s-4);
    }

    /* ── Updates ── */
    .upd-facts {
      margin: 0 0 var(--s-3);
    }
    .upd-advisories {
      margin-top: var(--s-3);
    }
    /* The callouts the summary stacks under the facts. */
    #upd-summary .callout {
      margin-top: var(--s-3);
    }
    .upd-list {
      margin: var(--s-1) 0 var(--s-2);
      padding-left: var(--s-5);
    }
    .upd-rel + .upd-rel {
      margin-top: var(--s-4);
      padding-top: var(--s-4);
      border-top: 1px solid var(--line);
    }
    .upd-rel-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
      margin-bottom: var(--s-2);
    }
    .upd-notes {
      max-height: 320px;
      overflow: auto;
      margin: var(--s-2) 0;
      font-size: var(--t-sm);
    }
    .upd-cmd {
      margin: var(--s-2) 0;
    }
    .upd-rel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    .upd-detail {
      margin-top: var(--s-1);
    }
    /* Stacked into cards on a phone (UPDATES_TABLE), the cell with a command
       or a reported log takes the card's whole width. */
    @media (max-width: 640px) {
      .list-table-stack td.upd-wide {
        grid-column: 1 / -1;
      }
    }
    #upd-unreported .callout {
      margin: 0 0 var(--s-3);
    }
    .upd-rel .callout {
      margin: var(--s-2) 0;
    }

    /* ── Retention ── */
    .ret-rows {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: var(--s-2) var(--s-4);
      align-items: center;
      margin: var(--s-3) 0;
    }
    .ret-row {
      display: contents;
    }
    .ret-input {
      width: 6em;
    }
    .ret-default {
      font-size: var(--t-sm);
    }
    /* A row's error spans the grid under the row it is about. */
    .ret-row-error {
      grid-column: 1 / -1;
      margin-top: calc(-1 * var(--s-1));
    }
    @media (max-width: 640px) {
      .ret-rows {
        grid-template-columns: minmax(0, 1fr) auto;
      }
      .ret-default {
        grid-column: 1 / -1;
        margin-top: calc(-1 * var(--s-1));
      }
    }
    .key-error {
      margin-bottom: var(--s-3);
    }
    .key-warning {
      margin-bottom: var(--s-2);
    }
    /* The strip a key's Rotate opens under its row: a small Field and its
       buttons, lined up on the select. */
    .key-rotate {
      display: flex;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    /* The specific events while the wildcard is ticked: still listed, plainly
       not what gets sent. */
    .is-dim {
      opacity: 0.5;
    }

    /* ── EE / license ── */
    .license-features {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-1);
    }
    .license-ce-note {
      margin-top: var(--s-3);
    }

    /* ── AI engines ── */
    .llm-intro {
      font-size: var(--t-sm);
      line-height: var(--lh-loose);
      max-width: 72ch;
      margin-bottom: var(--s-4);
    }
    .llm-cross {
      margin-bottom: var(--s-4);
    }
    /* The lines under a profile's name: what it runs, what the provider
       said when it refused the key (.text-warn or .text-danger), and who
       uses it. */
    .prof-line,
    .prof-note {
      display: block;
    }
    .prof-used {
      color: var(--fg-4);
    }

    /* ── Team member rows ── */
    /* The bar stacks its notes over the form with air between them, so a
       callout (read-only, seats full) never sits on the first label. */
    .invite-bar {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
      padding: var(--s-3);
      border-bottom: 1px solid var(--line);
    }
    .login-config {
      margin: var(--s-3) 0 0;
    }
    .invite-hint {
      max-width: 72ch;
    }
    /* The owner's role, where the other rows have a selector: the words a
       .select-sm would show, at its size and inset, so the column lines up. */
    .member-role-fixed {
      font-size: var(--t-sm);
      color: var(--fg-2);
      padding: 0 var(--s-3);
    }
    /* Why the owner's row has no selector, under its meta line. */
    .member-owner-note {
      color: var(--fg-2);
    }
  </style>

  <script>
