        const body = document.querySelector<HTMLElement>(".license-body")!;
        const badge = $("license-badge") as HTMLElement;
        try {
          const info = await fetchInfo();
          const ee = isEE(info);
          setBadge(
            badge,
            ee ? t("settings.edition.enterprise") : t("settings.edition.community"),
            ee ? "ok" : "neutral",
          );

          let expires: string | undefined;
          if (info.license_expires_at) {
            const { days, expired, warn } = expiryState(info.license_expires_at);
            const dateStr = new Date(info.license_expires_at).toLocaleDateString(locale);
            const suffix =
              days === null
                ? ""
                : expired
                  ? ` <span class="text-warn">${esc(t("settings.health.license.expired"))}</span>`
                  : ` <span class="${warn ? "text-warn" : "muted"}">${esc(t("settings.health.license.expires_in", { count: days }))}</span>`;
            expires = `${esc(dateStr)}${suffix}`;
          }
          const features = Array.isArray(info.features) ? info.features : [];
          const chips = features.length
            ? `<span class="license-features">${features.map((f) => tagHTML(f, { mono: true, size: "sm" })).join("")}</span>`
            : undefined;

          let html = factsHTML([
            {
              label: t("settings.health.license.edition"),
              value: ee ? t("settings.edition.enterprise_ee") : t("settings.edition.community_ce"),
