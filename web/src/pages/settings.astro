      interface Member {
        workspace_id: string;
        user_id: string;
        email: string;
        name: string;
        role: string;
        invited_at: string;
        owner?: boolean;
      }

      let currentWorkspaceID = "";
      let teamManage = true;
      let myUserID = "";

      async function getWorkspaceID(): Promise<string> {
        if (currentWorkspaceID) return currentWorkspaceID;
        try {
          const me = await api.get<{ workspace_id?: string }>("/auth/me");
          currentWorkspaceID = me.workspace_id || "default";
        } catch {
          currentWorkspaceID = "default";
        }
        return currentWorkspaceID;
      }

      function memberMeta(m: Member): string {
        const invAt = m.invited_at ? new Date(m.invited_at).toLocaleDateString(locale) : "";
        return m.name
          ? t("settings.team.members.joined_named", { name: m.name, date: invAt })
          : t("settings.team.members.joined", { date: invAt });
      }

      function createMemberRow(m: Member): HTMLElement {
        const base = {
          leadHTML: avatarHTML({ size: "md", name: memberInitials(m) }),
          title: m.email || m.user_id,
          meta: memberMeta(m),
        };
        if (m.owner) {
          const row = elFrom(
            listRowHTML({
              ...base,
              actionsHTML: `<span class="member-role-fixed">${esc(t("settings.roles.owner"))}</span>`,
            }),
          );
          row.querySelector(".row-main")!.appendChild(ownerNote(m));
          updateMemberRow(row, m, null);
          return row;
        }
        // "owner" appears only for members granted it by role before the daemon refused that, so
        // the selector shows the truth.
        const strayOwner =
          m.role === "owner"
            ? `<option value="owner" disabled>${esc(t("settings.roles.owner"))}</option>`
            : "";
        const row = elFrom(
          listRowHTML({
            ...base,
            actionsHTML: `<span class="member-role-fixed" hidden></span>
          <select class="select-sm member-role-select" aria-label="${esc(t("settings.labels.role"))}">
            ${strayOwner}
            <option value="admin">${esc(t("settings.roles.admin"))}</option>
            <option value="developer">${esc(t("settings.roles.developer"))}</option>
            <option value="viewer">${esc(t("settings.roles.viewer"))}</option>
          </select>
          ${buttonHTML({ label: t("settings.team.members.remove_aria"), title: t("common.buttons.remove"), icon: "trash", iconOnly: true, size: "sm", variant: "danger", cls: "remove-member-btn" })}`,
          }),
        );

        const roleSelect = row.querySelector<HTMLSelectElement>(".member-role-select")!;
        roleSelect.value = m.role;
        roleSelect.addEventListener("change", async () => {
          const who = m.email || m.user_id;
          const ok = await confirmDialog({
            title: t("settings.team.members.role_change_title", { email: who }),
            message: t("settings.team.members.role_change_message", {
              email: who,
              role: roleLabel(roleSelect.value),
            }),
            confirmLabel: t("settings.team.members.role_change_confirm"),
          });
          if (!ok) {
            roleSelect.value = m.role;
            return;
          }
          const wsID = await getWorkspaceID();
          try {
            await api.patch(`/auth/workspaces/${wsID}/members/${m.user_id}`, {
              role: roleSelect.value,
            });
            toast(t("settings.team.members.role_updated"), "ok");
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.members.role_failed"),
              "err",
            );
            roleSelect.value = m.role;
          }
        });

        const removeBtn = row.querySelector<HTMLButtonElement>(".remove-member-btn")!;
        removeBtn.addEventListener("click", () => void openMemberRemove(m));

        updateMemberRow(row, m, null);
        return row;
      }

      function ownerNote(m: Member): HTMLElement {
        const note = document.createElement("span");
        note.className = "row-meta member-owner-note";
        if (myUserID && m.user_id === myUserID) {
          const [before, , after] = tParts("settings.team.members.owner_fixed_self", {
            link: SLOT,
          });
          const link = document.createElement("a");
          link.href = "#account";
          link.textContent = t("settings.account.workspaces.transfer");
          note.append(before ?? "", link, after ?? "");
        } else {
          note.textContent = t("settings.team.members.owner_fixed_other");
        }
        return note;
      }

      function updateMemberRow(el: HTMLElement, m: Member, _prev: Member | null) {
        setText(el.querySelector(".avatar"), memberInitials(m));
        setText(el.querySelector(".row-title"), m.email || m.user_id);
        setText(el.querySelector(".row-meta"), memberMeta(m));
        const sel = el.querySelector<HTMLSelectElement>(".member-role-select");
        if (sel) {
          sel.value = m.role;
          sel.hidden = !teamManage;
          (el.querySelector(".remove-member-btn") as HTMLElement).hidden = !teamManage;
          const fixed = el.querySelector<HTMLElement>(".member-role-fixed")!;
          fixed.hidden = teamManage;
          setText(fixed, roleLabel(m.role));
        }
      }

      async function openMemberRemove(m: Member) {
        let live: number | null = null;
        try {
          live = liveKeysBy(await api.get<KeyLite[]>("/auth/api-keys"), m.user_id);
        } catch {
          // The key list is for admins with key management.
        }
        let revoked = false;
        const remove = async (revoke: boolean) => {
          const wsID = await getWorkspaceID();
          try {
            await api.del(
              `/auth/workspaces/${wsID}/members/${m.user_id}${revoke ? "?revoke_keys=1" : ""}`,
            );
          } catch (err) {
            throw new Error(
              err instanceof ApiError ? err.message : t("settings.team.members.remove_failed"),
              { cause: err },
            );
          }
          revoked = revoke;
        };
        const ask = {
          title: t("settings.team.members.remove_title"),
          message: t("settings.team.members.remove_message", { user: m.email || m.user_id }),
          confirmLabel: t("common.buttons.remove"),
          danger: true,
        };
        const option = revokeKeysOption(live);
        const ok = option
          ? (
              await confirmDialog({
                ...ask,
                option,
                action: (values) => remove(values.revoke_keys === true),
              })
            ).ok
          : await confirmDialog({ ...ask, action: () => remove(false) });
        if (!ok) return;
        toast(
          revoked ? t("settings.team.members.removed_keys") : t("settings.team.members.removed"),
          "ok",
        );
        await loadTeam();
      }

      let inviteSeatsFull = false;
      async function loadSeats(wsID: string) {
        const pill = $("team-seats") as HTMLElement;
        let seats: Seats | null = null;
        try {
          seats = await api.get<Seats>(`/auth/workspaces/${encodeURIComponent(wsID)}/seats`);
        } catch {
          seats = null;
        }
        const text = seatsText(seats);
        setCount(pill, text, { pill: true, title: t("settings.team.members.seats_hint") });
        pill.hidden = !text;
        const full = teamManage && seatsFull(seats);
        inviteSeatsFull = full;
        const note = $("team-seats-full") as HTMLElement;
        note.hidden = !full;
        if (full && seats) {
          setText(
            $("team-seats-full-text"),
            t("settings.team.members.seats_full", { limit: seats.limit }),
          );
        }
        $("invite-form")
          .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>(
            "input, select, button",
          )
          .forEach((el) => {
            el.disabled = full;
          });
      }

      const LICENSE_HIDDEN_KEY = "octopus.license-notice.hidden-at";
      async function loadLicenseSeats(wsID: string) {
        const note = $("team-license") as HTMLElement;
        note.hidden = true;
        if (!teamManage) return;
        if (
          licenseNoticeHidden(Number(localStorage.getItem(LICENSE_HIDDEN_KEY)) || 0, Date.now())
        ) {
          return;
        }
        let seats: LicenseSeats | null = null;
        try {
          seats = await api.get<LicenseSeats>(
            `/auth/workspaces/${encodeURIComponent(wsID)}/license-seats`,
          );
        } catch {
          seats = null;
        }
        const text = licenseSeatsText(seats);
        setText($("team-license-text"), text);
        note.hidden = !text;
      }
      $("team-license-hide").addEventListener("click", () => {
        localStorage.setItem(LICENSE_HIDDEN_KEY, String(Date.now()));
        ($("team-license") as HTMLElement).hidden = true;
      });

      const delegBox = $("deleg-enabled") as HTMLInputElement;
      async function loadDelegationPolicy() {
        try {
          const p = await api.get<{ enabled: boolean }>("/chat-delegation");
          delegBox.checked = p.enabled;
          delegBox.disabled = false;
        } catch {
          delegBox.disabled = true;
        }
      }
      delegBox.addEventListener("change", async () => {
        const want = delegBox.checked;
        delegBox.disabled = true;
        try {
          await api.put("/chat-delegation", { enabled: want });
          toast(
            want ? t("settings.team.delegation.allowed") : t("settings.team.delegation.turned_off"),
            "ok",
          );
        } catch (e) {
          delegBox.checked = !want;
          toast(
            e instanceof ApiError ? e.message : t("settings.team.delegation.change_failed"),
            "err",
            6000,
          );
        } finally {
          delegBox.disabled = false;
        }
      });

      interface AllowlistEntry {
        email: string;
        note: string;
        added_by: string;
        created_at: string;
        source: "list" | "env";
      }

      function createBetaRow(e: AllowlistEntry): HTMLElement {
        const row = elFrom(
          listRowHTML({
            title: e.email,
            meta: betaMeta(e),
            actions: [
              {
                label: t("settings.team.beta.remove_aria"),
                title: t("common.buttons.remove"),
                icon: "trash",
                iconOnly: true,
                variant: "danger",
              },
            ],
          }),
        );
        const removeBtn = row.querySelector<HTMLButtonElement>("button")!;
        removeBtn.addEventListener("click", async () => {
          const ok = await confirmDialog({
            title: t("settings.team.beta.remove_title"),
            message: t("settings.team.beta.remove_message", { email: e.email }),
            confirmLabel: t("common.buttons.remove"),
            danger: true,
          });
          if (!ok) return;
          removeBtn.disabled = true;
          try {
            await api.del(`/auth/signup-allowlist/${encodeURIComponent(e.email)}`);
            toast(t("settings.team.beta.removed"), "ok");
            await loadBetaAccess();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.beta.remove_failed"),
              "err",
            );
            removeBtn.disabled = false;
          }
        });
        updateBetaRow(row, e);
        return row;
      }

      function betaMeta(e: AllowlistEntry): string {
        if (e.source === "env") {
          return t("settings.team.beta.from_env", { env: "OCTOPUS_SSO_ALLOWED_EMAILS" });
        }
        const date = e.created_at ? new Date(e.created_at).toLocaleDateString(locale) : "";
        const meta = t("settings.team.beta.added", { by: e.added_by || "—", date });
        return e.note ? `${e.note} · ${meta}` : meta;
      }

      function updateBetaRow(el: HTMLElement, e: AllowlistEntry) {
        setText(el.querySelector(".row-title"), e.email);
        setText(el.querySelector(".row-meta"), betaMeta(e));
        // Env-seeded emails (OCTOPUS_SSO_ALLOWED_EMAILS) change only on restart; deleting them
        // returns 409.
        (el.querySelector("button") as HTMLButtonElement).hidden = e.source === "env";
      }

      function createWaitingRow(e: WaitingEntry): HTMLElement {
        const row = elFrom(
          listRowHTML({
            leadHTML: avatarHTML({ size: "md", pending: true }),
            title: e.email,
            meta: waitingMetaOf(e),
            actions: [
              { label: t("settings.team.beta.grant"), cls: "waiting-grant" },
              {
                label: t("settings.team.beta.dismiss_aria"),
                title: t("settings.team.beta.dismiss"),
                icon: "x",
                iconOnly: true,
                cls: "waiting-dismiss",
                attrs: { hidden: true },
              },
            ],
          }),
        );
        const dismiss = row.querySelector<HTMLButtonElement>(".waiting-dismiss")!;
        dismiss.addEventListener("click", async () => {
          dismiss.disabled = true;
          try {
            await api.del(`/auth/signup-requests/${encodeURIComponent(e.email)}`);
            toast(t("settings.team.beta.dismissed"), "ok");
            await loadBetaAccess();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.beta.dismiss_failed"),
              "err",
            );
            dismiss.disabled = false;
          }
        });
        const grant = row.querySelector<HTMLButtonElement>(".waiting-grant")!;
        grant.addEventListener("click", async () => {
          grant.disabled = true;
          try {
            await api.post("/auth/signup-allowlist", {
              email: e.email,
              note: e.requested
                ? t("settings.team.beta.requested_note")
                : t("settings.team.beta.waiting_meta", { workspaces: e.workspaces.join(", ") }),
            });
            toast(t("settings.team.beta.granted", { email: e.email }), "ok");
            await loadBetaAccess();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.beta.add_failed"),
              "err",
            );
            grant.disabled = false;
          }
        });
        updateWaitingRow(row, e);
        return row;
      }

      function waitingMetaOf(e: WaitingEntry): string {
        const date = e.invited_at ? new Date(e.invited_at).toLocaleDateString(locale) : "";
        return waitingMeta(e, date);
      }

      function updateWaitingRow(el: HTMLElement, e: WaitingEntry) {
        setText(el.querySelector(".row-title"), e.email);
        setText(el.querySelector(".row-meta"), waitingMetaOf(e));
        (el.querySelector(".waiting-dismiss") as HTMLElement).hidden = !e.requested;
      }

      function renderWaiting(waiting: WaitingEntry[]) {
        ($("beta-waiting") as HTMLElement).hidden = waiting.length === 0;
        setCount($("beta-waiting-count"), waiting.length, { pill: true });
        reconcile<WaitingEntry>({
          container: $("beta-waiting-list"),
          items: waiting,
          key: (e) => e.email,
          create: createWaitingRow,
          update: updateWaitingRow,
        });
      }

      async function loadLoginConfig() {
        const panel = $("login-config-panel") as HTMLElement;
        if (!(await sessionInfo())?.operator) {
          panel.hidden = true;
          return;
        }
        panel.hidden = false;
        const list = $("login-config-list");
        try {
          const lines = loginConfigLines(await api.get<LoginConfig>("/auth/login-config"));
          list.innerHTML = factsHTML(
            lines.map((l) => ({
              label: l.label,
              valueHTML: `${esc(l.value)}<span class="fact-list-note"><code>${esc(l.env)}</code></span>`,
            })),
          );
        } catch (err) {
          const msg = err instanceof ApiError ? err.message : t("settings.team.login.load_failed");
          list.innerHTML = emptyRowHTML(msg, { as: "div", tone: "danger" });
        }
      }

      async function loadBetaAccess() {
        const panel = $("beta-panel") as HTMLElement;
        if (!(await sessionInfo())?.operator) {
          panel.hidden = true;
          return;
        }
        panel.hidden = false;
        const ct = $("beta-list");
        try {
          const res = await api.get<{
            mode: string;
            entries: AllowlistEntry[];
            waiting?: WaitingEntry[];
          }>("/auth/signup-allowlist");
          renderWaiting(res.waiting ?? []);
          setCount($("beta-count"), res.entries.length, { pill: true });
          setText(
            $("beta-mode"),
            res.mode === "allowlist"
              ? t("settings.team.beta.mode_allowlist")
              : t("settings.team.beta.mode_open", { env: "OCTOPUS_SIGNUP_MODE" }),
          );
          if (res.entries.length === 0) {
            ct.innerHTML = emptyRowHTML(t("settings.team.beta.empty"), { as: "div" });
            return;
          }
          // reconcile only touches keyed rows; remove the shipped "Loading…" placeholder first.
          ct.querySelector(".row-empty")?.remove();
          reconcile<AllowlistEntry>({
            container: ct,
            items: res.entries,
            key: (e) => e.email,
            create: createBetaRow,
            update: updateBetaRow,
          });
        } catch (err) {
          const msg = err instanceof ApiError ? err.message : t("settings.team.beta.load_failed");
          ct.innerHTML = emptyRowHTML(msg, { as: "div", tone: "danger" });
        }
      }

      const betaEmail = $("beta-email") as HTMLInputElement;
      const betaNote = $("beta-note") as HTMLInputElement;
      const betaSubmit = $("beta-submit") as HTMLButtonElement;
      const { show: showBetaError, hide: hideBetaError } = bindError(
        $("beta-error") as HTMLElement,
      );

      ($("beta-form") as HTMLFormElement).addEventListener("submit", async (e) => {
        e.preventDefault();
        hideBetaError();
        const email = betaEmail.value.trim();
        if (!email) {
          showBetaError(t("settings.team.invite.email_required"));
          return;
        }
        betaSubmit.disabled = true;
        try {
          await api.post("/auth/signup-allowlist", { email, note: betaNote.value.trim() });
          betaEmail.value = "";
          betaNote.value = "";
          toast(t("settings.team.beta.added_toast"), "ok");
          await loadBetaAccess();
        } catch (err) {
          showBetaError(err instanceof ApiError ? err.message : t("settings.team.beta.add_failed"));
        } finally {
          betaSubmit.disabled = false;
        }
      });

      async function loadTeam() {
        void loadWorkspaceName();
        void loadDelegationPolicy();
        void loadBetaAccess();
        void loadLoginConfig();
        const info = await sessionInfo();
        myUserID = info?.user?.id ?? "";
        teamManage = !info?.role || canInvite(info.role);
        ($("team-readonly") as HTMLElement).hidden = teamManage;
        ($("invite-form") as HTMLElement).hidden = !teamManage;
        const wsID = await getWorkspaceID();
        void loadSeats(wsID);
        void loadLicenseSeats(wsID);
        try {
          const members = await api.get<Member[]>(`/auth/workspaces/${wsID}/members`);
          setCount($("team-count"), members.length, { pill: true });
          const ct = $("team-list");
          if (members.length === 0) {
            ct.innerHTML = emptyRowHTML(t("settings.team.members.empty"), { as: "div" });
            return;
          }
          ct.querySelector(".row-empty")?.remove();
          reconcile<Member>({
            container: ct,
            items: members,
            // The owner row is built differently, so the key changes on transfer to force a
            // rebuild.
            key: (m) => `${m.user_id}${m.owner ? ":owner" : ""}`,
            create: createMemberRow,
            update: updateMemberRow,
          });
          void loadPending(wsID);
        } catch (err) {
          const ct = $("team-list");
          const msg =
            err instanceof ApiError ? err.message : t("settings.team.members.load_failed");
          ct.innerHTML = emptyRowHTML(msg, { as: "div", tone: "danger" });
        }
      }

      function createPendingRow(inv: Invitation): HTMLElement {
        const row = elFrom(
          listRowHTML({
            leadHTML: avatarHTML({ size: "md", pending: true }),
            title: inv.email,
            metaHTML: pendingMetaHTML(inv),
            actionsHTML: `<select class="select-sm member-role-select" aria-label="${esc(t("settings.labels.role"))}">
              <option value="admin">${esc(t("settings.roles.admin"))}</option>
              <option value="developer">${esc(t("settings.roles.developer"))}</option>
              <option value="viewer">${esc(t("settings.roles.viewer"))}</option>
            </select>
            ${buttonHTML({ label: t("settings.team.pending.copy_link"), icon: "link", size: "sm", cls: "pending-copy", attrs: { "aria-label": t("settings.team.pending.copy_link_named", { email: inv.email }) } })}
            ${buttonHTML({ label: t("settings.team.pending.cancel"), icon: "x", iconOnly: true, size: "sm", variant: "danger", cls: "pending-cancel" })}`,
          }),
        );

        const roleSelect = row.querySelector<HTMLSelectElement>(".member-role-select")!;
        roleSelect.addEventListener("change", async () => {
          const prev = roleSelect.dataset.role ?? "";
          try {
            await setInvitationRole(inv.workspace_id, inv.id, roleSelect.value);
            roleSelect.dataset.role = roleSelect.value;
            toast(t("settings.team.members.role_updated"), "ok");
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.members.role_failed"),
              "err",
            );
            roleSelect.value = prev;
          }
        });

        row
          .querySelector<HTMLButtonElement>(".pending-copy")!
          .addEventListener("click", async () => {
            const ok = await copyText(invitationLink(window.location.origin, inv.id));
            if (ok) toast(t("settings.team.pending.link_copied"), "ok");
            else toast(t("settings.team.pending.copy_failed"), "err");
          });

        const cancelBtn = row.querySelector<HTMLButtonElement>(".pending-cancel")!;
        cancelBtn.addEventListener("click", async () => {
          const ok = await confirmDialog({
            title: t("settings.team.pending.cancel_title", { email: inv.email }),
            message: t("settings.team.pending.cancel_message", { email: inv.email }),
            confirmLabel: t("settings.team.pending.cancel"),
            danger: true,
          });
          if (!ok) return;
          cancelBtn.disabled = true;
          try {
            await cancelInvitation(inv.workspace_id, inv.id);
            toast(t("settings.team.pending.canceled"), "ok");
            await loadTeam();
          } catch (err) {
            toast(
              err instanceof ApiError ? err.message : t("settings.team.pending.cancel_failed"),
              "err",
            );
            cancelBtn.disabled = false;
          }
        });

        updatePendingRow(row, inv);
        return row;
      }

      function pendingMetaHTML(inv: Invitation): string {
        const date = inv.created_at ? new Date(inv.created_at).toLocaleDateString(locale) : "";
        const badge = inv.awaiting_access
          ? badgeHTML(t("settings.team.pending.awaiting"), "warn")
          : badgeHTML(t("settings.team.pending.badge"));
        const by = inv.invited_by
          ? t("settings.team.pending.invited_by", { by: inv.invited_by, date })
          : t("settings.team.pending.invited_on", { date });
        return `${badge} ${esc(by)}`;
      }

      function updatePendingRow(el: HTMLElement, inv: Invitation) {
        setText(el.querySelector(".row-title"), inv.email);
        el.querySelector(".row-meta")!.innerHTML = pendingMetaHTML(inv);
        const sel = el.querySelector<HTMLSelectElement>(".member-role-select")!;
        sel.value = inv.role;
        sel.dataset.role = inv.role;
        sel.hidden = !teamManage;
        (el.querySelector(".pending-copy") as HTMLElement).hidden = !teamManage;
        (el.querySelector(".pending-cancel") as HTMLElement).hidden = !teamManage;
      }

      async function loadPending(wsID: string) {
        const box = $("team-pending") as HTMLElement;
        let invs: Invitation[];
        try {
          invs = await listInvitations(wsID);
        } catch {
          return;
        }
        box.hidden = invs.length === 0;
        setCount($("team-pending-count"), invs.length, { pill: true });
        reconcile<Invitation>({
          container: $("team-pending-list"),
          items: invs,
          key: (i) => i.id,
          create: createPendingRow,
          update: updatePendingRow,
        });
      }

      const inviteForm = $("invite-form") as HTMLFormElement;
      const inviteEmail = $("invite-email") as HTMLInputElement;
      const inviteRole = $("invite-role") as HTMLSelectElement;
      const inviteError = $("invite-error") as HTMLElement;
      const inviteSubmit = $("invite-submit") as HTMLButtonElement;

      const { show: showInviteError, hide: hideInviteError } = bindError(inviteError);

      inviteForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideInviteError();
        const email = inviteEmail.value.trim();
        if (!email) {
          showInviteError(t("settings.team.invite.email_required"));
          return;
        }
        const role = inviteRole.value || "developer";
        inviteSubmit.disabled = true;
        try {
          const wsID = await getWorkspaceID();
          const res = await addMember(wsID, email, role);
          inviteEmail.value = "";
          inviteRole.value = "developer";
          if (res.status === "invited") {
            const key = res.invitation.awaiting_access
              ? "settings.team.invite.invited_waiting"
              : "settings.team.invite.invited";
            toast(t(key, { email: res.invitation.email }), "ok", 6000);
          } else {
            toast(t("settings.team.invite.added"), "ok");
          }
          await loadTeam();
        } catch (err) {
          showInviteError(err instanceof ApiError ? err.message : t("settings.team.invite.failed"));
        } finally {
          // The send may have taken the last seat: loadSeats (via loadTeam) decides whether the
          // button stays off.
          inviteSubmit.disabled = inviteSeatsFull;
        }
      });

      async function loadAccount() {
        const profileEl = $("account-profile") as HTMLElement;
        try {
          const me = await api.get<SessionInfo>("/auth/me");
          profileEl.innerHTML = factsHTML([
            { label: t("settings.account.profile.email"), value: me.user?.email || "—" },
            { label: t("settings.account.profile.name"), value: me.user?.name || "—" },
            {
              label: t("settings.account.profile.workspace"),
              value: me.workspace_name || me.workspace_id || "—",
            },
            { label: t("settings.labels.role"), value: me.role ? roleLabel(me.role) : "—" },
          ]);
        } catch {
          profileEl.innerHTML = emptyRowHTML(t("settings.account.profile.signed_out"), {
            as: "div",
          });
        }
      }

      interface Session {
        family_id: string;
        workspace_id: string;
        started_at: string;
        last_used_at: string;
        device_ua: string;
        device_ip: string;
        is_current: boolean;
      }

      async function loadSessions() {
        const body = $("sessions-list");
        try {
          const sessions = await api.get<Session[]>("/auth/sessions");
          if (!sessions.length) {
            body.innerHTML = emptyRowHTML(t("settings.account.sessions.empty"), { as: "div" });
            return;
          }
          body.innerHTML = "";
          for (const s of sessions) {
            const when = t("settings.account.sessions.times", {
              started: fmtDate(s.started_at),
              last_used: fmtDate(s.last_used_at),
            });
            const row = elFrom(
              listRowHTML({
                title: deviceLabel(s.device_ua),
                badgesHTML: s.is_current
                  ? badgeHTML(t("settings.account.sessions.this_device"), "accent")
                  : "",
                meta: [s.device_ip, when].filter(Boolean).join(" · "),
                actions: [{ label: t("settings.account.sessions.sign_out") }],
              }),
            );
            const btn = row.querySelector<HTMLButtonElement>(".row-actions button")!;
            btn.addEventListener("click", async () => {
              btn.disabled = true;
              try {
                await api.del(`/auth/sessions/${s.family_id}`);
                toast(t("settings.account.sessions.signed_out"), "ok");
                loadSessions();
              } catch (err) {
                btn.disabled = false;
                toast(
                  err instanceof ApiError
                    ? err.message
                    : t("settings.account.sessions.sign_out_failed"),
                  "err",
                );
              }
            });
            body.appendChild(row);
          }
        } catch {
          body.innerHTML = emptyRowHTML(t("settings.account.sessions.signed_out_state"), {
            as: "div",
          });
        }
      }

      const revokeAllBtn = $("sessions-revoke-all") as HTMLButtonElement;
      revokeAllBtn.addEventListener("click", async () => {
        revokeAllBtn.disabled = true;
        try {
          await api.post("/auth/sessions/revoke-all");
          toast(t("settings.account.sessions.revoked_all"), "ok");
          loadSessions();
        } catch (err) {
          toast(
            err instanceof ApiError
              ? err.message
              : t("settings.account.sessions.revoke_all_failed"),
            "err",
          );
        } finally {
          revokeAllBtn.disabled = false;
        }
      });

      startPoller({
        interval: 15_000,
        firstDelay: 0,
        fetch: async () => {
          if (activeSection === "webhooks") await loadWebhooks();
          if (activeSection === "audit") await loadAudit();
          if (activeSection === "health") await loadHealth();
          if (activeSection === "team") await loadTeam();
        },
        skipWhen: () => dirty.isFocusInEditable() || dirty.hasOpenModal(),
      });

      void syncSectionFromHash();
      applyEditionGate();
    });
  </script>
</Layout>
