      async function refreshGithubCredentialRow() {
        const sel = $("gh-cred") as HTMLSelectElement;
        const note = $("gh-cred-note");
        note.textContent = t("common.status.loading");
        let view: ProjectGithubCredential = { source: "none" };
        try {
          view = await api.get<ProjectGithubCredential>(`/projects/${projectID}/github-credential`);
        } catch (e) {
          note.textContent = t("project.github.read_failed", { error: errText(e) });
          return;
        }
        // Listing credentials is admin-only but reading this row is not: viewers get the answer
        // without the picker.
        let creds: CredentialSummary[] = [];
        let mayList = true;
        try {
          creds = await listCredentials();
        } catch {
          mayList = false;
        }
        const github = creds.filter((c) => c.provider === "github" && !c.disabled);
        if (!mayList) {
          const sel2 = $("gh-cred") as HTMLSelectElement;
          sel2.innerHTML = `<option>${esc(view.name || t("project.labels.none"))}</option>`;
          sel2.disabled = true;
          ($("gh-cred-save") as HTMLButtonElement).disabled = true;
          note.textContent =
            view.source === "app"
              ? t("project.github.app_decides")
              : t("project.github.needs_admin");
          return;
        }
        const selected = view.source === "credential" ? (view.credential_id ?? "") : "";
        sel.innerHTML =
          `<option value="">${esc(t("project.labels.none"))}</option>` +
          github
            .map((c) => {
              const who = c.identity ? ` — ${c.identity}` : "";
              const bad =
                c.state === "invalid" || c.state === "expired"
                  ? ` ${esc(t(CRED_STATE_LABEL[c.state]))}`
                  : "";
              return `<option value="${esc(c.id)}"${c.id === selected ? " selected" : ""}>${esc(c.name)}${esc(who)}${bad}</option>`;
            })
            .join("");
        sel.value = selected;

        switch (view.source) {
          case "app":
            sel.disabled = true;
            note.textContent = t("project.github.app_outranks");
            break;
          case "credential":
            sel.disabled = false;
            note.textContent = github.length ? t("project.github.uses_credential") : "";
            break;
          default:
            sel.disabled = false;
            note.textContent = github.length
              ? t("project.github.no_credential")
              : t("project.github.no_credentials");
        }
      }

      async function saveGhCredential() {
        const sel = $("gh-cred") as HTMLSelectElement;
