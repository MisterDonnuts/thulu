---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import Callout from "../components/Callout.astro";
import Check from "../components/Check.astro";
import Chart from "../components/Chart.astro";
import ChartLegend from "../components/ChartLegend.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Count from "../components/Count.astro";
import DropZone from "../components/DropZone.astro";
import EmptyState from "../components/EmptyState.astro";
import Field from "../components/Field.astro";
import DateInput from "../components/DateInput.astro";
import FilterBar from "../components/FilterBar.astro";
import FilterChips from "../components/FilterChips.astro";
import FilterField from "../components/FilterField.astro";
import FormError from "../components/FormError.astro";
import ListRow from "../components/ListRow.astro";
import Meter from "../components/Meter.astro";
import Modal from "../components/Modal.astro";
import PageHead from "../components/PageHead.astro";
import Panel from "../components/Panel.astro";
import SectionHead from "../components/SectionHead.astro";
import Segmented from "../components/Segmented.astro";
import StatGroup from "../components/StatGroup.astro";
import StatTile from "../components/StatTile.astro";
import Table from "../components/Table.astro";
import Tabs from "../components/Tabs.astro";
import { SLOT, t, tParts } from "../i18n";
import type { TabItem } from "../lib/ui/tabs";
import { dimColumns, topTaskColumns } from "../lib/project-tables";

const SAMPLE = {
  repo: "git@github.com:org/repo.git",
  branch: "main",
  envName: "prod",
  system: "acme-platform",
  region: "us-east-1",
  account: "123456789012",
  url: "https://app.example.com",
  // i18n-ignore selector syntax sample, not a message
  selectors: "tag:Environment=prod\nlog_group=/aws/lambda/api-prod",
  credName: "prod-aws",
};

const TABS: TabItem[] = [
  { id: "overview", icon: "home", label: t("project.tabs.overview") },
  { id: "environments", icon: "server", label: t("project.tabs.environments") },
  { id: "repo", icon: "github", label: t("project.tabs.repo") },
  { id: "settings", icon: "settings", label: t("project.tabs.settings") },
];

const PRESETS = ["24h", "7d", "30d", "90d"].map((value) => ({ value, label: value }));

const KPI_ROWS: [string, [string, string, string][]][] = [
  [
    t("project.kpis.flow"),
    [
      ["k-open", t("project.kpis.in_flight"), "—"],
      ["k-throughput", t("project.kpis.throughput"), t("project.kpis.throughput_sub")],
      ["k-lead", t("project.kpis.lead_time"), t("project.kpis.lead_time_sub")],
      ["k-firstpass", t("project.kpis.first_pass"), t("project.kpis.first_pass_sub")],
    ],
  ],
  [
    t("project.kpis.quality"),
    [
      ["k-rework", t("project.kpis.rework"), t("project.kpis.rework_sub")],
      ["k-runs", t("project.kpis.runs"), t("project.kpis.runs_sub")],
      ["k-human", t("project.kpis.human"), t("project.kpis.human_sub")],
      ["k-cache", t("project.kpis.cache"), t("project.kpis.cache_sub")],
    ],
  ],
  [
    t("project.kpis.spend"),
    [
      ["k-cost-task", t("project.kpis.cost_task"), "—"],
      ["k-cost-done", t("project.kpis.cost_done"), t("project.kpis.cost_done_sub")],
      ["k-agent-time", t("project.kpis.agent_time"), "—"],
      ["k-tokens-task", t("project.kpis.tokens_task"), "—"],
    ],
  ],
];

const [envBefore, , envAfter] = tParts("project.environments.intro", { em: SLOT });
const [credBefore, , credAfter] = tParts("project.credentials.intro", { link: SLOT });
---

<Layout title={t("project.title")}>
  <main class="proj-page">
    <PageHead
      title={t("common.status.loading")}
      titleId="p-title"
      flush
      subMax={720}
      crumbs={[
        { label: t("common.nav.projects"), href: "/projects/" },
        { label: "…", id: "crumb-name" },
      ]}
    >
      <Fragment slot="sub"><span id="p-sub">—</span></Fragment>
      <Fragment slot="actions">
        <Button id="p-tasks-link" href="/tasks/" size="md" icon="board"
          >{t("common.nav.tasks")}</Button
        >
        <Button
          id="p-repo-link"
          href="#"
          size="md"
          icon="github"
          target="_blank"
          rel="noreferrer"
          hidden
        >
          {t("project.header.repo")}
        </Button>
        <Button id="btn-refresh" size="md" icon="refresh">{t("common.buttons.refresh")}</Button>
      </Fragment>
    </PageHead>

    <EmptyState
      id="load-error"
      tone="danger"
      icon="warn"
      title={t("project.errors.not_found")}
      titleId="load-error-msg"
      hidden
    >
      <Button slot="action" href="/projects/" variant="primary" size="md"
        >{t("project.header.back_to_projects")}</Button
      >
    </EmptyState>

    <div id="body" hidden>
      <div id="clone-banner" class="clone-banner" role="status" hidden></div>
      <Tabs id="proj-tabs" label={t("project.tabs.aria")} items={TABS} panels />

      <div id="panel-overview" class="proj-panel" role="tabpanel" aria-labelledby="tab-overview">
        <FilterBar look="boxed" as="section" label={t("project.filters.aria")}>
          <FilterField label={t("project.filters.from")} for="f-from">
            <DateInput id="f-from" />
          </FilterField>
          <FilterField label={t("project.filters.to")} for="f-to">
            <DateInput id="f-to" />
          </FilterField>
          <FilterChips
            id="f-presets"
            items={PRESETS}
            picked="30d"
            attr="preset"
            label={t("project.filters.presets_aria")}
          />
          <Badge slot="end" shape="pill" id="window-pill">—</Badge>
        </FilterBar>

        <section class="kpis" aria-label={t("project.kpis.aria")}>
          {
            KPI_ROWS.map(([label, tiles]) => (
              <StatGroup label={label}>
                {tiles.map(([id, tileLabel, sub]) => (
                  <StatTile id={id} label={tileLabel} value="—" sub={sub} />
                ))}
              </StatGroup>
            ))
          }
        </section>

        <section class="grid-2">
          <Panel icon="board" title={t("project.charts.flow")}>
            <Fragment slot="aside">{t("project.charts.flow_hint")}</Fragment>
            <Chart id="chart-flow" size="lg" label={t("lib.minicharts.throughput.aria")} />
            <ChartLegend id="chart-flow-legend" items={[]} />
            <EmptyState id="chart-flow-empty" size="sm" hidden>
              {t("project.charts.flow_empty")}
            </EmptyState>
          </Panel>

          <Panel icon="zap" title={t("project.charts.spend")}>
            <Segmented
              slot="actions"
              id="spend-metric"
              name="spend-metric"
              size="sm"
              label={t("project.charts.metric_aria")}
              value="cost"
              options={[
                { value: "cost", label: t("project.charts.cost") },
                { value: "tokens", label: t("project.charts.tokens") },
              ]}
            />
            <Chart id="chart-spend" size="lg" interactive label={t("lib.minicharts.spend.aria")} />
            <EmptyState id="chart-spend-empty" size="sm" hidden>
              {t("project.charts.spend_empty")}
            </EmptyState>
          </Panel>
        </section>

        <section class="grid-2">
          <Panel icon="clock" title={t("project.charts.dwell")}>
            <Fragment slot="aside">{t("project.charts.dwell_hint")}</Fragment>
            <div id="dwell-bars"></div>
            <EmptyState id="dwell-empty" size="sm" hidden>
              {t("project.charts.dwell_empty")}
            </EmptyState>
          </Panel>

          <Panel icon="folder" title={t("project.charts.census")}>
            <Fragment slot="aside">{t("project.charts.census_hint")}</Fragment>
            <div id="census-bars"></div>
            <EmptyState id="census-empty" size="sm" hidden>
              {t("project.charts.census_empty")}
            </EmptyState>
          </Panel>
        </section>

        <section class="grid-2">
          <Panel icon="board" title={t("project.tables.cost_by_stage")} flush>
            <Table cols={dimColumns("stage")} stack id="t-stage" />
          </Panel>
          <Panel icon="bot" title={t("project.tables.cost_by_model")} flush>
            <Table cols={dimColumns("model")} stack id="t-model" />
          </Panel>
        </section>

        <Panel icon="zap" title={t("project.tables.top_tasks")} flush>
          <Table cols={topTaskColumns()} stack id="t-tasks" />
        </Panel>
      </div>

      <div
        id="panel-settings"
        class="proj-panel"
        role="tabpanel"
        aria-labelledby="tab-settings"
        hidden
      >
        <Panel icon="settings" title={t("project.settings.title")} bodyClass="form-grid">
          <Button slot="actions" size="sm" variant="primary" id="s-save"
            >{t("common.buttons.save")}</Button
          >
          <div class="form-col form-stack">
            <Field label={t("project.labels.name")} for="s-name" errorId="s-name-error">
              <input id="s-name" placeholder={t("project.settings.name_placeholder")} />
            </Field>
            <Field
              label={t("project.settings.repo")}
              for="s-repo"
              id="s-repo-field"
              errorId="s-repo-error"
            >
              <input id="s-repo" placeholder={SAMPLE.repo} />
            </Field>
            <Field label={t("project.settings.branch")} for="s-branch">
              <input id="s-branch" placeholder={SAMPLE.branch} />
            </Field>
            <Field
              label={t("project.settings.board")}
              for="s-board"
              help={t("project.settings.board_hint")}
            >
              <select id="s-board" aria-describedby="s-board-help"></select>
            </Field>
          </div>
          <div class="form-col form-stack">
            <Field
              label={t("project.settings.description")}
              for="s-desc"
              hint={t("project.settings.description_hint")}
            >
              <textarea
                id="s-desc"
                rows="4"
                placeholder={t("project.settings.description_placeholder")}></textarea>
            </Field>
            <Field
              label={t("project.settings.template")}
              hint={t("project.settings.template_hint")}
            >
              <Table
                compact
                bodyId="s-template"
                cols={[
                  { label: t("project.columns.stage"), width: "shrink" },
                  { label: t("project.columns.default_agent"), width: "fill" },
                ]}
              />
            </Field>
          </div>
        </Panel>

        <Panel icon="warn" title={t("project.danger.title")} tone="danger">
          <Button slot="actions" size="sm" variant="danger" id="p-delete" icon="trash"
            >{t("project.danger.delete")}</Button
          >
          <p class="panel-lede">
            {t("project.danger.note")}
          </p>
        </Panel>
      </div>

      <div
        id="panel-environments"
        class="proj-panel"
        role="tabpanel"
        aria-labelledby="tab-environments"
        hidden
      >
        <Panel icon="server" title={t("project.environments.title")}>
          <Button slot="actions" size="sm" id="env-new" icon="plus"
            >{t("project.environments.add")}</Button
          >
          <p class="panel-lede">
            {envBefore}<em>{t("project.environments.intro_em")}</em>{envAfter}
          </p>
          <div id="env-list"></div>
        </Panel>
      </div>

      <div id="panel-repo" class="proj-panel" role="tabpanel" aria-labelledby="tab-repo" hidden>
        <Panel icon="folder" title={t("project.code.title")} id="code-panel" hidden>
          <p class="panel-lede">{t("project.code.intro")}</p>
          <Field label={t("project.code.branch")} for="code-branch" class="code-download">
            <div class="code-download-row">
              <select id="code-branch"></select>
              <Button variant="primary" id="code-download" href="#" icon="arrow-down" download
                >{t("project.code.download")}</Button
              >
            </div>
          </Field>
          <Field label={t("project.code.new_version")} class="code-new">
            <DropZone id="code-drop" title={t("project.code.drop_title")} />
          </Field>
          <div class="upload-plan" id="code-plan" hidden></div>
          <div class="upload-progress" id="code-progress" hidden>
            <Meter
              value={0}
              label={t("projects.upload.progress_label")}
              id="code-progress-bar"
              class="upload-meter"
            />
            <span class="muted" id="code-progress-text"></span>
          </div>
          <p class="upload-rules" id="code-replace-note"></p>
          <div class="code-actions">
            <Button variant="primary" id="code-upload" disabled>{t("project.code.upload")}</Button>
          </div>
        </Panel>

        <Panel icon="github" title={t("project.github.title")} id="gh-panel">
          <ListRow id="gh-app-row" title={t("project.github.app")} hidden>
            <span slot="meta" id="gh-app-status"></span>
            <Button slot="actions" size="sm" variant="danger" id="gh-app-unlink"
              >{t("project.buttons.unlink")}</Button
            >
          </ListRow>
          <div class="form-stack">
            <Field
              label={t("project.github.link_label")}
              for="gh-link-inst"
              help={t("project.github.link_hint")}
              id="gh-link-row"
              hidden
            >
              <div class="gh-pick">
                <select id="gh-link-inst" aria-describedby="gh-link-inst-help"></select>
                <Button variant="primary" id="gh-link-save">{t("project.github.link")}</Button>
              </div>
            </Field>
            <Field
              label={t("project.labels.credential")}
              for="gh-cred"
              hint={t("project.github.credential_hint")}
              helpId="gh-cred-note"
            >
              <div class="gh-pick">
                <select id="gh-cred" aria-describedby="gh-cred-note"></select>
                <span class="btn-pair">
                  <Button href="/credentials/">{t("project.buttons.manage")}</Button>
                  <Button variant="primary" id="gh-cred-save">{t("common.buttons.save")}</Button>
                </span>
              </div>
              <Fragment slot="help">{t("common.status.loading")}</Fragment>
            </Field>
          </div>
        </Panel>

        <Panel icon="terminal" title={t("project.init_script.title")} id="init-script">
          <Fragment slot="actions">
            <Button size="sm" id="init-history">{t("lib.init_script.buttons.history")}</Button>
            <Button size="sm" variant="primary" id="init-save">{t("common.buttons.save")}</Button>
          </Fragment>
          <p class="panel-lede">{t("project.init_script.intro")}</p>
          <div id="init-root"><p class="muted">{t("common.status.loading")}</p></div>
        </Panel>

        <Panel icon="file" title={t("project.stage_files.panel_title")}>
          <Button slot="actions" size="sm" id="sf-open">{t("project.buttons.manage")}</Button>
          <p class="panel-lede">
            {t("project.stage_files.panel_note")}
          </p>
        </Panel>

        <Panel icon="branch" title={t("project.worktrees.title")} flush>
          <Count slot="aside" n="—" id="wt-count" />
          <div id="wt-list"></div>
        </Panel>
      </div>
    </div>

    <Modal
      id="env-modal"
      title={t("project.environments.add")}
      icon="server"
      size="md"
      closable
      bodyClass="form-stack"
      cancel
      primary={{ label: t("common.buttons.save"), id: "env-save" }}
    >
      <Field
        label={t("project.labels.name")}
        for="env-name"
        hint={t("project.env_form.name_hint")}
        errorId="env-name-error"
      >
        <input id="env-name" placeholder={SAMPLE.envName} autocomplete="off" />
      </Field>
      <Field
        label={t("project.env_form.display_name")}
        for="env-display-name"
        optional
        hint={t("project.env_form.display_name_hint")}
        errorId="env-display-name-error"
      >
        <input
          id="env-display-name"
          maxlength="60"
          placeholder={t("project.env_form.display_name_placeholder")}
          autocomplete="off"
        />
      </Field>
      <Field
        label={t("project.env_form.system")}
        for="env-system"
        optional
        hint={t("project.env_form.system_hint")}
        errorId="env-system-error"
      >
        <input id="env-system" placeholder={SAMPLE.system} autocomplete="off" />
      </Field>
      <Field
        label={t("project.labels.provider")}
        for="env-provider"
        help={t("project.env_form.provider_hint")}
        errorId="env-provider-error"
      >
        <select id="env-provider" aria-describedby="env-provider-help">
          <option value="aws">{t("project.env_form.provider_aws")}</option>
          <option value="gcp">{t("project.env_form.provider_gcp")}</option>
          <option value="prometheus">{t("project.env_form.provider_prometheus")}</option>
          <option value="other">{t("project.env_form.provider_other")}</option>
        </select>
      </Field>
      <Field label={t("project.env_form.region")} for="env-region">
        <input id="env-region" placeholder={SAMPLE.region} autocomplete="off" />
      </Field>
      <Field
        label={t("project.env_form.account")}
        for="env-account"
        hint={t("project.env_form.account_hint")}
      >
        <input id="env-account" placeholder={SAMPLE.account} autocomplete="off" />
      </Field>
      <Field label={t("project.env_form.url")} for="env-url" errorId="env-url-error">
        <input id="env-url" placeholder={SAMPLE.url} autocomplete="off" />
      </Field>
      <Field
        label={t("project.env_form.selectors")}
        for="env-selectors"
        hint={t("project.env_form.selectors_hint")}
        errorId="env-selectors-error"
      >
        <textarea id="env-selectors" rows="3" spellcheck="false" placeholder={SAMPLE.selectors}
        ></textarea>
      </Field>
      <Check
        id="env-prod"
        label={t("project.env_form.production")}
        hint={t("project.env_form.production_hint")}
      />

      <div id="env-cred-row" class="form-stack cred-split" hidden>
        <Field label={t("project.labels.credential")} for="env-cred-pick" helpId="env-cred-hint">
          <select id="env-cred-pick" aria-describedby="env-cred-hint"></select>
          <Fragment slot="help"></Fragment>
        </Field>
        <div id="env-cred-new" class="form-stack" hidden>
          <Field
            label={t("project.env_form.credential_name")}
            for="env-cred-name"
            errorId="env-cred-name-error"
          >
            <input id="env-cred-name" placeholder={SAMPLE.credName} autocomplete="off" />
          </Field>
          <Field label={t("project.labels.type")} for="env-cred-kind" id="env-cred-kind-row">
            <select id="env-cred-kind"></select>
          </Field>
          <div id="env-cred-fields" class="form-stack cred-fields"></div>
        </div>
      </div>

      <FormError id="env-error" />
    </Modal>

    <Modal
      id="cred-modal"
      title={t("project.credentials.title")}
      icon="link"
      size="sm"
      closable
      cancel
      primary={{ label: t("common.buttons.save"), id: "cred-save" }}
    >
      <p class="modal-lede">
        {credBefore}<a href="/credentials/">{t("project.credentials.intro_link")}</a>{credAfter}
      </p>
      <div class="form-stack">
        <Field label={t("project.labels.credential")} for="cred-pick" helpId="cred-hint">
          <select id="cred-pick" aria-describedby="cred-hint"></select>
          <Fragment slot="help"></Fragment>
        </Field>

        <div id="cred-new" class="form-stack cred-split" hidden>
          <Field label={t("project.labels.name")} for="cred-new-name" errorId="cred-new-name-error">
            <input id="cred-new-name" placeholder={SAMPLE.credName} autocomplete="off" />
          </Field>
          <Field
            label={t("project.labels.provider")}
            for="cred-new-provider"
            id="cred-new-provider-row"
          >
            <select id="cred-new-provider"></select>
          </Field>
          <Field
            label={t("project.labels.type")}
            for="cred-new-kind"
            id="cred-new-kind-row"
            helpId="cred-new-help"
          >
            <select id="cred-new-kind" aria-describedby="cred-new-help"></select>
            <Fragment slot="help"></Fragment>
          </Field>
          <div id="cred-new-fields" class="form-stack cred-fields"></div>
          <p class="field-help">{t("project.credentials.validated_hint")}</p>
        </div>

        <FormError id="cred-error" />
      </div>
    </Modal>

    <Modal
      id="ing-modal"
      title={t("project.telemetry.title")}
      icon="zap"
      size="lg"
      closable
      lede={t("project.telemetry.intro")}
      cancel={t("common.buttons.close")}
    >
      <div class="ing-body">
        <div id="ing-new" class="ing-new" hidden>
          <Callout tone="warn" bare role="note">{t("project.telemetry.copy_now")}</Callout>
          <CodeBlock
            textId="ing-secret"
            wrap
            copy
            label={t("project.telemetry.token_copy_label")}
          />
          <CodeBlock
            textId="ing-snippet"
            multiline
            copy
            label={t("project.telemetry.snippet_copy_label")}
          />
          <Callout tone="warn" bare id="ing-addr-warn" role="note" hidden />
        </div>

        <section aria-labelledby="ing-tokens-h">
          <SectionHead level={4} id="ing-tokens-h" title={t("project.telemetry.tokens")}>
            <input
              slot="actions"
              id="ing-name"
              size="24"
              maxlength="80"
              autocomplete="off"
              placeholder={t("project.telemetry.name_placeholder")}
              aria-label={t("project.telemetry.name_label")}
            />
            <Button slot="actions" size="sm" id="ing-create"
              >{t("project.telemetry.new_token")}</Button
            >
          </SectionHead>
          <div id="ing-tokens"></div>
        </section>

        <section aria-labelledby="ing-sources-h">
          <SectionHead level={4} id="ing-sources-h" title={t("project.telemetry.sources")} />
          <p class="field-help ing-hint">
            {t("project.telemetry.sources_hint")}
          </p>
          <div id="ing-sources"></div>
        </section>
        <FormError id="ing-error" />
      </div>
    </Modal>

    <Modal
      id="dash-modal"
      title={t("project.dashboards.title")}
      icon="columns"
      size="xl"
      closable
      cancel
      primary={{ label: t("common.buttons.save"), id: "dm-save" }}
    >
      <div class="form-stack">
        <Field label={t("project.labels.name")} for="dm-name">
          <input id="dm-name" type="text" placeholder={t("project.dashboards.name_placeholder")} />
        </Field>
        <section aria-labelledby="dm-panels-h">
          <SectionHead level={4} id="dm-panels-h" title={t("project.dashboards.panels")}>
            <Button slot="actions" size="sm" icon="plus" id="dm-add">
              {t("project.dashboards.add_panel")}
            </Button>
          </SectionHead>
          <div id="dm-panels" class="panel-stack"></div>
        </section>
        <FormError id="dm-error" />
      </div>
    </Modal>

    <Modal id="stage-modal" title={t("project.stage_files.title")} icon="file" size="xl" closable>
      <div id="sm-body"></div>
    </Modal>
  </main>

  <style is:global>
    .proj-page {
      padding: 28px 32px 80px;
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }
    .proj-page #body {
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }

    /* Each tab stacks its panels with the page's gap. */
    .proj-panel {
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }

    /* ─── KPI rows: three StatGroups of four tiles ───────────── */
    .kpis {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
    }

    /* ─── Charts ─────────────────────────────────────────────── */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-4);
    }
    @media (max-width: 980px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
    }
    /* Both an aside in a panel header (pushed right) and a note under a form
       control (pushed down). It was two rules that merged into exactly this. */
    .hint {
      margin-top: var(--s-2);
      margin-left: auto;
      font-size: var(--t-xs);
      color: var(--fg-3);
    }

    /* The share of the cost, a Meter after the amount. */
    .dim-share {
      margin-left: var(--s-2);
    }

    /* ─── Forms ──────────────────────────────────────────────── */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-6);
    }
    @media (max-width: 980px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
    }
    .form-col {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    /* A picker and the buttons that act on its choice, inside a Field. */
    .gh-pick {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-3);
    }
    .gh-pick select {
      flex: 1 1 200px;
      min-width: 0;
    }
    /* The branch picker and its download button share a row that wraps
       under the button on a phone. */
    .code-download-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-3);
    }
    .code-download-row select {
      flex: 1;
      min-width: 140px;
      max-width: 280px;
    }
    .code-download,
    .code-new {
      margin-bottom: var(--s-4);
    }
    .code-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: var(--s-3);
    }
    /* Holds the clone's Callout above the tabs. */
    .clone-banner {
      margin-bottom: var(--s-4);
    }
    /* Two buttons that travel together at the end of a config row. */
    .btn-pair {
      display: inline-flex;
      gap: var(--s-2);
    }
    .gh-info {
      font-size: var(--t-xs);
      line-height: 1.5;
    }
    /* The agent picker of each stage fills its column of the template. */
    #s-template select {
      width: 100%;
    }

    /* ─── Init script (lib/init-script.ts) ─────────────────────── */
    .is-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
      font-size: var(--t-sm);
    }
    .is-last-note {
      margin: var(--s-1) 0 0;
      font-size: var(--t-xs);
    }
    .proj-page .is-script {
      min-height: 220px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.55;
      tab-size: 2;
    }
    .proj-page .mono {
      font-family: var(--font-mono);
    }
    .is-grid {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--s-6);
    }
    /* The add buttons under the params and the support files keep their
       own width inside the field's column. */
    .is-editor .field > .btn {
      align-self: flex-start;
    }
    .is-params {
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
    }
    .is-param {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1.4fr) auto auto;
      align-items: center;
      gap: var(--s-2);
    }
    .is-pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-3);
    }
    .proj-page .is-setup {
      min-height: 96px;
    }
    .is-pair.is-triple {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .is-files {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
    }
    .is-file {
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
    }
    .is-file-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--s-2);
    }
    .proj-page .is-file-content {
      min-height: 120px;
    }
    .is-prewarm {
      margin-top: var(--s-3);
      padding-top: var(--s-3);
      border-top: 1px solid var(--line-soft);
    }
    .is-prewarm:empty {
      display: none;
    }
    .is-prewarm-line {
      margin: var(--s-1) 0 0;
      font-size: var(--t-sm);
      color: var(--fg-3);
      overflow-wrap: anywhere;
    }
    .is-prewarm-reason {
      margin: var(--s-2) 0 0;
      font-size: var(--t-sm);
      color: var(--danger);
    }
    .is-starter {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      flex-wrap: wrap;
      padding: var(--s-2) var(--s-3);
      margin-bottom: var(--s-3);
      border: 1px dashed var(--accent-line);
      border-radius: var(--r-sm);
      font-size: var(--t-sm);
    }
    @media (max-width: 720px) {
      .is-pair.is-triple {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 980px) {
      .is-grid {
        grid-template-columns: 1fr;
        gap: var(--s-4);
      }
    }
    @media (max-width: 720px) {
      .is-param {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto;
      }
      .is-param [data-p="description"] {
        grid-column: 1 / -1;
        grid-row: 2;
      }
    }

    /* ─── Environments ───────────────────────────────────────── */
    /* An environment is a list row with the blocks that hang under it
       (testing, proposals, signals, custom metrics, dashboards) lined up
       with the row's text. */
    .env-detail {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
      min-width: 0;
      padding: 0 var(--s-4) var(--s-4);
    }
    .env-name {
      font-weight: 600;
    }
    .env-slug {
      margin-left: var(--s-2);
      font-family: var(--font-mono);
      font-size: var(--t-xs);
      color: var(--fg-3);
    }
    /* How Evidence tests the environment: one quiet line, edited there. */
    .env-testing .env-meta {
      column-gap: var(--s-4);
    }
    .env-testing-link {
      font-size: var(--t-xs);
      font-weight: 500;
      color: var(--accent);
    }
    @media (pointer: coarse) {
      .env-testing-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
    }
    .env-meta {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
      color: var(--fg-3);
      font-size: var(--t-xs);
    }
    .env-meta-stacked {
      margin-top: 4px;
    }
    /* The credential part of a form, set off from the fields above it. */
    .cred-split {
      padding-top: var(--s-4);
      border-top: 1px solid var(--line);
    }
    /* The provider's own Fields (fieldInputs() in lib/credentials.ts) in a
       .form-stack; with no provider picked there are none, and the empty
       column takes no gap in the form around it. */
    .cred-fields:empty {
      display: none;
    }
    /* Push and pull tiles sit side by side, so where a number came from has
       to be readable off the tile itself — otherwise "reported by the app"
       and "polled from CloudWatch" are indistinguishable and a stale
       collector looks like a healthy one. */
    .sig-pushed {
      color: var(--accent);
    }
    /* ─── Custom metrics tray and dashboards ─────────────────── */
    /* Sections under an environment, each set off by a rule. */
    .cm-block,
    .dash-block {
      min-width: 0;
      padding-top: var(--s-3);
      border-top: 1px solid var(--line);
    }
    /* What a section under an environment is for, or what unlocks it. */
    .env-block-lede {
      margin-bottom: var(--s-2);
      font-size: var(--t-xs);
      color: var(--fg-3);
    }
    .cm-labels {
      font-family: var(--font-mono);
      font-size: var(--t-xs);
    }

    /* ─── Dashboards ─────────────────────────────────────────── */
    /* The strip of dashboards, and the buttons that act on the open one at
       its end; on a phone the buttons drop under the strip. */
    .dash-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2) var(--s-3);
      margin-bottom: var(--s-3);
    }
    .dash-bar > .tabs {
      flex: 0 1 auto;
      min-width: 0;
    }
    .dash-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-left: auto;
    }
    /* ─── Telemetry ingest ───────────────────────────────────── */
    /* The new token, then the tokens and the sources, one under the other. */
    .ing-body {
      display: flex;
      flex-direction: column;
      gap: var(--s-5);
    }
    .ing-hint {
      margin-bottom: var(--s-2);
    }
    /* The token just made, the snippet that uses it and the warning, one
       under the other. */
    .ing-new {
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
    }

    /* ─── Stage files modal ─────────────────────────────── */
    .sf-set {
      margin-bottom: var(--s-6);
    }
    .sf-intro {
      font-size: var(--t-xs);
      color: var(--fg-3);
      margin-bottom: var(--s-3);
      line-height: 1.5;
    }
  </style>

  <script>
    import { requireAuth } from "../lib/auth";
    import { t } from "../i18n";
    import { api, ApiError } from "../lib/api";
    import {
      $,
      bindDropZone,
      bindTabs,
      buttonHTML,
      calloutHTML,
      clearFormErrors,
      confirmDialog,
      emptyStateHTML,
      esc,
      fieldHTML,
      icoSvg,
      listRowsHTML,
      bindCrosshair,
      chartBarsHTML,
      makeToast,
      resetDropZone,
      segmentedValue,
      setBadge,
      setChartLegend,
      setChipsPressed,
      setCount,
      setFieldError,
      setFormError,
      setMeter,
      setStat,
      sparklineSVG,
      timeChart,
      uploadPlanHTML,
      uploadReportHTML,
      dateInputsValid,
      readDateInput,
      writeDateInput,
    } from "../lib/ui";
    import type { Board, BoardsResponse, Stage } from "../lib/stages";
    import { boardOptions, readStageTemplate, stageTemplateTable } from "../lib/pickers";
    import type { AgentType } from "../lib/pickers";
    import { wireMdEditor } from "../lib/mdeditor";
    import { renderPanel, type PanelData } from "../lib/charts";
    import { bindModal } from "../lib/modal";
    import { isoLocal } from "../lib/time";
    import { estimatedCost } from "../lib/format";
    import {
      fmtDur,
      fmtLatency,
      fmtNum,
      fmtPct,
      fmtUSD,
      presetRange,
      toInstant,
    } from "../lib/metrics-format";
    import {
      flowChartSVG,
      flowLegend,
      flowSummary,
      hasFlowData,
      type FlowPoint,
      type SpendPoint,
    } from "../lib/minicharts";
    import {
      DAY_MS,
      fmtUsageDay,
      usageChartSummary,
      usageDays,
      usageSeries,
    } from "../lib/usage-chart";
    import { fmtSignal, sigAge } from "../lib/signals";
    import {
      envListHTML,
      type CustomMetric,
      type CustomMetricsResponse,
      type Dashboard,
      type EnvCardDeps,
      type EnvTesting,
      type EnvDetail,
      type Environment,
      type Mapping,
    } from "../lib/env-cards";
    import type { SeriesPoint } from "../lib/signals";
    import {
      collectorSnippet,
      ingestBase,
      ingestSourcesHTML,
      ingestTokensHTML,
      parseCIDRs,
      type IngestSource,
      type IngestToken,
    } from "../lib/ingest";
    import {
      applyPanelEdit,
      blankPanel,
      panelRowHTML,
      type ChartCatalog,
      type PanelSpec,
    } from "../lib/dash-panels";
    import {
      HOOK_TEMPLATE,
      parseStageRef,
      stageEditorHTML,
      stageSetsHTML,
      type StageEntry,
      type StageFiles,
    } from "../lib/stage-files";
    import {
      CLOUD_PROVIDERS,
      NEW_CRED,
      credLabel,
      credentialForEnv,
      envErrorField,
      formatSelectors,
      grantsWith,
      grantsWithout,
      parseSelectors,
    } from "../lib/env-form";
    import { webRepoURL } from "../lib/repo-url";
    import { apiBase } from "../lib/auth";
    import {
      buildTarGz,
      formatBytes,
      MAX_UPLOAD_BYTES,
      pickedFromDrop,
      pickedFromInput,
      planUpload,
      sendUpload,
      UploadError,
      type PickedFile,
      type UploadPlan,
      type UploadReport,
    } from "../lib/project-upload";
    import {
      dimColumns,
      dimRowsHTML,
      topTaskColumns,
      topTaskRowsHTML,
      type DimensionRow,
      type TaskRow,
    } from "../lib/project-tables";
    import { setStageLabels } from "../lib/init-script";
    import { mountInitScript, type InitPanel } from "../lib/init-script-panel";
    import {
      checkSummary,
      checkTone,
      createCredential,
      fetchProviders,
      fieldInputs,
      kindOptions,
      listCredentials,
      providerOptions,
      readPayload,
      type Credential as ManagedCredential,
      type KindSpec,
      type ProviderSpec,
    } from "../lib/credentials";
    import { navigate } from "astro:transitions/client";
    import { every, onPage, replaceURL } from "../lib/page";

    onPage("/project", (signal) => {
      requireAuth();

      interface Project {
        id: string;
        name: string;
        repo_url: string;
        description: string;
        default_branch: string;
        default_board_id?: string;
        stage_template: Record<string, string>;
        github_installation_id?: number;
        source?: string;
        clone_status?: "cloning" | "failed";
        clone_error?: string;
        clone_detail?: string;
      }
      interface Worktree {
        task_id?: string;
        path?: string;
        branch?: string;
      }
      interface ProjectGithubCredential {
        source: "app" | "credential" | "none";
        credential_id?: string;
        name?: string;
        identity?: string;
        state?: string;
        installation_id?: number;
        account?: string;
      }
      interface CredentialSummary {
        id: string;
        name: string;
        provider: string;
        identity?: string;
        state?: string;
        disabled?: boolean;
      }
      const CRED_STATE_LABEL = {
        invalid: "project.github.state_invalid",
        expired: "project.github.state_expired",
      } as const;

      function errText(e: unknown): string {
        return e instanceof ApiError ? e.message : t("project.errors.unknown");
      }

      interface GithubInstallation {
        installation_id: number;
        account_login: string;
        suspended_at?: string;
      }

      interface Dist {
        n: number;
        avg_ms: number;
        p50_ms: number;
        p90_ms: number;
        max_ms: number;
      }
      interface FlowMetrics {
        tasks_total: number;
        tasks_open: number;
        tasks_done: number;
        tasks_blocked: number;
        tasks_running: number;
        tasks_failed: number;
        tasks_created: number;
        tasks_completed: number;
        tasks_touched: number;
        first_pass_tasks: number;
        first_pass_rate: number;
        human_comments: number;
        human_intervention_rate: number;
        by_stage: { stage: string; count: number }[];
        throughput: FlowPoint[];
        lead_time: Dist;
        stage_dwell: ({ stage: string } & Dist)[];
        wip_age: Dist;
        reworked_tasks: number;
        rework_rate: number;
        kickbacks: number;
        agent_runs: number;
        runs_per_task: number;
        flags_raised: number;
        flags_resolved: number;
        prs_opened: number;
      }
      interface AgentRollup {
        sessions: number;
        turns: number;
        total_tokens: number;
        cost_usd: number;
        estimated_cost_usd?: number;
        unpriced_sessions?: number;
        cache_hit_ratio: number;
        error_rate: number;
        max_tokens_rate: number;
        tasks_with_runs: number;
        cost_per_task: number;
        cost_per_completed_task: number;
        tokens_per_task: number;
        sessions_per_task: number;
        compute_time_per_task: Dist;
        wall_time_per_task: Dist;
      }
      interface ProjectMetrics {
        project_id: string;
        from: string;
        to: string;
        flow: FlowMetrics;
        agent: AgentRollup;
      }

      const projectID = new URLSearchParams(window.location.search).get("id") || "";
      const toast = makeToast();

      let project: Project | null = null;
      let initPanel: InitPanel | null = null;
      let stages: Stage[] = [];
      let boards: Board[] = [];
      let agents: AgentType[] = [];
      let spendSeries: SpendPoint[] = [];
      let flowSeries: FlowPoint[] = [];
      let spendMetric: "cost" | "tokens" = "cost";

      const signalFormat = { latency: fmtLatency, usd: fmtUSD, num: fmtNum };
      const fmtSig = (signal: string, value: number, unit?: string) =>
        fmtSignal(signal, value, unit, signalFormat);

      function windowQS(): string {
        const p = new URLSearchParams();
        const from = toInstant(readDateInput("f-from"));
        const to = toInstant(readDateInput("f-to"));
        if (from) p.set("from", from);
        if (to) p.set("to", to);
        return p.toString() ? `?${p}` : "";
      }

      let activePreset = "";

      function applyPreset(key: string) {
        activePreset = key;
        const { from, to } = presetRange(key);
        writeDateInput("f-from", isoLocal(from));
        writeDateInput("f-to", isoLocal(to));
        setChipsPressed($("f-presets"), key, "preset");
      }

      async function bootstrap() {
        if (!projectID) {
          showLoadError(t("project.errors.no_id"));
          return;
        }
        applyPreset("30d");
        try {
          // /stages is the full catalog on purpose: the stage template and stage-file editor key
          // stages by id across every board.
          const [proj, catalog, types, boardsResp] = await Promise.all([
            api.get<Project>(`/projects/${projectID}`),
            api.get<Stage[]>("/stages"),
            api.get<AgentType[]>("/types"),
            api.get<BoardsResponse>("/boards"),
          ]);
          project = proj;
          stages = catalog;
          agents = types;
          boards = boardsResp.boards;
        } catch (e) {
          showLoadError(e instanceof ApiError ? e.message : t("project.errors.load_failed"));
          return;
        }
        $("body").hidden = false;
        renderHeader();
        renderSettings();
        if (project.source === "upload") void loadCodeBranches();
        else void refreshGithubCredentialRow();
        setStageLabels(stageLabel);
        const codeReady = !project.clone_status;
        initPanel = mountInitScript({
          host: $("init-root"),
          saveBtn: $("init-save"),
          historyBtn: $("init-history"),
          projectID,
          toast,
          codeReady,
        });
        if (codeReady) void loadWorktrees();
        void loadEnvironments();
        startEnvAutoRefresh();
        await loadMetrics();
      }

      function showLoadError(msg: string) {
        $("load-error-msg").textContent = msg;
        $("load-error").hidden = false;
        $("p-title").textContent = t("project.title");
        $("p-sub").textContent = "";
      }

      function renderHeader() {
        if (!project) return;
        document.title = t("project.document_title", { name: project.name });
        $("crumb-name").textContent = project.name;
        $("p-title").textContent = project.name;
        const uploaded = project.source === "upload";
        $("p-sub").textContent =
          project.description || (uploaded ? t("projects.labels.uploaded") : project.repo_url);
        const repoLink = $("p-repo-link") as HTMLAnchorElement;
        const web = uploaded ? null : webRepoURL(project.repo_url);
        repoLink.hidden = !web;
        if (web) repoLink.href = web;
        ($("gh-panel") as HTMLElement).hidden = uploaded;
        ($("code-panel") as HTMLElement).hidden = !uploaded;
        ($("s-repo-field") as HTMLElement).hidden = uploaded;
        const tasksQS = new URLSearchParams({ q: project.name });
        if (project.default_board_id) tasksQS.set("board", project.default_board_id);
        ($("p-tasks-link") as HTMLAnchorElement).href = `/tasks/?${tasksQS}`;
        renderCloneBanner();
      }

      let clonePoll: number | null = null;
      signal.addEventListener("abort", () => {
        if (clonePoll !== null) window.clearTimeout(clonePoll);
      });

      function renderCloneBanner() {
        const banner = $("clone-banner");
        const st = project?.clone_status;
        banner.hidden = !st;
        if (st === "cloning")
          banner.innerHTML = calloutHTML({
            tone: "accent",
            icon: "i-clock",
            body: t("project.clone.cloning"),
          });
        else if (st === "failed") {
          const reason = t("project.clone.failed", {
            reason: project?.clone_error || t("projects.errors.unknown"),
          });
          const detail = project?.clone_detail;
          banner.innerHTML = calloutHTML({
            tone: "danger",
            icon: "i-alert",
            body: reason,
            detail: detail ? { summary: t("project.clone.detail"), text: detail } : undefined,
          });
        }
        if (clonePoll !== null) window.clearTimeout(clonePoll);
        clonePoll = null;
        if (st === "cloning" && !signal.aborted)
          clonePoll = window.setTimeout(() => void pollClone(), 3000);
      }

      async function pollClone() {
        try {
          const p = await api.get<Project>(`/projects/${projectID}`);
          const wasCloning = project?.clone_status === "cloning";
          project = p;
          renderHeader();
          if (wasCloning && !p.clone_status) {
            toast(t("project.clone.ready", { name: p.name }), "ok");
            renderSettings();
            initPanel?.codeArrived();
            void loadWorktrees();
          }
        } catch {
          clonePoll = window.setTimeout(() => void pollClone(), 3000);
        }
      }

      async function loadMetrics() {
        // An invalid date would drop out of the query and load the whole history; keep the current
        // window instead.
        if (!dateInputsValid(["f-from", "f-to"])) return;
        const qs = windowQS();
        const scoped = (path: string) => {
          const sep = qs ? "&" : "?";
          return `${path}${qs}${sep}project_id=${encodeURIComponent(projectID)}`;
        };
        setBadge($("window-pill"), t("common.status.loading"), "muted", {
          shape: "pill",
          pulse: true,
        });
        try {
          const [metrics, series, byStage, byModel, topTasks] = await Promise.all([
            api.get<ProjectMetrics>(`/projects/${projectID}/metrics${qs}`),
            api.get<{ points: SpendPoint[] }>(scoped("/usage/timeseries")),
            api.get<DimensionRow[]>(scoped("/usage/by-stage")),
            api.get<DimensionRow[]>(scoped("/usage/by-model")),
            api.get<TaskRow[]>(scoped("/usage/top-tasks")),
          ]);
          spendSeries = series.points || [];
          flowSeries = metrics.flow.throughput || [];
          renderKPIs(metrics);
          renderFlowChart();
          renderSpendChart();
          renderDwell(metrics.flow);
          renderCensus(metrics.flow);
          renderDimTable("t-stage", "stage", byStage);
          renderDimTable("t-model", "model", byModel);
          renderTopTasks(topTasks);
          setBadge(
            $("window-pill"),
            t("project.filters.tasks_linked", { count: metrics.flow.tasks_total }),
            "neutral",
            { shape: "pill" },
          );
        } catch (e) {
          setBadge($("window-pill"), t("project.filters.unavailable"), "warn", { shape: "pill" });
          toast(t("project.filters.load_failed", { error: errText(e) }), "err");
        }
      }

      function setKPI(id: string, value: string, sub?: string, trend?: "good" | "bad") {
        setStat($(id), {
          value,
          sub,
          tone: trend === "good" ? "ok" : trend === "bad" ? "danger" : "neutral",
        });
      }

      function markEstimated(id: string, title: string) {
        const el = $(id).querySelector<HTMLElement>(".stat-value");
        if (!el) return;
        el.classList.toggle("est", !!title);
        if (title) el.title = title;
        else el.removeAttribute("title");
      }

      function renderKPIs(m: ProjectMetrics) {
        const f = m.flow;
        const a = m.agent;

        setKPI(
          "k-open",
          String(f.tasks_open),
          t("project.kpis.open_detail", {
            done: f.tasks_done,
            blocked: f.tasks_blocked,
            running: f.tasks_running,
          }),
        );
        setKPI(
          "k-throughput",
          String(f.tasks_completed),
          t("project.kpis.created_in_window", { created: f.tasks_created }),
        );
        setKPI(
          "k-lead",
          f.lead_time.n ? fmtDur(f.lead_time.p50_ms) : "—",
          f.lead_time.n
            ? t("project.kpis.lead_detail", { p90: fmtDur(f.lead_time.p90_ms), n: f.lead_time.n })
            : t("project.kpis.no_completions"),
        );
        setKPI(
          "k-firstpass",
          f.tasks_completed ? fmtPct(f.first_pass_rate) : "—",
          f.tasks_completed
            ? t("project.kpis.first_pass_detail", {
                clean: f.first_pass_tasks,
                completed: f.tasks_completed,
              })
            : t("project.kpis.no_completions_in_window"),
          firstPassTrend(f),
        );

        setKPI(
          "k-rework",
          fmtPct(f.rework_rate),
          t("project.kpis.rework_detail", {
            tasks: t("project.kpis.tasks_count", { count: f.reworked_tasks }),
            kickbacks: t("project.kpis.kickbacks_count", { count: f.kickbacks }),
          }),
          f.rework_rate >= 0.3 ? "bad" : undefined,
        );
        setKPI(
          "k-runs",
          f.tasks_touched ? f.runs_per_task.toFixed(1) : "—",
          t("project.kpis.runs_detail", {
            runs: t("project.kpis.runs_count", { count: f.agent_runs }),
            tasks: t("project.kpis.tasks_count", { count: f.tasks_touched }),
          }),
        );
        setKPI(
          "k-human",
          f.tasks_touched ? f.human_intervention_rate.toFixed(1) : "—",
          t("project.kpis.human_detail", { count: f.human_comments }),
        );
        setKPI(
          "k-cache",
          fmtPct(a.cache_hit_ratio),
          t("project.kpis.error_rate", { rate: fmtPct(a.error_rate) }),
          // Below 40% signals prompt drift or unstable tool schemas; 0 just means no runs yet.
          a.cache_hit_ratio > 0 && a.cache_hit_ratio < 0.4 ? "bad" : undefined,
        );

        const estShare = a.cost_usd > 0 ? (a.estimated_cost_usd || 0) / a.cost_usd : 0;
        const perTask = estimatedCost(a.cost_per_task, a.cost_per_task * estShare, fmtUSD);
        const perDone = estimatedCost(
          a.cost_per_completed_task,
          a.cost_per_completed_task * estShare,
          fmtUSD,
        );
        setKPI(
          "k-cost-task",
          perTask.text,
          t("project.kpis.cost_total", {
            total: estimatedCost(a.cost_usd, a.estimated_cost_usd, fmtUSD, a.unpriced_sessions)
              .text,
            sessions: a.sessions,
          }),
        );
        markEstimated("k-cost-task", perTask.title);
        setKPI(
          "k-cost-done",
          f.tasks_completed ? perDone.text : "—",
          f.tasks_completed
            ? t("project.kpis.cost_vs_touched", { cost: perTask.text })
            : t("project.kpis.nothing_completed"),
        );
        markEstimated("k-cost-done", f.tasks_completed ? perDone.title : "");
        setKPI(
          "k-agent-time",
          a.compute_time_per_task.n ? fmtDur(a.compute_time_per_task.p50_ms) : "—",
          a.wall_time_per_task.n
            ? t("project.kpis.wall_clock", { duration: fmtDur(a.wall_time_per_task.p50_ms) })
            : t("project.kpis.agent_time_median"),
        );
        setKPI(
          "k-tokens-task",
          fmtNum(a.tokens_per_task),
          t("project.kpis.tokens_total", { tokens: fmtNum(a.total_tokens) }),
        );
      }

      function firstPassTrend(f: FlowMetrics): "good" | "bad" | undefined {
        if (!f.tasks_completed) return undefined;
        if (f.first_pass_rate >= 0.8) return "good";
        if (f.first_pass_rate < 0.5) return "bad";
        return undefined;
      }

      function renderFlowChart() {
        const host = $("chart-flow");
        const has = hasFlowData(flowSeries);
        $("chart-flow-empty").hidden = has;
        host.hidden = !has;
        setChartLegend($("chart-flow-legend"), has ? flowLegend() : []);
        if (!has) {
          host.replaceChildren();
          return;
        }
        host.innerHTML = flowChartSVG(flowSeries, {
          width: host.clientWidth || 640,
          height: host.clientHeight || 220,
        });
        host.setAttribute("aria-label", flowSummary(flowSeries));
      }

      let unbindSpend: () => void = () => undefined;
      function renderSpendChart() {
        unbindSpend();
        unbindSpend = () => undefined;
        const host = $("chart-spend");
        const days = usageDays(spendSeries, {
          from: toInstant(readDateInput("f-from")),
          to: toInstant(readDateInput("f-to")),
        });
        const has = days.length > 0;
        $("chart-spend-empty").hidden = has;
        host.hidden = !has;
        if (!has) {
          host.replaceChildren();
          return;
        }
        const series = [usageSeries(spendMetric)];
        const fmt = spendMetric === "cost" ? fmtUSD : fmtNum;
        const end = Date.parse(days[days.length - 1].t);
        const model = timeChart(days, series, {
          width: host.clientWidth || 640,
          height: host.clientHeight || 220,
          rangeMs: Math.max(DAY_MS, end - Date.parse(days[0].t)),
          end,
          intervalMs: DAY_MS,
          fmtY: fmt,
          fmtX: fmtUsageDay,
        });
        host.innerHTML = model.svg;
        host.setAttribute("aria-label", usageChartSummary(days, spendMetric, fmt));
        unbindSpend = bindCrosshair(host, model, days, series, fmt, { fmtTime: fmtUsageDay });
      }

      function stageLabel(id: string): string {
        return stages.find((s) => s.id === id)?.label || id;
      }

      function renderDwell(f: FlowMetrics) {
        const rows = f.stage_dwell.filter((d) => d.n > 0);
        $("dwell-empty").hidden = rows.length > 0;
        const max = Math.max(1, ...rows.map((d) => d.p50_ms));
        $("dwell-bars").innerHTML = chartBarsHTML(
          rows.map((d) => ({
            label: stageLabel(d.stage),
            share: (d.p50_ms / max) * 100,
            value: fmtDur(d.p50_ms),
            sub: t("project.charts.dwell_p90", { value: fmtDur(d.p90_ms) }),
          })),
        );
      }

      function renderCensus(f: FlowMetrics) {
        const rows = f.by_stage;
        $("census-empty").hidden = rows.length > 0;
        const max = Math.max(1, ...rows.map((r) => r.count));
        const wip = f.wip_age.n ? fmtDur(f.wip_age.p90_ms) : "—";
        $("census-bars").innerHTML =
          chartBarsHTML(
            rows.map((r) => ({
              label: stageLabel(r.stage),
              share: (r.count / max) * 100,
              value: String(r.count),
            })),
          ) +
          (rows.length
            ? `<p class="hint">${esc(t("project.charts.census_oldest", { age: wip }))}</p>`
            : "");
      }

