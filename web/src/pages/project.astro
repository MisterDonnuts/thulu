      async function saveSettings() {
        if (!project) return;
        const body = {
          name: ($("s-name") as HTMLInputElement).value.trim(),
          repo_url: ($("s-repo") as HTMLInputElement).value.trim(),
          description: ($("s-desc") as HTMLTextAreaElement).value.trim(),
          default_branch: ($("s-branch") as HTMLInputElement).value.trim() || "main",
          default_board_id: ($("s-board") as HTMLSelectElement).value,
          stage_template: readStageTemplate(
            $("s-template").querySelectorAll<HTMLSelectElement>("[data-stage]"),
          ),
        };
        const missing: [string, string][] = [];
        if (!body.name) missing.push(["s-name", t("projects.errors.name_required")]);
        if (!body.repo_url && project.source !== "upload")
          missing.push(["s-repo", t("projects.errors.repo_required")]);
        clearFormErrors($("panel-settings"));
        missing.forEach(([id, msg], i) => setFieldError($(id), msg, { focus: i === 0 }));
        if (missing.length) return;
        const btn = $("s-save") as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = t("common.status.saving");
        try {
          project = await api.patch<Project>(`/projects/${projectID}`, body);
          renderHeader();
          toast(t("project.settings.saved"), "ok");
        } catch (e) {
          toast(t("project.settings.save_failed", { error: errText(e) }), "err", 4500);
        } finally {
          btn.disabled = false;
          btn.textContent = t("common.buttons.save");
        }
      }

      async function loadCodeBranches() {
        const sel = $("code-branch") as HTMLSelectElement;
        const keep = sel.value;
        try {
          const r = await api.get<{
            default_branch: string;
            branches: string[];
            task_branches?: { branch: string; task_id: string; title?: string }[];
          }>(`/projects/${projectID}/branches`);
          const tasks = r.task_branches ?? [];
          sel.innerHTML =
            r.branches
              .map(
                (b) =>
                  `<option value="${esc(b)}"${b === r.default_branch ? " selected" : ""}>${esc(b)}</option>`,
              )
              .join("") +
            (tasks.length
              ? `<optgroup label="${esc(t("project.code.task_branches"))}">${tasks
                  .map(
                    (tb) =>
                      `<option value="${esc(tb.branch)}">${esc(
                        tb.title
                          ? t("project.code.task_branch", {
                              title: tb.title,
                              id: tb.task_id.slice(0, 6),
                            })
                          : t("project.code.task_branch_untitled", { id: tb.task_id.slice(0, 6) }),
                      )}</option>`,
                  )
                  .join("")}</optgroup>`
              : "");
          if (keep && [...sel.options].some((o) => o.value === keep)) sel.value = keep;
        } catch {
          const b = project?.default_branch || "main";
          sel.innerHTML = `<option value="${esc(b)}">${esc(b)}</option>`;
        }
        syncDownloadLink();
        $("code-replace-note").textContent = t("project.code.replace_note", {
