      function syncDownloadLink() {
        const branch = ($("code-branch") as HTMLSelectElement).value;
        ($("code-download") as HTMLAnchorElement).href =
          `${apiBase()}/projects/${encodeURIComponent(projectID)}/archive?branch=${encodeURIComponent(branch)}`;
      }

      let codePlan: UploadPlan | null = null;
      let codeZip: File | null = null;

      function resetCodeUpload() {
        codePlan = null;
        codeZip = null;
        resetDropZone($("code-drop"));
        $("code-drop-title").textContent = t("project.code.drop_title");
        ($("code-plan") as HTMLElement).hidden = true;
        ($("code-upload") as HTMLButtonElement).disabled = true;
      }

      function renderCodePlan(name: string) {
        const box = $("code-plan") as HTMLElement;
        $("code-drop-title").textContent = name || t("project.code.drop_title");
        box.innerHTML = uploadPlanHTML(codePlan, { zip: codeZip, history: "ignore" });
        box.hidden = false;
        ($("code-upload") as HTMLButtonElement).disabled =
          !codeZip && !(codePlan && codePlan.count > 0);
      }

      function takeCodeFolder(picked: PickedFile[]) {
        codeZip = null;
        pendingArchive = null;
        codePlan = planUpload(picked);
        codePlan.files = codePlan.files.filter((f) => !f.path.startsWith(".git/"));
        const first = picked[0]?.path ?? "";
        renderCodePlan(first.includes("/") ? first.slice(0, first.indexOf("/")) : "");
      }

      function takeCodeZip(f: File) {
        codePlan = null;
        pendingArchive = null;
        codeZip = f;
        renderCodePlan(f.name);
      }

      let pendingArchive: { blob: Blob; name: string } | null = null;

      async function uploadCode(mode: "" | "merge" | "replace" = "") {
        if (!pendingArchive && !codeZip && !codePlan) return;
        const btn = $("code-upload") as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = t("projects.status.packing");
        try {
          if (!mode || !pendingArchive) {
            const blob = codeZip ?? (await buildTarGz(codePlan!.files));
            pendingArchive = { blob, name: codeZip ? codeZip.name : "folder.tar.gz" };
          }
          const archive = pendingArchive;
          if (archive.blob.size > MAX_UPLOAD_BYTES) {
            pendingArchive = null;
            toast(
              t("projects.errors.too_big", {
                size: formatBytes(archive.blob.size),
                max: formatBytes(MAX_UPLOAD_BYTES),
              }),
              "err",
              6000,
            );
            return;
          }
          btn.textContent = t("projects.status.uploading");
          const path = `/projects/${projectID}/upload${mode ? `?mode=${mode}` : ""}`;
          const res = await sendUpload<{ report: UploadReport }>(
            path,
            archive.blob,
            archive.name,
            null,
            (sent, total) => {
              ($("code-progress") as HTMLElement).hidden = false;
              const pct = total > 0 ? Math.round((sent / total) * 100) : 0;
              setMeter($("code-progress-bar"), pct);
              $("code-progress-text").textContent =
                pct >= 100
                  ? t("projects.status.processing")
                  : t("projects.upload.progress", {
                      pct,
                      sent: formatBytes(sent),
                      total: formatBytes(total),
                    });
            },
          );
          const r = res.report;
          pendingArchive = null;
          resetCodeUpload();
          const box = $("code-plan") as HTMLElement;
          box.innerHTML = uploadReportHTML(r, { lead: uploadedText(r) });
          box.hidden = false;
          toast(
            r.changed
              ? t("project.code.uploaded_toast")
              : t("project.code.unchanged", { branch: r.branch }),
            "ok",
          );
          void loadCodeBranches();
        } catch (e) {
          if (e instanceof UploadError && e.status === 409 && showCodeRefusal(e)) return;
          pendingArchive = null;
          const msg =
            e instanceof UploadError && e.message ? e.message : t("projects.errors.unknown");
          toast(t("project.code.upload_failed", { error: msg }), "err", 6000);
        } finally {
          ($("code-progress") as HTMLElement).hidden = true;
          btn.textContent = t("project.code.upload");
          btn.disabled = !!pendingArchive || (!codeZip && !(codePlan && codePlan.count > 0));
        }
      }

      function uploadedText(r: UploadReport): string {
        if (!r.changed) return t("project.code.unchanged", { branch: r.branch });
        const commit = r.commit.slice(0, 7);
        return r.version
          ? t("project.code.uploaded_merged", {
              branch: r.branch,
              version: r.version.slice(0, 7),
              commit,
            })
          : t("project.code.uploaded", { branch: r.branch, commit });
      }

      function showCodeRefusal(e: UploadError): boolean {
        const code = String(e.body.code ?? "");
        const box = $("code-plan") as HTMLElement;
        const replace = buttonHTML({
          label: t("project.code.moved.replace"),
          size: "sm",
          attrs: { "data-code-mode": "replace" },
        });
        if (code === "api.projects.errors.main_moved") {
          box.innerHTML = calloutHTML({
            tone: "warn",
            icon: "warn",
            title: e.message,
            body: t("project.code.moved.explain", {
              branch: String(e.body.branch ?? project?.default_branch ?? "main"),
            }),
            actionsHTML:
              buttonHTML({
                label: t("project.code.moved.merge"),
                variant: "primary",
                size: "sm",
                attrs: { "data-code-mode": "merge" },
              }) + replace,
            attrs: { role: "alert" },
          });
        } else if (code === "api.projects.errors.reupload_conflict") {
          const files = Array.isArray(e.body.conflicts)
            ? (e.body.conflicts as unknown[]).map(String)
            : [];
          box.innerHTML = calloutHTML({
            tone: "warn",
            icon: "warn",
            title: e.message,
            bodyHTML:
              `<ul class="mono">${files.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>` +
              `<p>${esc(t("project.code.moved.conflict_explain"))}</p>`,
            actionsHTML: replace,
            attrs: { role: "alert" },
          });
        } else {
          return false;
        }
        box.hidden = false;
        box.querySelectorAll<HTMLButtonElement>("[data-code-mode]").forEach((b) =>
          b.addEventListener("click", () => {
            const mode = b.dataset.codeMode === "merge" ? "merge" : "replace";
            void uploadCode(mode);
          }),
        );
        return true;
      }

      async function deleteProject() {
        if (!project) return;
        const ok = await confirmDialog({
          title: t("project.danger.confirm_title", { name: project.name }),
          message: t("project.danger.confirm_message"),
          confirmLabel: t("projects.confirm.delete_ok"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/projects/${projectID}`);
        } catch {
          toast(t("project.danger.delete_failed"), "err");
          return;
        }
        void navigate("/projects/");
      }

