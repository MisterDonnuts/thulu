      $("sf-open").addEventListener("click", () => void openStageFiles());

      document.querySelectorAll<HTMLElement>("[data-preset]").forEach((b) =>
        b.addEventListener("click", () => {
          applyPreset(b.dataset.preset!);
          void loadMetrics();
        }),
      );
      ["f-from", "f-to"].forEach((id) =>
        $(id).addEventListener("change", () => {
          activePreset = "";
          setChipsPressed($("f-presets"), null, "preset");
          void loadMetrics();
        }),
      );
      $("spend-metric").addEventListener("change", () => {
        spendMetric = segmentedValue($("spend-metric")) === "tokens" ? "tokens" : "cost";
        renderSpendChart();
      });

      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Escape") return;
          if (credModal.isOpen()) {
            credModal.close();
            return;
          }
          if (ingModal.isOpen()) {
            ingModal.close();
            return;
          }
          if (dashModal.isOpen()) {
            dashModal.close();
            return;
          }
          if (envModal.isOpen()) {
            envModal.close();
            return;
          }
          if (stageModal.isOpen()) stageModal.close();
        },
        { signal },
      );

      // Charts are drawn in viewBox pixels from the container width, so a resize needs a re-render.
      let resizeTimer: number | undefined;
      window.addEventListener(
        "resize",
        () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            if (activeTab() !== "overview") return;
            renderFlowChart();
            renderSpendChart();
          }, 150);
        },
        { signal },
      );

      void bootstrap();
    });
  </script>
</Layout>
