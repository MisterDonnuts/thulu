      let environments: Environment[] = [];
      const envDetail = new Map<string, EnvDetail>();
      const dashData = new Map<string, PanelData[]>();
      // Kept outside the DOM: the panel re-renders on a timer and state read from markup would
      // collapse open dashboards.
      const openDash = new Map<string, string>();

      const envDeps: EnvCardDeps = {
        detail: (id) => envDetail.get(id),
        openDashID: (id) => openDash.get(id),
        dashPanels: (id) => dashData.get(id)?.map((p) => renderPanel(p)),
        fmtSignal: fmtSig,
        sigAge: (bucket) => sigAge(bucket),
        sparkline: (values) => sparklineSVG(values),
        testing: (id) => testingByEnv.get(id),
      };

      let testingByEnv = new Map<string, EnvTesting>();

      async function loadTesting() {
        try {
          const r = await api.get<{
            environments?: Array<EnvTesting & { kind?: string; project_environment_id?: string }>;
          }>(`/evidence/environments?project_id=${encodeURIComponent(projectID)}`);
          testingByEnv = new Map(
            (r.environments ?? [])
              .filter((e) => e.kind === "project" && e.project_environment_id)
              .map((e) => [e.project_environment_id ?? "", e]),
          );
        } catch {
          // Keep what is on screen.
        }
      }

      const emptyCustom: CustomMetricsResponse = {
        metrics: [],
        discovered: 0,
        registered: 0,
        capacity: 0,
      };
      let editingEnvID: string | null = null;
      let credEnvID: string | null = null;

      async function loadEnvironments() {
        try {
          environments =
            (await api.get<Environment[]>(`/projects/${projectID}/environments`)) || [];
        } catch {
          $("env-list").innerHTML = emptyStateHTML({
            size: "sm",
            tone: "danger",
            body: t("project.environments.load_failed"),
          });
          return;
        }
        renderEnvironments();
        await Promise.all([...environments.map(loadEnvDetail), loadTesting()]);
        renderEnvironments();
      }

      // A failed fetch keeps the last known-good detail: falling back to empty repaints tiles as
      // "no data", which reads as broken collection.
      async function loadEnvDetail(e: Environment) {
        const base = `/projects/${projectID}/environments/${e.id}`;
        const prev = envDetail.get(e.id);
        const [mappings, series, custom, dashboards] = await Promise.all([
          api.get<Mapping[]>(`${base}/mappings`).catch(() => prev?.mappings ?? ([] as Mapping[])),
          api
            .get<{ points: SeriesPoint[] }>(`${base}/series`)
            .then((r) => r.points || [])
            .catch(() => prev?.points ?? ([] as SeriesPoint[])),
          api
            .get<CustomMetricsResponse>(`${base}/custom-metrics`)
            .catch(() => prev?.custom ?? emptyCustom),
          api
            .get<Dashboard[]>(`${base}/dashboards`)
            .catch(() => prev?.dashboards ?? ([] as Dashboard[])),
        ]);
        envDetail.set(e.id, { mappings, points: series, custom, dashboards });
        await loadOpenDashboard(e.id);
      }

      async function loadOpenDashboard(envID: string) {
        const detail = envDetail.get(envID);
        const dashboards = detail?.dashboards ?? [];
        let id = openDash.get(envID);
        if (id && !dashboards.some((d) => d.id === id)) {
          openDash.delete(envID);
          id = undefined;
        }
        if (!id) {
          // Proposals are never opened by default: rendering one unasked makes it look adopted.
          const active = dashboards.find((d) => d.status === "active");
          if (!active) return;
          id = active.id;
          openDash.set(envID, id);
        }
        try {
          const res = await api.get<{ panels: PanelData[] }>(
            `/projects/${projectID}/environments/${envID}/dashboards/${id}/data`,
          );
          dashData.set(id, res.panels || []);
        } catch {
          // Keep the last good panels; an empty dashboard reads as "this says
          // nothing", which is a different and worse statement than "the last
          // refresh failed".
        }
      }

      // Collector ticks every 5 min and the cloud publishes late; 1 min is fine because this reads
      // the daemon's database, not the cloud provider's billing.
      const ENV_REFRESH_MS = 60_000;

      let envRefreshing = false;

      // Unlike loadEnvironments, a failure here leaves the screen alone: a timer blip must not wipe
      // a working panel.
      async function refreshEnvironmentsQuietly() {
        // Skip if a round is in flight, the tab is hidden, or a modal is open (re-rendering under
        // an edit).
        // `.overlay.open` is Modal.astro's open shape, same check as dirty.hasOpenModal() in
        // lib/reactive.ts.
        if (envRefreshing || document.visibilityState !== "visible") return;
        if (activeTab() !== "environments") return;
        if (document.querySelector(".overlay.open")) return;
        envRefreshing = true;
        try {
          environments =
            (await api.get<Environment[]>(`/projects/${projectID}/environments`)) || [];
          await Promise.all([...environments.map(loadEnvDetail), loadTesting()]);
          renderEnvironments();
        } catch {
          // Keep what is on screen.
        } finally {
          envRefreshing = false;
        }
      }

      function startEnvAutoRefresh() {
        every(ENV_REFRESH_MS, () => void refreshEnvironmentsQuietly(), signal);
        document.addEventListener(
          "visibilitychange",
          () => {
            if (document.visibilityState === "visible") void refreshEnvironmentsQuietly();
          },
          { signal },
        );
      }

      async function approveMappings(envID: string) {
        const e = environments.find((x) => x.id === envID);
        const ok = await confirmDialog({
          title: t("project.environments.approve_title", { name: e?.name ?? envID }),
          message: t("project.environments.approve_message"),
          confirmLabel: t("project.confirm.approve_mappings"),
        });
        if (!ok) return;
        try {
          const res = await api.post<{ activated: number }>(
            `/projects/${projectID}/environments/${envID}/mappings/approve`,
            {},
          );
          toast(t("project.environments.activated", { count: res.activated }), "ok");
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("project.environments.approve_failed"),
            "err",
          );
          return;
        }
        await loadEnvironments();
      }

      // Rejecting keeps the row: deleting it would let the next export rediscover the metric.
      async function setMetricStatus(envID: string, metricID: string, status: string) {
        try {
          await api.patch(
            `/projects/${projectID}/environments/${envID}/custom-metrics/${metricID}`,
            {
              status,
