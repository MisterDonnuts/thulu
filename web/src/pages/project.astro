      async function renderGhAppRow() {
        if (!project || project.source === "upload") return;
        if (!project.github_installation_id) {
          await renderGhLinkRow();
          return;
        }
        ($("gh-link-row") as HTMLElement).hidden = true;
        const row = $("gh-app-row");
        row.hidden = false;
        let label = String(project.github_installation_id);
        try {
          const installs = await api.get<GithubInstallation[]>("/github/installations");
          const inst = installs.find((i) => i.installation_id === project!.github_installation_id);
          if (inst)
            label = inst.suspended_at
              ? t("project.github.suspended", { account: inst.account_login })
              : inst.account_login;
        } catch {
          // Fall back to the raw id — the link itself is what matters here.
        }
        $("gh-app-status").innerHTML = t("project.github.linked_html", {
          installation: esc(label),
        });
