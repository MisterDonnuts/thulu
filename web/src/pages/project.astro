      let chartCatalog: ChartCatalog | null = null;
      let editingDash: {
        envID: string;
        dashID: string | null;
        name: string;
        panels: PanelSpec[];
      } | null = null;

      async function chartTypes(): Promise<ChartCatalog> {
        chartCatalog ??= await api.get<ChartCatalog>("/chart-types");
        return chartCatalog;
      }

      function approvedMetrics(envID: string): CustomMetric[] {
        return (envDetail.get(envID)?.custom.metrics ?? []).filter((m) => m.status === "approved");
      }

      async function openDashEditor(envID: string, dashID: string | null) {
        try {
          await chartTypes();
        } catch {
          toast(t("project.dashboards.catalog_failed"), "err");
          return;
        }
        const existing = dashID
          ? envDetail.get(envID)?.dashboards.find((d) => d.id === dashID)
          : undefined;
        let panels: PanelSpec[] = [];
        if (dashID) {
          // Read stored panels, not resolved ones: the resolved shape lacks the spec and saving it
          // back would corrupt the dashboard.
          try {
            const full = await api.get<{ panels: PanelSpec[] }>(
              `/projects/${projectID}/environments/${envID}/dashboards/${dashID}`,
            );
            panels = full.panels || [];
          } catch {
            toast(t("project.dashboards.load_failed"), "err");
            return;
          }
        } else {
          panels = [blankPanel(approvedMetrics(envID))].filter(Boolean) as PanelSpec[];
        }
        editingDash = { envID, dashID, name: existing?.name ?? "", panels };
        $("dash-modal-title").textContent = dashID
          ? t("project.dashboards.edit")
          : t("project.dashboards.new");
        ($("dm-name") as HTMLInputElement).value = editingDash.name;
        setFormError($("dm-error"), "");
        renderDashEditor();
        dashModal.open($("dm-name"));
      }

      function renderDashEditor() {
        if (!editingDash || !chartCatalog) return;
        const metrics = approvedMetrics(editingDash.envID);
        const catalog = chartCatalog;
        const rows = editingDash.panels
          .map((p, i) => panelRowHTML(p, i, metrics, catalog))
          .join("");
        $("dm-panels").innerHTML =
          rows || emptyStateHTML({ size: "sm", body: t("project.dashboards.empty") });

        $("dm-panels")
          .querySelectorAll<HTMLElement>("[data-dp]")
          .forEach((el) => {
            const idx = Number(el.dataset.dp);
            const field = el.dataset.dpField!;
            el.addEventListener("change", () => {
              const p = editingDash?.panels[idx];
              if (!p) return;
              const value = (el as HTMLInputElement | HTMLSelectElement).value;
              if (applyPanelEdit(p, field, value, approvedMetrics(editingDash!.envID), catalog)) {
                renderDashEditor();
              }
            });
          });
        $("dm-panels")
          .querySelectorAll<HTMLElement>("[data-dp-del]")
          .forEach((el) =>
            el.addEventListener("click", () => {
              editingDash!.panels.splice(Number(el.dataset.dpDel), 1);
              renderDashEditor();
            }),
          );
      }

      async function saveDashboard() {
        if (!editingDash) return;
        const body = {
          name: ($("dm-name") as HTMLInputElement).value.trim(),
          panels: editingDash.panels,
        };
        const base = `/projects/${projectID}/environments/${editingDash.envID}/dashboards`;
        const err = $("dm-error");
        setFormError(err, "");
        try {
          if (editingDash.dashID) {
            await api.put(`${base}/${editingDash.dashID}`, body);
          } else {
            const created = await api.post<{ id: string }>(base, body);
            await api.post(`${base}/${created.id}/approve`, {});
            openDash.set(editingDash.envID, created.id);
          }
        } catch (e) {
          setFormError(
            err,
            e instanceof ApiError ? e.message : t("project.dashboards.save_failed"),
          );
          return;
        }
        toast(t("project.dashboards.saved"), "ok");
        dashModal.close();
        await loadEnvironments();
      }

      async function collectNow(envID: string, btn: HTMLButtonElement) {
        btn.disabled = true;
        try {
          const res = await api.post<{ points: number; note?: string }>(
            `/projects/${projectID}/environments/${envID}/collect`,
            {},
          );
          if (res.note) {
            toast(res.note, "err");
          } else if (res.points === 0) {
            toast(t("project.environments.collected_nothing"), "ok");
          } else {
            toast(t("project.environments.collected", { count: res.points }), "ok");
          }
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("project.environments.collect_failed"),
            "err",
          );
        } finally {
          btn.disabled = false;
        }
        await loadEnvironments();
      }

      function renderEnvironments() {
        if (!environments.length) {
          $("env-list").innerHTML = emptyStateHTML({
            size: "sm",
            body: t("project.environments.empty"),
          });
          return;
        }
        const focused = document.activeElement?.id;
        $("env-list").innerHTML = envListHTML(environments, envDeps);
        if (focused && $("env-list").contains(document.getElementById(focused)))
          document.getElementById(focused)?.focus();

        wire("[data-env-cred]", (b) => void openCredModal(b.dataset.envCred!));
        wire("[data-env-ingest]", (b) => void openIngestModal(b.dataset.envIngest!));
        wire("[data-env-edit]", (b) => openEnvModal(b.dataset.envEdit!));
        wire("[data-env-del]", (b) => void deleteEnvironment(b.dataset.envDel!));
        wire("[data-env-approve]", (b) => void approveMappings(b.dataset.envApprove!));
        wire(
          "[data-cm-approve]",
          (b) => void setMetricStatus(b.dataset.cmApprove!, b.dataset.cmId!, "approved"),
        );
        wire(
          "[data-cm-reject]",
          (b) => void setMetricStatus(b.dataset.cmReject!, b.dataset.cmId!, "rejected"),
        );
        wire(
          "[data-cm-reset]",
          (b) => void setMetricStatus(b.dataset.cmReset!, b.dataset.cmId!, "discovered"),
        );
        wire("[data-cm-delete]", (b) => void deleteMetric(b.dataset.cmDelete!, b.dataset.cmId!));
        $("env-list")
          .querySelectorAll<HTMLElement>("[data-dash-env]")
          .forEach((strip) =>
            bindTabs(strip, {
              onChange: (id, { user }) => {
                if (user) void openDashboard(strip.dataset.dashEnv!, id);
              },
            }),
          );
        wire(
          "[data-dash-approve]",
          (b) => void approveDashboard(b.dataset.dashApprove!, b.dataset.dashId!),
        );
        wire("[data-dash-del]", (b) => void deleteDashboard(b.dataset.dashDel!, b.dataset.dashId!));
        wire(
          "[data-dash-remove]",
          (b) => void deleteDashboard(b.dataset.dashRemove!, b.dataset.dashId!, true),
        );
        wire("[data-dash-new]", (b) => void openDashEditor(b.dataset.dashNew!, null));
        wire(
          "[data-dash-edit]",
          (b) => void openDashEditor(b.dataset.dashEdit!, b.dataset.dashId!),
        );
        wire(
          "[data-env-collect]",
          (b) => void collectNow(b.dataset.envCollect!, b as HTMLButtonElement),
        );
      }

      function wire(selector: string, fn: (el: HTMLElement) => void) {
        wireIn("env-list", selector, fn);
      }

      function wireIn(containerID: string, selector: string, fn: (el: HTMLElement) => void) {
        $(containerID)
          .querySelectorAll<HTMLElement>(selector)
          .forEach((el) => el.addEventListener("click", () => fn(el)));
      }

      function openEnvModal(id: string | null) {
        editingEnvID = id;
        const e = id ? environments.find((x) => x.id === id) : null;
        $("env-modal-title").textContent = e
          ? t("project.environments.edit_title", { name: e.name })
          : t("project.environments.add");
        ($("env-name") as HTMLInputElement).value = e?.name ?? "";
        ($("env-display-name") as HTMLInputElement).value = e?.display_name ?? "";
        ($("env-system") as HTMLInputElement).value = e?.system ?? "";
        ($("env-provider") as HTMLSelectElement).value = e?.provider ?? "aws";
        ($("env-region") as HTMLInputElement).value = e?.region ?? "";
        ($("env-account") as HTMLInputElement).value = e?.account ?? "";
        ($("env-url") as HTMLInputElement).value = e?.url ?? "";
        ($("env-selectors") as HTMLTextAreaElement).value = formatSelectors(e?.selectors);
        ($("env-prod") as HTMLInputElement).checked = e?.is_production ?? false;
        clearFormErrors($("env-modal"));
        ($("env-cred-name") as HTMLInputElement).value = "";
        ($("env-cred-pick") as HTMLSelectElement).innerHTML = "";
        $("env-cred-new").hidden = true;
        envModal.open($("env-name"));
        void ensureCredentialsLoaded().then(syncEnvCredRow);
      }

      async function ensureCredentialsLoaded(force = false) {
        if (!force && workspaceCreds.length && credProviders.length) return;
        const [credsResp, provs] = await Promise.all([
          listCredentials().catch(() => [] as ManagedCredential[]),
          credProviders.length ? Promise.resolve(credProviders) : fetchProviders(),
        ]);
        workspaceCreds = credsResp;
        credProviders = provs.filter((p) => !p.connect);
      }

      function envCredProvider(): string {
        return ($("env-provider") as HTMLSelectElement).value;
      }
      function envCredKind(): KindSpec | undefined {
        const p = credProviders.find((x) => x.id === envCredProvider());
        const id = ($("env-cred-kind") as HTMLSelectElement).value;
        return p?.kinds.find((k) => k.id === id);
      }

      function renderEnvCredFields() {
        $("env-cred-fields").innerHTML = fieldInputs(envCredKind(), "envcredf-");
      }

      function syncEnvCredRow() {
        const provider = envCredProvider();
        const row = $("env-cred-row");
        row.hidden = !CLOUD_PROVIDERS.has(provider);
        if (row.hidden) return;

        const current = editingEnvID ? credentialForEnv(workspaceCreds, editingEnvID) : undefined;
        const fits = workspaceCreds.filter((c) => c.provider === provider || c.id === current?.id);
        const sel = $("env-cred-pick") as HTMLSelectElement;
        const previous = sel.value;
        const canCreate = credProviders.some((p) => p.id === provider);
        sel.innerHTML =
          `<option value="">${esc(t("project.labels.none"))}</option>` +
          fits.map((c) => `<option value="${esc(c.id)}">${esc(credLabel(c))}</option>`).join("") +
          (canCreate
            ? `<option value="${NEW_CRED}">${esc(t("project.labels.new_credential"))}</option>`
            : "");
        sel.value = [...sel.options].some((o) => o.value === previous)
          ? previous
          : (current?.id ?? "");

        const kindSel = $("env-cred-kind") as HTMLSelectElement;
        const spec = credProviders.find((p) => p.id === provider);
        kindSel.innerHTML = kindOptions(spec);
        $("env-cred-kind-row").hidden = (spec?.kinds.length ?? 0) < 2;

        const creating = sel.value === NEW_CRED;
        $("env-cred-new").hidden = !creating;
        if (creating) renderEnvCredFields();
        else $("env-cred-fields").innerHTML = "";

        $("env-cred-hint").textContent = creating
          ? t("project.credentials.validated_hint")
          : fits.length
            ? t("project.env_form.cred_resolves")
            : t("project.env_form.cred_none_for_provider");
      }

      // Runs after the environment is saved (a grant needs its id), so a rejected key still leaves
      // a usable environment.
      async function applyEnvCredential(envID: string) {
        if ($("env-cred-row").hidden) return;
        const picked = ($("env-cred-pick") as HTMLSelectElement).value;
        const current = credentialForEnv(workspaceCreds, envID);
        if (picked !== NEW_CRED && picked === (current?.id ?? "")) return;

        if (picked === NEW_CRED) {
          const name = ($("env-cred-name") as HTMLInputElement).value.trim();
          if (!name) throw new Error(t("project.env_form.cred_name_or_none"));
          const payload = readPayload(envCredKind(), "envcredf-");
          if (!Object.keys(payload).length)
            throw new Error(t("project.credentials.fields_required"));
          const created = await createCredential({
            name,
            provider: envCredProvider(),
            kind: ($("env-cred-kind") as HTMLSelectElement).value,
            payload,
            grants: [{ subject_type: "environment", subject_id: envID }],
          });
          toast(checkSummary(created), checkTone(created), 6000);
          return;
        }
        await attachExisting(envID, picked);
      }

      async function saveEnvironment() {
        const body = {
          name: ($("env-name") as HTMLInputElement).value.trim(),
          display_name: ($("env-display-name") as HTMLInputElement).value.trim(),
          system: ($("env-system") as HTMLInputElement).value.trim(),
          provider: ($("env-provider") as HTMLSelectElement).value,
          region: ($("env-region") as HTMLInputElement).value.trim(),
          account: ($("env-account") as HTMLInputElement).value.trim(),
          url: ($("env-url") as HTMLInputElement).value.trim(),
          selectors: parseSelectors(($("env-selectors") as HTMLTextAreaElement).value),
          is_production: ($("env-prod") as HTMLInputElement).checked,
        };
        const err = $("env-error");
        clearFormErrors($("env-modal"));
        // Validate the new credential's name before saving anything, or half the form would be
        // applied.
        const creatingCred =
          !$("env-cred-row").hidden && ($("env-cred-pick") as HTMLSelectElement).value === NEW_CRED;
        if (creatingCred && !($("env-cred-name") as HTMLInputElement).value.trim()) {
          setFieldError($("env-cred-name"), t("project.env_form.cred_name_or_none"), {
            focus: true,
          });
          return;
        }
        const btn = $("env-save") as HTMLButtonElement;
        btn.disabled = true;
        try {
          const saved = editingEnvID
            ? await api.patch<Environment>(
                `/projects/${projectID}/environments/${editingEnvID}`,
                body,
              )
            : await api.post<Environment>(`/projects/${projectID}/environments`, body);
          try {
            await applyEnvCredential(saved.id);
          } catch (credErr) {
            await loadEnvironments();
            await ensureCredentialsLoaded(true);
            setFormError(
              err,
              t("project.environments.saved_without_credential", {
                error: credErr instanceof Error ? credErr.message : String(credErr),
              }),
            );
            return;
          }
          envModal.close();
          toast(t("project.environments.saved"), "ok");
          await ensureCredentialsLoaded(true);
          await loadEnvironments();
        } catch (e) {
          const fieldID = e instanceof ApiError ? envErrorField(e.body) : undefined;
          if (fieldID) setFieldError($(fieldID), errText(e), { focus: true });
          else
            setFormError(
              err,
              e instanceof ApiError ? e.message : t("project.environments.save_failed"),
            );
        } finally {
          btn.disabled = false;
        }
      }

      async function deleteEnvironment(id: string) {
        const e = environments.find((x) => x.id === id);
        if (!e) return;
        const ok = await confirmDialog({
          title: t("project.environments.delete_title", { name: e.name }),
          message: e.has_credential
            ? t("project.environments.delete_message_with_credential")
            : t("project.environments.delete_message"),
          confirmLabel: t("project.confirm.delete_environment"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/projects/${projectID}/environments/${id}`);
        } catch {
          toast(t("project.environments.delete_failed"), "err");
          return;
        }
        toast(t("project.environments.deleted", { name: e.name }), "ok");
        await loadEnvironments();
      }

      let workspaceCreds: ManagedCredential[] = [];
      let credProviders: ProviderSpec[] = [];

      function newCredProvider(): ProviderSpec | undefined {
        const id = ($("cred-new-provider") as HTMLSelectElement).value;
        return credProviders.find((p) => p.id === id);
      }
      function newCredKind(): KindSpec | undefined {
        const id = ($("cred-new-kind") as HTMLSelectElement).value;
        return newCredProvider()?.kinds.find((k) => k.id === id);
      }

      function renderNewCredKinds() {
        const p = newCredProvider();
        ($("cred-new-kind") as HTMLSelectElement).innerHTML = kindOptions(p);
        $("cred-new-kind-row").hidden = (p?.kinds.length ?? 0) < 2;
        $("cred-new-help").textContent = p?.help ?? "";
        renderNewCredFields();
      }

      function renderNewCredFields() {
        $("cred-new-fields").innerHTML = fieldInputs(newCredKind(), "credf-");
      }

      function syncCredMode() {
        const creating = ($("cred-pick") as HTMLSelectElement).value === NEW_CRED;
        $("cred-new").hidden = !creating;
        $("cred-save").textContent = creating
          ? t("project.credentials.validate_save")
          : t("common.buttons.save");
        if (creating && !$("cred-new-fields").innerHTML) renderNewCredKinds();
      }

      function renderCredPicker(envID: string) {
        const e = environments.find((x) => x.id === envID);
        const current = credentialForEnv(workspaceCreds, envID);
        const sel = $("cred-pick") as HTMLSelectElement;

        const fits = workspaceCreds.filter(
          (c) => !e?.provider || !c.provider || c.provider === e.provider || c.id === current?.id,
        );

        sel.innerHTML =
          `<option value="">${esc(t("project.labels.none"))}</option>` +
          fits.map((c) => `<option value="${esc(c.id)}">${esc(credLabel(c))}</option>`).join("") +
          (credProviders.length
            ? `<option value="${NEW_CRED}">${esc(t("project.labels.new_credential"))}</option>`
            : "");
        sel.value = current?.id ?? "";

        const provSel = $("cred-new-provider") as HTMLSelectElement;
        provSel.innerHTML = providerOptions(credProviders);
        if (e?.provider && credProviders.some((p) => p.id === e.provider))
          provSel.value = e.provider;
        $("cred-new-provider-row").hidden = credProviders.length < 2;
        $("cred-new-fields").innerHTML = "";
        ($("cred-new-name") as HTMLInputElement).value = "";

        const hint = $("cred-hint");
        if (!workspaceCreds.length) {
          hint.textContent = t("project.credentials.none_in_workspace");
        } else if (!fits.length) {
          hint.textContent = t("project.credentials.none_for_provider", {
            provider: e?.provider ?? "",
          });
        } else {
          const environment = e?.name ?? t("project.credentials.this_environment");
          hint.textContent = current
            ? t("project.credentials.resolves", { credential: current.name, environment })
            : t("project.credentials.nothing_granted", { environment });
        }
        syncCredMode();
      }

      async function openCredModal(envID: string) {
        credEnvID = envID;
        const e = environments.find((x) => x.id === envID);
        $("cred-modal-title").textContent = t("project.credentials.title_named", {
          name: e?.name ?? "",
        });
        clearFormErrors($("cred-modal"));
        ($("cred-pick") as HTMLSelectElement).innerHTML =
          `<option>${esc(t("common.status.loading"))}</option>`;
        $("cred-new").hidden = true;
        credModal.open();

        await ensureCredentialsLoaded(true);
        renderCredPicker(envID);
      }

      async function attachExisting(envID: string, picked: string) {
        const current = credentialForEnv(workspaceCreds, envID);
        // Detach first so an environment is never granted to two credentials; the resolver could
        // not pick one.
        if (current) {
          await api.put(`/credentials/${current.id}/grants`, {
            grants: grantsWithout(current, envID),
          });
        }
        if (picked) {
          const next = workspaceCreds.find((c) => c.id === picked);
          await api.put(`/credentials/${picked}/grants`, { grants: grantsWith(next, envID) });
        }
        toast(picked ? t("project.credentials.attached") : t("project.credentials.detached"), "ok");
      }

      // Detach the previous credential only after the new key validates, so a rejected key never
      // leaves the environment with nothing.
      async function createAndAttach(envID: string) {
        const name = ($("cred-new-name") as HTMLInputElement).value.trim();
        if (!name) throw new Error(t("project.credentials.name_first"));
        const provider = ($("cred-new-provider") as HTMLSelectElement).value;
        const kind = ($("cred-new-kind") as HTMLSelectElement).value;
        const payload = readPayload(newCredKind(), "credf-");
        if (!Object.keys(payload).length) throw new Error(t("project.credentials.fields_required"));

        const created = await createCredential({
          name,
          provider,
          kind,
          payload,
          grants: [{ subject_type: "environment", subject_id: envID }],
        });
        const previous = credentialForEnv(workspaceCreds, envID);
        if (previous && previous.id !== created.id) {
          await api.put(`/credentials/${previous.id}/grants`, {
            grants: grantsWithout(previous, envID),
          });
        }
        toast(checkSummary(created), checkTone(created), 6000);
      }

      async function saveCredential() {
        if (!credEnvID) return;
        const envID = credEnvID;
        const picked = ($("cred-pick") as HTMLSelectElement).value;
        const err = $("cred-error");
        clearFormErrors($("cred-modal"));
        if (picked !== NEW_CRED && picked === (credentialForEnv(workspaceCreds, envID)?.id ?? "")) {
          credModal.close();
          return;
        }
        if (picked === NEW_CRED && !($("cred-new-name") as HTMLInputElement).value.trim()) {
          setFieldError($("cred-new-name"), t("project.credentials.name_first"), { focus: true });
          return;
        }
        const btn = $("cred-save") as HTMLButtonElement;
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent =
          picked === NEW_CRED ? t("project.credentials.checking") : t("common.status.saving");
        try {
          if (picked === NEW_CRED) await createAndAttach(envID);
          else await attachExisting(envID, picked);
          credModal.close();
          await loadEnvironments();
        } catch (e) {
          setFormError(err, e instanceof Error ? e.message : t("project.credentials.save_failed"));
        } finally {
          btn.disabled = false;
          btn.textContent = label;
        }
      }

      let ingEnvID: string | null = null;

      function ingBase(): string {
        return `/projects/${projectID}/environments/${ingEnvID}`;
      }

      async function openIngestModal(envID: string) {
        ingEnvID = envID;
        const e = environments.find((x) => x.id === envID);
        $("ing-modal-title").textContent = e
          ? t("project.telemetry.title_named", { name: e.name })
          : t("project.telemetry.title");
        $("ing-new").hidden = true;
        setFormError($("ing-error"), "");
        ($("ing-name") as HTMLInputElement).value = "";
        $("ing-tokens").innerHTML = `<div class="muted">${esc(t("common.status.loading"))}</div>`;
        $("ing-sources").innerHTML = "";
        ingModal.open();
        await refreshIngest();
      }

      async function refreshIngest() {
        if (!ingEnvID) return;
        const [tokens, sources] = await Promise.all([
          api.get<IngestToken[]>(`${ingBase()}/ingest-tokens`).catch(() => null),
          api.get<IngestSource[]>(`${ingBase()}/ingest-sources`).catch(() => [] as IngestSource[]),
        ]);
        if (tokens === null) {
          $("ing-tokens").innerHTML = emptyStateHTML({
            size: "sm",
            tone: "danger",
            body: t("project.telemetry.load_failed"),
          });
          return;
        }
        $("ing-tokens").innerHTML = ingestTokensHTML(tokens);
        wireIn("ing-tokens", "[data-ing-cidr]", (b) => void editIngestCIDRs(b.dataset.ingCidr!));
        wireIn(
          "ing-tokens",
          "[data-ing-revoke]",
          (b) => void revokeIngestToken(b.dataset.ingRevoke!),
        );
        $("ing-sources").innerHTML = ingestSourcesHTML(sources || [], tokens);
      }

      async function createIngestToken() {
        if (!ingEnvID) return;
        const err = $("ing-error");
        setFormError(err, "");
        const nameInput = $("ing-name") as HTMLInputElement;
        const name = nameInput.value.trim();
        if (!name) {
          setFormError(err, t("project.telemetry.name_required"));
          nameInput.focus();
          return;
        }
        try {
          const [res, setting] = await Promise.all([
            api.post<{ raw: string }>(`${ingBase()}/ingest-tokens`, { name }),
            // Unset answers 404, which means fall back to the browser's origin, not an error.
            api.get<string>("/settings/ingest.public_url").catch(() => ""),
          ]);
          const where = ingestBase(
            typeof setting === "string" ? setting : "",
            window.location.origin,
          );
          $("ing-secret").textContent = res.raw;
          $("ing-snippet").textContent = collectorSnippet(res.raw, where.base);
          const warn = $("ing-addr-warn");
          warn.hidden = where.fromSetting;
          warn.textContent = where.fromSetting
            ? ""
            : t("project.telemetry.address_fallback", { origin: where.base });
          nameInput.value = "";
          $("ing-new").hidden = false;
          await refreshIngest();
        } catch (e) {
          setFormError(
            err,
            e instanceof ApiError ? e.message : t("project.telemetry.create_failed"),
          );
        }
      }

      async function editIngestCIDRs(tokenID: string) {
        if (!ingEnvID) return;
        const current = await api
          .get<IngestToken[]>(`${ingBase()}/ingest-tokens`)
          .then((ts) => ts.find((tok) => tok.id === tokenID))
          .catch(() => null);
        const answer = await confirmDialog({
          title: t("project.telemetry.cidr_title"),
          icon: "zap",
          confirmLabel: t("project.confirm.save_addresses"),
          bodyHTML: fieldHTML({
            label: t("project.telemetry.cidr_label"),
            for: "ing-cidrs",
            hint: t("project.telemetry.cidr_hint"),
            help: t("project.telemetry.cidr_help"),
            control: `<input id="ing-cidrs" name="cidrs" class="mono" autocomplete="off" spellcheck="false" aria-describedby="ing-cidrs-help" value="${esc((current?.allow_cidrs || []).join(", "))}" />`,
          }),
        });
        if (!answer.ok) return;
        const cidrs = parseCIDRs(String(answer.values.cidrs ?? ""));
        try {
          await api.patch(`${ingBase()}/ingest-tokens/${tokenID}`, { allow_cidrs: cidrs });
          toast(
            cidrs.length
              ? t("project.telemetry.allowlist_updated")
              : t("project.telemetry.any_address"),
            "ok",
          );
          await refreshIngest();
        } catch (e) {
          toast(e instanceof ApiError ? e.message : t("project.telemetry.allowlist_failed"), "err");
        }
      }

      async function revokeIngestToken(tokenID: string) {
        if (!ingEnvID) return;
        const ok = await confirmDialog({
          title: t("project.telemetry.revoke_title"),
          message: t("project.telemetry.revoke_message"),
          confirmLabel: t("project.confirm.revoke_token"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`${ingBase()}/ingest-tokens/${tokenID}`);
          toast(t("project.telemetry.revoked"), "ok");
          await refreshIngest();
        } catch (e) {
          toast(e instanceof ApiError ? e.message : t("project.telemetry.revoke_failed"), "err");
        }
      }

