          );
          toast(
            status === "approved"
              ? t("project.environments.metric_approved")
              : status === "rejected"
                ? t("project.environments.metric_rejected")
                : t("project.environments.metric_reopened"),
            "ok",
          );
        } catch (err) {
          toast(
            err instanceof ApiError ? err.message : t("project.environments.metric_failed"),
            "err",
          );
          return;
        }
        await loadEnvironments();
      }

