      async function pruneStageFiles() {
        if (!smState?.orphans?.length) return;
        const ok = await confirmDialog({
          title: t("project.stage_files.prune_title"),
          message: t("project.stage_files.prune_message", { files: smState.orphans.join(", ") }),
          confirmLabel: t("project.confirm.prune_files"),
          danger: true,
        });
        if (!ok) return;
        try {
          const res = await api.post<{ stages: string[]; files: string[] }>(
            `/projects/${projectID}/stage-files/prune`,
