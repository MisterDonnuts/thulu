      const TAB_IDS = ["overview", "environments", "repo", "settings"] as const;
      type TabID = (typeof TAB_IDS)[number];
      // The infra cache table and the sandboxes page link to #init-script.
      const SECTION_TAB: Record<string, TabID> = { "init-script": "repo" };

      function tabFromHash(): TabID {
        const h = location.hash.replace(/^#/, "");
        if (Object.hasOwn(SECTION_TAB, h)) return SECTION_TAB[h];
        return (TAB_IDS as readonly string[]).includes(h) ? (h as TabID) : "overview";
      }

      // The browser's own anchor jump ran while the tab was hidden, so scroll again once it shows.
      function revealSection() {
        const h = location.hash.replace(/^#/, "");
        if (Object.hasOwn(SECTION_TAB, h))
          document.getElementById(h)?.scrollIntoView({ block: "start" });
      }

      let tabsReady = false;
      const tabs = bindTabs($("proj-tabs"), {
        onChange: (id, { user }) => {
          const tab = id as TabID;
          if (user)
            replaceURL(tab === "overview" ? location.pathname + location.search : `#${tab}`);
          if (!tabsReady) return;
          // Charts size from their container, which has no width while its tab is hidden.
          if (tab === "overview") {
            renderFlowChart();
            renderSpendChart();
          }
          if (tab === "environments") void refreshEnvironmentsQuietly();
        },
      });
      const activeTab = (): TabID => (tabs.current() as TabID | undefined) ?? "overview";

      window.addEventListener(
        "hashchange",
        () => {
          tabs.select(tabFromHash());
          revealSection();
        },
        { signal },
      );
      tabs.select(tabFromHash());
      tabsReady = true;
      revealSection();

