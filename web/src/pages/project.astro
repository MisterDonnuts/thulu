      async function openStageFileEditor(kind: string, stage: string) {
        if (!smState) return;
        const set = smState.sets.find((s) => s.kind === kind);
        const entry = set?.stages.find((e) => e.stage === stage);
        if (!entry) return;
        let initial = "";
        if (entry.exists) {
          try {
            initial = await api.getText(`/projects/${projectID}/stage-files/${kind}/${stage}`);
          } catch {
            // Fall through with an empty editor — the save path surfaces errors.
          }
        } else if (kind === "hooks") {
          initial = HOOK_TEMPLATE;
        }
        smOriginal = entry.exists ? initial : "";
        renderStageFileEditor(kind, stage, entry, initial);
      }

      function renderStageFileEditor(
        kind: string,
        stage: string,
        entry: StageEntry,
        initial: string,
      ) {
        $("sm-body").innerHTML = stageEditorHTML(entry, initial);

        wireMdEditor({
          ta: $("sm-text") as HTMLTextAreaElement,
          saveBtn: $("sf-save") as HTMLButtonElement,
          stateEl: $("sf-state"),
          backBtn: $("sf-back"),
          isCreate: !entry.exists,
          getOriginal: () => smOriginal,
          setOriginal: (v) => {
            smOriginal = v;
          },
          save: (text) => api.putText(`/projects/${projectID}/stage-files/${kind}/${stage}`, text),
          onSaveError: () => toast(t("project.stage_files.save_failed"), "err"),
          onSaved: () => toast(t("project.stage_files.saved", { path: entry.path }), "ok", 1800),
          discardMessage: t("project.stage_files.edits_lost"),
          onBack: () => loadStageFiles(),
        });
      }

