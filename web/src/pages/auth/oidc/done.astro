---
import { locale, t } from "../../../i18n";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{t("auth.oidc.signing_in")}</title>
    <style>
      /* This page is a redirect with a
         line of text on it, so it takes the palette and nothing else: no
         reset, no primitives, no webfont. */
      @import "../../../styles/tokens.css";

      body {
        margin: 0;
        background: var(--surface-0);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: var(--t-base);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .oidc-msg {
        color: var(--fg-3);
      }
    </style>
  </head>
  <body>
    <p class="oidc-msg" id="msg">{t("auth.oidc.signing_in")}</p>
    <script>
      import { sameOriginPath } from "../../../lib/safe-url";
      import { t } from "../../../i18n";

      (function () {
        const params = new URLSearchParams(window.location.search);
        const error = params.get("error");
        if (error) {
          document.getElementById("msg")!.textContent = t("auth.oidc.failed", { error });
          setTimeout(() => {
            window.location.replace("/login");
          }, 2500);
          return;
        }
        // Same origin only: "/\evil.com" is "//evil.com" to the browser.
        window.location.replace(sameOriginPath(params.get("next"), window.location.origin));
      })();
    </script>
  </body>
</html>
