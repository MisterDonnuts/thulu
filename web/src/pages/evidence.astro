    }

    /* ── Touch: 44px targets ─────────────────────────────────────────────── */
    /* Buttons, tabs, chips, menu rows and filter controls take their own tap
       area from the primitives; these are the inline links. */
    @media (pointer: coarse) {
      .ev-sandbox-off a,
      .ev-group-link,
      .ev-bringup-fail a,
      #ef-prod-hint a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
    }

    /* ── Phones ────────────────────────────────────────────────────────── */
    @media (max-width: 900px) {
      .ev-d-pair {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 640px) {
      .ev-page {
        --page-pad-x: 16px;
        --page-pad-y: 20px;
      }
      .ev-page .page-head-actions {
        display: none;
      }
      /* Auto basis: a button that does not fit beside the others drops to
         its own row and fills it, instead of every button shrinking until
         its label breaks. */
      .ev-toolbar .filter-bar-end .btn-md {
        flex: 1 1 auto;
      }
      .ev-env-grid {
        grid-template-columns: 1fr;
      }
      .ev-scope .field-filter {
        flex: 1;
      }
      .ev-scope .field-filter > select {
        flex: 1;
        min-width: 0;
      }

      .ev-d-actions .btn {
        flex: 1 1 auto;
      }
      .ev-d-actions .btn-danger {
        margin-left: 0;
      }
      .ev-login {
        grid-template-columns: 1fr auto;
      }
      .ev-login > :nth-child(2) {
        grid-column: 1 / -1;
        grid-row: 2;
      }
      /* The search gets the whole row, so its placeholder reads in full. */
      .ev-field-search {
        flex-basis: 100%;
      }
      /* Four tabs on one phone row: words only. */
      .ev-tabs .tab .ico {
        display: none;
      }
    }
