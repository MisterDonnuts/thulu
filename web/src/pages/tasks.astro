        thread_applied: "tasks.runs.event_kinds.thread_applied",
        branch_created: "tasks.runs.event_kinds.branch_created",
        pr_opened: "tasks.runs.event_kinds.pr_opened",
        branch_merged: "tasks.runs.event_kinds.branch_merged",
        section_updated: "tasks.runs.event_kinds.section_updated",
        checklist_toggled: "tasks.runs.event_kinds.checklist_toggled",
