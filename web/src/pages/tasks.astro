      interface PropRow {
        key: string;
        label: string;
        icon: string;
        value: string;
        edit: string;
        wide?: boolean;
      }

      function propRows(task: Task): PropRow[] {
        const parent = task.parent_id ? parentTask : null;
        const stage = stageInfo(task.stage);
        const hint = agentHint({
          stage: task.stage,
          assignments: task.stage_assignments || {},
          flow: flowOf(task).map((s) => ({ id: s.id, label: s.label })),
          isSubtask: !!task.parent_id,
          initial: initialStage(),
        });
        const agentValue = hint.replaces
          ? `<span class="prop-line">${esc(hint.line)}</span>`
          : (hint.agent
              ? agentChipHTML(hint.agent)
              : emptyValueHTML(t("tasks.drawer.props.summary_no_agent_long"))) +
            (hint.line ? `<span class="prop-line">${esc(hint.line)}</span>` : "");
        const type = taskTypeOf(taskTypes, task.type_id);
        const owner = parent || task;
        const ownerPRs = Object.values(owner.pr_urls || {}).filter(Boolean).length;
        const uploaded = uploadProjectIDs(task);
        const projectName = (id: string) => projects.find((x) => x.id === id)?.name || id;
        const rows: PropRow[] = [
          {
            key: "stage",
            label: t("tasks.drawer.props.stage"),
            icon: "i-flag",
            value: stagePillHTML(task.stage, stage),
            edit: t("tasks.drawer.props.change_stage_named", { stage: stage?.label || task.stage }),
          },
          {
            key: "agent",
            label: t("tasks.drawer.props.agent"),
            icon: "i-bot",
            value: agentValue,
            edit: t("tasks.drawer.props.edit_agents"),
          },
          ...(task.orphan_agents?.length
            ? [
                {
                  key: "orphan",
                  label: t("tasks.drawer.props.orphan"),
                  icon: "i-box",
                  value: orphanAgentsHTML(task.orphan_agents),
                  edit: "",
                  wide: true,
                },
              ]
            : []),
          {
            key: "priority",
            label: t("tasks.drawer.props.priority"),
            icon: "i-arrow-up-right",
            value:
              taskPriorityTagHTML(task.priority) ||
              emptyValueHTML(t("tasks.drawer.props.no_priority")),
            edit: t("tasks.drawer.props.set_priority"),
          },
        ];
        if (taskTypes.length > 0) {
          rows.push({
            key: "type",
            label: t("tasks.drawer.props.type"),
            icon: "i-tt-checklist",
            value: type
              ? typeTagHTML(taskTypes, type.id)
              : emptyValueHTML(t("tasks.drawer.props.untyped")),
            edit: t("tasks.drawer.props.change_type"),
          });
        }
        rows.push(
          {
            key: "projects",
            label: t("tasks.drawer.props.projects"),
            icon: "i-folder",
            value: projectChipsHTML(task.project_ids || [], projectName),
            edit: "",
          },
          {
            key: "branch",
            label: t("tasks.drawer.props.branch"),
            icon: "i-branch",
            value: `<div class="branch-block">${branchHTML({ branch: owner.branch_name || "", prCount: ownerPRs, shared: !!task.parent_id, pr: hasGitHubProject(task), merge: uploaded.length > 0 })}</div>`,
            edit: "",
            wide: true,
          },
          {
            key: "deps",
            label: t("tasks.drawer.props.blocked_by"),
            icon: "i-lock",
            value: blockedByHTML(task.blocked_by, isTerminalStage),
            edit: t("tasks.drawer.props.edit_deps"),
          },
          {
            key: "blocks",
            label: t("tasks.drawer.props.blocks"),
            icon: "i-link",
            value: blocksHTML(task.blocking),
            edit: "",
          },
          {
            key: "tags",
            label: t("tasks.drawer.props.tags"),
            icon: "i-list",
            value:
              (task.tags || []).length === 0
                ? emptyValueHTML(t("tasks.drawer.props.no_tags"))
                : (task.tags || []).map((tag) => labelTagHTML(tag)).join(""),
            edit: t("tasks.drawer.props.edit_tags"),
          },
        );
        const runs = lastUsage
          ? runsLine(
              lastUsage.runs,
              lastUsage.tokens,
              lastUsage.cost,
              lastUsage.estimated,
              lastUsage.unpriced,
            )
          : "";
        if (runs) {
          const runsTip = lastUsage
            ? runsTitle(lastUsage.cost, lastUsage.estimated, lastUsage.unpriced)
            : "";
          rows.push({
            key: "runs",
            label: t("tasks.drawer.props.runs"),
            icon: "i-zap",
            value: `<button class="link-btn" type="button" data-tab-go="timeline"${runsTip ? ` title="${esc(runsTip)}"` : ""}>${esc(runs)}</button>`,
            edit: "",
          });
        }
        if (taskSandbox) {
          const sb = taskSandbox;
          const links = portLinks(sb)
            .map(
              (p) =>
                `<a class="link-btn sbx-port" href="${esc(p.url)}" target="_blank" rel="noopener noreferrer" title="${esc(p.url)}">${esc(t("tasks.drawer.props.sandbox_port", { port: p.port }))}</a>`,
            )
            .join("");
          rows.push({
            key: "sandbox",
            label: t("tasks.drawer.props.sandbox"),
