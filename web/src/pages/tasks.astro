      interface ReportVM {
        id: string;
        source: string;
        author: string;
        stage: string;
        instance_id: string;
        kind: string;
        title: string;
        body: string;
        created_at: string;
      }

      let reportsLastTaskID: string | null = null;
      let reportsCache: ReportVM[] = [];
      const reportsExpanded = new Set<string>();

      async function loadReports(taskID: string): Promise<void> {
        try {
          const list = await api.get<ReportVM[]>(`/tasks/${taskID}/reports`);
          if (activeTask?.id !== taskID) return;
          reportsCache = list;
        } catch {
          if (reportsLastTaskID !== taskID) reportsCache = [];
        }
        reportsLastTaskID = taskID;
        renderTabCounts();
        renderTestCases();
        if (activeTask?.id === taskID) renderAttachments();
      }

      const prOpen = new Set<string>();
      let prTaskID = "";
      let prLinksKey = "";
      let prRows: PullRequestStatus[] | undefined;
      let prFailed = false;
      let prTimer: ReturnType<typeof setTimeout> | undefined;
      // Bumped by every read and by stopPullRequests, so a late answer is dropped instead of
      // painted or rescheduled.
      let prGen = 0;

      function prLinksOf(task: Task): PRLink[] {
        const urls = task.pr_urls || {};
        const linked = (task.project_ids || []).filter((id) => urls[id]);
        const rest = Object.keys(urls)
          .filter((id) => urls[id] && !linked.includes(id))
          .sort();
        return [...linked, ...rest].map((id) => ({
          project_id: id,
          project_name: projects.find((p) => p.id === id)?.name || id,
          url: urls[id],
        }));
      }

      function stopPullRequests() {
        clearTimeout(prTimer);
        prTimer = undefined;
        prGen++;
        prTaskID = "";
        prLinksKey = "";
        prRows = undefined;
        prFailed = false;
      }

      async function loadPullRequests(taskID: string) {
        clearTimeout(prTimer);
        const gen = ++prGen;
        try {
          const res = await api.get<{ pull_requests: PullRequestStatus[] }>(
            `/tasks/${taskID}/pull-requests`,
          );
          if (gen !== prGen) return;
          prRows = res.pull_requests || [];
          prFailed = false;
        } catch {
          if (gen !== prGen) return;
          prFailed = true;
        }
        renderPullRequests();
        prTimer = setTimeout(() => {
          const owner = activeTask?.parent_id || activeTask?.id;
          if (owner === taskID) void loadPullRequests(taskID);
        }, prPollDelay(prRows));
      }

      function renderPullRequests() {
        const task = activeTask?.parent_id ? parentTask : activeTask;
        const box = document.getElementById("ov-prs");
        if (!task || !box) return;
        const links = prLinksOf(task);
        const key = JSON.stringify(links.map((l) => [l.project_id, l.url]));
        if (prTaskID !== task.id) {
          stopPullRequests();
          prOpen.clear();
          prTaskID = task.id;
        }
        if (!links.length) {
          clearTimeout(prTimer);
          box.hidden = true;
          box.innerHTML = "";
          delete box.dataset.sig;
          prLinksKey = key;
          return;
        }
        if (prLinksKey !== key) {
          prLinksKey = key;
          void loadPullRequests(task.id);
        }
        box.hidden = false;
        const input = { links, rows: prRows, failed: prFailed };
        const sig = prSectionSignature(input);
        if (box.dataset.sig === sig && box.childNodes.length > 0) return;
        box.innerHTML = prSectionHTML(input, { openKeys: prOpen });
        box.dataset.sig = sig;
        if (!box.dataset.wired) {
          box.dataset.wired = "1";
          box.addEventListener("click", (e) => {
            const head = (e.target as Element).closest<HTMLElement>("[data-pr-toggle]");
            const key = head?.dataset.prToggle;
            if (!head || !key) return;
            const detail = document.getElementById(head.getAttribute("aria-controls") ?? "");
            if (!detail) return;
            detail.hidden = !detail.hidden;
            head.setAttribute("aria-expanded", String(!detail.hidden));
            if (detail.hidden) prOpen.delete(key);
            else prOpen.add(key);
          });
        }
      }

      const tcOpen = new Set<string>();
      const tcReportOpen = new Set<string>();
      let tcOpenTask = "";
      let tcReportsAsked = "";

      function testCasesInput(t: Task): TestCasesInput {
        return {
          cases: t.test_cases || [],
          attachments: t.attachments || [],
          comments: t.comments || [],
          reports: reportsLastTaskID === t.id ? reportsCache : undefined,
          body: t.body || "",
        };
      }

      function fetchRunReports(t: Task) {
        const ids = (t.test_cases || []).flatMap((c) =>
          (c.runs || []).map((r) => r.report_id).filter(Boolean),
        );
        const known =
          reportsLastTaskID === t.id ? new Set(reportsCache.map((r) => r.id)) : new Set<string>();
        const missing = ids
          .filter((id) => !known.has(id))
          .sort()
          .join(",");
        const asked = `${t.id}:${missing}`;
        if (!missing || tcReportsAsked === asked) return;
        tcReportsAsked = asked;
        void loadReports(t.id);
      }

      function renderTestCases(force = false) {
        const t = activeTask;
        const box = document.getElementById("ov-testcases");
        if (!t || !box) return;
        if (tcOpenTask !== t.id) {
          tcOpen.clear();
          tcReportOpen.clear();
          tcOpenTask = t.id;
        }
        fetchRunReports(t);
        if (box.querySelector(".tc-form")) return;
        const playing = [...box.querySelectorAll("video")].some((v) => !v.paused);
        if (playing && !force) return;
        const input = testCasesInput(t);
        const block = runCasesBlock(runAgents(agentTypes));
        const sig = `${testCasesSignature(input)}|${block}|${mayWriteTasks}|${!!viewer}`;
        if (!force && box.dataset.sig === sig && box.childNodes.length > 0) return;
        const refocus = testCaseFocus(box);
        box.innerHTML = testCasesBlockHTML(input, {
          md: (src) => mdBody(src),
          attachmentURL: (id) => API + attachmentPath(id),
          openKeys: tcOpen,
          openReports: tcReportOpen,
          runCases: { block, reason: runCasesReason(block) },
          viewer,
          readOnly: !mayWriteTasks,
        });
        box.dataset.sig = sig;
        wireTestCases(box);
        refocus();
      }

      function testCaseFocus(box: HTMLElement): () => void {
        const el = document.activeElement as HTMLElement | null;
        if (!el || !box.contains(el)) return () => {};
        const key = el.closest<HTMLElement>(".tc-case")?.dataset.key;
        const act = el.dataset.tcAct;
        const sel = el.tagName === "SUMMARY" ? "summary" : act ? `[data-tc-act="${act}"]` : "";
        if (!sel) return () => {};
        return () => {
          const root = key ? document.getElementById(`tc-${key}`) : box;
          root?.querySelector<HTMLElement>(sel)?.focus({ preventScroll: true });
        };
      }

      async function reloadTestCases(taskId: string) {
        try {
          const fresh = await api.get<Task>(`/tasks/${taskId}`);
          if (activeTask?.id !== taskId) return;
          activeTask.test_cases = fresh.test_cases || [];
          activeTask.attachments = fresh.attachments || [];
          activeTask.comments = fresh.comments || [];
        } catch {
          // The poller catches up; the block keeps what it shows.
        }
        renderTestCases(true);
      }

      function testCaseURL(taskId: string, key: string): string {
        return `/tasks/${taskId}/test-cases/${encodeURIComponent(key)}`;
      }

      async function testCaseWrite(
        failed: (error: string) => string,
        fn: (taskId: string) => Promise<unknown>,
      ) {
        const taskId = activeTask?.id;
        if (!taskId) return false;
        let ok = true;
        try {
          await fn(taskId);
        } catch (e) {
          ok = false;
          toast(failed((e as Error).message), "err");
        }
        await reloadTestCases(taskId);
        return ok;
      }

      function readCaseForm(form: HTMLFormElement): CaseFields {
        const v = (name: string) => String(new FormData(form).get(name) ?? "").trim();
        return {
          title: v("title"),
          priority: v("priority") as CaseFields["priority"],
          description: v("description"),
          steps: v("steps"),
          expected: v("expected"),
        };
      }

      function openCaseForm(slot: HTMLElement, c?: TestCase) {
        slot.innerHTML = testCaseFormHTML(c, c ? `tc-edit-${c.key}` : "tc-add");
        const form = slot.querySelector<HTMLFormElement>(".tc-form")!;
        form.dataset.key = c?.key || "";
        form.querySelector<HTMLInputElement>('[name="title"]')!.focus();
      }

      async function submitCaseForm(form: HTMLFormElement) {
        const fields = readCaseForm(form);
        const err = form.querySelector<HTMLElement>(".form-error")!;
        clearFormErrors(form);
        if (caseFormProblem(fields)) {
          setFieldError(
            form.querySelector<HTMLInputElement>('[name="title"]')!,
            t("tasks.test_cases.title_required"),
            { focus: true },
          );
          return;
        }
        const key = form.dataset.key || "";
        const taskId = activeTask?.id;
        if (!taskId) return;
        const save = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
        save.disabled = true;
        try {
          if (key) await api.patch(testCaseURL(taskId, key), fields);
          else await api.post(`/tasks/${taskId}/test-cases`, fields);
        } catch (e) {
          setFormError(err, (e as Error).message || t("tasks.test_cases.save_failed"));
          save.disabled = false;
          return;
        }
        form.remove();
        await reloadTestCases(taskId);
      }

      async function deleteTestCase(c: TestCase) {
        const runs = (c.runs || []).length;
        const ok = await confirmDialog({
          title: t("tasks.test_cases.delete_title", { key: c.key }),
          message: runs
            ? t("tasks.test_cases.delete_message_runs", { title: c.title, count: runs })
            : t("tasks.test_cases.delete_message", { title: c.title }),
          confirmLabel: t("common.buttons.delete"),
          danger: true,
        });
        if (!ok) return;
        tcOpen.delete(c.key);
        await testCaseWrite(
          (error) => t("tasks.test_cases.delete_failed", { error }),
          (taskId) => api.del(testCaseURL(taskId, c.key)),
        );
      }

      async function moveTestCase(key: string, dir: -1 | 1) {
        const position = movedPosition(activeTask?.test_cases || [], key, dir);
        if (position === null) return;
        await testCaseWrite(
          (error) => t("tasks.test_cases.move_failed", { error }),
          (taskId) => api.patch(testCaseURL(taskId, key), { position }),
        );
        document
          .getElementById(`tc-${key}`)
          ?.querySelector<HTMLElement>(`[data-tc-act="${dir < 0 ? "up" : "down"}"]`)
          ?.focus();
      }

      async function importTestCases() {
        const ok = await testCaseWrite(
          (error) => t("tasks.test_cases.import_failed", { error }),
          (taskId) => api.post(`/tasks/${taskId}/test-cases/import-body`),
        );
        const n = activeTask?.test_cases?.length || 0;
        if (ok) toast(t("tasks.test_cases.imported", { count: n }), "ok");
      }

      function revealComment(id: string) {
        let el = document.getElementById(`comment-${id}`);
        if (!el) {
          const root = (activeTask?.comments || []).find((c: any) => c.id === id)?.parent_id || id;
          expandedThreads.add(root);
          shownResolved.add(root);
          streamExpanded = true;
          if (activityFilter !== "all" && activityFilter !== "comments") setActivityFilter("all");
          else renderComments();
          el = document.getElementById(`comment-${id}`);
        }
        if (!el) return;
        el.scrollIntoView({ behavior: "smooth", block: "center" });
        el.classList.add("flash");
        window.setTimeout(() => el.classList.remove("flash"), 1600);
      }

      async function revealReport(id: string) {
        reportsExpanded.add(id);
        showTab("reports");
        await renderReports({ force: true });
        const el = document.getElementById(`report-${id}`);
        if (!el) {
          toast(t("tasks.test_cases.report_gone"), "err");
          return;
        }
        el.scrollIntoView({ behavior: "smooth", block: "start" });
        el.classList.add("flash");
        window.setTimeout(() => el.classList.remove("flash"), 1600);
      }

      function revealTestCase(key: string) {
        showTab("overview");
        tcOpen.add(key);
        const el = document.getElementById(`tc-${key}`) as HTMLDetailsElement | null;
        if (!el) {
          toast(t("tasks.test_cases.not_found", { key }), "err");
          return;
        }
        el.open = true;
        el.scrollIntoView({ behavior: "smooth", block: "start" });
        el.querySelector<HTMLElement>("summary")?.focus({ preventScroll: true });
      }

      function openRunCasesForm(slot: HTMLElement) {
        const task = activeTask;
        if (!task) return;
        const agents = runAgents(agentTypes);
        const picked = defaultRunAgent(agents, task.stage_assignments?.[task.stage] || "");
        slot.innerHTML = runCasesFormHTML(task.test_cases || [], agents, picked);
        slot.querySelector<HTMLInputElement>('[name="url"]')?.focus();
      }

      function syncRunCasesForm(form: HTMLFormElement) {
        const type = String(new FormData(form).get("agent") ?? "");
        const line = missingLine(runAgents(agentTypes).find((a) => a.type === type));
        setFieldError(form.querySelector<HTMLSelectElement>('[name="agent"]')!, line);
        form.querySelector<HTMLButtonElement>('[type="submit"]')!.disabled = Boolean(line);
      }

      async function submitRunCases(form: HTMLFormElement) {
        const data = new FormData(form);
        const err = form.querySelector<HTMLElement>(".form-error")!;
        const url = String(data.get("url") ?? "").trim();
        const compare = String(data.get("compare") ?? "").trim();
        const keys = data.getAll("case").map(String);
        for (const name of ["url", "compare"]) {
          setFieldError(form.querySelector<HTMLInputElement>(`[name="${name}"]`)!, "");
        }
        const casesErr = form.querySelector<HTMLElement>(".tc-run-cases > .field-error")!;
        setFormError(casesErr, "");
        setFormError(err, "");
        const problem = runCasesProblem({ url, compare, keys });
        if (problem === "cases") {
          setFormError(casesErr, t("tasks.test_cases.run_no_cases"));
          form.querySelector<HTMLInputElement>('[name="case"]')?.focus();
          return;
        }
        if (problem) {
          setFieldError(
            form.querySelector<HTMLInputElement>(`[name="${problem}"]`)!,
            t("tasks.test_cases.run_url_invalid"),
            { focus: true },
          );
          return;
        }
        const agent = String(data.get("agent") ?? "");
        const taskId = activeTask?.id;
        if (!taskId || !agent) return;
        const send = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
        send.disabled = true;
        try {
          await api.post(`/tasks/${taskId}/comments`, {
            body: runCasesComment({ agent, url, compare, keys }),
          });
        } catch (e) {
          setFormError(err, t("tasks.test_cases.run_failed", { error: (e as Error).message }));
          send.disabled = false;
          return;
        }
        form.remove();
        const name = agentTypes.find((a) => a.type === agent)?.name || agent;
        toast(t("tasks.test_cases.run_started", { agent: name, count: keys.length }), "ok");
        await refresh(true);
        renderTestCases(true);
      }

      async function removeTestCasesSection() {
        const taskId = activeTask?.id;
        if (!taskId) return;
        try {
          await api.del(`/tasks/${taskId}/sections/test-cases`);
          const fresh = await api.get<Task>(`/tasks/${taskId}`);
          if (activeTask?.id !== taskId) return;
          activeTask.body = fresh.body || "";
          renderBrief();
          toast(t("tasks.test_cases.section_removed"), "ok");
        } catch (e) {
          toast(
            t("tasks.test_cases.remove_section_failed", { error: (e as Error).message }),
            "err",
          );
        }
        renderTestCases(true);
      }

      function wireTestCases(box: HTMLElement) {
        if (box.dataset.wired) return;
        box.dataset.wired = "1";
        const caseOf = (el: Element): TestCase | undefined => {
          const key = el.closest<HTMLElement>(".tc-case")?.dataset.key;
          return (activeTask?.test_cases || []).find((c) => c.key === key);
        };

        // toggle does not bubble; listen in the capture phase.
        box.addEventListener(
          "toggle",
          (e) => {
            const d = e.target as HTMLDetailsElement;
            if (d.classList?.contains("tc-report") && d.dataset.run) {
              if (d.open) tcReportOpen.add(d.dataset.run);
              else tcReportOpen.delete(d.dataset.run);
              return;
            }
            if (!d.classList?.contains("tc-case") || !d.dataset.key) return;
            if (d.open) tcOpen.add(d.dataset.key);
            else tcOpen.delete(d.dataset.key);
          },
          true,
        );

        box.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const lb = target.closest<HTMLElement>("[data-lightbox]");
          if (lb)
            return void openLightbox(
              lb.dataset.lightbox!,
              (lb.dataset.lightboxSet || "").split(",").filter(Boolean),
            );
          const report = target.closest<HTMLElement>("[data-tc-report]");
          if (report) return revealComment(report.dataset.tcReport!);
          const inTab = target.closest<HTMLElement>("[data-tc-open-report]");
          if (inTab) return void revealReport(inTab.dataset.tcOpenReport!);
          const btn = target.closest<HTMLButtonElement>("button[data-tc-act]");
          if (!btn) return;
          const c = caseOf(btn);
          switch (btn.dataset.tcAct) {
            case "add":
              return openCaseForm(box.querySelector<HTMLElement>(".tc-add-slot")!);
            case "import":
              return void importTestCases();
            case "run":
              return openRunCasesForm(box.querySelector<HTMLElement>(".tc-add-slot")!);
            case "remove-section":
              return void removeTestCasesSection();
            case "edit":
              if (c)
                openCaseForm(
                  btn.closest(".tc-case")!.querySelector<HTMLElement>(".tc-edit-slot")!,
                  c,
                );
              return;
            case "cancel":
              btn.closest(".tc-form")?.remove();
              return renderTestCases();
            case "delete":
              if (c) void deleteTestCase(c);
              return;
            case "up":
            case "down":
              if (c) void moveTestCase(c.key, btn.dataset.tcAct === "up" ? -1 : 1);
              return;
          }
        });

        box.addEventListener("change", (e) => {
          const el = e.target as HTMLInputElement | HTMLSelectElement;
          const runForm = el.closest<HTMLFormElement>(".tc-run-form");
          if (runForm) {
            if (el.name === "agent") syncRunCasesForm(runForm);
            return;
          }
          const c = caseOf(el);
          if (!c) return;
          if (el.dataset.tcAct === "covered") {
            const covered = (el as HTMLInputElement).checked;
            void testCaseWrite(
              (error) => t("tasks.test_cases.mark_failed", { error }),
              (taskId) => api.patch(testCaseURL(taskId, c.key), { covered }),
            );
          } else if (el.dataset.tcAct === "status") {
            const status = el.value;
            void (async () => {
              if (status === "pass" && !(c.runs || []).length) {
                const ok = await confirmDialog({
                  title: t("tasks.test_cases.pass_unrun_title", { key: c.key }),
                  message: t("tasks.test_cases.pass_unrun_message"),
                  confirmLabel: t("tasks.test_cases.pass_unrun_confirm"),
                });
                if (!ok) return renderTestCases(true);
              }
              await testCaseWrite(
                (error) => t("tasks.test_cases.status_failed", { error }),
                (taskId) => api.patch(testCaseURL(taskId, c.key), { status }),
              );
            })();
          }
        });

        box.addEventListener("submit", (e) => {
          e.preventDefault();
          const form = e.target as HTMLFormElement;
          if (form.classList.contains("tc-run-form")) void submitRunCases(form);
          else void submitCaseForm(form);
        });

        box.addEventListener("keydown", (e) => {
          if (e.key !== "Escape") return;
          const form = (e.target as HTMLElement).closest(".tc-form");
          if (!form) return;
          e.stopPropagation();
          form.remove();
          renderTestCases();
        });
      }

      function attachmentURL(a: Attachment): string {
        return API + attachmentPath(a.id);
      }

      function attachmentOrigin(a: Attachment): string {
        if (a.comment_id) {
          const c = (activeTask?.comments || []).find((x: any) => x.id === a.comment_id);
          return c
            ? t("tasks.drawer.attachments.origin_comment_by", { author: authorLabel(c, viewer) })
            : t("tasks.drawer.attachments.origin_comment");
        }
        if (embeddedIn(activeTask?.body || "", a.id))
          return t("tasks.drawer.attachments.origin_body");
        return a.author
          ? authorLabel({ author: a.author, source: "user" }, viewer)
          : t("tasks.drawer.attachments.origin_upload");
      }

      function createAttachmentCard(a: Attachment): HTMLElement {
        const url = attachmentURL(a);
        const kind = mediaKind(a.mime_type, a.filename);
        const el = document.createElement("div");
        el.className = kind === "image" || kind === "video" ? "att-card" : "att-card file-icon";
        const preview =
          kind === "image"
            ? // Not lazy: a lazy image inside the drawer never loads (see mdInline in lib/markdown.ts).
              `<img alt="">`
            : kind === "video"
              ? `<video muted preload="metadata" playsinline></video><span class="att-play">▶</span>`
              : "";
        el.innerHTML = `
          ${preview}
          <div class="att-meta">
            <span class="att-name"></span>
            <span class="att-size"></span>
          </div>
          <div class="att-foot">
            <span class="att-origin"></span>
            ${buttonHTML({
              iconOnly: true,
              icon: "x",
              label: t("tasks.drawer.attachments.delete_label"),
              title: t("tasks.drawer.attachments.delete_title"),
              size: "sm",
              variant: "ghost",
              cls: "att-del write-only",
            })}
          </div>`;
        const img = el.querySelector("img");
        if (img) (img as HTMLImageElement).src = url;
        const vid = el.querySelector("video");
        // t=0.1 makes the browser paint the first frame instead of a black box.
        if (vid) (vid as HTMLVideoElement).src = `${url}#t=0.1`;
        el.addEventListener("click", () => openLightbox(a.id));
        el.querySelector(".att-del")!.addEventListener("click", (e) => {
          e.stopPropagation();
          void deleteAttachment(a);
        });
        updateAttachmentCard(el, a, null);
        return el;
      }

      function updateAttachmentCard(el: HTMLElement, a: Attachment, _prev: Attachment | null) {
        const name = el.querySelector(".att-name");
        setText(name, a.filename);
        setAttr(name, "title", a.filename);
        setAttr(el.querySelector("img"), "alt", a.filename);
        setText(el.querySelector(".att-size"), fmtBytes(a.size));
        const origin = attachmentOrigin(a);
        setText(el.querySelector(".att-origin"), origin);
        setAttr(
          el.querySelector(".att-origin"),
          "title",
          t("tasks.drawer.attachments.added_from", { origin }),
        );
      }

      async function deleteAttachment(a: Attachment) {
        const ok = await confirmDialog({
          title: t("tasks.drawer.attachments.delete_confirm_title"),
          message: t("tasks.drawer.attachments.delete_confirm_message", { file: a.filename }),
          confirmLabel: t("common.buttons.delete"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/task-attachments/${a.id}`);
        } catch {
          toast(t("tasks.drawer.attachments.delete_failed"), "err");
          return;
        }
        await refresh(true);
      }

      let lightboxAtts: Attachment[] = [];
      let lightboxIdx = -1;
      // Clear the stage on close: a playing video would keep its audio running.
      const lightbox = bindModal($("lightbox"), {
        onClose: () => {
          $("lb-stage").innerHTML = "";
          lightboxAtts = [];
          lightboxIdx = -1;
        },
      });

      function renderLightbox() {
        const a = lightboxAtts[lightboxIdx];
        if (!a) return;
        const url = attachmentURL(a);
        const mime = a.mime_type || "";
        const stage = $("lb-stage");
        const kind = mediaKind(mime, a.filename);
        if (kind === "image") {
          stage.innerHTML = `<img alt="${esc(a.filename)}">`;
          (stage.querySelector("img") as HTMLImageElement).src = url;
        } else if (kind === "video") {
          stage.innerHTML = `<video class="lb-video" controls autoplay playsinline></video>`;
          (stage.querySelector("video") as HTMLVideoElement).src = url;
        } else if (kind === "audio") {
          stage.innerHTML = `<audio class="lb-audio" controls autoplay></audio>`;
          (stage.querySelector("audio") as HTMLAudioElement).src = url;
        } else if (mime === "application/pdf" || mime.startsWith("text/")) {
          // text/* can be HTML: sandbox it even though the daemon serves a sandbox CSP.
          // Not PDFs: the browser's viewer does not run in a sandboxed frame.
          const sandbox = mime.startsWith("text/") ? ' sandbox=""' : "";
          stage.innerHTML = `<iframe title="${esc(a.filename)}"${sandbox}></iframe>`;
          (stage.querySelector("iframe") as HTMLIFrameElement).src = url;
        } else {
          stage.innerHTML = `<div class="lb-fallback">
            <span class="lb-fallback-icon">${icoSvg("i-file")}</span>
            <span>${esc(t("tasks.lightbox.no_preview"))}</span>
          </div>`;
        }
        setText($("lightbox-title"), a.filename);
        setText($("lb-count"), `${lightboxIdx + 1} / ${lightboxAtts.length}`);
        setAttr($("lb-open"), "href", url);
        ($("lb-prev") as HTMLButtonElement).disabled = lightboxIdx <= 0;
        ($("lb-next") as HTMLButtonElement).disabled = lightboxIdx >= lightboxAtts.length - 1;
      }

      function openLightbox(attachmentId: string, only?: string[]): boolean {
        const all = (activeTask?.attachments || []) as Attachment[];
        const pick = only?.length ? new Set(only) : null;
        const atts = pick ? all.filter((a) => pick.has(a.id)) : all;
        const idx = atts.findIndex((a) => a.id === attachmentId);
        if (idx < 0) return false;
        lightboxAtts = atts;
        lightboxIdx = idx;
        renderLightbox();
        lightbox.open();
        return true;
      }

      function closeLightbox() {
        lightbox.close();
      }

      function stepLightbox(delta: number) {
        const next = lightboxIdx + delta;
        if (next < 0 || next >= lightboxAtts.length) return;
        lightboxIdx = next;
        renderLightbox();
      }

      $("lb-prev").addEventListener("click", () => stepLightbox(-1));
      $("lb-next").addEventListener("click", () => stepLightbox(1));

      document.addEventListener(
        "click",
        (e) => {
          const el = (e.target as HTMLElement | null)?.closest?.(
            "#drawer .md img, #drawer .md a.md-file",
          );
          if (!el) return;
          const id = attachmentIDFromURL(el.getAttribute("src") || el.getAttribute("href") || "");
          if (!id) return;
          const report = el.closest(".tc-report, .report-body");
          const only = report
            ? [...report.querySelectorAll("img, a.md-file")]
                .map((x) =>
                  attachmentIDFromURL(x.getAttribute("src") || x.getAttribute("href") || ""),
                )
                .filter(Boolean)
            : undefined;
          const shown = openLightbox(id, only);
          if (shown) e.preventDefault();
        },
        { signal },
      );

      const filesOpen = new Set<string>();

      function filesKindsLabel(atts: Attachment[]): string {
        const n = countKinds(atts);
        const parts: string[] = [];
        if (n.video) parts.push(t("tasks.drawer.files.kinds.video", { count: n.video }));
        if (n.image) parts.push(t("tasks.drawer.files.kinds.image", { count: n.image }));
        if (n.other) parts.push(t("tasks.drawer.files.kinds.other", { count: n.other }));
        return parts.join(" · ");
      }

      function renderAttachments() {
        const task = activeTask!;
        const atts = (task.attachments || []) as Attachment[];
        const list = document.getElementById("ov-attachments");
        if (!list) return;
        setCount($("ov-files-count"), atts.length, { hideZero: true });
        const open = filesOpen.has(task.id) && atts.length > 0;
        const toggle = $("ov-files-toggle");
        setAttr(toggle, "aria-expanded", String(open));
        (toggle as HTMLButtonElement).disabled = atts.length === 0;
        ($("ov-files-body") as HTMLElement).hidden = !open;
        setText($("ov-files-kinds"), open ? "" : filesKindsLabel(atts));
        if (!open) return;
        const loaded = reportsLastTaskID === task.id;
        if (!loaded) void loadReports(task.id);
        const { groups, loose } = groupFilesByReport(atts, loaded ? reportsCache : []);
        const groupsBox = document.getElementById("ov-att-groups");
        if (groupsBox)
          reconcile<ReportFilesGroup>({
            container: groupsBox,
            items: groups,
            key: (g) => g.report.id,
            create: createReportFilesGroup,
            update: updateReportFilesGroup,
          });
        reconcile<Attachment>({
          container: list,
          items: loose,
          key: (a) => a.id,
          create: createAttachmentCard,
          update: updateAttachmentCard,
        });
      }

      type ReportFilesGroup = ReportFiles<Attachment, ReportVM>;

      function createReportFilesGroup(g: ReportFilesGroup): HTMLElement {
        const el = document.createElement("div");
        el.className = rowGroupBoxedClasses({ cls: "row-list att-group" });
        const bodyId = `att-group-${g.report.id}`;
        el.innerHTML =
          listRowHTML({
            as: "button",
            size: "sm",
            expanded: false,
            title: "",
            asideHTML: countHTML(0),
            attrs: { "aria-controls": bodyId },
          }) +
          `<div class="row-detail" id="${esc(bodyId)}" hidden><div class="attachments-list"></div></div>`;
        const row = el.querySelector<HTMLButtonElement>(".row")!;
        const body = el.querySelector<HTMLElement>(".row-detail")!;
        row.addEventListener("click", () => {
          body.hidden = !body.hidden;
          row.setAttribute("aria-expanded", String(!body.hidden));
        });
        updateReportFilesGroup(el, g, null);
        return el;
      }

      function updateReportFilesGroup(
        el: HTMLElement,
        g: ReportFilesGroup,
        _prev: ReportFilesGroup | null,
      ) {
        const title = reportView(g.report, (id) => stageInfo(id)?.label || id).title;
        setText(el.querySelector(".row-title"), title);
        const n = g.files.length;
        const count = el.querySelector<HTMLElement>(".row-aside .count");
        if (count && count.dataset.n !== String(n)) {
          setCount(count, n);
          count.dataset.n = String(n);
        }
        el.querySelector(".row")?.setAttribute(
          "aria-label",
          `${title}, ${t("tasks.drawer.files.group_count", { count: n })}`,
        );
        reconcile<Attachment>({
          container: el.querySelector<HTMLElement>(".attachments-list")!,
          items: g.files,
          key: (a) => a.id,
          create: createAttachmentCard,
          update: updateAttachmentCard,
        });
      }

      function openThreadsCount(n: number): Omit<CountOptions, "id" | "attrs"> {
        return {
          pill: true,
          hideZero: true,
          label: t("tasks.comments.open_label"),
          title: t("tasks.comments.open_threads", { count: n }),
        };
      }
      let commentsSig: string | null = null;
      let pinnedSig: string | null = null;
      let replyingTo: string | null = null;
      const threadDrafts = new Map<string, string>();
      let applyingTo: string | null = null;
      const applyNotes = new Map<string, string>();
      const expandedThreads = new Set<string>();
      const shownResolved = new Set<string>();
      const openGroups = new Set<string>();
      let streamExpanded = false;
      const questionDrafts = new Map<string, QuestionDraft>();
      let streamEvents: StreamEvent[] = [];
      let streamEventsTask = "";
      function resetThreadUI() {
        replyingTo = null;
        threadDrafts.clear();
        applyingTo = null;
        applyNotes.clear();
        expandedThreads.clear();
        shownResolved.clear();
        openGroups.clear();
        streamExpanded = false;
        questionDrafts.clear();
        pinnedSig = null;
        streamEvents = [];
        streamEventsTask = "";
        stopRunWatch();
        liveActions.clear();
      }

      let activityFilter: ActivityFilter = "all";
      try {
        activityFilter = parseFilter(localStorage.getItem(FILTER_KEY));
      } catch {
        // Not remembered; the stream shows everything.
      }
      function setActivityFilter(f: ActivityFilter) {
        activityFilter = f;
        try {
          localStorage.setItem(FILTER_KEY, f);
        } catch {
          // Not remembered past this page.
        }
        const bar = document.getElementById("act-filter");
        if (bar) setSegmentedValue(bar, f);
        renderComments();
      }

      let viewer: Viewer | null = null;
      void Promise.all([sessionInfo(), authDisabled()]).then(([s, devSession]) => {
        viewer = viewerFor(s?.user, devSession);
        mayDeleteTasks = roleWithin("admin", s?.role);
        mayWriteTasks = roleWithin("developer", s?.role);
        ($("new-task-btn") as HTMLButtonElement).disabled = !mayWriteTasks;
        $("board-readonly").hidden = mayWriteTasks;
        if (!mayWriteTasks) {
          document.querySelectorAll<HTMLElement>(".col-add").forEach((b) => (b.hidden = true));
          document
            .querySelectorAll<HTMLElement>("#board [draggable='true']")
            .forEach((c) => (c.draggable = false));
        }
        if (activeTask) renderDrawerContents();
        if (viewer && activeTask && document.getElementById("ov-comments")) {
          commentsSig = null;
          renderComments();
        }
      });

      const liveActions = new Map<string, string>();
      let runWatch: { id: string; off: () => void } | null = null;
      function stopRunWatch() {
        runWatch?.off();
        runWatch = null;
      }
      signal.addEventListener("abort", stopRunWatch);
      function watchRun(run: RunInfo | undefined) {
        const cid = run ? run.containerID || instanceToContainer[run.id] || "" : "";
        if (!run || !cid) {
          stopRunWatch();
          return;
        }
        if (runWatch?.id === run.id) return;
        stopRunWatch();
        const id = run.id;
        const off = events.subscribe(logsTopic(cid), (f) => {
          if (f.type !== "line") return;
          const line = String(f.data ?? "");
          const at = line.indexOf("{");
          if (at < 0) return;
          let obj: unknown;
          try {
            obj = JSON.parse(line.slice(at));
          } catch {
            return;
          }
          const ev = normalizeLiveEvent(obj as Parameters<typeof normalizeLiveEvent>[0]);
          if (ev?.type !== "assistant") return;
          const tool = lastToolUse(ev.message?.content);
          if (!tool?.name) return;
          const text = `${tool.name} ${liveToolPreview(tool.name, tool.input)}`.trim();
          liveActions.set(id, text);
          const el = document.querySelector<HTMLElement>(
            `#ov-comments [data-run-action="${CSS.escape(id)}"]`,
          );
          if (el) {
            el.hidden = false;
            setText(el, text);
          }
        });
        runWatch = { id, off };
      }

      let notifyAgent = false;

      function notifyAgentHTML(task: Task): string {
        if (!task.run_alive) return "";
        const agent = task.stage_assignments?.[task.stage] || "";
        if (!task.can_steer) {
          return checkHTML({
            cls: "notify-agent",
            disabled: true,
            label: agent
              ? t("tasks.comments.notify.off_named", { agent })
              : t("tasks.comments.notify.off_unnamed"),
            attrs: { title: t("tasks.comments.notify.off_title") },
          });
        }
        return checkHTML({
          cls: "notify-agent",
          id: "dr-notify",
          checked: notifyAgent,
          labelHTML: agent
            ? t("tasks.comments.notify.on_named_html", { agent: esc(agent) })
            : t("tasks.comments.notify.on_unnamed_html"),
          attrs: { title: t("tasks.comments.notify.on_title") },
        });
      }

      let pendingReplyAtts: Attachment[] = [];

      function renderReplyAttachments() {
        const box = $("dr-atts");
        if (!box) return;
        box.hidden = pendingReplyAtts.length === 0;
        box.innerHTML = pendingReplyAtts
          .map(
            (a) => `<span class="reply-att" title="${esc(a.filename)}">
              <span class="reply-att-name">${esc(a.filename)}</span>
              <span class="reply-att-size">${fmtBytes(a.size)}</span>
              <button class="reply-att-del" type="button" data-att="${esc(a.id)}"
                      aria-label="${esc(t("tasks.drawer.labels.remove_item", { name: a.filename }))}">×</button>
            </span>`,
          )
          .join("");
        box.querySelectorAll<HTMLButtonElement>("[data-att]").forEach((b) => {
          b.addEventListener("click", () => {
            const id = b.dataset.att!;
            pendingReplyAtts = pendingReplyAtts.filter((a) => a.id !== id);
            renderReplyAttachments();
            paintComposer();
            // The upload already created the row; delete it or it lingers on the task.
            void api.del(`/task-attachments/${id}`).catch(() => {
              toast(t("tasks.comments.upload_delete_failed"), "err");
            });
          });
        });
      }

      async function uploadReplyFiles(ta: HTMLTextAreaElement, files: File[]) {
        if (!activeTask || files.length === 0) return;
        const taskID = activeTask.id;
        for (const f of files) {
          const name = pastedName(f);
          try {
            const att = await uploadAttachment(taskID, f, name);
            pendingReplyAtts.push(att);
            if (mediaKind(att.mime_type, att.filename) !== "file") {
              insertAtCursor(ta, `\n${attachmentMarkdown(att)}\n`);
              growComposer(ta);
            }
            renderReplyAttachments();
            paintComposer();
          } catch (err) {
            toast(t("tasks.comments.upload_failed", { error: (err as Error).message }), "err");
          }
        }
      }

      function wireReplyAttachments(ta: HTMLTextAreaElement | null) {
        if (!ta) return;
        const box = ta.closest<HTMLElement>(".composer");
        ta.addEventListener("paste", (e) => {
          const files = Array.from(e.clipboardData?.items || [])
            .filter((it) => it.kind === "file")
            .map((it) => it.getAsFile())
            .filter((f): f is File => f !== null);
          if (files.length === 0) return;
          e.preventDefault();
          void uploadReplyFiles(ta, files);
        });
        ta.addEventListener("dragover", (e) => {
          if (e.dataTransfer && Array.from(e.dataTransfer.items).some((it) => it.kind === "file")) {
            e.preventDefault();
            box?.classList.add("drag-over");
          }
        });
        ta.addEventListener("dragleave", () => box?.classList.remove("drag-over"));
        ta.addEventListener("drop", (e) => {
          box?.classList.remove("drag-over");
          const files = Array.from(e.dataTransfer?.files || []);
          if (files.length === 0) return;
          e.preventDefault();
          void uploadReplyFiles(ta, files);
        });
        const picker = $("dr-file") as HTMLInputElement | null;
        const pick = $("dr-attach");
        if (picker && pick) {
          pick.addEventListener("click", () => picker.click());
          picker.addEventListener("change", () => {
            const files = Array.from(picker.files || []);
            picker.value = "";
            void uploadReplyFiles(ta, files);
          });
        }
      }

      function mentionHandles(): string[] {
        return mentionableAgents(agentTypes).map((a) => a.type || a.name);
      }

      function paintComposer() {
        const ta = document.getElementById("dr-reply") as HTMLTextAreaElement | null;
        const task = activeTask;
        if (!ta || !task) return;
        const agent = task.stage_assignments?.[task.stage] || "";
        setText(
          $("act-audience"),
          audienceLine({
            text: ta.value,
            handles: mentionHandles(),
            notify: { agent, on: notifyAgent && !!task.run_alive && !!task.can_steer },
          }),
        );
        const has = ta.value.trim().length > 0 || pendingReplyAtts.length > 0;
        setComposerReady($("act-composer"), has);
      }

      let posting = false;
      async function postComment() {
        const task = activeTask;
        const ta = document.getElementById("dr-reply") as HTMLTextAreaElement | null;
        const btn = document.getElementById("dr-send") as HTMLButtonElement | null;
        if (!task || !ta || !btn || posting) return;
        const body = ta.value.trim();
        if (!body && pendingReplyAtts.length === 0) {
          ta.focus();
          return;
        }
        const err = $("act-err");
        err.hidden = true;
        const attachmentIDs = pendingReplyAtts.map((a) => a.id);
        const notify = notifyAgent;
        posting = true;
        btn.disabled = true;
        setText(btn, t("tasks.comments.posting"));
        let posted: { notice?: { delivery?: string; agent?: string; detail?: string } };
        try {
          posted = await api.post(`/tasks/${task.id}/comments`, {
            body,
            attachment_ids: attachmentIDs,
            notify_agent: notify,
          });
        } catch (e) {
          err.hidden = false;
          setText(
            err,
            t("tasks.comments.post_failed_detail", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
          );
          return;
        } finally {
          posting = false;
          btn.disabled = false;
          setText(btn, t("tasks.comments.post"));
        }
        if (notify) {
          const n = posted?.notice;
          if (n?.delivery === "steered") {
            toast(
              n.agent
                ? t("tasks.comments.notify.steered_named", { agent: n.agent })
                : t("tasks.comments.notify.steered_unnamed"),
              "ok",
            );
          } else {
            toast(n?.detail || t("tasks.comments.notify.not_delivered"), "info");
          }
        }
        ta.value = "";
        growComposer(ta);
        notifyAgent = false;
        pendingReplyAtts = [];
        renderReplyAttachments();
        renderNotify();
        paintComposer();
        await refresh(true);
      }

      function focusComposer() {
        showTab("overview");
        const ta = document.getElementById("dr-reply") as HTMLTextAreaElement | null;
        if (!ta) return;
        document
          .getElementById("ov-activity")
          ?.scrollIntoView({ block: "end", behavior: scrollBehavior() });
        ta.focus({ preventScroll: true });
      }

      function wireActivity() {
        $("act-filter").addEventListener("change", (e) => {
          setActivityFilter(parseFilter((e.target as HTMLInputElement).value));
        });

        const ta = $("dr-reply") as HTMLTextAreaElement;
        ta.addEventListener("input", () => {
          growComposer(ta);
          paintComposer();
        });
        ta.addEventListener("keydown", (e) => {
          if (composerSubmits(e)) {
            e.preventDefault();
            void postComment();
          }
        });
        $("dr-send").addEventListener("click", () => void postComment());

        const section = $("ov-activity");
        section.addEventListener("click", (e) => void onActivityClick(e));
        section.addEventListener("input", (e) => {
          const el = e.target as HTMLElement;
          if (el instanceof HTMLTextAreaElement && el.classList.contains("thread-apply-note")) {
            const root = el.closest<HTMLElement>("[data-thread-apply-form]")?.dataset
              .threadApplyForm;
            if (root) applyNotes.set(root, el.value);
            growComposer(el);
            return;
          }
          if (!(el instanceof HTMLTextAreaElement) || !el.classList.contains("thread-input"))
            return;
          const box = el.closest<HTMLElement>(".thread-composer");
          const root = box?.dataset.thread || "";
          threadDrafts.set(root, el.value);
          growComposer(el);
          const th = threadOf(root);
          const line = box?.querySelector<HTMLElement>("[data-thread-audience]");
          if (line)
            setText(
              line,
              audienceLine({
                text: el.value,
                handles: mentionHandles(),
                fallback: th ? lastAgent(th) : "",
              }),
            );
          if (box) setComposerReady(box, el.value.trim().length > 0);
        });
        section.addEventListener("keydown", (e) => {
          const el = e.target as HTMLElement;
          if (!composerSubmits(e)) return;
          if (el.classList.contains("thread-input")) {
            e.preventDefault();
            const root = el.closest<HTMLElement>(".thread-composer")?.dataset.thread || "";
            void postThreadReply(root);
          } else if (el.classList.contains("thread-apply-note")) {
            e.preventDefault();
            const root = el.closest<HTMLElement>("[data-thread-apply-form]")?.dataset
              .threadApplyForm;
            const send = root
              ? document.querySelector<HTMLButtonElement>(
                  `#ov-comments [data-thread-apply-send="${CSS.escape(root)}"]`,
                )
              : null;
            if (root && send) void applyThread(root, send);
          }
        });
        section.addEventListener("change", (e) => {
          const box = (e.target as HTMLElement)?.closest?.("#dr-notify");
          if (!box) return;
          notifyAgent = (box as HTMLInputElement).checked;
          paintComposer();
        });
        paintComposer();
      }

      function threadOf(rootID: string) {
        const cs = (activeTask?.comments || []) as Array<StreamComment & Record<string, any>>;
        return groupThreads(cs).find((th) => th.root.id === rootID) || null;
      }

      function openThreadComposer(rootID: string) {
        replyingTo = rootID;
        if (threadOf(rootID)?.root.resolved_at) shownResolved.add(rootID);
        renderComments();
        const ta = document.querySelector<HTMLTextAreaElement>(
          `#ov-comments .thread-composer[data-thread="${CSS.escape(rootID)}"] .thread-input`,
        );
        if (!ta) return;
        ta.scrollIntoView({ block: "center", behavior: scrollBehavior() });
        ta.focus({ preventScroll: true });
        ta.setSelectionRange(ta.value.length, ta.value.length);
      }

      function closeThreadComposer() {
        const id = replyingTo;
        if (!id) return;
        replyingTo = null;
        renderComments();
        document
          .querySelector<HTMLButtonElement>(`#ov-comments [data-thread-reply="${CSS.escape(id)}"]`)
          ?.focus();
      }

      async function postThreadReply(rootID: string) {
        const task = activeTask;
        const box = document.querySelector<HTMLElement>(
          `#ov-comments .thread-composer[data-thread="${CSS.escape(rootID)}"]`,
        );
        const ta = box?.querySelector<HTMLTextAreaElement>(".thread-input");
        const post = box?.querySelector<HTMLButtonElement>("[data-thread-post]");
        const body = ta?.value.trim() || "";
        if (!task || !box || !body) {
          ta?.focus();
          return;
        }
        const err = composerParts(box).error;
        if (err) err.hidden = true;
        if (post) post.disabled = true;
        try {
          await api.post(`/tasks/${task.id}/comments`, { body, parent_id: rootID });
        } catch (e) {
          if (err) {
            err.hidden = false;
            setText(
              err,
              t("tasks.comments.threads.reply_failed_detail", {
                error: e instanceof ApiError ? e.message : String(e),
              }),
            );
          }
          if (post) post.disabled = false;
          return;
        }
        threadDrafts.delete(rootID);
        replyingTo = null;
        await refresh(true);
      }

      async function resolveThread(rootID: string, resolved: boolean, btn?: HTMLButtonElement) {
        if (!activeTask) return;
        if (btn) btn.disabled = true;
        try {
          await api.post(`/tasks/${activeTask.id}/threads/${rootID}/resolve`, { resolved });
        } catch {
          toast(t("tasks.comments.threads.update_failed"), "err");
          if (btn) btn.disabled = false;
          return;
        }
        shownResolved.delete(rootID);
        announce(
          resolved ? t("tasks.comments.threads.resolved") : t("tasks.comments.threads.reopened"),
        );
        await refresh(true);
      }

      async function applyThread(rootID: string, btn: HTMLButtonElement) {
        if (!activeTask) return;
        const note = (applyNotes.get(rootID) || "").trim();
        btn.disabled = true;
        let res: { delivery?: string; detail?: string };
        try {
          res = await api.post(
            `/tasks/${activeTask.id}/threads/${rootID}/apply`,
            note ? { note } : {},
          );
        } catch (err) {
          toast(
            err instanceof ApiError && err.status === 409
              ? err.message
              : t("tasks.comments.threads.apply_failed"),
            "err",
          );
          btn.disabled = false;
          return;
        }
        applyingTo = null;
        applyNotes.delete(rootID);
        toast(
          res?.detail || t("tasks.comments.threads.applied"),
          res?.delivery === "unreachable" ? "info" : "ok",
        );
        await refresh(true);
      }

      async function makeSubtaskFromThread(rootID: string, btn: HTMLButtonElement) {
        const task = activeTask;
        const th = threadOf(rootID);
        if (!task || !th) return;
        const root = th.root as StreamComment & Record<string, any>;
        const title = subtaskTitle(root.body || "") || t("tasks.comments.subtask_title_fallback");
        const parentID = task.parent_id || task.id;
        const board = task.board_id || currentBoard;
        const link = `/tasks/?board=${encodeURIComponent(board)}#task-${task.id}`;
        const quote = (root.body || "")
          .trim()
          .split("\n")
          .slice(0, 12)
          .map((l: string) => `> ${l}`)
          .join("\n");
        const body = `${t("tasks.comments.subtask_body", {
          title: task.title.replace(/[[\]]/g, "\\$&"),
          link,
          author: authorLabel(root, null),
        })}\n\n${quote}`;
        btn.disabled = true;
        setText(btn, t("tasks.comments.subtask_creating"));
        try {
          await api.post(`/tasks/${parentID}/subtasks`, { title, body });
        } catch (e) {
          toast(
            t("tasks.comments.subtask_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
          );
          btn.disabled = false;
          commentsSig = null;
          renderComments();
          return;
        }
        announce(t("tasks.comments.subtask_created", { title }));
        toast(t("tasks.comments.subtask_created", { title }), "ok");
        commentsSig = null;
        await refresh(true);
      }

      async function viewRunLog(instanceID: string) {
        showTab("timeline");
        await renderTimeline();
        const el = document.querySelector<HTMLElement>(
          `#tl-list .event[data-run="${CSS.escape(instanceID)}"]`,
        );
        if (!el) {
          toast(t("tasks.comments.run_log_missing"), "info");
          return;
        }
        el.scrollIntoView({ block: "start", behavior: scrollBehavior() });
        if (el.dataset.cid && !el.classList.contains("expanded")) void toggleInlineLogs(el);
        el.classList.add("flash");
        window.setTimeout(() => el.classList.remove("flash"), 1600);
      }

      interface AgentRow {
        id: string;
        task_id?: string;
        instance?: string;
        name?: string;
        status?: string;
      }

      async function stopRun(instanceID: string, number: number, btn: HTMLButtonElement) {
        const task = activeTask;
        if (!task) return;
        const ok = await confirmDialog({
          title: t("tasks.comments.stop_title", { number }),
          message: t("tasks.comments.stop_message"),
          confirmLabel: t("tasks.comments.stop_button"),
          danger: true,
        });
        if (!ok) return;
        btn.disabled = true;
        try {
          const list = await api.get<AgentRow[]>("/agents");
          const live = list.filter((a) => a.task_id === task.id && a.status === "running");
          const hit =
            live.find((a) => a.instance === instanceID || a.name === instanceID) || live[0];
          if (!hit) {
            toast(t("tasks.comments.stop_gone"), "info");
            btn.disabled = false;
            return;
          }
          await api.post(`/agents/${hit.id}/stop`);
        } catch (e) {
          toast(
            t("tasks.comments.stop_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
          );
          btn.disabled = false;
          return;
        }
        toast(t("tasks.comments.stopped", { number }), "ok");
        await refresh(true);
      }

      async function cancelQueuedRun(btn: HTMLButtonElement) {
        const task = activeTask;
        if (!task) return;
        const ok = await confirmDialog(
          cancelWaitQuestion(btn.dataset.runAgent ?? "", btn.dataset.runStage ?? ""),
        );
        if (!ok) return;
        btn.disabled = true;
        try {
          await api.post(`/tasks/${task.id}/queue/cancel`, {});
        } catch (e) {
          toast(
            t("tasks.comments.cancel_wait_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
          );
          btn.disabled = false;
          return;
        }
        toast(t("tasks.comments.wait_canceled"), "ok");
        await refresh(true);
      }

      async function onActivityClick(e: MouseEvent) {
        const el = e.target as HTMLElement;
        const hit = <T extends HTMLElement = HTMLElement>(sel: string) => el.closest<T>(sel);
        const lb = hit("[data-lightbox]");
        if (lb) return openLightbox(lb.dataset.lightbox!);
        if (hit("[data-stream-more]")) {
          streamExpanded = true;
          renderComments();
          $("ov-comments").querySelector<HTMLElement>("button, a[href]")?.focus();
          return;
        }
        const grp = hit("[data-group]");
        if (grp) {
          const id = grp.dataset.group!;
          if (openGroups.has(id)) openGroups.delete(id);
          else openGroups.add(id);
          renderComments();
          document
            .querySelector<HTMLButtonElement>(`#ov-comments [data-group="${CSS.escape(id)}"]`)
            ?.focus();
          return;
        }
        const show = hit("[data-thread-show]");
        if (show) {
          const id = show.dataset.threadShow!;
          shownResolved.add(id);
          renderComments();
          document
            .querySelector<HTMLButtonElement>(`#ov-comments [data-thread-hide="${CSS.escape(id)}"]`)
            ?.focus();
          return;
        }
        const hide = hit("[data-thread-hide]");
        if (hide) {
          const id = hide.dataset.threadHide!;
          shownResolved.delete(id);
          expandedThreads.delete(id);
          renderComments();
          document
            .querySelector<HTMLButtonElement>(`#ov-comments [data-thread-show="${CSS.escape(id)}"]`)
            ?.focus();
          return;
        }
        const expand = hit("[data-thread-expand]");
        if (expand) {
          expandedThreads.add(expand.dataset.threadExpand!);
          renderComments();
          return;
        }
        const reply = hit("[data-thread-reply]");
        if (reply) return openThreadComposer(reply.dataset.threadReply!);
        const resolve = hit<HTMLButtonElement>("[data-thread-resolve]");
        if (resolve)
          return resolveThread(
            resolve.dataset.threadResolve!,
            resolve.dataset.resolved === "true",
            resolve,
          );
        const apply = hit<HTMLButtonElement>("[data-thread-apply]");
        if (apply) {
          if (apply.getAttribute("aria-disabled") === "true") return;
          applyingTo = apply.dataset.threadApply!;
          renderComments();
          const note = document.querySelector<HTMLTextAreaElement>(
            `#ov-comments [data-thread-apply-form="${CSS.escape(applyingTo)}"] .thread-apply-note`,
          );
          note?.focus();
          return;
        }
        const applyCancel = hit<HTMLButtonElement>("[data-thread-apply-cancel]");
        if (applyCancel) {
          const id = applyCancel.dataset.threadApplyCancel!;
          applyingTo = null;
          applyNotes.delete(id);
          renderComments();
          document
            .querySelector<HTMLButtonElement>(
              `#ov-comments [data-thread-apply="${CSS.escape(id)}"]`,
            )
            ?.focus();
          return;
        }
        const applySend = hit<HTMLButtonElement>("[data-thread-apply-send]");
        if (applySend) return applyThread(applySend.dataset.threadApplySend!, applySend);
        const sub = hit<HTMLButtonElement>("[data-thread-subtask]");
        if (sub) return makeSubtaskFromThread(sub.dataset.threadSubtask!, sub);
        if (hit("[data-thread-cancel]")) {
          const root = hit<HTMLElement>(".thread-composer")?.dataset.thread || "";
          threadDrafts.delete(root);
          closeThreadComposer();
          return;
        }
        const post = hit("[data-thread-post]");
        if (post)
          return postThreadReply(hit<HTMLElement>(".thread-composer")?.dataset.thread || "");
        const log = hit("[data-run-log]");
        if (log) return viewRunLog(log.dataset.runLog!);
        if (hit("[data-run-chat]")) return showTab("liveview");
        const stop = hit<HTMLButtonElement>("[data-run-stop]");
        if (stop) return stopRun(stop.dataset.runStop!, Number(stop.dataset.runN) || 0, stop);
        const cancel = hit<HTMLButtonElement>("[data-run-cancel]");
        if (cancel) return cancelQueuedRun(cancel);
        const rq = hit("[data-reveal-question]");
        if (rq) return revealQuestion(rq.dataset.revealQuestion!);
        if (hit("[data-pick-agent]")) return openPropPicker("agent");
      }

      function wireQuestions(listEl: HTMLElement, qs: TaskQuestion[]) {
        const byID = new Map(qs.map((q) => [q.id, q]));
        listEl.querySelectorAll<HTMLElement>(".q-card[data-question]").forEach((card) => {
          const q = byID.get(card.dataset.question!);
          if (!q || q.status !== "open") return;
          const draft = () => questionDrafts.get(q.id) ?? emptyDraft(q);
          const errEl = card.querySelector<HTMLElement>(".q-error")!;
          const clearError = () => {
            errEl.hidden = true;
            errEl.textContent = "";
          };
          card.querySelectorAll<HTMLInputElement>("[data-q-opt]").forEach((inp) => {
            inp.addEventListener("change", () => {
              const i = Number(inp.dataset.qOpt);
              const multi = !!questionItems(q)[i]?.multi_select;
              questionDrafts.set(q.id, toggleOption(draft(), i, inp.value, multi));
              clearError();
            });
          });
          card.querySelectorAll<HTMLInputElement>("[data-q-other]").forEach((inp) => {
            inp.addEventListener("input", () => {
              const d = draft();
              const other = [...d.other];
              other[Number(inp.dataset.qOther)] = inp.value;
              questionDrafts.set(q.id, { ...d, other });
              clearError();
            });
          });
          card
            .querySelector<HTMLTextAreaElement>("[data-q-note]")
            ?.addEventListener("input", (e) => {
              questionDrafts.set(q.id, {
                ...draft(),
                note: (e.target as HTMLTextAreaElement).value,
              });
              clearError();
            });
          const submit = card.querySelector<HTMLButtonElement>("[data-q-submit]")!;
          card.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
              e.preventDefault();
              submit.click();
            }
          });
          submit.addEventListener("click", async () => {
            if (!activeTask) return;
            const d = draft();
            const problem = answerProblem(q, d);
            if (problem) {
              errEl.textContent = answerProblemMessage(q, problem);
              errEl.hidden = false;
              return;
            }
            submit.disabled = true;
            try {
              await api.post(`/tasks/${activeTask.id}/questions/${q.id}/answer`, answerBody(q, d));
            } catch (e) {
              errEl.textContent = t("tasks.questions.answer_failed", {
                error: (e as Error).message,
              });
              errEl.hidden = false;
              submit.disabled = false;
              return;
            }
            questionDrafts.delete(q.id);
            toast(t("tasks.questions.answered"), "ok");
            await refresh(true);
          });
          const cancel = card.querySelector<HTMLButtonElement>("[data-q-cancel]")!;
          cancel.addEventListener("click", async () => {
            if (!activeTask) return;
            const ok = await confirmDialog({
              title: t("tasks.questions.cancel_title"),
              message: t("tasks.questions.cancel_message"),
              confirmLabel: t("tasks.questions.cancel_button"),
              danger: true,
            });
            if (!ok) return;
            cancel.disabled = true;
            try {
              await api.post(`/tasks/${activeTask.id}/questions/${q.id}/cancel`, {});
            } catch (e) {
              toast(t("tasks.questions.cancel_failed", { error: (e as Error).message }), "err");
              cancel.disabled = false;
              return;
            }
            questionDrafts.delete(q.id);
            await refresh(true);
          });
        });
      }

      function questionFieldKey(el: Element | null): string {
        const card = el?.closest?.(".q-card[data-question]") as HTMLElement | null;
        if (!card || !(el instanceof HTMLElement)) return "";
        const id = CSS.escape(card.dataset.question!);
        if (el.dataset.qOther !== undefined)
          return `.q-card[data-question="${id}"] [data-q-other="${el.dataset.qOther}"]`;
        if (el.hasAttribute("data-q-note")) return `.q-card[data-question="${id}"] [data-q-note]`;
        return "";
      }

      function activityCtx(): ActivityCtx {
        return {
          now: Date.now(),
          stageLabel: (id: string) => stageInfo(id)?.label || id,
          eventLabel: eventKindLabel,
          liveAction: (id: string) => liveActions.get(id) || "",
          viewer,
          eventText: (e) => historyText(e, { stageLabel: (id) => stageInfo(id)?.label || id }),
          eventLine: (ev: StreamEvent) => threadEventText(ev, threadTitle),
          fixedAbove: statusCause(activeTask?.status),
        };
      }

      function threadTitle(rootID: string): string {
        const root = (activeTask?.comments || []).find((c: any) => c.id === rootID);
        return root ? excerpt(root.body || "", 60) : "";
      }

      function renderPinned(task: Task) {
        const box = document.getElementById("act-pinned");
        if (!box) return;
        const open = (task.questions || []).filter(
          (q) => q.status === "open" && questionItems(q).length > 0,
        );
        const sig = open.map(questionSig).join(",");
        if (sig === pinnedSig && (open.length === 0 || box.childNodes.length > 0)) return;
        const qFocus = questionFieldKey(document.activeElement);
        const ctx = activityCtx();
        box.innerHTML = open
          .map(
            (q) =>
              `<div class="act-q" role="region" aria-label="${esc(questionWhoText(q.agent || "", isBlocking(q)))}">${questionPinHeadHTML(q.agent || "", q.created_at || "", ctx, isBlocking(q))}${questionHTML(q, questionDrafts.get(q.id) ?? emptyDraft(q), { pinned: true })}</div>`,
          )
          .join("");
        box.hidden = open.length === 0;
        wireQuestions(box, open);
        if (qFocus) {
          const el = box.querySelector<HTMLInputElement | HTMLTextAreaElement>(qFocus);
          if (el) {
            el.focus();
            el.setSelectionRange(el.value.length, el.value.length);
          }
        }
        pinnedSig = sig;
      }

      // i18n-ignore a selector: the relative times of Activity and History
      const RELATIVE_TIMES = "#ov-activity time[data-ts], #tl-list time[data-ts]";

      function refreshTimes() {
        const now = Date.now();
        document.querySelectorAll<HTMLElement>(RELATIVE_TIMES).forEach((el) => {
          const txt = relTime(el.dataset.ts || "", now);
          if (el.textContent !== txt) el.textContent = txt;
        });
        document
          .querySelectorAll<HTMLElement>("#ov-activity [data-running-since]")
          .forEach((el) => {
            const txt = runningForText(el.dataset.runningSince || "", now);
            if (el.textContent !== txt) el.textContent = txt;
          });
      }

      function runErrorLine(run: RunInfo): string {
        if (run.state !== "failed" || !run.finishedAt) return "";
        const end = Date.parse(run.finishedAt);
        const note = (activeTask?.comments || []).find((c: any) => {
          if (c.source !== "system") return false;
          const at = Date.parse(c.created_at);
          return at >= end - 5000 && at <= end + 15000;
        });
        const lines = String(note?.body || "")
          .split("\n")
          .map((l) => l.replace(/[*_`#>]/g, "").trim())
          .filter(Boolean);
        if (lines.length < 2) return "";
        const last = lines[lines.length - 1];
        return last.length > 160 ? last.slice(0, 159) + "…" : last;
      }

      function renderComments() {
        const task = activeTask;
        const listEl = document.getElementById("ov-comments");
        if (!task || !listEl) return;

        const qByComment = questionsByComment(task.questions);
        const all = (task.comments || []) as Array<StreamComment & Record<string, any>>;
        const people = new Set(
          all.filter((c) => c.source !== "system" || qByComment.has(c.id)).map((c) => c.id),
        );
        const cs = all.filter(
          (c) => people.has(c.id) || (!!c.parent_id && people.has(c.parent_id) && isNoteLine(c)),
        );
        const notes = all.filter((c) => !c.parent_id && !people.has(c.id) && isNoteLine(c));
        const atts = (task.attachments || []) as Attachment[];
        const byComment = new Map<string, Attachment[]>();
        for (const a of atts) {
          if (!a.comment_id) continue;
          const bucket = byComment.get(a.comment_id) || [];
          bucket.push(a);
          byComment.set(a.comment_id, bucket);
        }
        const evs = streamEventsTask === task.id ? streamEvents : [];
        const runs = runsFromEvents(evs, { status: task.status, alive: task.run_alive });
        watchRun(runs.filter((r) => r.state === "running").pop());
        renderPinned(task);
        const nOpen = openThreadCount(cs);
        const openEl = $("act-open");
        if (openEl.dataset.n !== String(nOpen)) {
          setCount(openEl, nOpen, openThreadsCount(nOpen));
          openEl.dataset.n = String(nOpen);
        }
        const kids = task.parent_id ? [] : task.children || [];
        const { agent: sendTo, gone: goneAgent } = applyTarget(
          task,
          agentTypesLoaded
            ? (name) => agentTypes.some((a) => a.type === name || a.name === name)
            : undefined,
        );

        const nextSig = [
          cs
            .map(
              (c: any) =>
                `${c.id}:${c.parent_id || ""}:${(c.body || "").length}:${c.author || ""}:${c.stage || ""}:${(byComment.get(c.id) || []).length}:${c.resolved_at || ""}`,
            )
            .join("|"),
          notes.map((c) => c.id).join(","),
          evs.map((e) => e.id).join(","),
          runs
            .map((r) => `${r.id}:${r.state}:${r.exit ?? ""}:${r.containerID}:${r.turns ?? ""}`)
            .join(","),
          kids.map((c) => `${c.id}:${c.title}`).join(","),
          activityFilter,
          replyingTo || "",
          [...expandedThreads].join(","),
          [...shownResolved].join(","),
          [...openGroups].join(","),
          streamExpanded ? "1" : "",
          [...qByComment.values()].map(questionSig).join(","),
          viewer?.name || viewer?.email || "",
          sendTo,
          goneAgent,
          applyingTo || "",
          statusCause(activeTask?.status),
        ].join("#");

        if (nextSig === commentsSig && listEl.childNodes.length > 0) {
          refreshTimes();
          return;
        }
        const ctx = activityCtx();

        const attStrip = (c: any) => {
          const own = (byComment.get(c.id) || []).filter((a) => !embeddedIn(c.body || "", a.id));
          if (own.length === 0) return "";
          return `<div class="comment-atts">${own
            .map(
              (a) =>
                `<button class="comment-att" type="button" data-lightbox="${esc(a.id)}" title="${esc(a.filename)}">
                    <span class="comment-att-name">${esc(a.filename)}</span>
                    <span class="comment-att-size">${fmtBytes(a.size)}</span>
                  </button>`,
            )
            .join("")}</div>`;
        };
        const bodyHTML = (c: any) => {
          const q = qByComment.get(c.id);
          if (!q || questionItems(q).length === 0)
            return mdHTML(mdBody(c.body || ""), { compact: true, cls: "act-body" });
          if (q.status === "open")
            return `<button class="act-q-ref" type="button" data-reveal-question="${esc(q.id)}">${icoSvg("i-help")}<span>${esc(t("tasks.comments.question_above"))}</span></button>`;
          return questionHTML(q, emptyDraft(q), {
            resumeFailed: activeTask?.status === "resume_failed",
          });
        };
        const commentHTML = (c: any) => {
          if (c.source === "system" && c.parent_id && !qByComment.has(c.id))
            return threadNoteHTML(c, ctx);
          const kind = authorKind(c.source);
          const name = authorLabel(c, viewer);
          return `<div class="act-c" id="comment-${esc(c.id)}">
              ${avatarHTML(kind, name)}
              <div class="act-main">${metaHTML({ name, kind, at: c.created_at, stage: c.stage || "" }, ctx)}${bodyHTML(c)}${attStrip(c)}</div>
            </div>`;
        };
        const threadComposerHTML = (rootID: string, to: string) => {
          const draft = threadDrafts.get(rootID) || "";
          return composerHTML({
            variant: "thread",
            label: t("tasks.comments.threads.reply_label"),
            placeholder: to
              ? t("tasks.comments.threads.placeholder_to", { agent: to })
              : t("tasks.comments.threads.placeholder_none"),
            audience: audienceLine({ text: draft, handles: mentionHandles(), fallback: to }),
            audienceAttrs: { "data-thread-audience": true },
            cancel: true,
            cancelAttrs: { "data-thread-cancel": true },
            submitLabel: t("lib.activity.thread.reply"),
            submitTitle: t("tasks.comments.post_key", {
              keys: chordText([MOD_KEY, t("tasks.kbd.enter")]),
            }),
            submitAttrs: { "data-thread-post": true },
            ready: !!draft.trim(),
            inputCls: "thread-input",
            cls: "thread-composer",
            attrs: { "data-thread": rootID },
          });
        };
        const threadHTML = (it: Extract<StreamItem, { type: "thread" }>) => {
          const th = it.thread as { root: any; replies: any[] };
          const rootID = th.root.id;
          const composing = replyingTo === rootID;
          if (it.resolved && !shownResolved.has(rootID) && !composing)
            return resolvedLineHTML(it.thread, th.root.resolved_by || "", ctx);
          const { shown, hidden } = visibleReplies(
            th.replies,
            expandedThreads.has(rootID) || it.resolved,
          );
          const typing = `<div class="typing-row thread-typing" data-thread-typing="${esc(rootID)}"></div>`;
          const actions =
            threadActionsHTML({
              id: rootID,
              replies: th.replies.length,
              resolved: it.resolved,
              agent: sendTo,
              goneAgent,
              stageAgent: task.stage_assignments?.[task.stage] ?? "",
              canSubtask: true,
              canHide: it.resolved,
            }) +
            (applyingTo === rootID && sendTo && !it.resolved
              ? applyFormHTML(rootID, sendTo, applyNotes.get(rootID) || "")
              : "");
          const replies =
            (hidden ? earlierRepliesHTML(rootID, hidden) : "") +
            shown.map(commentHTML).join("") +
            typing +
            (composing ? threadComposerHTML(rootID, lastAgent(th)) : "");
          const who = authorLabel(th.root, viewer);
          return `<article class="act-thread${it.open ? " is-open" : ""}${it.resolved ? " is-resolved" : ""}" data-thread="${esc(rootID)}" tabindex="-1" aria-label="${esc(t("tasks.comments.threads.label", { who }))}">
              ${commentHTML(th.root)}
              ${actions}
              <div class="act-replies${th.replies.length || composing ? "" : " is-empty"}">${replies}</div>
            </article>`;
        };
        const itemHTML = (it: StreamItem) => {
          if (it.type === "thread") return threadHTML(it);
          if (it.type === "run") return runCardHTML(it.run, ctx, runErrorLine(it.run));
          if (it.type === "group") return groupHTML(it, openGroups.has(it.id), ctx);
          return systemLineHTML(it.entry, ctx);
        };

        const items = buildStream({
          comments: cs,
          events: evs,
          runs,
          notes,
          children: kids.map((c) => ({ id: c.id, title: c.title, created_at: c.created_at })),
          filter: activityFilter,
        });
        const { shown, hidden } = foldStream(items, streamExpanded);
        const empty = {
          all: t("tasks.comments.empty"),
          comments: t("tasks.comments.empty"),
          runs: t("tasks.comments.empty_runs"),
          system: t("tasks.comments.empty_system"),
        }[activityFilter];

        const composerFocused =
          document.activeElement instanceof HTMLTextAreaElement &&
          document.activeElement.classList.contains("thread-input");
        const applyFocused =
          document.activeElement instanceof HTMLTextAreaElement &&
          document.activeElement.classList.contains("thread-apply-note");
        listEl.innerHTML =
          items.length === 0
            ? emptyStateHTML({ size: "sm", body: empty })
            : (hidden ? foldRowHTML(hidden) : "") + shown.map(itemHTML).join("");
        const box = listEl.querySelector<HTMLElement>(".thread-composer");
        if (box) {
          const ta = box.querySelector<HTMLTextAreaElement>(".thread-input")!;
          ta.value = threadDrafts.get(box.dataset.thread!) || "";
          growComposer(ta);
          attachMentionAutocomplete(ta);
          if (composerFocused) {
            ta.focus({ preventScroll: true });
            ta.setSelectionRange(ta.value.length, ta.value.length);
          }
        }
        const applyNote = listEl.querySelector<HTMLTextAreaElement>(".thread-apply-note");
        if (applyNote) {
          growComposer(applyNote);
          if (applyFocused) {
            applyNote.focus({ preventScroll: true });
            applyNote.setSelectionRange(applyNote.value.length, applyNote.value.length);
          }
        }
        commentsSig = nextSig;
        paintComposer();
        void renderTypingIndicators();
      }

      // Only hits /events when a system comment carries a mention instance id
      // (`<agent>-mention-<task>-…`), which is language-independent.
      // renderComments empties the slots, so it calls this after every rebuild.
      let typingTimer: number | null = null;
      const TYPING_POLL_MS = 4000;
      function pollTyping(on: boolean) {
        if (on && typingTimer === null)
          typingTimer = window.setInterval(() => void renderTypingIndicators(), TYPING_POLL_MS);
        else if (!on && typingTimer !== null) {
          window.clearInterval(typingTimer);
          typingTimer = null;
        }
      }
      async function renderTypingIndicators() {
        const box = $("ov-typing");
        if (!box || !activeTask || !$("drawer").classList.contains("open")) {
          pollTyping(false);
          return;
        }
        const taskID = activeTask.id;
        const hasMention = (activeTask.comments || []).some(
          (c: any) => c.source === "system" && /-mention-/.test(c.body || ""),
        );
        let inflight: { agent: string; thread: string }[] = [];
        if (hasMention) {
          try {
            inflight = inflightMentions(await api.get<any[]>(`/tasks/${taskID}/events`));
          } catch {
            return;
          }
          if (!activeTask || activeTask.id !== taskID) return;
        }
        pollTyping(inflight.length > 0);
        const slots = new Map<string, HTMLElement>();
        document
          .querySelectorAll<HTMLElement>("#ov-comments [data-thread-typing]")
          .forEach((el) => slots.set(el.dataset.threadTyping || "", el));
        const agentsIn = new Map<HTMLElement, string[]>([[box, []]]);
        slots.forEach((el) => agentsIn.set(el, []));
        for (const m of inflight) agentsIn.get(slots.get(m.thread) || box)!.push(m.agent);
        agentsIn.forEach((agents, el) => {
          const sig = agents.join("|");
          if ((el.dataset.sig || "") === sig) return;
          el.dataset.sig = sig;
          el.innerHTML = agents
            .map(
              (agent) => `
          <div class="act-c act-typing-line">
            ${avatarHTML("agent", agent)}
            <span class="typing-who">${t("tasks.comments.typing_html", { agent: esc(agent) })}</span>
            <span class="typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          </div>`,
            )
            .join("");
        });
      }

      let mentionOpen = false;
      function attachMentionAutocomplete(ta: HTMLTextAreaElement | null) {
        if (!ta) return;
        const mentionAgents = mentionableAgents(agentTypes);
        const host = ta.closest<HTMLElement>(".composer") ?? ta.parentElement ?? ta;
        const handleOf = (a: AgentType) => a.type || a.name;
        let picker: PickerHandle | null = null;
        let anchor = -1;

        const close = () => {
          picker?.close(false);
          picker = null;
          anchor = -1;
        };
        const choose = (handle: string) => {
          const caret = ta.selectionStart;
          const before = ta.value.slice(0, anchor);
          const after = ta.value.slice(caret);
          const insert = "@" + handle + " ";
          ta.value = before + insert + after;
          const newCaret = before.length + insert.length;
          ta.setSelectionRange(newCaret, newCaret);
          anchor = -1;
          ta.focus();
          ta.dispatchEvent(new Event("input", { bubbles: true }));
        };

        const sync = () => {
          const caret = ta.selectionStart;
          const m = ta.value.slice(0, caret).match(/(^|\s)@([a-zA-Z0-9_-]*)$/);
          if (!m) {
            close();
            return;
          }
          anchor = caret - m[2].length - 1;
          if (picker?.isOpen()) {
            picker.setQuery(m[2]);
            return;
          }
          mentionOpen = true;
          picker = openPicker(host, {
            label: t("tasks.comments.mention_label"),
            mount: host,
            start: true,
            focus: false,
            empty: t("tasks.comments.mention_empty"),
            items: (q) => {
              const needle = q.toLowerCase();
              return mentionAgents
                .filter(
                  (a) =>
                    handleOf(a).toLowerCase().includes(needle) ||
                    (a.name || "").toLowerCase().includes(needle),
                )
                .map((a) => ({
                  value: handleOf(a),
                  label: "@" + handleOf(a),
                  hint: a.description,
                }));
            },
            onSelect: (item) => choose(item.value),
            onClose: () => {
              picker = null;
              mentionOpen = false;
            },
          });
          picker.setQuery(m[2]);
        };

        ta.addEventListener("input", () => {
          if (anchor >= 0 || /(^|\s)@[a-zA-Z0-9_-]*$/.test(ta.value.slice(0, ta.selectionStart)))
            sync();
        });
        ta.addEventListener("keyup", (e) => {
          // i18n-ignore KeyboardEvent.key values
          if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(e.key)) sync();
        });
        ta.addEventListener("keydown", (e) => {
          if (!picker?.isOpen() || e.metaKey || e.ctrlKey) return;
          if (picker.keydown(e)) e.stopPropagation();
        });
        ta.addEventListener("blur", () => setTimeout(close, 120));
      }

      let approvalNoting: NoteForm | null = null;
      let approvalAskOpen = false;
      let approvalMenuFor: string | null = null;

      async function decideApproval(id: string, decision: Decision, note: string) {
        const body = decisionBody(decision, note);
        if (!body) {
          toast(t("tasks.approvals.note_required"), "err");
          return;
        }
        try {
          const res = await api.post<{ mappings_activated?: number }>(
            `/tasks/${activeTask!.id}/approvals/${id}/decide`,
            body,
          );
          const n = res?.mappings_activated ?? 0;
          if (n > 0) toast(t("tasks.approvals.approved_mappings", { count: n }), "ok");
        } catch (e) {
          toast(t("tasks.approvals.update_failed", { error: (e as Error).message }), "err");
          return;
        }
        approvalNoting = null;
        await refresh(true);
      }

      let apMenuRelease: (() => void) | null = null;
      function releaseApprovalMenu() {
        apMenuRelease?.();
        apMenuRelease = null;
        approvalMenuFor = null;
      }
      function closeApprovalMenu(restore = true): boolean {
        if (!approvalMenuFor) return false;
        const id = approvalMenuFor;
        releaseApprovalMenu();
        renderApprovals();
        if (restore)
          document
            .querySelector<HTMLButtonElement>(`#pane-approvals [data-ap-menu="${CSS.escape(id)}"]`)
            ?.focus();
        return true;
      }

      function renderApprovals() {
        if (!activeTask) return;
        const list = approvalsOf(activeTask);
        const pane = $("pane-approvals");
        const task = activeTask;
        const view: PaneView = {
          askOpen: approvalAskOpen,
          menuFor: approvalMenuFor,
          readOnly: !mayWriteTasks,
          stageLabel,
          effectOf: (a) =>
            changesEffect(
              a,
              task.stage,
              stages,
              task.stage_assignments?.[task.stage] ?? "",
              task.status === "running",
            ),
        };
        const sig = approvalsSig(list, approvalNoting, view);
        if (pane.dataset.sig === sig && pane.childNodes.length > 0) return;
        const keep = {
          label: (pane.querySelector("#ap-label") as HTMLInputElement | null)?.value ?? "",
          reason: (pane.querySelector("#ap-reason") as HTMLInputElement | null)?.value ?? "",
          note: (pane.querySelector("[data-ap-note]") as HTMLTextAreaElement | null)?.value ?? "",
        };
        const notes = new Map<string, string>();
        pane
          .querySelectorAll<HTMLTextAreaElement>("[data-ap-note-for]")
          .forEach((el) => notes.set(el.dataset.apNoteFor!, el.value));
        const focusID = pane.contains(document.activeElement)
          ? (document.activeElement as HTMLElement).id
          : "";
        pane.innerHTML = approvalsPaneHTML(list, approvalNoting, view);
        pane.dataset.sig = sig;
        const askLabel = pane.querySelector<HTMLInputElement>("#ap-label");
        const askReason = pane.querySelector<HTMLInputElement>("#ap-reason");
        if (askLabel) askLabel.value = keep.label;
        if (askReason) askReason.value = keep.reason;
        pane.querySelectorAll<HTMLTextAreaElement>("[data-ap-note-for]").forEach((el) => {
          el.value = notes.get(el.dataset.apNoteFor!) || "";
        });
        const noteBox = pane.querySelector<HTMLTextAreaElement>("[data-ap-note]");
        if (noteBox) {
          noteBox.value = keep.note;
          noteBox.focus();
        } else if (focusID) document.getElementById(focusID)?.focus();
        apMenuRelease?.();
        apMenuRelease = null;
        const pop = pane.querySelector<HTMLElement>(".ap-pop");
        if (pop && approvalMenuFor) {
          const btn = pane.querySelector<HTMLElement>(
            `[data-ap-menu="${CSS.escape(approvalMenuFor)}"]`,
          );
          apMenuRelease = dismissLayer(pop, btn, (restore) => void closeApprovalMenu(restore));
        }
      }

      async function addApproval() {
        const label = ($("ap-label") as HTMLInputElement).value.trim();
        const reason = ($("ap-reason") as HTMLInputElement).value.trim();
        if (!label) {
          $("ap-label").focus();
          return;
        }
        try {
          await api.post(`/tasks/${activeTask!.id}/approvals`, { label, reason });
        } catch (e) {
          toast(t("tasks.approvals.add_failed", { error: (e as Error).message }), "err");
          return;
        }
        ($("ap-label") as HTMLInputElement).value = "";
        ($("ap-reason") as HTMLInputElement).value = "";
        approvalAskOpen = false;
        await refresh(true);
      }

      async function approvalAction(b: HTMLButtonElement) {
        const task = activeTask;
        if (!task) return;
        const pane = $("pane-approvals");
        const id = b.dataset.id!;
        const action = b.dataset.ap!;
        const a = approvalsOf(task).find((x) => x.id === id);
        if (action === "dismiss") {
          approvalNoting = null;
          renderApprovals();
          return;
        }
        if (action === "confirm" && approvalNoting) {
          b.disabled = true;
          await decideApproval(
            id,
            approvalNoting.decision,
            pane.querySelector<HTMLTextAreaElement>("[data-ap-note]")?.value ?? "",
          );
          b.disabled = false;
          return;
        }
        releaseApprovalMenu();
        if (action === "delete") {
          const ok = await confirmDialog({
            title: t("tasks.approvals.delete_title", { label: a?.label || "" }),
            message: t("tasks.approvals.delete_message"),
            confirmLabel: t("tasks.approvals.delete_button"),
            danger: true,
          });
          if (!ok) {
            renderApprovals();
            return;
          }
          try {
            await api.del(`/tasks/${task.id}/approvals/${id}`);
          } catch (e) {
            toast(t("tasks.approvals.update_failed", { error: (e as Error).message }), "err");
            renderApprovals();
            return;
          }
          await refresh(true);
          return;
        }
        const decision = action as Decision;
        if (a?.status === "pending") {
          const noteEl = pane.querySelector<HTMLTextAreaElement>(
            `[data-ap-note-for="${CSS.escape(id)}"]`,
          );
          const note = noteEl?.value ?? "";
          if (decisionNeedsNote(decision) && !note.trim()) {
            if (noteEl)
              setFieldError(
                noteEl,
                decision === "waived"
                  ? t("tasks.approvals.note_needed_waive")
                  : t("tasks.approvals.note_needed_changes"),
                { focus: true },
              );
            return;
          }
          b.disabled = true;
          await decideApproval(id, decision, note);
          b.disabled = false;
          return;
        }
        if (decisionNeedsNote(decision)) {
          approvalNoting = { id, decision };
          renderApprovals();
          return;
        }
        b.disabled = true;
        await decideApproval(id, decision, "");
        b.disabled = false;
      }

      function wireApprovals() {
        const pane = $("pane-approvals");
        pane.addEventListener("click", async (e) => {
          const el = e.target as HTMLElement;
          const menuBtn = el.closest<HTMLElement>("[data-ap-menu]");
          if (menuBtn) {
            const id = menuBtn.dataset.apMenu!;
            if (approvalMenuFor === id) {
              closeApprovalMenu();
              return;
            }
            approvalMenuFor = id;
            renderApprovals();
            const pop = pane.querySelector<HTMLElement>(".ap-pop");
            if (pop) menuFocusables(pop)[0]?.focus();
            return;
          }
          if (el.closest("#ap-ask-open")) {
            approvalAskOpen = true;
            renderApprovals();
            $("ap-label").focus();
            return;
          }
          if (el.closest("#ap-ask-cancel")) {
            approvalAskOpen = false;
            renderApprovals();
            $("ap-ask-open").focus();
            return;
          }
          if (el.closest("#ap-add")) return addApproval();
          const b = el.closest<HTMLButtonElement>("[data-ap]");
          if (b) return approvalAction(b);
        });
        pane.addEventListener("keydown", (e) => {
          const el = e.target as HTMLElement;
          const pop = el.closest<HTMLElement>(".ap-pop");
          if (pop && menuStep(e, pop)) return;
          if (pop && e.key === "Tab") {
            closeApprovalMenu(false);
            return;
          }
          if (e.key === "Enter" && (el.id === "ap-label" || el.id === "ap-reason")) {
            e.preventDefault();
            void addApproval();
          }
        });
        pane.addEventListener("input", (e) => {
          const el = e.target as HTMLElement;
          const id = el.dataset?.apNoteFor;
          if (!id || el.getAttribute("aria-invalid") !== "true") return;
          setFieldError(el, "");
        });
      }

      async function renderReports(opts: { force?: boolean } = {}) {
        const task = activeTask;
        if (!task) return;
        const pane = $("pane-reports");
        const focusInside = pane.contains(document.activeElement);
        if (focusInside && !opts.force) return;

        if (opts.force || reportsLastTaskID !== task.id) await loadReports(task.id);

        const reports = reportsNewestFirst(reportsCache);
        const sig =
          (viewer ? "v|" : "") +
          reports
            .map((r) => `${r.id}:${(r.body || "").length}:${reportsExpanded.has(r.id) ? "1" : "0"}`)
            .join("|");
        if (pane.dataset.sig === sig && pane.childNodes.length > 0) return;

        if (reportsCache.length === 0) {
          pane.innerHTML = `<div class="muted">${esc(t("tasks.runs.reports.empty"))}</div>`;
          pane.dataset.sig = sig;
          return;
        }

        const rows = reports
          .map((r) => {
            const ts = new Date(r.created_at).toLocaleString(locale);
            const open = reportsExpanded.has(r.id);
            const stageID = r.stage || "";
            const v = reportView(r, (id) => stageInfo(id)?.label || id);
            const meta = [
              r.author ? esc(authorLabel(r, viewer)) : "",
              stageID
                ? `<span title="${esc(stageID)}">${esc(reportStageLabel(stageID, (id) => stageInfo(id)?.label))}</span>`
                : "",
              v.score ? esc(t("lib.reports.score", { score: v.score })) : "",
              esc(ts),
            ]
              .filter(Boolean)
              .join(" · ");
            return `<div class="report-card ${open ? "open" : ""}" id="report-${esc(r.id)}">
            <button class="report-head" type="button" data-toggle="${esc(r.id)}" aria-expanded="${open}">
              ${sourceTagHTML(r.source, v.source)}
              <span class="report-title">${esc(v.title)}</span>
              <span class="report-meta">${meta}</span>
              ${icoSvg(DISCLOSURE_CARET, { cls: "report-chev" })}
            </button>
            ${open ? `<div class="report-body">${mdHTML(mdBody(v.body), { compact: true })}</div>` : ""}
          </div>`;
          })
          .join("");
        pane.innerHTML = rows;
        pane.dataset.sig = sig;
        pane.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((b) => {
          b.addEventListener("click", () => {
            const id = b.dataset.toggle!;
            if (reportsExpanded.has(id)) reportsExpanded.delete(id);
            else reportsExpanded.add(id);
            renderReports({ force: true });
          });
        });
      }

