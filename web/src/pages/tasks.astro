        mention_started: "tasks.runs.event_kinds.mention_started",
        mention_finished: "tasks.runs.event_kinds.mention_finished",
        auditor_prompt: "tasks.runs.event_kinds.auditor_prompt",
        auditor_verdict: "tasks.runs.event_kinds.auditor_verdict",
        auditor_run_started: "tasks.runs.event_kinds.auditor_run_started",
