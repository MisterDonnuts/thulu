      const DEP_KIND = {
        hard: "tasks.drawer.deps.kind_hard",
        soft: "tasks.drawer.deps.kind_soft",
      } as const;

      function openDepsSelect(propEl: HTMLElement) {
        if (!activeTask) return;
        const task = activeTask;

        // The daemon refuses a hard dependency once the task has left the initial stage.
        const initialID = initialStage();
        const hardOK = task.stage === initialID;
        const initialLabel = stageInfo(initialID)?.label || initialID;

        const current = () => ({
          heading: t("tasks.drawer.deps.blocked_by"),
          empty: t("tasks.drawer.deps.empty"),
          items: ((task as any).blocked_by || []).map((d: any) => {
            const unmet = d.kind === "hard" && !stageInfo(d.stage)?.terminal;
            const kind =
              d.kind === "hard" || d.kind === "soft"
                ? t(DEP_KIND[d.kind as "hard" | "soft"])
                : d.kind;
            const stage = stageInfo(d.stage)?.label || d.stage;
            const label = d.title || shortId(d.task_id);
            return {
              value: d.task_id,
              label,
              labelHTML: tagHTML(label, {
                tone: unmet ? "warn" : undefined,
                icon: unmet ? "i-lock" : undefined,
                dashed: d.kind !== "hard",
              }),
              hint: unmet
                ? t("tasks.drawer.deps.meta_blocked", { kind, stage })
                : t("tasks.drawer.deps.meta", { kind, stage }),
            };
          }),
        });

        const candidates = (q: string): PickerItem[] => {
          const needle = q.trim().toLowerCase();
          const taken = new Set(
            [...((task as any).blocked_by || []), ...((task as any).blocking || [])].map(
              (d: any) => d.task_id,
            ),
          );
          const fits = (x: Task) =>
            x.id !== task.id &&
            !taken.has(x.id) &&
            (!needle || (x.title || "").toLowerCase().includes(needle) || x.id.includes(needle));
          const siblings =
            task.parent_id && parentTask?.id === task.parent_id
              ? (parentTask.children || []).filter(fits).slice(0, 12)
              : [];
          const sibIDs = new Set(siblings.map((x) => x.id));
          const others = tasks
            .filter((x) => fits(x) && !sibIDs.has(x.id))
            .slice(0, Math.max(0, 12 - siblings.length));
          const item = (x: Task, group?: string): PickerItem => {
            const label = x.title || shortId(x.id);
            return {
              value: x.id,
              label,
              labelHTML: tagHTML(label),
              hint: stageInfo(x.stage)?.label || x.stage,
              group,
            };
          };
          if (!siblings.length) return others.map((x) => item(x));
          return [
            ...siblings.map((x) => item(x, t("tasks.drawer.deps.siblings"))),
            ...others.map((x) => item(x, t("tasks.drawer.deps.other_tasks"))),
          ];
        };

        const failed = (e: unknown, apiText: (msg: string) => string) =>
          e instanceof ApiError
            ? apiText(e.message)
            : t("tasks.errors.network_detail", { error: (e as Error).message });

        // The API omits an empty side of the graph, so reset both before merging.
        async function reread() {
          try {
            const fresh = await api.get<Task>(`/tasks/${task.id}`);
            Object.assign(task, { blocked_by: [], blocking: [] }, fresh);
          } catch {}
          handle.refresh();
          refresh(true);
        }

        const handle = pickOn(propEl, {
          label: t("tasks.drawer.deps.add_label"),
          search: t("tasks.drawer.deps.search_placeholder"),
          multi: true,
          current,
          kind: {
            label: t("tasks.drawer.deps.kind_label"),
            value: hardOK ? "hard" : "soft",
            options: [
              { value: "hard", label: t("tasks.drawer.deps.kind_hard"), disabled: !hardOK },
              { value: "soft", label: t("tasks.drawer.deps.kind_soft") },
            ],
          },
          hint: hardOK
            ? undefined
            : t("tasks.drawer.deps.hard_initial_only", { stage: initialLabel }),
          errors: true,
          items: candidates,
          onSelect: async (item, pick) => {
            handle.setError("");
            try {
              await api.post(`/tasks/${task.id}/dependencies`, {
                depends_on_task_id: item.value,
                kind: pick?.kind || "hard",
              });
            } catch (e) {
              handle.setError(failed(e, (msg) => msg));
              return;
            }
            await reread();
          },
          onRemove: async (id) => {
            handle.setError("");
            try {
              await api.del(`/tasks/${task.id}/dependencies/${encodeURIComponent(id)}`);
            } catch (e) {
              handle.setError(
                failed(e, (error) => t("tasks.drawer.deps.remove_failed", { error })),
              );
              return;
            }
            await reread();
          },
        });
      }

      const PRIORITY_OPTIONS = [
        { value: "", labelKey: "tasks.drawer.priority.none" },
        { value: "low", labelKey: "tasks.drawer.priority.low" },
        { value: "medium", labelKey: "tasks.drawer.priority.medium" },
        { value: "high", labelKey: "tasks.drawer.priority.high" },
        { value: "urgent", labelKey: "tasks.drawer.priority.urgent" },
      ] as const;
      function openPrioritySelect(propEl: HTMLElement) {
        if (!activeTask) return;
        const task = activeTask;
        const cur = task.priority || "";
        pickOn(propEl, {
          label: t("tasks.drawer.props.priority"),
          items: PRIORITY_OPTIONS.map((opt) => {
            const label = t(opt.labelKey);
            return {
              value: opt.value,
              label,
              labelHTML: (opt.value && taskPriorityTagHTML(opt.value)) || emptyValueHTML(label),
              selected: opt.value === cur,
            };
          }),
          onSelect: async (item) => {
            if (item.value === cur) return;
            try {
              await api.patch(`/tasks/${task.id}`, { priority: item.value });
            } catch {
              toast(t("tasks.drawer.priority.set_failed"), "err");
              return;
            }
            task.priority = item.value;
            repaintProps();
          },
        });
      }

      function openTypeSelect(propEl: HTMLElement) {
        if (!activeTask) return;
        const task = activeTask;
        const cur = task.type_id || "";
        const row = (id: string, label: string): PickerItem => ({
          value: id,
          label,
          leadHTML: (id && typeIconHTML(taskTypes, id)) || dotHTML("neutral"),
          selected: id === cur,
        });
        const applyType = async (typeID: string, stage?: string) => {
          const body: Record<string, string> = { type_id: typeID };
          if (stage) body.stage = stage;
          try {
            const res = await fetch(`${API}/tasks/${task.id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json", ...csrfHeaders() },
              credentials: "include",
              body: JSON.stringify(body),
            });
            if (res.status === 409) {
              const j = await res.json();
              pickStageFor(typeID, j.available_stages || [], j.error || "");
              return;
            }
            if (!res.ok) {
              toast(t("tasks.types.change_failed"), "err");
              return;
            }
          } catch {
            toast(t("tasks.errors.network"), "err");
            return;
          }
          await refresh(true);
          toast(t("tasks.types.changed"), "ok");
        };
        const pickStageFor = (typeID: string, available: Stage[], why: string) => {
          const prop = propRow("type");
          if (!prop) return;
          pickOn(prop, {
            label: t("tasks.drawer.props.stage"),
            hint: why,
            items: available.map((st) => ({
              value: st.id,
              label: st.label,
              labelHTML: stagePillHTML(st.id, st),
            })),
            onSelect: (item) => void applyType(typeID, item.value),
          });
        };
        pickOn(propEl, {
          label: t("tasks.drawer.props.type"),
          items: [
            ...taskTypes.map((ty) => row(ty.id, ty.label)),
            row("", t("tasks.types.untyped_option")),
          ],
          onSelect: (item) => {
            if (item.value !== cur) void applyType(item.value);
          },
        });
      }

      const tagOf = (q: string) => q.trim().replace(/\s+/g, "-").toLowerCase();
      function openTagsEdit(propEl: HTMLElement) {
        if (!activeTask) return;
        const task = activeTask;
        const items = (): PickerItem[] => {
          const mine = task.tags || [];
          const known = new Set([...mine, ...tasks.flatMap((x) => x.tags || [])]);
          return [...known].sort().map((tag) => ({
            value: tag,
            label: tag,
            labelHTML: labelTagHTML(tag),
            selected: mine.includes(tag),
            chip: { color: chipColor(tag) },
          }));
        };
        const setTags = async (next: string[], failed: string) => {
          try {
            await api.patch(`/tasks/${task.id}`, { tags: next });
          } catch {
            toast(failed, "err");
            return;
          }
          task.tags = next;
          handle.refresh();
        };
        const add = (tag: string) => {
          const mine = task.tags || [];
          if (!tag || mine.includes(tag)) return;
          void setTags([...mine, tag], t("tasks.drawer.tags.add_failed"));
        };
        const remove = (tag: string) =>
          void setTags(
            (task.tags || []).filter((x) => x !== tag),
            t("tasks.drawer.tags.remove_failed"),
          );
        const handle = pickOn(propEl, {
          label: t("tasks.drawer.props.tags"),
          multi: true,
          chips: true,
          search: t("tasks.drawer.tags.placeholder"),
          empty: t("tasks.drawer.tags.empty"),
          items: (q) => {
            const needle = q.trim().toLowerCase();
            const all = items();
            return needle ? all.filter((i) => i.selected || i.label.includes(needle)) : all;
          },
          createLabel: (q) => {
            const tag = tagOf(q);
            return !tag || items().some((i) => i.value === tag)
              ? null
              : t("tasks.drawer.tags.create", { tag });
          },
          onSelect: (item) => (item.selected ? remove(item.value) : add(item.value)),
          onRemove: remove,
          onCreate: (q) => add(tagOf(q)),
        });
      }

      let usageExpanded = false;
      let usageSig: string | null = null;

      let taskSandboxReading = "";
      async function loadTaskSandbox() {
        if (!activeTask) return;
        const taskId = activeTask.id;
        if (taskSandboxReading === taskId) return;
        taskSandboxReading = taskId;
        let sb: TaskSandbox | null = null;
        try {
          sb =
            (await api.get<TaskSandbox | undefined>(
              `/tasks/${encodeURIComponent(taskId)}/sandbox`,
            )) ?? null;
        } catch {
          sb = null;
        } finally {
          if (taskSandboxReading === taskId) taskSandboxReading = "";
        }
        if (!activeTask || activeTask.id !== taskId) return;
        const sig = (v: TaskSandbox | null) =>
          v ? JSON.stringify([v.status, Math.floor(v.idle_seconds / 60), v.urls]) : "";
        if (sig(sb) === sig(taskSandbox)) return;
        taskSandbox = sb;
        renderProps();
      }

      async function killTaskSandbox() {
        const sb = taskSandbox;
        if (!sb || refuseReadOnly()) return;
        const ok = await confirmDialog({
          title: t("tasks.drawer.props.sandbox_kill_title"),
          message: killMessage(activeTask?.title || sb.owner_id, sb.publishes_ports),
          confirmLabel: t("tasks.drawer.props.sandbox_kill"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/tasks/${encodeURIComponent(sb.owner_id)}/sandbox`);
          taskSandbox = null;
          renderProps();
          toast(t("tasks.drawer.props.sandbox_killed"), "ok");
        } catch (e) {
          toast(
            t("tasks.drawer.props.sandbox_kill_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
          );
        }
      }

      async function removeOrphanAgent(containerID: string) {
        const task = activeTask;
        const o = task?.orphan_agents?.find((x) => x.container_id === containerID);
        if (!task || !o || refuseReadOnly()) return;
        const ok = await confirmDialog({
          title: t("tasks.drawer.props.orphan_remove_title"),
          message: t("tasks.drawer.props.orphan_remove_message", { name: o.name }),
          confirmLabel: t("tasks.drawer.props.orphan_remove"),
          danger: true,
        });
        if (!ok) return;
        const btn = document.querySelector<HTMLButtonElement>(
          `[data-orphan-remove="${CSS.escape(containerID)}"]`,
        );
        if (btn) {
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
        }
        try {
          await api.del(
            `/tasks/${encodeURIComponent(task.id)}/orphan-agents/${encodeURIComponent(containerID)}`,
          );
          toast(t("tasks.drawer.props.orphan_removed"), "ok");
          await refresh(true);
        } catch (e) {
          toast(
            t("tasks.drawer.props.orphan_remove_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
          );
          if (btn) {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
          }
        }
