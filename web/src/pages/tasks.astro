      function renderNotify() {
        const slot = document.getElementById("dr-notify-slot");
        if (!slot || !activeTask) return;
        const html = notifyAgentHTML(activeTask);
        if (slot.dataset.sig === html) return;
        slot.innerHTML = html;
        slot.dataset.sig = html;
        paintComposer();
