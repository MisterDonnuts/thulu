      function renderProps() {
        const task = activeTask!;
        const box = document.getElementById("ov-props");
        if (!box) return;
        if (box.querySelector(".nselect")) return;
        const rows = propRows(task);
        setText(document.getElementById("ov-props-sum-text"), propsSummary(task, rows.length));
        const fold = foldIndex(rows.map((r) => !!r.wide));
        const sig = JSON.stringify([
          rows.map((r) => [r.key, r.value, r.edit]),
          fold,
          propsShowAll,
          mayWriteTasks,
        ]);
        if (box.dataset.sig === sig) return;
        const focused = (document.activeElement as HTMLElement | null)
          ?.closest?.("#ov-props [data-edit], #ov-props [data-props-more]")
          ?.getAttribute("data-edit");
        const rowHTML = rows.map((r, i) => {
          const editable = !!r.edit && mayWriteTasks;
          return propRowHTML({
            name: r.key,
            label: r.label,
            icon: r.icon,
            valueHTML: r.value,
            edit: editable ? r.edit : undefined,
            valueAttrs: editable ? { "data-edit": r.key } : undefined,
            trailingHTML:
              r.key === "projects" && mayWriteTasks
                ? buttonHTML({
                    iconOnly: true,
                    icon: "edit",
                    label: t("tasks.drawer.props.edit_projects"),
                    size: "sm",
                    variant: "ghost",
                    cls: "prop-edit",
                    attrs: { "data-edit": "projects", "aria-haspopup": "true" },
                  })
                : undefined,
            cls: [r.wide && "props-wide", i >= fold && "props-folded"].filter(Boolean).join(" "),
          });
        });
        box.innerHTML =
          `<div class="props-stick"><div class="props-top">${rowHTML.slice(0, fold).join("")}</div>` +
          `<div class="props-rest">${rowHTML.slice(fold).join("")}</div></div>` +
          (fold < rows.length
            ? buttonHTML({
                label: propsShowAll
                  ? t("tasks.drawer.props.show_less")
                  : t("tasks.drawer.props.show_all"),
                size: "sm",
                variant: "ghost",
                cls: "props-more",
                attrs: { "data-props-more": true, "aria-expanded": String(propsShowAll) },
              })
            : "");
        box.classList.toggle("show-all", propsShowAll);
        box.dataset.sig = sig;
        if (focused) box.querySelector<HTMLElement>(`[data-edit="${focused}"]`)?.focus();
        fitProps();
      }

      function fitProps() {
        const box = document.getElementById("ov-props");
        const body = box?.closest<HTMLElement>(".drawer-body");
        const rows = box?.querySelectorAll<HTMLElement>(".nprop:not([hidden])");
        if (!box || !body || !rows?.length) return;
        const span =
          rows[rows.length - 1].getBoundingClientRect().bottom -
          rows[0].getBoundingClientRect().top;
        const pad = parseFloat(getComputedStyle(body).paddingTop) || 0;
        box.classList.toggle("props-fit", span + 2 * pad <= body.clientHeight);
      }
      {
        const ro = new ResizeObserver(() => fitProps());
        ro.observe(drawerBody());
        signal.addEventListener("abort", () => ro.disconnect());
      }

      function propsSummary(task: Task, total: number): string {
        const parts = [
          stageInfo(task.stage)?.label || task.stage,
          task.stage_assignments?.[task.stage] || t("tasks.drawer.props.summary_no_agent"),
        ];
        const orphans = orphanSummary(task.orphan_agents);
        if (orphans) parts.push(orphans);
        const prio = priorityLook(task.priority);
        if (prio) parts.push(prio.label);
        const list = parts.join(", ");
        const more = total - parts.length;
        return more > 0 ? t("tasks.drawer.props.summary_more", { list, count: more }) : list;
      }

      let propsSheet: DrawerControls | null = null;
      function propsSheetOpen(): boolean {
        return !!propsSheet?.isOpen();
      }
      function openPropsSheet() {
        const sheet = document.getElementById("ov-props-sheet");
        const props = document.getElementById("ov-props");
        if (!sheet || !props || !propsSheet) return;
        sheet.querySelector(".drawer-body")?.appendChild(props);
        setPropListLayout(props, "sheet");
        $("ov-props-sum").setAttribute("aria-expanded", "true");
        propsSheet.open(sheet.querySelector<HTMLElement>("[data-modal-close]"));
      }
      function putPropsBack() {
        const sum = document.getElementById("ov-props-sum");
        const props = document.getElementById("ov-props");
        if (sum && props) {
          sum.after(props);
          setPropListLayout(props, "auto");
        }
        sum?.setAttribute("aria-expanded", "false");
      }
      function closePropsSheet(): boolean {
        if (!propsSheetOpen()) return false;
        propsSheet!.close();
        return true;
      }
      function propsBehindSheet(): boolean {
        const sum = document.getElementById("ov-props-sum");
        return !!sum && sum.offsetParent !== null;
      }

      function repaintProps() {
        const box = document.getElementById("ov-props");
        if (box) delete box.dataset.sig;
        if (!activeTask) return;
        renderProps();
        renderPullRequests();
        renderHeader();
      }

      const PICKERS: Record<string, (prop: HTMLElement) => void> = {
        stage: (p) => openStageSelect(p),
        agent: (p) => openAgentSelect(p, p),
        priority: (p) => openPrioritySelect(p),
        type: (p) => openTypeSelect(p),
        projects: (p) => openProjectSelect(p),
        deps: (p) => openDepsSelect(p),
        tags: (p) => openTagsEdit(p),
      };

      function openPropPicker(key: string) {
        if (!activeTask || !PICKERS[key] || refuseReadOnly()) return;
        showTab("overview");
        const find = () => document.querySelector<HTMLElement>(`#ov-props [data-prop="${key}"]`);
        let prop = find();
        if (!prop) return;
        if (propsBehindSheet() && !propsSheetOpen()) openPropsSheet();
        if (prop.classList.contains("props-folded") && !propsShowAll && !propsSheetOpen()) {
          propsShowAll = true;
          repaintProps();
          prop = find();
          if (!prop) return;
        }
        prop.scrollIntoView({ block: "nearest", behavior: scrollBehavior() });
        PICKERS[key](prop);
      }

      const briefEditing = () => document.getElementById("ov-write")?.hidden === false;
      let enterBriefEdit: () => void = () => {};
      let teardownBrief: () => void = () => {};
      signal.addEventListener("abort", () => teardownBrief());

      function renderBrief() {
        const task = activeTask!;
        const box = document.getElementById("ov-display");
        if (!box || briefEditing()) return;
        const kids = task.children || [];
        const sig = JSON.stringify({
          b: task.body || "",
          k: kids.map((c) => [c.id, c.title, c.stage]),
          o: [...briefOpen],
          by: [...sectionBy].map(([k, v]) => [k, v.agent, agoLabel(v.at)]),
          s: !!task.parent_id,
          a: (task.attachments || []).map((a: Attachment) => a.id),
          w: mayWriteTasks,
        });
        if (box.dataset.sig === sig) return;
        box.dataset.sig = sig;
        box.innerHTML = briefHTML(task);
        decorateChecklist(box, task);
        if (!mayWriteTasks)
          box
            .querySelectorAll<HTMLInputElement>(".md-task-check")
            .forEach((cb) => (cb.disabled = true));
      }

      function briefHTML(task: Task): string {
        const { text: body, wrapped } = unwrapMarkdownFence(task.body || "");
        const checklist = !wrapped;
        if (!body.trim()) {
          return `<div class="brief-empty"><span>${esc(t("tasks.drawer.brief.empty"))}</span>${buttonHTML({ label: t("tasks.drawer.brief.write"), icon: "edit", size: "sm", cls: "write-only", attrs: { "data-brief-write": true } })}</div>`;
        }
        const brief = splitBrief(body);
        const out: string[] = [];
        if (brief.preamble) {
          out.push(`<div class="brief-pre">${mdBody(brief.preamble, { checklist })}</div>`);
        }
        for (const s of brief.sections) {
          // Rendered with its heading so checklist items keep their section address for the section
          // endpoint.
          const full = mdBody(`## ${s.title}\n${s.source}`, { checklist });
          const h = full.match(/^<h2>([\s\S]*?)<\/h2>\n?/);
          const titleHTML = h ? h[1] : esc(s.title);
          const html = h ? full.slice(h[0].length) : full;
          const count = checklistCount(s.source);
          const by = sectionBy.get(s.slug);
          const long = shouldFold(s);
          const folded = long && !briefOpen.has(s.slug);
          const bodyID = `brief-${s.slug}`;
          out.push(`<section class="brief-sec${folded ? " folded" : ""}" data-slug="${esc(s.slug)}" style="--fold-lines:${FOLD_TO_LINES}">
            ${sectionHeadHTML({
              level: 4,
              titleHTML,
              asideHTML:
                (count.total ? progressTextHTML(count, { text: "long" }) : "") +
                (by
                  ? agentChipHTML(
                      t("tasks.drawer.brief.written_by", { agent: by.agent, ago: agoLabel(by.at) }),
                      { size: "sm", title: fmtDate(by.at) },
                    )
                  : ""),
            })}
            <div class="brief-sec-body" id="${esc(bodyID)}">${html}</div>
            ${long ? buttonHTML({ label: folded ? t("tasks.drawer.brief.show_all") : t("tasks.drawer.brief.show_less"), size: "sm", variant: "ghost", cls: "brief-fold", attrs: { "data-fold": s.slug, "aria-expanded": String(!folded), "aria-controls": bodyID } }) : ""}
          </section>`);
        }
        return out.join("");
      }

      function isCheckedItem(li: HTMLElement): boolean {
        return (
          li.classList.contains("done") ||
          !!li.querySelector<HTMLInputElement>(".md-task-check")?.checked
        );
      }

      function decorateChecklist(box: HTMLElement, task: Task) {
        const kids = task.children || [];
        const canMake = !task.parent_id;
        box.querySelectorAll<HTMLElement>("li.md-task").forEach((li) => {
          const text = (li.querySelector(".md-task-text")?.textContent || "").trim();
          if (!text) return;
          const hit = matchSubtask(text, kids);
          if (hit) {
            li.insertAdjacentHTML(
              "beforeend",
              `<a class="ck-sub" href="#task-${esc(hit.id)}" data-open-task="${esc(hit.id)}" aria-label="${esc(t("tasks.drawer.brief.open_subtask", { title: hit.title, stage: stageInfo(hit.stage)?.label || hit.stage }))}">${stagePillHTML(hit.stage, stageInfo(hit.stage), { size: "sm" })}</a>`,
            );
          } else if (canMake && !isCheckedItem(li)) {
            li.insertAdjacentHTML(
              "beforeend",
              `<button class="${buttonClasses({ size: "sm", variant: "ghost", cls: "ck-make write-only" })}" type="button" data-make-subtask="${esc(text)}" title="${esc(t("tasks.drawer.brief.make_subtask"))}">${icoSvg("i-plus")}<span class="ck-make-label">${esc(t("tasks.drawer.brief.make_subtask"))}</span></button>`,
            );
          }
        });
      }

