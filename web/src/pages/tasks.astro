      async function loadOverviewUsage() {
        if (!activeTask) return;
        void loadTaskSandbox();
        const taskId = activeTask.id;
        const root = document.getElementById("tl-usage");
        if (!root) return;
        try {
          const u = await api.get<any>(`/tasks/${taskId}/usage`);
          if (!activeTask || activeTask.id !== taskId) return;
          const cur = document.getElementById("tl-usage");
          if (!cur) return;
          const fmt = (n: number) => (n || 0).toLocaleString(locale);
          const sessions = u.sessions || 0;
          const runs = {
            runs: sessions,
            tokens: u.total_tokens || 0,
            cost: u.cost_usd || 0,
            estimated: u.estimated_cost_usd || 0,
            unpriced: u.unpriced_sessions || 0,
          };
          if (
            lastUsage?.runs !== runs.runs ||
            lastUsage?.tokens !== runs.tokens ||
            lastUsage?.cost !== runs.cost ||
            lastUsage?.estimated !== runs.estimated ||
            lastUsage?.unpriced !== runs.unpriced
          ) {
            lastUsage = runs;
            renderProps();
          }

          const view = taskUsageView(u);
          const nextSig = JSON.stringify({
            tid: taskId,
            view,
            sessions,
            ctx: u.current_context || 0,
            tot: u.total_tokens || 0,
            in: u.input_tokens || 0,
            out: u.output_tokens || 0,
            cr: u.cache_read_tokens || 0,
            cw: u.cache_creation_tokens || 0,
            turns: u.turns || 0,
            live: !!u.live,
            exp: usageExpanded,
            bd: u.breakdown ?? null,
          });
          if (nextSig === usageSig && cur.childNodes.length > 0) return;

          cur.hidden = view === "no_usage";
          if (view !== "usage") {
            cur.innerHTML =
              view === "no_runs"
                ? emptyStateHTML({ size: "inline", body: t("tasks.drawer.usage.empty") })
                : "";
            usageSig = nextSig;
            return;
          }

          const ctx = u.current_context || 0;
          const ctxPct = Math.min(100, Math.round((ctx / CONTEXT_WINDOW) * 100));
          const tone = ctxPct > 85 ? "danger" : ctxPct > 60 ? "warn" : "ok";

          const detailHidden = usageExpanded ? "" : "hidden";
          cur.innerHTML = `
            <button class="usage-bar" id="ov-usage-bar" type="button" aria-expanded="${usageExpanded}" aria-controls="ov-usage-detail">
              <div class="usage-bar-row">
                <span class="usage-bar-label">
                  ${icoSvg(usageExpanded ? "chevron-down" : "chevron-right")}
                  <span>${esc(t("tasks.drawer.usage.context"))}</span>
                  ${u.live ? `<span class="usage-live">${dotHTML("ok", { pulse: true })}${esc(t("tasks.drawer.usage.live"))}</span>` : ""}
                </span>
                <span class="usage-bar-stat">
                  <strong>${fmt(ctx)}</strong>
                  <span class="muted"> / ${fmt(CONTEXT_WINDOW)} · ${ctxPct}%</span>
                </span>
              </div>
              <div class="usage-bar-track">
                <div class="usage-bar-fill usage-bar-fill-${tone}" style="width:${ctxPct}%"></div>
              </div>
            </button>
            <div class="usage-detail" id="ov-usage-detail" ${detailHidden}>
              <div class="usage-detail-row">
                <strong>${fmt(u.total_tokens)}</strong>
                <span class="muted">${esc(
                  t("tasks.drawer.usage.summary", {
                    runs: t("tasks.drawer.usage.runs", { count: sessions }),
                    turns: t("tasks.drawer.usage.turns", { count: u.turns || 0, n: fmt(u.turns) }),
                  }),
                )}</span>
              </div>
              <div class="usage-detail-grid">
                <div><span class="muted">${esc(t("tasks.drawer.usage.input"))}</span> ${fmt(u.input_tokens)}</div>
                <div><span class="muted">${esc(t("tasks.drawer.usage.output"))}</span> ${fmt(u.output_tokens)}</div>
                <div><span class="muted">${esc(t("tasks.drawer.usage.cache_read"))}</span> ${fmt(u.cache_read_tokens)}</div>
                <div><span class="muted">${esc(t("tasks.drawer.usage.cache_write"))}</span> ${fmt(u.cache_creation_tokens)}</div>
              </div>
              ${taskBreakdownHTML(u.breakdown)}
            </div>
          `;
          cur.querySelectorAll<HTMLElement>("[data-breakdown-session]").forEach((b) => {
            b.addEventListener("click", () => void openRunBreakdown(b.dataset.breakdownSession!));
          });

          const btn = document.getElementById("ov-usage-bar") as HTMLButtonElement | null;
          const detail = document.getElementById("ov-usage-detail") as HTMLElement | null;
          const chevron = btn?.querySelector("use");
          btn?.addEventListener("click", () => {
            usageExpanded = !usageExpanded;
            btn.setAttribute("aria-expanded", String(usageExpanded));
            if (detail) detail.hidden = !usageExpanded;
            chevron?.setAttribute("href", usageExpanded ? "#i-chevron-down" : "#i-chevron-right");
            usageSig = null;
          });
          usageSig = nextSig;
        } catch {
          // Network error — leave the placeholder; next render will retry.
        }
      }

      function agentSourceHTML(task: Task): string {
        const linked = (task.project_ids || [])
          .map((id) => projects.find((p) => p.id === id))
          .filter((p): p is Project => Boolean(p));
        if (linked.length === 0) {
          return `<p class="nselect-hint astage-source">${esc(t("lib.stage_agents.no_project"))}</p>`;
        }
        const cols = agentColumns(stages).map((s) => s.id);
        const links = linked
          .map(
            (p) =>
              `<a href="/project/?id=${encodeURIComponent(p.id)}#settings">${esc(t("lib.stage_agents.template_link", { project: p.name }))}</a>`,
          )
          .join(" · ");
        const fill = linked.find(
          (p) => Object.keys(templateFill(task.stage_assignments, p.stage_template, cols)).length,
        );
        const apply = fill
          ? buttonHTML({
              label: t("lib.stage_agents.apply_template", { project: fill.name }),
              size: "sm",
              attrs: { "data-apply-template": fill.id },
            })
          : "";
        return `<div class="nselect-hint astage-source"><p>${esc(t("lib.stage_agents.from_template"))} ${links}</p>${apply}</div>`;
      }

      async function applyProjectTemplate(projectID: string) {
        const task = activeTask;
        const p = projects.find((x) => x.id === projectID);
        if (!task || !p) return;
        const fill = templateFill(
          task.stage_assignments,
          p.stage_template,
          agentColumns(stages).map((s) => s.id),
        );
        if (Object.keys(fill).length === 0) return;
        const ok = await patchStageAssignments(
          { ...(task.stage_assignments || {}), ...fill },
          { refresh: false },
        );
        if (ok) toast(t("lib.stage_agents.applied", { project: p.name }), "ok");
      }

      function offerProjectTemplate(projectID: string) {
        const task = activeTask;
        const p = projects.find((x) => x.id === projectID);
        if (!task || !p) return;
        const count = Object.keys(
          templateFill(
            task.stage_assignments,
            p.stage_template,
            agentColumns(stages).map((s) => s.id),
          ),
        ).length;
        if (count === 0) return;
        toast(
          t("lib.stage_agents.apply_template_msg", { project: p.name, count }),
          "info",
          8000,
          null,
          {
            label: t("lib.stage_agents.apply_template", { project: p.name }),
            run: () => void applyProjectTemplate(projectID).then(() => renderProps()),
          },
        );
      }

      async function patchStageAssignments(
        next: Record<string, string>,
        opts: { refresh?: boolean } = {},
      ) {
        try {
          await api.patch(`/tasks/${activeTask!.id}`, { stage_assignments: next });
        } catch {
          toast(t("tasks.drawer.agents.save_failed"), "err");
          return false;
        }
        activeTask!.stage_assignments = next;
        if (opts.refresh !== false) await refresh(true);
        return true;
