      } as const;
      const eventKindLabel = (k: string) =>
        k in EVENT_KIND ? t(EVENT_KIND[k as keyof typeof EVENT_KIND]) : k;

      interface TimelineVM {
        id: string;
        kind: string;
        actor: string;
        summary: string;
        createdAt: string;
        isRun: boolean;
        isPrompt: boolean;
        instanceID: string;
        containerID: string;
        stage: string;
        agent: string;
        exit: number | null;
        prompt: string;
      }

      function timelineInnerHTML(e: TimelineVM): string {
        const exitPill =
          e.exit === null
            ? ""
            : badgeHTML(t("tasks.runs.exit", { code: e.exit }), e.exit === 0 ? "ok" : "danger", {
                size: "sm",
                mono: true,
              });
        const stagePill = e.stage
          ? stagePillHTML(e.stage, stageInfo(e.stage), { size: "sm", title: e.stage })
          : "";
        const agentPill = e.agent
          ? agentChipHTML(e.agent, {
              size: "sm",
              title: e.instanceID ? t("tasks.runs.instance", { id: e.instanceID }) : undefined,
            })
          : "";
        const cta =
          e.isRun && e.containerID
            ? `<span class="run-cta">${esc(t("tasks.runs.view_logs"))}</span>`
            : "";
        const promptCta =
          e.isPrompt && e.prompt
            ? `<span class="run-cta">${esc(t("tasks.runs.view_prompt"))}</span>`
            : "";
        const promptRow = e.isPrompt
          ? `<div class="run-row">${stagePill}${agentPill}${promptCta}</div>`
          : "";
        return `<div class="comment-head">
            ${sourceTagHTML(e.actor.startsWith("agent:") ? "agent" : "system", eventKindLabel(e.kind))}
            ${authorLineHTML({ name: historyActor(e.actor), kind: historyActorKind(e.actor), at: e.createdAt, avatar: true })}
          </div>
          <div class="comment-body">${esc(e.summary)}</div>
          ${e.isRun ? `<div class="run-row">${stagePill}${agentPill}${exitPill}${cta}</div>` : ""}
          ${promptRow}`;
      }

      function applyTimelineDataAttrs(el: HTMLElement, e: TimelineVM) {
        if (e.isRun && e.instanceID) el.dataset.run = e.instanceID;
        else delete el.dataset.run;
        if (e.isRun && e.containerID) {
          el.dataset.cid = e.containerID;
          el.dataset.iid = e.instanceID;
          el.dataset.stage = e.stage;
          el.dataset.agent = e.agent;
        } else {
          delete el.dataset.cid;
          delete el.dataset.iid;
          delete el.dataset.stage;
          delete el.dataset.agent;
        }
        if (e.isPrompt && e.prompt) {
          el.dataset.prompt = "1";
          (el as any).__prompt = e.prompt;
        } else {
          delete el.dataset.prompt;
          delete (el as any).__prompt;
        }
      }

      function createTimelineNode(e: TimelineVM): HTMLElement {
        const el = document.createElement("div");
        el.className = `event ${e.isRun ? "run" : ""} ${e.isPrompt ? "prompt" : ""}`.trim();
        applyTimelineDataAttrs(el, e);
        el.innerHTML = timelineInnerHTML(e);
        el.addEventListener("click", (ev) => {
          const target = ev.target as HTMLElement;
          if (target.closest(".run-logs") || target.closest(".run-prompt")) return;
          if (el.dataset.cid) {
            toggleInlineLogs(el);
            return;
          }
          if (el.dataset.prompt) {
            toggleInlinePrompt(el);
            return;
          }
        });
        return el;
      }

      function updateTimelineNode(el: HTMLElement, e: TimelineVM, prev: TimelineVM | null) {
        // Events are append-only; only containerID, exit, summary and prompt can change after first
        // render.
        if (
          prev &&
          prev.containerID === e.containerID &&
          prev.exit === e.exit &&
          prev.summary === e.summary &&
          prev.prompt === e.prompt
        )
          return;
        applyTimelineDataAttrs(el, e);
        el.innerHTML = timelineInnerHTML(e);
      }

      function toggleInlinePrompt(el: HTMLElement) {
        const existing = el.querySelector(".run-prompt") as HTMLElement | null;
        if (existing) {
          existing.remove();
          el.classList.remove("expanded");
          const cta = el.querySelector(".run-cta");
          if (cta) cta.textContent = t("tasks.runs.view_prompt");
          return;
        }
        const text = (el as any).__prompt as string | undefined;
        if (!text) return;
        el.classList.add("expanded");
        const cta = el.querySelector(".run-cta");
        if (cta) cta.textContent = t("tasks.runs.hide_prompt");

        const panel = document.createElement("div");
        panel.className = "run-prompt";
        panel.innerHTML = `
          <p class="run-prompt-size">${esc(t("tasks.runs.chars", { count: text.length }))}</p>
          ${codeBlockHTML({ text, multiline: true, maxHeight: "lg", copy: true, label: t("tasks.runs.prompt_label") })}`;
        el.appendChild(panel);
      }

      async function renderTimeline() {
        try {
          const sess = await api.get<any[]>("/usage/sessions");
          instanceToContainer = {};
          for (const s of sess) {
            if (s.agent && s.id) instanceToContainer[s.agent] = s.id;
          }
        } catch {}

        const ct = $("tl-list");
        const forTask = activeTask!.id;
        let raw: any[];
        try {
          raw = await api.get<any[]>(`/tasks/${forTask}/events`);
        } catch {
          if (!ct.querySelector(".event")) {
            ct.innerHTML = `<div class="muted">${esc(t("tasks.runs.timeline_failed"))}</div>`;
          }
          return;
        }

        if (activeTask?.id === forTask) {
          streamEvents = raw as StreamEvent[];
          streamEventsTask = forTask;
          renderComments();
          renderHeader();
        }

        if (activeTask?.id === forTask) {
          const by = sectionAuthors(raw, isAgentName);
          const key = (m: Map<string, SectionAuthor>) =>
            JSON.stringify([...m].map(([k, v]) => [k, v.agent, v.at]));
          if (key(by) !== key(sectionBy)) {
            sectionBy = by;
            renderBrief();
          }
        }

        const items: TimelineVM[] = raw
          .slice()
          .reverse()
          .map((e: any) => {
            const isRun = [
              "agent_run_started",
              "agent_run_finished",
              "auditor_run_started",
              "auditor_run_finished",
            ].includes(e.kind);
            const isPrompt = e.kind === "agent_prompt" || e.kind === "auditor_prompt";
            const payload = e.payload || {};
            const instanceID = payload.instance_id || e.ref_id || "";
            const containerID = payload.container_id || instanceToContainer[instanceID] || "";
            const exit = typeof payload.exit === "number" ? payload.exit : null;
            return {
              id: e.id,
              kind: e.kind,
              actor: e.actor || "",
              summary:
                threadEventText(e, threadTitle) ||
                historyText(e, { stageLabel: (id) => stageInfo(id)?.label || id }) ||
                e.summary ||
                "",
              createdAt: e.created_at,
              isRun,
              isPrompt,
              instanceID,
              containerID,
              stage: payload.stage || "",
              agent: payload.agent || "",
              exit,
              prompt: typeof payload.prompt === "string" ? payload.prompt : "",
            };
          });

        let empty = ct.querySelector<HTMLElement>(":scope > .timeline-empty");
        if (items.length === 0) {
          reconcile<TimelineVM>({
            container: ct,
            items: [],
            key: (e) => e.id,
            create: createTimelineNode,
          });
          if (!empty) {
            ct.innerHTML = emptyStateHTML({
              size: "sm",
              body: t("tasks.runs.timeline_empty"),
              cls: "timeline-empty",
            });
          }
          return;
        }
        if (empty) empty.remove();

        reconcile<TimelineVM>({
          container: ct,
          items,
          key: (e) => e.id,
          create: createTimelineNode,
          update: updateTimelineNode,
          skip: (el) => el.classList.contains("expanded"),
        });
      }

      interface LogPanelState {
        raw: string;
        lines: string[];
        mode: "raw" | "pretty";
        off: (() => void) | null;
        followTail: boolean;
      }

      function isAtBottom(el: HTMLElement, slack = 12): boolean {
        return el.scrollTop + el.clientHeight >= el.scrollHeight - slack;
      }

      async function toggleInlineLogs(el: HTMLElement) {
        const cid = el.dataset.cid!;
        const existing = el.querySelector(".run-logs") as HTMLElement | null;
        if (existing) {
          const st = (existing as any).__st as LogPanelState | undefined;
          st?.off?.();
          existing.remove();
          el.classList.remove("expanded");
          const cta = el.querySelector(".run-cta");
          if (cta) cta.textContent = t("tasks.runs.view_logs");
          return;
        }
        el.classList.add("expanded");
        const cta = el.querySelector(".run-cta");
        if (cta) cta.textContent = t("tasks.runs.hide_logs");

        const panel = document.createElement("div");
        panel.className = "run-logs";
        panel.innerHTML = `
          <div class="run-logs-bar">
            ${segmentedHTML(
              `run-logs-mode-${cid}`,
              [
                { value: "pretty", label: t("tasks.runs.mode_pretty") },
                { value: "raw", label: t("tasks.runs.mode_raw") },
              ],
              "pretty",
              { size: "sm", label: t("tasks.runs.mode_aria"), cls: "run-logs-mode" },
            )}
            <span class="run-logs-status" data-status="connecting">${esc(t("tasks.runs.status.connecting"))}</span>
            ${buttonHTML({ label: t("common.buttons.copy"), size: "sm", attrs: { "data-act": "copy" } })}
            <span class="muted" style="font-size:0.7rem;margin-left:auto">${esc(cid)}</span>
          </div>
          <div class="run-logs-body"><span class="muted" style="font-family:inherit">${esc(t("tasks.runs.connecting"))}</span></div>`;
        el.appendChild(panel);

        const body = panel.querySelector(".run-logs-body") as HTMLElement;
        const statusEl = panel.querySelector(".run-logs-status") as HTMLElement;

        const st: LogPanelState = {
          raw: "",
          lines: [],
          mode: "pretty",
          off: null,
          followTail: true,
        };
        (panel as any).__st = st;

        const setStatus = (kind: "connecting" | "live" | "closed" | "error", label?: string) => {
          if (!label && statusEl.dataset.status === kind) return;
          statusEl.dataset.status = kind;
          const labels: Record<string, string> = {
            connecting: t("tasks.runs.status.connecting"),
            live: t("tasks.runs.status.live"),
            closed: t("tasks.runs.status.closed"),
            error: t("tasks.runs.status.error"),
          };
          statusEl.textContent = label ?? labels[kind];
        };

        body.addEventListener("scroll", () => {
          st.followTail = isAtBottom(body);
        });

        const offStatus = events.onStatus((s) => {
          if (s === "live") setStatus(st.lines.length ? "live" : "connecting");
          else setStatus("error", t("tasks.runs.status.reconnecting"));
        });
        // Drawn a slice per animation frame: replaying a long run line by line froze the tab.
        const drawFrame = (f: Frame) => {
          // FRAME_ERROR is followed by FRAME_END; keep the error status.
          if (f.type === FRAME_END) {
            if (statusEl.dataset.status !== "error") setStatus("closed");
            return;
          }
          if (f.type === FRAME_ERROR)
            return setStatus(
              "error",
              f.data != null
                ? t("tasks.runs.status.error_detail", { error: String(f.data) })
                : t("tasks.runs.status.no_logs"),
            );
          if (f.type === FRAME_WAITING)
            return setStatus("connecting", t("tasks.runs.status.waiting_runner"));
          if (f.type === FRAME_TRUNCATED) {
            body.innerHTML = "";
            const marker = t("tasks.runs.truncated");
            st.lines.push(marker);
            st.raw += marker + "\n";
            appendLineToBody(body, marker, st.mode);
            return;
          }
          if (f.type !== "line") return;
          if (st.lines.length === 0) body.innerHTML = "";
          const line = String(f.data ?? "");
          st.lines.push(line);
          st.raw += line + "\n";
          setStatus("live");
          appendLineToBody(body, line, st.mode);
        };
        const queue = frameQueue<Frame>({
          each: drawFrame,
          after: () => {
            if (st.followTail) body.scrollTop = body.scrollHeight;
          },
        });
        const offTopic = events.subscribe(logsTopic(cid), (f) => {
          if (f.type === FRAME_RESET) {
            // A reconnect replays the run from the start: drop drawn and queued lines.
            queue.clear();
            st.lines = [];
            st.raw = "";
            body.innerHTML = `<span class="muted" style="font-family:inherit">${esc(t("tasks.runs.connecting"))}</span>`;
            return;
          }
          queue.push(f);
        });
        st.off = () => {
          queue.stop();
          offStatus();
          offTopic();
        };

        const modeCtl = panel.querySelector<HTMLElement>(".run-logs-mode")!;
        modeCtl.addEventListener("change", () => {
          st.mode = segmentedValue(modeCtl) === "raw" ? "raw" : "pretty";
          repaintBody(body, st);
          if (st.followTail) body.scrollTop = body.scrollHeight;
        });

        const copyBtn = panel.querySelector<HTMLButtonElement>('button[data-act="copy"]')!;
        copyBtn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const ok = await copyToClipboard(st.raw);
          copyBtn.textContent = ok ? t("tasks.runs.copied") : t("tasks.toasts.copy_failed");
          setTimeout(() => {
            copyBtn.textContent = t("common.buttons.copy");
          }, COPY_FEEDBACK_MS);
        });
      }

      function prettyNodeFromLine(line: string): Element | null {
        const trimmed = line.trim();
        if (!trimmed) return null;
        const idx = trimmed.indexOf("{");
        if (idx < 0) return null;
        try {
          const ev = JSON.parse(trimmed.slice(idx));
          const wrap = document.createElement("div");
          wrap.innerHTML = prettyEvent(ev);
          return wrap.firstElementChild;
        } catch {
          return null;
        }
      }

      function appendLineToBody(body: HTMLElement, line: string, mode: "raw" | "pretty") {
        if (mode === "raw") {
          body.appendChild(document.createTextNode(line + "\n"));
          return;
        }
        if (!line.trim()) return;
        const node = prettyNodeFromLine(line);
        if (node) body.appendChild(node);
        else body.appendChild(document.createTextNode(line + "\n"));
      }

      function repaintBody(body: HTMLElement, st: LogPanelState) {
        body.innerHTML = "";
        if (st.lines.length === 0) {
          body.innerHTML = `<span class="muted" style="font-family:inherit">${esc(t("tasks.runs.no_logs"))}</span>`;
          return;
        }
        if (st.mode === "raw") {
          body.textContent = st.raw;
          return;
        }
        let renderedAny = false;
        for (const line of st.lines) {
          const node = prettyNodeFromLine(line);
          if (node) {
            body.appendChild(node);
            renderedAny = true;
          }
        }
        if (!renderedAny) body.textContent = st.raw;
      }

      function closeAllInlineLogs(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(".event.expanded").forEach((ev) => {
          const logs = ev.querySelector<HTMLElement>(".run-logs");
          if (logs) {
            const st = (logs as any).__st as LogPanelState | undefined;
            st?.off?.();
            logs.remove();
            const cta = ev.querySelector(".run-cta");
            if (cta) cta.textContent = t("tasks.runs.view_logs");
          }
          const prompt = ev.querySelector<HTMLElement>(".run-prompt");
          if (prompt) {
            prompt.remove();
            const cta = ev.querySelector(".run-cta");
            if (cta) cta.textContent = t("tasks.runs.view_prompt");
          }
          ev.classList.remove("expanded");
        });
      }

      interface LiveViewState {
        off: (() => void) | null;
        containerID: string;
        feed: HTMLElement;
        statusEl: HTMLElement;
        toolCards: Map<string, HTMLDetailsElement>;
        followTail: boolean;
      }

      interface ConvView {
        key: string;
        taskID: string;
        feed: HTMLElement;
        runs: Map<string, LiveViewState>;
        followTail: boolean;
      }
      let liveView: ConvView | null = null;

      function closeLiveView() {
        if (!liveView) return;
        for (const run of liveView.runs.values()) run.off?.();
        liveView = null;
      }

      function openLiveView() {
        const pane = $("pane-liveview");
        if (!activeTask) {
          pane.innerHTML = emptyStateHTML({ size: "sm", body: t("tasks.chat.no_task") });
          return;
        }
        const key = activeTask.id + "|" + (activeTask.current_run_id || "");
        if (liveView && liveView.key === key) return;
        closeLiveView();

        pane.innerHTML = `
          <div class="lv-feed" id="lv-feed"></div>
          ${composerHTML({
            variant: "chat",
            id: "lv-compose",
            ids: { input: "lv-input", submit: "lv-send" },
            label: t("tasks.chat.input_label"),
            placeholder: t("tasks.chat.placeholder"),
            submitLabel: t("tasks.chat.send"),
            extraHTML:
              checkHTML({
                cls: "lv-interrupt",
                id: "lv-interrupt",
                label: t("tasks.chat.interrupt"),
                attrs: { title: t("tasks.chat.interrupt_title") },
              }) + `<span class="lv-delivery" id="lv-delivery" aria-live="polite"></span>`,
            cls: "lv-compose",
          })}`;

        const st: ConvView = {
          key,
          taskID: activeTask.id,
          feed: pane.querySelector<HTMLElement>("#lv-feed")!,
          runs: new Map(),
          followTail: true,
        };
        st.feed.addEventListener("scroll", () => {
          st.followTail = isAtBottom(st.feed);
        });
        liveView = st;
        wireConversationComposer(st);
        void loadConversation(st);
      }

      async function loadConversation(st: ConvView) {
        let data: any;
        try {
          data = (await api.get(`/tasks/${st.taskID}/conversation`)) as any;
        } catch {
          st.feed.innerHTML = emptyStateHTML({
            size: "sm",
            tone: "danger",
            body: t("tasks.chat.load_failed"),
          });
          return;
        }
        if (liveView !== st) return;
        for (const run of st.runs.values()) run.off?.();
        st.runs.clear();
        st.feed.innerHTML = "";

        const items: any[] = data?.items || [];
        if (!items.length) {
          st.feed.innerHTML = emptyStateHTML({ size: "sm", bodyHTML: t("tasks.chat.empty_html") });
          return;
        }
        for (const it of items) {
          if (it.kind === "message" && it.message) renderConversationMessage(st, it.message);
          else if (it.kind === "run" && it.run_id) renderRunSection(st, it);
        }
        st.feed.scrollTop = st.feed.scrollHeight;
        st.followTail = true;
      }

      function renderConversationMessage(st: ConvView, m: any) {
        // A steered message is echoed inside its run's transcript; drawing it here would duplicate
        // it.
        if (m.delivery === "steered") return;
        if (m.role === "system") {
          st.feed.appendChild(messageEl({ role: "system", text: m.body || "" }));
          return;
        }
        const el = messageEl({ role: "user", bodyHTML: mdBody(m.body || "") });

        const foot = document.createElement("div");
        foot.className = "msg-meta";
        if (m.delivery === "chat" && m.chat_id) {
          foot.appendChild(
            linkButton(
              t("tasks.chat.answers_in_chat", { agent: m.agent || t("tasks.chat.agent_fallback") }),
              () =>
                document.dispatchEvent(
                  new CustomEvent("octopus:open-chat", { detail: { id: m.chat_id } }),
                ),
            ),
          );
        } else if (m.delivery === "unreachable") {
          const note = document.createElement("span");
          note.className = "muted";
          note.textContent = t("tasks.chat.unread_note");
          foot.append(note, " ");
          const btn = linkButton(t("tasks.chat.to_comments"), async () => {
            btn.disabled = true;
            try {
              await api.post(`/tasks/${st.taskID}/conversation/${m.id}/to-comment`, {});
              foot.textContent = t("tasks.chat.moved_to_comments");
              await refresh(true);
            } catch {
              btn.disabled = false;
              toast(t("tasks.chat.to_comments_failed"), "err");
            }
          });
          foot.appendChild(btn);
        } else if (m.delivery === "mention") {
          foot.textContent = t("tasks.chat.answers_in_comments", {
            agent: m.agent || t("tasks.chat.agent_fallback"),
          });
        }
        if (foot.childNodes.length) el.appendChild(foot);
        st.feed.appendChild(el);
      }

      function linkButton(label: string, onClick: () => void): HTMLButtonElement {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "lv-link";
        b.textContent = label;
        b.addEventListener("click", onClick);
        return b;
      }

      function renderRunSection(st: ConvView, it: any) {
        const wrap = document.createElement("div");
        wrap.className = "lv-run";
        wrap.dataset.open = it.live ? "1" : "0";

        const when = it.at ? new Date(it.at).toLocaleString(locale) : "";
        const nTurns = Number(it.turns) || 0;
        const turns = nTurns ? ` · ${esc(t("tasks.chat.run_turns", { count: nTurns }))}` : "";
        const stage = it.stage
          ? `<span title="${esc(it.stage)}">${esc(stageInfo(it.stage)?.label || it.stage)}</span> · `
          : "";
        const runStatus = it.live ? "connecting" : "closed";
        wrap.innerHTML = `
          <button class="lv-run-head" type="button">
            ${icoSvg("chevron-right", { cls: "lv-run-caret" })}
            <b>${esc(it.agent || t("tasks.chat.agent_fallback"))}</b>
            <span class="lv-run-meta">${stage}${esc(when)}${turns}</span>
            <span class="lv-status" data-status="${runStatus}">
              <span class="lv-status-dot"></span><span class="lv-status-text">${it.live ? esc(t("tasks.chat.status.live")) : ""}</span>
            </span>
          </button>
          <div class="lv-run-body"><div class="lv-run-feed"></div></div>`;
        st.feed.appendChild(wrap);

        wrap.querySelector<HTMLElement>(".lv-run-head")!.addEventListener("click", () => {
          const wasOpen = wrap.dataset.open === "1";
          wrap.dataset.open = wasOpen ? "0" : "1";
          if (!wasOpen) attachRunStream(st, it, wrap);
        });
        if (it.live) attachRunStream(st, it, wrap);
      }

      function attachRunStream(st: ConvView, it: any, wrap: HTMLElement) {
        if (st.runs.has(it.run_id)) return;
        const feed = wrap.querySelector<HTMLElement>(".lv-run-feed")!;
        const statusEl = wrap.querySelector<HTMLElement>(".lv-status")!;
        const run: LiveViewState = {
          off: null,
          containerID: it.run_id,
          feed,
          statusEl,
          toolCards: new Map(),
          followTail: !!it.live,
        };
        st.runs.set(it.run_id, run);

        const setStatus = (kind: string, label: string) => {
          const el = statusEl.querySelector<HTMLElement>(".lv-status-text");
          if (statusEl.dataset.status === kind && (!el || el.textContent === label)) return;
          statusEl.dataset.status = kind;
          if (el) el.textContent = label;
        };
        setStatus("connecting", t("tasks.chat.status.reading"));

        const offStatus = events.onStatus((s) => {
          if (s !== "live") setStatus("error", t("tasks.chat.status.reconnecting"));
        });
        const queue = frameQueue<Frame>({
          each: (f) => drawFrame(f),
          after: () => {
            if (run.followTail && st.followTail) st.feed.scrollTop = st.feed.scrollHeight;
          },
        });
        const drawFrame = (f: Frame) => {
          if (f.type === FRAME_END) {
            if (statusEl.dataset.status !== "error")
              setStatus("closed", it.live ? t("tasks.chat.status.finished") : "");
            return;
          }
          if (f.type === FRAME_ERROR)
            return setStatus("error", t("tasks.chat.status.no_transcript"));
          if (f.type === FRAME_WAITING)
            return setStatus("connecting", t("tasks.chat.status.waiting_runner"));
          if (f.type !== "line") return;
          setStatus(it.live ? "live" : "closed", it.live ? t("tasks.chat.status.live") : "");
          const trimmed = String(f.data ?? "").trim();
          if (!trimmed) return;
          const idx = trimmed.indexOf("{");
          if (idx < 0) return;
          let obj: any;
          try {
            obj = JSON.parse(trimmed.slice(idx));
          } catch {
            return;
          }
          handleLiveEvent(run, obj);
        };
        const offTopic = events.subscribe(logsTopic(it.run_id), (f) => {
          if (f.type === FRAME_RESET) {
            queue.clear();
            feed.innerHTML = "";
            run.toolCards.clear();
            return setStatus("connecting", t("tasks.chat.status.reading"));
          }
          queue.push(f);
        });
        run.off = () => {
          queue.stop();
          offStatus();
          offTopic();
        };
      }

      const composers = new TaskComposers();
      const LV_INPUT_LINES = 8;

      function wireConversationComposer(st: ConvView) {
        const input = $("lv-input") as HTMLTextAreaElement | null;
        const sendBtn = $("lv-send") as HTMLButtonElement | null;
        const interruptEl = $("lv-interrupt") as HTMLInputElement | null;
        const deliveryEl = $("lv-delivery");
        if (!input || !sendBtn) return;
        input.value = composers.draft(st.taskID);
        growComposer(input, LV_INPUT_LINES);
        input.addEventListener("input", () => {
          composers.setDraft(st.taskID, input.value);
          growComposer(input, LV_INPUT_LINES);
        });
        if (interruptEl) {
          interruptEl.checked = composers.interrupt(st.taskID);
          interruptEl.addEventListener("change", () => {
            composers.setInterrupt(st.taskID, interruptEl.checked);
          });
        }
        attachMentionAutocomplete(input);

        const send = async () => {
          const text = input.value.trim();
          if (!text || sendBtn.disabled) return;
          sendBtn.disabled = true;
          const interrupt = !!interruptEl?.checked;
          try {
            const res = (await api.post(`/tasks/${st.taskID}/converse`, {
              text,
              interrupt,
            })) as { delivery: string; detail?: string; agent?: string };
            input.value = "";
            growComposer(input, LV_INPUT_LINES);
            composers.setDraft(st.taskID, "");
            if (deliveryEl) {
              deliveryEl.textContent = res.detail ?? "";
              deliveryEl.dataset.kind = res.delivery;
            }
            await loadConversation(st);
            await refresh(true);
          } catch {
            toast(t("tasks.chat.send_failed"), "err");
          } finally {
            sendBtn.disabled = false;
          }
        };
        $("lv-compose").addEventListener("submit", (e) => {
          e.preventDefault();
          void send();
        });
        input.addEventListener("keydown", (e) => {
          if (composerSubmits(e, "chat") && !mentionOpen) {
            e.preventDefault();
            void send();
          }
        });
      }

      function handleLiveEvent(st: LiveViewState, ev: any) {
        const norm = normalizeLiveEvent(ev);
        if (!norm) return;
        switch (norm.type) {
          case "system":
            return renderLiveSystem(st, norm);
          case "assistant":
            return renderLiveAssistant(st, norm);
          case "user":
            return renderLiveUser(st, norm);
          case "result":
            return renderLiveResult(st, norm);
          case "warning":
            return renderLiveWarning(st, norm);
          case "session":
            return renderLiveSession(st, norm);
        }
      }

      function renderLiveSession(st: LiveViewState, ev: any) {
        const label = sessionModeLabel(ev.mode || "");
        if (!label) return;
        st.feed.appendChild(messageEl({ role: "system", text: label }));
      }

      function renderLiveSystem(st: LiveViewState, ev: any) {
        if (ev.subtype !== "init") return;
        const el = document.createElement("div");
        el.className = "lv-divider";
        const label = ev.model
          ? t("tasks.chat.session_start_model", { model: ev.model })
          : t("tasks.chat.session_start");
        el.innerHTML = `${icoSvg("power")}<span>${esc(label)}</span>`;
        st.feed.appendChild(el);
      }

      function renderLiveWarning(st: LiveViewState, ev: any) {
        const text = (ev.text || "").trim();
        if (!text) return;
        st.feed.appendChild(calloutEl({ tone: "warn", icon: "warn", body: text, cls: "lv-warn" }));
      }

      function renderLiveAssistant(st: LiveViewState, ev: any) {
        const blocks = ev.message?.content || [];
        for (const b of blocks) {
          if (b.type === "text" && b.text) {
            st.feed.appendChild(messageEl({ role: "agent", bodyHTML: mdBody(b.text) }));
          } else if (b.type === "thinking" && b.thinking) {
            st.feed.insertAdjacentHTML(
              "beforeend",
              disclosureHTML({
                variant: "code",
                summary: t("tasks.chat.thinking"),
                bodyHTML: codeBlockHTML({ text: b.thinking, multiline: true, maxHeight: "sm" }),
                cls: "lv-thinking",
              }),
            );
          } else if (b.type === "tool_use") {
            appendToolCard(st, b);
          }
        }
      }

      function renderLiveUser(st: LiveViewState, ev: any) {
        const content = ev.message?.content;
        if (!content) return;
        if (typeof content === "string") {
          st.feed.appendChild(messageEl({ role: "user", bodyHTML: mdBody(content) }));
          return;
        }
        if (!Array.isArray(content)) return;
        for (const b of content) {
          if (b.type === "tool_result") updateToolCard(st, b);
          else if (b.type === "text" && b.text) {
            st.feed.appendChild(messageEl({ role: "user", bodyHTML: mdBody(b.text) }));
          }
        }
      }

      function renderLiveResult(st: LiveViewState, ev: any) {
        const ok = !ev.is_error;
        // ev is the agent's raw output; coerce so a string can't land in the HTML below.
        const turns = Number(ev.num_turns) || 0;
        const STOP: Record<string, string> = {
          max_tokens: "tasks.chat.stop.max_tokens",
          refusal: "tasks.chat.stop.refusal",
        };
        const stop = STOP[String(ev.stop_reason || "")];
        const outOfTurns = ev.subtype === "error_max_turns";
        const el = document.createElement("div");
        el.className = `lv-divider ${ok && !outOfTurns ? "ok" : "err"}`;
        const iconId = ok && !outOfTurns ? "check" : "alert";
        const turnsLabel = t("tasks.chat.run_turns", { count: turns });
        const label = outOfTurns
          ? t("tasks.chat.turn_out_of_turns", { turns: turnsLabel })
          : ok
            ? t("tasks.chat.turn_finished", { turns: turnsLabel })
            : t("tasks.chat.turn_failed", { turns: turnsLabel });
        const why = stop ? ` · ${t(stop)}` : "";
        el.innerHTML = `${icoSvg(iconId)}<span>${esc(label + why)}</span>`;
        st.feed.appendChild(el);
      }

      function appendToolCard(st: LiveViewState, b: any) {
        const card = document.createElement("details");
        card.className = "lv-tool";
        card.innerHTML = toolCardHTML(b);
        if (b.id) st.toolCards.set(b.id, card);
        st.feed.appendChild(card);
      }

      function updateToolCard(st: LiveViewState, b: any) {
        const card = b.tool_use_id ? st.toolCards.get(b.tool_use_id) : null;
        if (!card) return;
        const isErr = !!b.is_error;
        const status = card.querySelector<HTMLElement>(".lv-tool-status")!;
        status.classList.remove("pending");
        status.classList.add(isErr ? "err" : "ok");
        // i18n-ignore icon ids, not text
        status.innerHTML = icoSvg(isErr ? "alert" : "check");
        const out = card.querySelector<HTMLElement>(".lv-tool-result")!;
        out.innerHTML = toolResultHTML(toolResultText(b.content), isErr);
      }

      function onDrawerTab(id: string) {
        drawerBody().classList.toggle("drawer-body-frame", id === "liveview");
        if (id === "liveview") openLiveView();
        else closeLiveView();
        if (id === "reports") renderReports({ force: true });
      }
      drawerTabs = bindTabs($("drawer").querySelector<HTMLElement>('[role="tablist"]')!, {
        onChange: (id) => onDrawerTab(id),
        signal,
      });

      // The gap between the fold (48) and unfold (8) thresholds stops the height change from
      // flipping it back.
      {
        const drawerEl = $("drawer");
        const body = drawerBody();
        body?.addEventListener(
          "scroll",
          () => {
            if (drawerEl.getBoundingClientRect().width >= 480) {
              drawerEl.classList.remove("compact");
              return;
            }
            const top = body.scrollTop;
            if (top > 48 && body.scrollHeight - body.clientHeight > 240) {
              drawerEl.classList.add("compact");
            } else if (top < 8) drawerEl.classList.remove("compact");
          },
          { passive: true },
        );
      }

      const searchInput = $("search") as HTMLInputElement;
      const phoneWidth = window.matchMedia("(max-width: 640px)");
      const fitSearchHint = () => {
        searchInput.placeholder = phoneWidth.matches
          ? t("tasks.toolbar.search_placeholder_short")
          : t("tasks.toolbar.search_placeholder");
      };
      phoneWidth.addEventListener("change", fitSearchHint);
      fitSearchHint();
      const urlQuery = new URLSearchParams(window.location.search).get("q")?.trim();
      if (urlQuery) {
        searchInput.value = urlQuery;
        searchQuery = urlQuery;
      }
      let searchDebounce: number | null = null;
      searchInput.addEventListener("input", () => {
        if (searchDebounce !== null) window.clearTimeout(searchDebounce);
        searchDebounce = window.setTimeout(() => {
          searchQuery = searchInput.value.trim();
          renderBoard();
        }, 80);
      });

      let lastG = 0;
      function drawerKey(e: KeyboardEvent): boolean {
        const task = activeTask;
        if (!task || !$("drawer").classList.contains("open")) return false;
        if (e.key === "g" || e.key === "G") {
          lastG = Date.now();
          return false;
        }
        if (Date.now() - lastG < 900) return false;
        if (!$("dr-menu").hidden || document.querySelector("#st-rows .st-pop")) return false;
        if (newModal.isOpen() || mergeModal.isOpen()) return false;
        const key = e.key;
        const run = (fn: () => void) => {
          e.preventDefault();
          fn();
          return true;
        };
        if (key === "N" && e.shiftKey) return run(focusSubtaskAdd);
        switch (key.toLowerCase()) {
          case "e":
            return run(() => enterBriefEdit());
          case "f":
            return run(() => setExpanded(!$("drawer").classList.contains("expanded")));
          case "j":
          case "k":
            return run(() => stepColumn(key.toLowerCase() === "j" ? 1 : -1));
          case "[":
          case "]": {
            const go = $(key === "[" ? "dr-sib-prev" : "dr-sib-next").dataset.go;
            if (!task.parent_id || !go) return false;
            return run(() => void openDrawer(go));
          }
          case "u":
            if (!task.parent_id) return false;
            return run(() => void openDrawer(task.parent_id!));
          case "s":
            return run(() => openPropPicker("stage"));
          case "p":
            return run(() => openPropPicker("priority"));
          case "l":
            return run(() => openPropPicker("tags"));
          case "d":
            return run(() => openPropPicker("deps"));
          case "a":
            return run(() => openPropPicker("agent"));
          case ".":
            return run(() => drMenuCtl.open());
          case "c":
            return run(focusComposer);
          case "r":
          case "x": {
            const th = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>(
              "#ov-comments .act-thread[data-thread], #ov-comments .act-resolved[data-thread]",
            );
            if (!th) return false;
            const id = th.dataset.thread!;
            if (key.toLowerCase() === "r") return run(() => openThreadComposer(id));
            const btn = th.querySelector<HTMLButtonElement>(
              ":scope > .act-actions [data-thread-resolve]",
            );
            if (th.classList.contains("act-resolved"))
              return run(() => void resolveThread(id, false));
            if (!btn) return false;
            return run(() => btn.click());
          }
        }
        return false;
      }

      function stepColumn(dir: 1 | -1) {
        const task = activeTask;
        if (!task) return;
        // In the list, the next task is the next row on screen.
        const cards = listLayout()
          ? listRowIDs()
          : Array.from(
              document.querySelectorAll<HTMLElement>(
                `#board .col[data-stage="${CSS.escape(task.stage)}"] .task-card[data-id]`,
              ),
            ).map((c) => c.dataset.id || "");
        const at = cards.indexOf(task.id);
        const next = at < 0 ? "" : cards[at + dir];
        if (next) void openDrawer(next);
      }

      // V flips the layout from anywhere on the page but a field, a menu or a dialog.
      function layoutKey(e: KeyboardEvent): boolean {
        if (e.key !== "v" && e.key !== "V") return false;
        if (dirty.hasOpenModal() || cmTask || colEd?.editing) return false;
        e.preventDefault();
        toggleLayout();
        return true;
      }

      initKeyboard({
        rawKey: (e) => {
          if (!lightbox.isOpen()) return false;
          if (e.key === "Escape") {
            e.preventDefault();
            closeLightbox();
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            stepLightbox(-1);
          } else if (e.key === "ArrowRight") {
            e.preventDefault();
            stepLightbox(1);
          }
          return true;
        },
        onEscape: [
          () => colEd?.escape() ?? false,
          () => cancelLift(),
          () => closeFilters(),
          escapeCloses(runModal, newModal, mergeModal),
          () => {
            if (!activePickerClose) return false;
            activePickerClose();
            return true;
          },
          () => closePropsSheet(),
          () => {
            const f = document.activeElement as HTMLElement | null;
            if (!replyingTo || !f?.closest(".thread-composer")) return false;
            closeThreadComposer();
            return true;
          },
          () => {
            if (!$("drawer").classList.contains("open")) return false;
            closeDrawer();
            return true;
          },
          () => {
            if (!colEd?.editing) return false;
            setBoardEditing(false);
            return true;
          },
          () => {
            if (!searchInput.value) return false;
            searchInput.value = "";
            searchQuery = "";
            renderBoard();
            searchInput.blur();
            return true;
          },
        ],
        onKey: (e) => drawerKey(e) || layoutKey(e),
        onSearch: () => {
          searchInput.focus();
          searchInput.select();
        },
        onNew: () => {
          if (newModal.isOpen()) return;
          openNewModal();
        },
      });

      bootstrap()
        .catch((err: unknown) => {
          freshness.stale = true;
          freshness.failures += 1;
          freshness.lastError = err instanceof Error ? err.message : String(err);
          renderStaleBanner();
        })
        .then(() => {
          // The tasks topic drives updates; the poller only reconciles missed frames, hence the
          // long interval.
          const poller = startPoller({
            interval: 30000,
            firstDelay: 30000,
            fetch: pollTick,
            skipWhen: () => dirty.isDragging() || dirty.hasOpenModal(),
          });
          const offTasks = events.subscribe(TASKS_TOPIC, () => poller.poke(), { replay: false });
          // Nothing is replayed across a reconnect; refetch.
          const offReconnect = events.onReconnect(() => poller.poke());
          signal.addEventListener("abort", () => {
            offTasks();
            offReconnect();
          });
        });
    });
  </script>
</Layout>
