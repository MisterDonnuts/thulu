      function loadBlockers(kids: Task[]) {
        const finished = kids
          .filter((c) => isTerminalStage(c.stage))
          .map((c) => c.id)
          .join(",");
        for (const c of kids) {
          if (isTerminalStage(c.stage)) {
            stBlockers.delete(c.id);
            continue;
          }
          const ask = `${c.id}:${c.blocked_by_count || 0}:${!!c.is_blocked}:${c.stage}:${finished}`;
          if (stBlockersAsked.has(ask)) continue;
          stBlockersAsked.add(ask);
          const forTask = activeTask?.id;
          api
            .get<{
              blocked_by?: Array<{ title?: string; task_id: string; kind: string; stage: string }>;
            }>(`/tasks/${c.id}/dependencies`)
            .then((res) => {
              if (activeTask?.id !== forTask) return;
              const deps = res.blocked_by || [];
              const name = (d: { title?: string; task_id: string }) =>
                d.title || shortId(d.task_id);
              const hard = deps.filter((d) => d.kind !== "soft");
              stBlockers.set(c.id, {
                titles: hard.filter((d) => !isTerminalStage(d.stage)).map(name),
                soft: deps.filter((d) => d.kind === "soft" && !isTerminalStage(d.stage)).map(name),
                metHard: hard.filter((d) => isTerminalStage(d.stage)).length,
              });
              renderSubtasks(false);
              renderAttention();
            })
            .catch(() => {
              // The row says "Waits for another subtask" without the name.
            });
        }
      }

      function subtaskStart(c: Task) {
        return startTarget(
          flowOf(c).map((s) => ({ id: s.id, label: s.label, terminal: !!s.terminal })),
          c.stage,
          c.stage_assignments || {},
        );
      }

      function subtaskRowHTML(c: Task, init: string): string {
        const state = subtaskState(c, isTerminalStage, init);
        const agent = c.stage_assignments?.[c.stage] || "";
        const word = state === "done" ? null : runWord(c.status, false);
        const deps = stBlockers.get(c.id);
        const ready = state === "todo" && !!deps && deps.metHard > 0 && deps.titles.length === 0;
        const go = ready ? subtaskStart(c) : null;
        const waits = waitsLineHTML(state, {
          blockers: deps?.titles || [],
          soft: deps?.soft || [],
          ready: !!go,
        });
        const stage = stageInfo(c.stage)?.label || c.stage;
        const name = subtaskRowName(c.title, subtaskStateLabel(state), stage);
        const start = go
          ? buttonHTML({
              label: go.label,
              size: "sm",
              cls: "write-only",
              attrs: { "data-st-start": c.id },
            })
          : "";
        return listRowHTML({
          as: "li",
          size: "sm",
          wrap: true,
          dim: state === "done",
          cls: `st-row st-${state}`,
          attrs: { "data-id": c.id },
          leadHTML: `<span class="st-grip write-only" data-st-grip="${esc(c.id)}" aria-hidden="true" title="${esc(t("tasks.drawer.subtasks.drag"))}">${icoSvg("i-grip")}</span>${subtaskStateIconHTML(state)}`,
          title: c.title,
          titleHref: `#task-${c.id}`,
          titleAttrs: { "data-open-task": c.id, "aria-label": name },
          badgesHTML: `${stagePillHTML(c.stage, stageInfo(c.stage), { size: "sm" })}${agent ? agentChipHTML(agent, { inline: true, size: "sm", cls: "st-agent" }) : ""}${runPillHTML(word)}`,
          metaHTML: waits,
          asideHTML: `<code class="st-id">${esc(shortId(c.id))}</code>`,
          actionsHTML:
            start +
            buttonHTML({
              iconOnly: true,
              icon: "more",
              label: t("tasks.drawer.subtasks.row_actions", { title: c.title }),
              size: "sm",
              variant: "ghost",
              cls: "write-only",
              attrs: { "data-st-menu": c.id, "aria-haspopup": "menu", "aria-expanded": "false" },
            }),
        });
      }

      function renderSubtasks(background = false) {
        const task = activeTask!;
        const sec = document.getElementById("ov-subtasks");
        if (!sec || task.parent_id) return;
        const list = $("st-rows");
        if (stDragging || list.querySelector(".st-pop")) return;
        if (background && list.contains(document.activeElement)) return;
        const kids = task.children || [];
        loadBlockers(kids);
        const init = initialStage();
        const prog = subtaskProgress(kids, isTerminalStage, init);
        const doneCount = prog.done;
        const visible = stHideDone ? kids.filter((c) => !isTerminalStage(c.stage)) : kids;
        const sig = JSON.stringify({
          k: visible.map((c) => [
            c.id,
            c.title,
            c.stage,
            c.status,
            !!c.is_blocked,
            c.stage_assignments?.[c.stage] || "",
            stBlockers.get(c.id) || null,
          ]),
          p: stPending.map((p) => p.key),
          s: stages.map((s) => [s.id, s.label, s.color]),
        });
        if (list.dataset.sig !== sig) {
          list.innerHTML =
            visible.map((c) => subtaskRowHTML(c, init)).join("") +
            stPending
              .map((p) =>
                listRowHTML({
                  as: "li",
                  size: "sm",
                  wrap: true,
                  cls: "st-row st-pending",
                  attrs: { "aria-busy": "true" },
                  leadHTML: `<span class="st-grip" aria-hidden="true"></span>${subtaskStateIconHTML("todo")}`,
                  title: p.title,
                  badgesHTML: `<span class="st-adding">${esc(t("tasks.drawer.subtasks.adding"))}</span>`,
                }),
              )
              .join("");
          list.dataset.sig = sig;
        }
        list.hidden = visible.length === 0 && stPending.length === 0;

        const progress = $("st-progress");
        setText(progress, kids.length ? progressText(prog, "long") : "");
        const bar = $("st-bar");
        const barHTML = subtaskBarHTML(prog);
        if (bar.dataset.sig !== barHTML) {
          bar.innerHTML = barHTML;
          bar.dataset.sig = barHTML;
        }
        const hide = $("st-hide-done") as HTMLButtonElement;
        hide.hidden = doneCount === 0;
        hide.setAttribute("aria-pressed", String(stHideDone));
        setText(
          hide,
          stHideDone
            ? t("tasks.drawer.subtasks.show_done", { count: doneCount })
            : t("tasks.drawer.subtasks.hide_done"),
        );
        const empty = kids.length === 0 && stPending.length === 0;
        $("st-add-open").hidden = !empty || stAddOpen;
        $("st-add").hidden = empty && !stAddOpen;
        paintSubtaskOptions();
      }

      function paintSubtaskOptions() {
        const task = activeTask!;
        const more = document.getElementById("st-more") as HTMLDetailsElement | null;
        if (!more) return;
        const start = $("st-start") as HTMLSelectElement;
        const waits = $("st-waits");
        const agentsBox = $("st-agents");
        const flow = flowOf(task).filter((s) => !s.terminal);
        const kids = task.children || [];
        const sig = JSON.stringify([
          flow.map((s) => [s.id, s.label]),
          kids.map((c) => [c.id, c.title]),
          task.stage_assignments || {},
          agentTypes.map((a) => a.type || a.name),
        ]);
        if (more.dataset.sig === sig) return;
        const pickedStart = start.value;
        const pickedWaits = new Set(
          Array.from(waits.querySelectorAll<HTMLInputElement>("input:checked")).map((i) => i.value),
        );
        const pickedAgents = new Map(
          Array.from(agentsBox.querySelectorAll<HTMLSelectElement>("select")).map((s) => [
            s.dataset.stage || "",
            s.value,
          ]),
        );
        const init = initialStage();
        start.innerHTML = flow
          .map(
            (s) =>
              `<option value="${esc(s.id)}"${(pickedStart || init) === s.id ? " selected" : ""}>${esc(s.label)}</option>`,
          )
          .join("");
        waits.innerHTML = kids.length
          ? kids
              .map((c) =>
                checkHTML({ value: c.id, label: c.title, checked: pickedWaits.has(c.id) }),
              )
              .join("")
          : propEmptyHTML(t("tasks.drawer.subtasks.no_siblings"));
        const parentAssign = task.stage_assignments || {};
        agentsBox.innerHTML = agentColumns(flow)
          .map((s) => {
            const inherited = parentAssign[s.id] || "";
            const picked = pickedAgents.get(s.id) ?? "";
            const valid = agentTypes.filter((a) => agentCovers(a, s.id));
            const opts = [
              `<option value="">${esc(inherited ? t("tasks.drawer.subtasks.inherit_agent", { agent: inherited }) : t("tasks.drawer.subtasks.inherit_none"))}</option>`,
              `<option value="-"${picked === "-" ? " selected" : ""}>${esc(t("tasks.drawer.agents.none_option"))}</option>`,
              ...valid.map((a) => {
                const n = a.type || a.name;
                return `<option value="${esc(n)}"${picked === n ? " selected" : ""}>${esc(n)}</option>`;
              }),
            ];
            const sid = `st-agent-${s.id}`;
            return fieldHTML({
              label: s.label,
              for: sid,
              control: `<select id="${esc(sid)}" data-stage="${esc(s.id)}">${opts.join("")}</select>`,
            });
          })
          .join("");
        more.dataset.sig = sig;
        syncWaitsReason();
      }

      function syncWaitsReason() {
        const start = document.getElementById("st-start") as HTMLSelectElement | null;
        if (!start) return;
        const off = !!start.value && start.value !== initialStage();
        document
          .querySelectorAll<HTMLInputElement>("#st-waits input")
          .forEach((i) => (i.disabled = off));
        $("st-waits-reason").hidden = !off;
      }

      function focusSubtaskAdd() {
        if (!activeTask || activeTask.parent_id || refuseReadOnly()) return;
        showTab("overview");
        stAddOpen = true;
        renderSubtasks(false);
        const input = document.getElementById("subtask-title") as HTMLInputElement | null;
        if (!input) return;
        input.scrollIntoView({ block: "center", behavior: scrollBehavior() });
        input.focus({ preventScroll: true });
      }

      async function createSubtasks(titles: string[], plain = false): Promise<string[]> {
        const task = activeTask;
        if (!task || task.parent_id || titles.length === 0 || refuseReadOnly()) return [];
        const err = document.getElementById("subtask-err");
        if (err) err.hidden = true;
        const opts: Record<string, unknown> = {};
        if (!plain) {
          const start =
            (document.getElementById("st-start") as HTMLSelectElement | null)?.value || "";
          if (start && start !== initialStage()) opts.stage = start;
          const waits = Array.from(
            document.querySelectorAll<HTMLInputElement>("#st-waits input:checked:not(:disabled)"),
          ).map((i) => i.value);
          if (waits.length) opts.depends_on = waits;
          const assigns: Record<string, string> = {};
          document.querySelectorAll<HTMLSelectElement>("#st-agents select").forEach((s) => {
            if (s.value === "-") assigns[s.dataset.stage!] = "";
            else if (s.value) assigns[s.dataset.stage!] = s.value;
          });
          if (Object.keys(assigns).length) opts.stage_assignments = assigns;
        }

        const batch = titles.map((title, i) => ({ key: `p${Date.now()}-${i}`, title }));
        stPending.push(...batch);
        renderSubtasks(false);
        let made = 0;
        let left: string[] = [];
        for (const [i, p] of batch.entries()) {
          try {
            await api.post(`/tasks/${task.id}/subtasks`, { title: p.title, ...opts });
            made++;
          } catch (e) {
            left = titles.slice(i);
            if (err) {
              err.hidden = false;
              const error = e instanceof ApiError ? e.message : String(e);
              setText(
                err,
                left.length > 1
                  ? t("tasks.drawer.subtasks.create_failed_many", {
                      title: p.title,
                      error,
                      count: left.length,
                    })
                  : t("tasks.drawer.subtasks.create_failed", { title: p.title, error }),
              );
            }
            break;
          }
        }
        if (made) announce(t("tasks.drawer.subtasks.created", { count: made }));
        if (!plain && left.length === 0) resetSubtaskOptions();
        if (activeTask?.id === task.id) {
          try {
            activeTask = await api.get<Task>(`/tasks/${task.id}`);
          } catch {
            // The next poll brings the new rows.
          }
        }
        stPending = stPending.filter((p) => !batch.includes(p));
        if (activeTask?.id === task.id) {
          renderSubtasks(false);
          renderHeader();
          renderAttention();
          renderBrief();
        }
        void refresh(true);
        return left;
      }

      function resetSubtaskOptions() {
        const start = document.getElementById("st-start") as HTMLSelectElement | null;
        if (start) start.value = initialStage();
        document
          .querySelectorAll<HTMLInputElement>("#st-waits input")
          .forEach((i) => (i.checked = false));
        document
          .querySelectorAll<HTMLSelectElement>("#st-agents select")
          .forEach((s) => (s.value = ""));
        syncWaitsReason();
      }

      function wireSubtaskAdd() {
        const input = $("subtask-title") as HTMLInputElement;
        const add = $("subtask-add") as HTMLButtonElement;
        const pasteBtn = $("st-paste-create") as HTMLButtonElement;
        const cancel = $("st-paste-cancel") as HTMLButtonElement;
        const box = $("st-paste");
        const list = $("st-paste-list");
        const titles = () => stPaste.map((x) => x.trim()).filter(Boolean);
        const paintPaste = (focusAt = -1) => {
          const on = stPaste.length > 0;
          box.hidden = !on;
          pasteBtn.hidden = !on;
          cancel.hidden = !on;
          add.hidden = on;
          if (!on) {
            list.innerHTML = "";
            return;
          }
          const n = titles().length;
          setText(pasteBtn, t("tasks.drawer.subtasks.create_n", { count: n }));
          pasteBtn.disabled = n === 0;
          setText($("st-paste-h"), t("tasks.drawer.subtasks.paste_head", { count: n }));
          list.innerHTML = stPaste
            .map(
              (title, i) =>
                `<li class="st-paste-row"><input type="text" value="${esc(title)}" data-paste-at="${i}" aria-label="${esc(t("tasks.drawer.subtasks.paste_title", { n: i + 1 }))}">${buttonHTML({ iconOnly: true, icon: "x", label: t("tasks.drawer.subtasks.paste_drop", { title }), variant: "danger", attrs: { "data-paste-drop": i } })}</li>`,
            )
            .join("");
          if (focusAt >= 0)
            list
              .querySelector<HTMLInputElement>(
                `[data-paste-at="${Math.min(focusAt, stPaste.length - 1)}"]`,
              )
              ?.focus();
        };
        const syncCount = () => {
          const n = titles().length;
          setText(pasteBtn, t("tasks.drawer.subtasks.create_n", { count: n }));
          pasteBtn.disabled = n === 0;
          setText($("st-paste-h"), t("tasks.drawer.subtasks.paste_head", { count: n }));
        };
        const submit = async () => {
          const title = input.value.trim();
          if (!title) {
            input.focus();
            return;
          }
          input.value = "";
          input.focus();
          const left = await createSubtasks([title]);
          if (left.length && !input.value) input.value = left[0];
        };
        const createPasted = async () => {
          const todo = titles();
          if (todo.length === 0) return;
          stPaste = [];
          paintPaste();
          input.focus();
          const left = await createSubtasks(todo);
          if (left.length) {
            stPaste = [...left, ...stPaste];
            paintPaste();
          }
        };
        add.addEventListener("click", () => void submit());
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            void submit();
          } else if (e.key === "Escape" && stPaste.length) {
            e.preventDefault();
            e.stopPropagation();
            cancel.click();
          }
        });
        input.addEventListener("paste", (e) => {
          const pasted = parsePastedList(e.clipboardData?.getData("text/plain") || "");
          if (pasted.length === 0) return;
          e.preventDefault();
          stPaste = [...stPaste, ...pasted];
          paintPaste(stPaste.length - pasted.length);
        });
        list.addEventListener("input", (e) => {
          const el = e.target as HTMLInputElement;
          const at = Number(el.dataset.pasteAt);
          if (Number.isNaN(at)) return;
          stPaste[at] = el.value;
          syncCount();
        });
        list.addEventListener("keydown", (e) => {
          if (!(e.target as HTMLElement).matches("[data-paste-at]")) return;
          if (e.key === "Enter") {
            e.preventDefault();
            void createPasted();
          } else if (e.key === "Escape") {
            e.preventDefault();
            e.stopPropagation();
            cancel.click();
          }
        });
        list.addEventListener("click", (e) => {
          const drop = (e.target as HTMLElement).closest<HTMLElement>("[data-paste-drop]");
          if (!drop) return;
          const at = Number(drop.dataset.pasteDrop);
          stPaste.splice(at, 1);
          paintPaste(at);
          if (!stPaste.length) input.focus();
        });
        pasteBtn.addEventListener("click", () => void createPasted());
        cancel.addEventListener("click", () => {
          stPaste = [];
          paintPaste();
          input.focus();
        });
        $("st-start").addEventListener("change", syncWaitsReason);
        paintPaste();
      }

      async function putSubtaskOrder(ids: string[]) {
        const task = activeTask;
        if (!task) return;
        const prev = task.children || [];
        const byID = new Map(prev.map((c) => [c.id, c]));
        task.children = ids.map((id) => byID.get(id)!).filter(Boolean);
        renderSubtasks(false);
        try {
          const res = await api.put<{ children?: Task[] }>(`/tasks/${task.id}/subtasks/order`, {
            ids,
          });
          if (activeTask?.id === task.id && res?.children) activeTask.children = res.children;
          announce(t("tasks.drawer.subtasks.reordered"));
          showOrderHint();
        } catch (e) {
          if (activeTask?.id === task.id) activeTask.children = prev;
          toast(
            t("tasks.drawer.subtasks.reorder_failed", {
              error: e instanceof ApiError ? e.message : String(e),
            }),
            "err",
            4500,
          );
        }
        renderSubtasks(false);
      }

      function showOrderHint() {
        let seen = false;
        try {
          seen = localStorage.getItem(ORDER_HINT_KEY) === "1";
          localStorage.setItem(ORDER_HINT_KEY, "1");
        } catch {
          // Shown again next time.
        }
        if (!seen) $("st-hint").hidden = false;
      }

      async function startSubtask(id: string) {
        if (refuseReadOnly()) return;
        const c = (activeTask?.children || []).find((x) => x.id === id);
        const go = c ? subtaskStart(c) : null;
        if (c && go) await moveTask(c.id, go.stage, c.title);
      }

      async function deleteSubtask(id: string) {
        const c = (activeTask?.children || []).find((x) => x.id === id);
        if (!c) return;
        const ok = await confirmDialog({
          title: t("tasks.confirm.delete_subtask_title", { title: c.title }),
          message: t("tasks.confirm.delete_subtask_message"),
          confirmLabel: t("tasks.confirm.delete_subtask_button"),
          danger: true,
        });
        if (!ok) return;
        try {
          await api.del(`/tasks/${id}`);
          announce(t("tasks.drawer.subtasks.deleted", { title: c.title }));
          await refresh(true);
        } catch (err) {
          toast(
            t("tasks.toasts.delete_failed", {
              error: err instanceof ApiError ? err.message : String(err),
            }),
            "err",
            4500,
          );
        }
      }

      let rowMenuRelease: (() => void) | null = null;
      function closeRowMenu(restore = true): boolean {
        const pop = document.querySelector<HTMLElement>("#st-rows .st-pop");
        if (!pop) return false;
        rowMenuRelease?.();
        rowMenuRelease = null;
        const row = pop.closest<HTMLElement>(".st-row");
        const btn = row?.querySelector<HTMLButtonElement>("[data-st-menu]");
        const hadFocus = pop.contains(document.activeElement);
        pop.remove();
        btn?.setAttribute("aria-expanded", "false");
        if (hadFocus && restore) btn?.focus();
        renderSubtasks(false);
        return true;
      }

      function openRowMenu(id: string) {
        const already = document.querySelector<HTMLElement>(
          `#st-rows .st-row[data-id="${CSS.escape(id)}"] .st-pop`,
        );
        closeRowMenu();
        if (already) return;
        const task = activeTask;
        const c = (task?.children || []).find((x) => x.id === id);
        const row = document.querySelector<HTMLElement>(
          `#st-rows .st-row[data-id="${CSS.escape(id)}"]`,
        );
        if (!task || !c || !row) return;
        const tpl = document.createElement("template");
        tpl.innerHTML = menuHTML([], {
          label: t("tasks.drawer.subtasks.row_actions", { title: c.title }),
          open: true,
          cls: "st-pop",
        });
        const pop = tpl.content.firstElementChild as HTMLElement;
        row.appendChild(pop);
        const menuBtn = row.querySelector<HTMLElement>("[data-st-menu]");
        menuBtn?.setAttribute("aria-expanded", "true");
        rowMenuRelease = dismissLayer(pop, menuBtn, (restore) => closeRowMenu(restore));

        const ids = (task.children || []).map((x) => x.id);
        const shownIDs = (task.children || [])
          .filter((x) => !stHideDone || !isTerminalStage(x.stage) || x.id === id)
          .map((x) => x.id);
        const item = (act: string, title: string, icon: string, danger = false): MenuEntry => ({
          title,
          icon,
          danger,
          attrs: { "data-row-act": act },
        });
        const terminals = flowOf(c).filter((s) => s.terminal && s.id !== c.stage);
        const paint = (entries: MenuEntry[]) => {
          pop.innerHTML = menuItemsHTML(entries);
          menuFocusables(pop)[0]?.focus({ preventScroll: true });
        };
        const paintMain = () => {
          const pos = shownIDs.indexOf(id);
          const go =
            subtaskState(c, isTerminalStage, initialStage()) === "todo" ? subtaskStart(c) : null;
          const entries: MenuEntry[] = [
            item("open", t("tasks.drawer.subtasks.menu.open"), "i-arrow-up-right"),
            item("move", t("tasks.drawer.subtasks.menu.move"), "i-arrow-right"),
          ];
          if (terminals.length && !isTerminalStage(c.stage))
            entries.push(item("done", t("tasks.drawer.subtasks.menu.mark_done"), "i-check-circle"));
          if (go) entries.push(item("start", go.label, "i-play"));
          entries.push(item("waits", t("tasks.drawer.subtasks.menu.waits"), "i-lock"));
          if (pos > 0) entries.push(item("up", t("tasks.drawer.subtasks.menu.up"), "i-arrow-up"));
          if (pos < shownIDs.length - 1)
            entries.push(item("down", t("tasks.drawer.subtasks.menu.down"), "i-arrow-down"));
          entries.push(
            { sep: true },
            item("delete", t("tasks.drawer.subtasks.menu.delete"), "i-trash", true),
          );
          paint(entries);
        };
        const paintStages = (list: Stage[]) =>
          paint([
            { head: t("tasks.drawer.subtasks.menu.move_to") },
            ...list.map((s): MenuEntry => ({
              title: s.label,
              dot: s.color,
              indent: true,
              checked: s.id === c.stage,
              attrs: { "data-row-stage": s.id },
            })),
          ]);
        const paintWaits = async () => {
          const head: MenuEntry = { head: t("tasks.drawer.subtasks.menu.waits_for") };
          paint([head, { note: t("common.status.loading") }]);
          let current: Array<{ task_id: string; kind: string }> = [];
          try {
            const res = await api.get<{ blocked_by?: Array<{ task_id: string; kind: string }> }>(
              `/tasks/${c.id}/dependencies`,
            );
            current = res.blocked_by || [];
          } catch {
            // Shown as nothing picked; a refused toggle explains itself.
          }
          if (!pop.isConnected) return;
          const hard = c.stage === initialStage();
          const sibs = (task.children || []).filter((x) => x.id !== c.id);
          paint([
            head,
            {
              note: hard
                ? t("tasks.drawer.subtasks.waits_hard")
                : t("tasks.drawer.subtasks.waits_soft"),
            },
            ...(sibs.length
              ? sibs.map((s): MenuEntry => ({
                  title: s.title,
                  role: "menuitemcheckbox",
                  checked: current.some((d) => d.task_id === s.id),
                  attrs: { "data-row-wait": s.id },
                }))
              : [{ note: t("tasks.drawer.subtasks.no_siblings") }]),
          ]);
        };

        pop.addEventListener("keydown", (e) => {
          if (menuStep(e, pop)) return;
          if (e.key === "Tab") closeRowMenu(false);
        });
        pop.addEventListener("click", async (e) => {
          e.stopPropagation();
          const b = (e.target as HTMLElement).closest<HTMLElement>('[role^="menuitem"]');
          if (!b) return;
          const act = b.dataset.rowAct;
          if (b.dataset.rowStage) {
            const stage = b.dataset.rowStage;
            closeRowMenu();
            if (stage !== c.stage) await moveTask(c.id, stage, c.title);
            return;
          }
          if (b.dataset.rowWait) {
            const on = b.getAttribute("aria-checked") === "true";
            try {
              if (on) {
                await api.del(
                  `/tasks/${c.id}/dependencies/${encodeURIComponent(b.dataset.rowWait)}`,
                );
              } else {
                await api.post(`/tasks/${c.id}/dependencies`, {
                  depends_on_task_id: b.dataset.rowWait,
                  kind: c.stage === initialStage() ? "hard" : "soft",
                });
              }
            } catch (err) {
              toast(err instanceof ApiError ? err.message : String(err), "err", 4500);
              return;
            }
            stBlockersAsked.clear();
            await paintWaits();
            void refresh(true);
            return;
          }
          if (act === "open") {
            closeRowMenu();
            await openDrawer(c.id);
          } else if (act === "move") paintStages(flowOf(c));
          else if (act === "done") {
            if (terminals.length === 1) {
              closeRowMenu();
              await moveTask(c.id, terminals[0].id, c.title);
            } else paintStages(terminals);
          } else if (act === "start") {
            closeRowMenu();
            await startSubtask(c.id);
          } else if (act === "waits") await paintWaits();
          else if (act === "up" || act === "down") {
            const next = moveAmong(ids, shownIDs, c.id, act === "up" ? -1 : 1);
            closeRowMenu();
            if (next) await putSubtaskOrder(next);
          } else if (act === "delete") {
            closeRowMenu();
            await deleteSubtask(c.id);
          }
        });
        paintMain();
      }

      function wireSubtaskDrag(pane: HTMLElement) {
        let dragID = "";
        let before = -1;
        let moved = false;
        const rowsOf = () =>
          Array.from(document.querySelectorAll<HTMLElement>("#st-rows .st-row[data-id]"));
        const clearMarks = () =>
          rowsOf().forEach((r) => r.classList.remove("drop-before", "drop-after", "dragging"));
        pane.addEventListener("pointerdown", (e) => {
          const grip = (e.target as HTMLElement).closest<HTMLElement>("[data-st-grip]");
          if (!grip || e.button !== 0 || !mayWriteTasks) return;
          e.preventDefault();
          dragID = grip.dataset.stGrip || "";
          before = -1;
          moved = false;
          stDragging = true;
          grip.setPointerCapture(e.pointerId);
          grip.closest(".st-row")?.classList.add("dragging");
        });
        pane.addEventListener("pointermove", (e) => {
          if (!dragID) return;
          moved = true;
          const rows = rowsOf();
          before = rows.length;
          for (let i = 0; i < rows.length; i++) {
            const r = rows[i].getBoundingClientRect();
            if (e.clientY < r.top + r.height / 2) {
              before = i;
              break;
            }
          }
          rows.forEach((r, i) => {
            r.classList.toggle("drop-before", i === before);
            r.classList.toggle("drop-after", before === rows.length && i === rows.length - 1);
          });
        });
        const end = async () => {
          if (!dragID) return;
          const id = dragID;
          dragID = "";
          stDragging = false;
          clearMarks();
          if (!moved || before < 0) {
            renderSubtasks(false);
            return;
          }
          const shown = rowsOf().map((r) => r.dataset.id || "");
          const target = shown[before];
          const all = (activeTask?.children || []).map((c) => c.id);
          const at = target ? all.indexOf(target) : all.length;
          const next = dropInOrder(all, id, at);
          if (next) await putSubtaskOrder(next);
          else renderSubtasks(false);
        };
        pane.addEventListener("pointerup", end);
        pane.addEventListener("pointercancel", end);
      }

      async function uploadTaskFiles(files: File[]) {
        const task = activeTask;
        if (!task || files.length === 0 || refuseReadOnly()) return;
        const err = document.getElementById("ov-files-err");
        if (err) err.hidden = true;
        let ok = 0;
        for (const f of files) {
          try {
            await uploadAttachment(task.id, f, f.name || pastedName(f));
            ok++;
          } catch (e) {
            if (err) {
              err.hidden = false;
              setText(
                err,
                t("tasks.drawer.files.upload_failed", {
                  file: f.name,
                  error: (e as Error).message,
                }),
              );
            }
          }
        }
        if (ok) {
          filesOpen.add(task.id);
          toast(t("tasks.drawer.files.uploaded", { count: ok }), "ok", 1800);
        }
        await refresh(true);
      }

      function wireTaskTabDrop(pane: HTMLElement) {
        const editable = (el: EventTarget | null) => {
          const n = el as HTMLElement | null;
          return !!n?.closest?.("textarea, input, [contenteditable]");
        };
        const hasFiles = (e: DragEvent) =>
          !!e.dataTransfer && Array.from(e.dataTransfer.items).some((it) => it.kind === "file");
        pane.addEventListener("dragover", (e) => {
          if (e.defaultPrevented || editable(e.target) || !hasFiles(e)) return;
          e.preventDefault();
          pane.classList.add("drop-files");
        });
        pane.addEventListener("dragleave", (e) => {
          if (!pane.contains(e.relatedTarget as Node)) pane.classList.remove("drop-files");
        });
        pane.addEventListener("drop", (e) => {
          pane.classList.remove("drop-files");
          if (e.defaultPrevented || editable(e.target) || !e.dataTransfer) return;
          const files = Array.from(e.dataTransfer.files);
          if (files.length === 0) return;
          e.preventDefault();
          void uploadTaskFiles(files);
        });
        pane.addEventListener("paste", (e) => {
          if (e.defaultPrevented || editable(e.target) || !e.clipboardData) return;
          const files = Array.from(e.clipboardData.items)
            .filter((it) => it.kind === "file")
            .map((it) => it.getAsFile())
            .filter((f): f is File => f !== null);
          if (files.length === 0) return;
          e.preventDefault();
          void uploadTaskFiles(files);
        });
      }

      function wireDrawerClicks() {
        const drawer = $("drawer");
        drawer.addEventListener("click", async (e) => {
          const el = e.target as HTMLElement;
          if (el.closest(".nselect, .st-pop")) return;
          const hit = <T extends HTMLElement = HTMLElement>(sel: string) => el.closest<T>(sel);
          const boardCrumb = hit("[data-crumb-board]");
          if (boardCrumb) {
            const id = boardCrumb.dataset.crumbBoard!;
            const act = boardCrumbAction(e, id, currentBoard);
            if (act === "browser") return;
            e.preventDefault();
            if (act === "close") closeDrawer();
            else await switchBoard(id);
            return;
          }
          const open = hit("[data-open-task]");
          if (open) {
            e.preventDefault();
            const id = open.dataset.openTask!;
            if (id !== activeTask?.id) await openDrawer(id);
            return;
          }
          const copy = hit("[data-copy]");
          if (copy) return copyText(copy.dataset.copy || "", "tasks.toasts.branch_copied");
          if (hit("[data-copy-link]")) return copyTaskLink();
          const move = hit("[data-move-to]");
          if (move) return moveActiveTask(move.dataset.moveTo!);
          const primary = hit("[data-primary]");
          if (primary) {
            const kind = primary.dataset.primary;
            if (kind === "answer") {
              const q = (activeTask?.questions || []).find((x) => x.status === "open");
              if (q) revealQuestion(q.id);
            } else if (kind === "review") showTab("approvals");
            else if (kind === "more_turns" || kind === "retry" || kind === "relaunch_stage")
              await relaunchTask();
            else if (kind === "review_retry") await reviewAndRetry();
            else if (kind === "credentials") window.location.assign("/credentials/");
            else if (kind === "pick_agent") openPropPicker("agent");
            return;
          }
          if (hit("#dr-stage")) return openStageSelect($("dr-state"));
          if (hit("[data-attn-toggle]")) {
            attnOpen = !attnOpen;
            renderAttention();
            $("dr-attention").querySelector<HTMLElement>("[data-attn-toggle]")?.focus();
            return;
          }
          const attn = hit("[data-attn]");
          if (attn) return runAttention(attn.dataset.attn!, attn.dataset.target || "");
          if (hit("[data-force-pr]")) return ensureActiveTaskPR();
          if (hit("[data-merge]")) return openMergeModal();
          const go = hit("[data-tab-go]");
          if (go) return showTab(go.dataset.tabGo!);
          if (hit("[data-sandbox-kill]")) return killTaskSandbox();
          const orphan = hit("[data-orphan-remove]");
          if (orphan) return removeOrphanAgent(orphan.dataset.orphanRemove!);
          const sib = hit<HTMLButtonElement>("#dr-sib-prev, #dr-sib-next");
          if (sib) {
            if (sib.dataset.go) await openDrawer(sib.dataset.go);
            return;
          }
          if (hit("[data-brief-write]")) return enterBriefEdit();
          const fold = hit("[data-fold]");
          if (fold) {
            const slug = fold.dataset.fold!;
            if (briefOpen.has(slug)) briefOpen.delete(slug);
            else briefOpen.add(slug);
            renderBrief();
            document.querySelector<HTMLElement>(`[data-fold="${CSS.escape(slug)}"]`)?.focus();
            return;
          }
          const make = hit("[data-make-subtask]");
          if (make) {
            await createSubtasks([make.dataset.makeSubtask || ""], true);
            return;
          }
          if (hit("#ov-props-sum")) return openPropsSheet();
          if (hit("[data-props-more]")) {
            propsShowAll = !propsShowAll;
            repaintProps();
            document.querySelector<HTMLElement>("#ov-props [data-props-more]")?.focus();
            return;
          }
          const edit = hit("[data-edit]");
          if (edit) return openPropPicker(edit.dataset.edit!);
          if (hit("#st-hide-done")) {
            stHideDone = !stHideDone;
            try {
              if (stHideDone) localStorage.setItem(HIDE_DONE_KEY, "1");
              else localStorage.removeItem(HIDE_DONE_KEY);
            } catch {
              // Not remembered.
            }
            renderSubtasks(false);
            return;
          }
          if (hit("#st-add-open")) return focusSubtaskAdd();
          const menu = hit("[data-st-menu]");
          if (menu) return openRowMenu(menu.dataset.stMenu!);
          const start = hit("[data-st-start]");
          if (start) return startSubtask(start.dataset.stStart!);
          const row = hit(".st-row[data-id]");
          if (row && !el.closest("button, a, input, select, summary, [data-st-grip]")) {
            await openDrawer(row.dataset.id!);
          }
        });
        drawer.addEventListener("keydown", (e) => {
          const el = e.target as HTMLElement;
          if ((e.key === "Enter" || e.key === " ") && el.matches("[data-edit][role='button']")) {
            e.preventDefault();
            openPropPicker(el.dataset.edit!);
          }
        });
        wireSubtaskDrag($("pane-overview"));
        wireTaskTabDrop($("pane-overview"));
      }
      wireDrawerClicks();
      wireApprovals();

      function fitPopover(wrap: HTMLElement, minHeight = 0) {
        const anchor = wrap.parentElement;
        if (!anchor) return;
        if (wrap.closest(".props-drawer")) {
          requestAnimationFrame(() => wrap.scrollIntoView({ block: "nearest" }));
          return;
        }
        const pane = wrap.closest<HTMLElement>(".drawer-body");
        const box = pane ? pane.getBoundingClientRect() : { top: 0, bottom: window.innerHeight };
        const at = anchor.getBoundingClientRect();
        const gap = 12;
        const below = box.bottom - at.bottom - gap;
        const above = at.top - box.top - gap;
        const want = Math.max(wrap.scrollHeight, minHeight);
        const up = want > below && above > below;
        wrap.style.top = up ? "auto" : "";
        wrap.style.bottom = up ? "calc(100% + 6px)" : "";
        wrap.style.maxHeight = `${Math.max(160, up ? above : below)}px`;
        wrap.style.overflowY = "auto";
      }

      function attachPopover(
        wrap: HTMLElement,
        onClosed: () => void,
      ): (fromOutside?: boolean) => void {
        fitPopover(wrap);
        const close = (fromOutside = false) => {
          document.removeEventListener("mousedown", onOutside);
          if (activePickerClose === escClose) activePickerClose = null;
          if (!wrap.isConnected) return;
          const key = wrap.parentElement?.dataset.prop;
          wrap.remove();
          onClosed();
          repaintProps();
          if (!fromOutside) {
            if (key) document.querySelector<HTMLElement>(`#ov-props [data-edit="${key}"]`)?.focus();
          }
        };
        const onOutside = (e: MouseEvent) => {
          if (!wrap.contains(e.target as Node)) close(true);
        };
        const escClose = () => close();
        activePickerClose = escClose;
        setTimeout(() => document.addEventListener("mousedown", onOutside, { signal }), 50);
        return close;
      }
      let activePickerClose: (() => void) | null = null;

      let propPicker: PickerHandle | null = null;
      function pickOn(
        propEl: HTMLElement,
        opts: Omit<OpenPickerOptions, "mount" | "onClose">,
      ): PickerHandle {
        propPicker?.close(false);
        const anchor = propEl.querySelector<HTMLElement>("#dr-stage, [data-edit]") ?? propEl;
        const again = anchor.id
          ? `#${anchor.id}`
          : `#ov-props [data-edit="${CSS.escape(anchor.dataset.edit ?? "")}"]`;
        const handle = openPicker(anchor, {
          ...opts,
          mount: propEl,
          onClose: () => {
            const refocus = document.activeElement === anchor;
            if (propPicker === handle) propPicker = null;
            repaintProps();
            if (refocus) document.querySelector<HTMLElement>(again)?.focus();
          },
        });
        propPicker = handle;
        return handle;
      }
      const propRow = (key: string) =>
        document.querySelector<HTMLElement>(`#ov-props [data-prop="${CSS.escape(key)}"]`);

      function openProjectSelect(propEl: HTMLElement) {
        if (!activeTask) return;
        const task = activeTask;
        const items = (): PickerItem[] => {
          const linked = task.project_ids || [];
          return projects.map((p) => ({
            value: p.id,
            label: p.name,
            labelHTML: repoChipHTML(p.name),
            selected: linked.includes(p.id),
            chip: { dot: chipColor(p.name) },
          }));
        };
        const setLinked = async (next: string[], failed: string): Promise<boolean> => {
          try {
            await api.patch(`/tasks/${task.id}`, { project_ids: next });
          } catch {
            toast(failed, "err");
            return false;
          }
          task.project_ids = next;
          return true;
        };
        const unlink = async (id: string) => {
          const next = (task.project_ids || []).filter((x) => x !== id);
          if (await setLinked(next, t("tasks.drawer.projects.unlink_failed"))) handle.refresh();
        };
        const handle = pickOn(propEl, {
          label: t("tasks.drawer.props.projects"),
          multi: true,
          chips: true,
          search: t("tasks.drawer.projects.search_placeholder"),
          hint: t("tasks.drawer.projects.hint"),
          items: (q) => {
            const all = items();
            const needle = q.trim().toLowerCase();
            return needle
              ? all.filter((i) => i.selected || i.label.toLowerCase().includes(needle))
              : all;
          },
          createLabel: (q) =>
            projects.some((p) => p.name.toLowerCase() === q.toLowerCase())
              ? null
              : t("tasks.drawer.projects.create", { name: q }),
          onSelect: async (item) => {
            if (item.selected) return unlink(item.value);
            const next = [...(task.project_ids || []), item.value];
            if (!(await setLinked(next, t("tasks.drawer.projects.link_failed")))) return;
            offerProjectTemplate(item.value);
            handle.refresh();
          },
          onRemove: (id) => void unlink(id),
          onCreate: (q) => void navigate(newProjectFromTaskURL(q, task.id)),
        });
      }

      let agentSelectClose: (() => void) | null = null;
      function openAgentSelect(propEl: HTMLElement, _valueEl: HTMLElement) {
        if (agentSelectClose) agentSelectClose();
        if (!activeTask) return;

        const wrap = document.createElement("div");
        wrap.className = pickerClasses();
        wrap.innerHTML = `<div class="row-list astage-list" id="astage-list"></div>`;
        propEl.appendChild(wrap);

        agentSelectClose = attachPopover(wrap, () => (agentSelectClose = null));

        const list = wrap.querySelector("#astage-list") as HTMLElement;

        function render() {
          const assigns = activeTask!.stage_assignments || {};
          list.innerHTML =
            agentColumns(stages)
              .map((s) => {
                const agent = assigns[s.id] || "";
                const pick = {
                  button: true,
                  attrs: {
                    "data-pick": s.id,
                    "aria-label": t("tasks.drawer.agents.pick_for", { stage: s.label }),
                  },
                };
                const chip = agent
                  ? agentChipHTML(agent, pick)
                  : tagHTML(t("tasks.drawer.props.summary_no_agent_long"), {
                      ...pick,
                      tone: "muted",
                      dashed: true,
                    });
                return listRowHTML({
                  size: "sm",
                  current: s.id === activeTask!.stage || undefined,
                  cls: "astage-row",
                  attrs: { "data-stage": s.id },
                  title: s.label,
                  actionsHTML: chip,
                });
              })
              .join("") + agentSourceHTML(activeTask!);
          list
            .querySelector<HTMLButtonElement>("[data-apply-template]")
            ?.addEventListener("click", async (e) => {
              e.stopPropagation();
              const id = (e.currentTarget as HTMLElement).dataset.applyTemplate ?? "";
              await applyProjectTemplate(id);
              render();
            });

          list.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((btn) => {
            btn.addEventListener("click", (e) => {
              e.stopPropagation();
              openStageAgents(btn, btn.dataset.pick!);
            });
          });
        }

        function openStageAgents(anchorBtn: HTMLElement, stageId: string) {
          const current = activeTask!.stage_assignments?.[stageId] || "";
          const valid = agentTypes.filter((a) => agentCovers(a, stageId));
          const items: PickerItem[] = [
            {
              value: "",
              label: t("tasks.drawer.agents.none_option"),
              labelHTML: tagHTML(t("tasks.drawer.agents.none_option"), {
                tone: "muted",
                dashed: true,
              }),
              selected: current === "",
            },
            ...valid.map((a) => {
              const name = a.type || a.name;
              return {
                value: name,
                label: name,
                labelHTML: agentChipHTML(name),
                selected: current === name,
              };
            }),
          ];
          openPicker(anchorBtn, {
            mount: anchorBtn.closest<HTMLElement>(".astage-row") ?? undefined,
            start: true,
            label: t("tasks.drawer.agents.pick_for", {
              stage: stageInfo(stageId)?.label || stageId,
            }),
            items,
            width: "sm",
            hint: agentTypes.length === 0 ? t("tasks.drawer.agents.none_installed") : undefined,
            onSelect: async (item) => {
              const next = { ...(activeTask!.stage_assignments || {}) };
              if (item.value) next[stageId] = item.value;
              else delete next[stageId];
              await patchStageAssignments(next, { refresh: false });
              render();
            },
          });
        }

        render();
      }

      function openStageSelect(propEl: HTMLElement) {
        if (!activeTask) return;
        if (activeTask.archived_at) {
          toast(t("tasks.drawer.header.archived_title"), "info");
          return;
        }
        const task = activeTask;
        const inHeader = propEl.id === "dr-state";
        pickOn(propEl, {
          label: t("tasks.drawer.props.stage"),
          start: inHeader,
          width: inHeader ? "sm" : undefined,
          items: stages
            .filter((st) => typeAllowsStage(taskTypes, task.type_id, st.id))
            .map((st) => ({
              value: st.id,
              label: st.label,
              labelHTML: stagePillHTML(st.id, st),
              selected: st.id === task.stage,
            })),
