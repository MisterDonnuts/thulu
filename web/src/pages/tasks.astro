    onPage("/tasks", (signal) => {
      requireAuth();

      // Sonnet/Opus context window; the usage bar measures current_context against it.
      const CONTEXT_WINDOW = 200_000;

      const API = apiBase();

      let drawerTabs: TabsHandle | null = null;
      const drawerBody = () => $("drawer").querySelector<HTMLElement>(":scope > .drawer-body")!;

      // Stored bodies and comments keep `/task-attachments/<id>` relative, so the daemon's current
      // origin is prepended at render time.
      function mdBody(src: string, opts: { checklist?: boolean } = {}): string {
        return md(src, { ...opts, mediaBase: API, attachment: attachmentInfo });
      }

      function attachmentInfo(id: string): { mime?: string; filename?: string } | undefined {
        const a = ((activeTask?.attachments || []) as Attachment[]).find((x) => x.id === id);
        return a ? { mime: a.mime_type, filename: a.filename } : undefined;
      }
      const fmtDate = (s: string) => {
        try {
          return new Date(s).toLocaleString(locale);
        } catch {
          return s;
        }
      };

      interface Project {
        id: string;
        name: string;
        repo_url: string;
        description?: string;
        default_branch: string;
        stage_template: Record<string, string>;
        default_board_id?: string;
        source?: string;
        clone_status?: string;
      }
      interface Attachment {
        id: string;
        filename: string;
        mime_type: string;
        size: number;
        created_at: string;
        comment_id?: string;
        author?: string;
      }
      type RunStatus =
        | "idle"
        | "running"
        | "out_of_turns"
        | "failed"
        | "blocked"
        | "needs_more_turns"
        | "awaiting_input"
        | "awaiting_approval"
        | "queued"
        | "not_started"
        | "credential_blocked"
        | "no_agent"
        | "stopped"
        | "resume_failed";
      interface Task {
        id: string;
        project_ids: string[];
        title: string;
        body: string;
        stage: string;
        type_id?: string;
        stage_assignments: Record<string, string>;
        status?: RunStatus;
        // Older daemons only; lib/approvals.ts reads both flags and approvals.
        flags?: LegacyFlag[];
        approvals?: Approval[];
        pending_approvals?: number;
        status_reason?: string;
        open_questions?: number;
        questions?: TaskQuestion[];
        comments?: any[];
        attachments?: Attachment[];
        pr_urls?: Record<string, string>;
        branch_name?: string;
        updated_at?: string;
        created_at?: string;
        current_run_id?: string;
        // Only GET /tasks/{id} fills it; undefined on every board card.
        run_alive?: boolean;
        can_steer?: boolean;
        orphan_agents?: OrphanAgent[];
        tags?: string[];
        priority?: string;
        parent_id?: string;
        board_id?: string;
        children?: Task[];
        child_count?: number;
        sort_order?: number;
        archived_at?: string;
        is_blocked?: boolean;
        blocked_by_count?: number;
        blocked_by?: any[];
        blocking?: any[];
        test_cases?: TestCase[];
      }
      interface AgentType {
        name: string;
        type: string;
        valid_stages?: string[];
        description?: string;
        mcp_by_stage?: Record<string, string[]>;
      }

      let stages: Stage[] = [];
      let boards: Board[] = [];
      let taskTypes: TaskType[] = [];
      let view: BoardView = defaultView();
      let mayDeleteTasks = true;
      let mayWriteTasks = true;
      let currentBoard = "";
      let agentTypes: AgentType[] = [];
      let agentTypesLoaded = false;
      let projects: Project[] = [];
      let allTasks: Task[] = [];
      let tasks: Task[] = [];
      let grouped: Grouped<Task> = { top: [], children: new Map() };
      let activeTask: Task | null = null;
      let parentTask: Task | null = null;
      let searchQuery = "";
      let suspendRefresh = 0; // Timestamp: background refresh is skipped until then, so a poll can't undo an optimistic update.
      const freshness = freshState();
      let instanceToContainer: Record<string, string> = {};

      const toast = makeToast(3200);

      async function bootstrap() {
        // allSettled: only /boards is needed to paint; a failed /types or /projects must not fail
        // bootstrap.
        const [boardsRes, typesRes, projsRes, prefsRes] = await Promise.allSettled([
          api.get<BoardsResponse>("/boards"),
          api.get<AgentType[]>("/types"),
          api.get<Project[]>("/projects"),
          loadPreferences(),
        ]);
        adoptTasksView(prefsRes);
        if (boardsRes.status === "rejected") throw boardsRes.reason;
        const boardsResp = boardsRes.value;
        agentTypes = typesRes.status === "fulfilled" ? typesRes.value || [] : [];
        agentTypesLoaded = typesRes.status === "fulfilled";
        projects = projsRes.status === "fulfilled" ? projsRes.value || [] : [];
        if (typesRes.status === "rejected") {
          toast(
            t("tasks.toasts.agents_load_failed", {
              error: String((typesRes.reason as Error)?.message ?? typesRes.reason),
            }),
            "err",
          );
        }
        if (projsRes.status === "rejected") {
          toast(
            t("tasks.toasts.projects_load_failed", {
              error: String((projsRes.reason as Error)?.message ?? projsRes.reason),
            }),
            "err",
          );
        }
        boards = boardsResp.boards;
        currentBoard = pickInitialBoard(boardsResp);
        loadView();
        applyLayout();
        renderBoardName();
        await loadBoardFlow(currentBoard);
        await mountBoardEditor();
        await refresh(true);
        const target = parseTaskHash(window.location.hash);
        if (target) openDrawer(target.taskId, target.caseKey);
        // openDrawer writes the hash itself, so its echo lands on the already-open task.
        window.addEventListener(
          "hashchange",
          () => {
            const next = parseTaskHash(window.location.hash);
            if (!next) return;
            const open = $("drawer").classList.contains("open") && activeTask?.id === next.taskId;
            if (!open) openDrawer(next.taskId, next.caseKey);
            else if (next.caseKey) revealHashKey(next.caseKey);
          },
          { signal },
        );
        // After the projects load, so the modal's project list is not empty.
        if (takeNewParam()) openNewModal();
      }

      async function refresh(force = false) {
        if (!force && Date.now() < suspendRefresh) return;
        // Board-scoped: a stage id can belong to several boards.
        // Don't swallow the rejection here: startPoller derives its backoff from it (see pollTick).
        try {
          allTasks = await keepFresh({
            current: allTasks,
            freshness,
            fetch: () =>
              api.get<Task[]>(
                `/tasks?board=${encodeURIComponent(currentBoard)}&include_subtasks=true`,
              ),
          });
          regroup();
        } catch {
          // Swallowed for user-action callers; pollTick re-throws for the poller's backoff.
          renderStaleBanner();
          renderBoard();
          return;
        }
        renderStaleBanner();
        renderBoard();

        if (!activeTask) return;
        // Fetched by id: a drawer opened from a link can show a task from another board.
        const openID = activeTask.id;
        const drawer = $("drawer");
        const focusInsideDrawer = !force && drawer.contains(document.activeElement);
        try {
          activeTask = await api.get<Task>(`/tasks/${openID}`);
        } catch {
          return;
        }
        if (activeTask.parent_id) await loadParent(activeTask.parent_id);
        if (activeTask?.id !== openID) return;
        renderDrawerContents({ skipOverviewIfDirty: !force, focusInsideDrawer });
        loadOverviewUsage();
        if (liveView) openLiveView();
      }

      // Re-throws what refresh() absorbs: startPoller backs off only on a rejection.
      async function pollTick() {
        await refresh();
        if (freshness.stale) {
          throw new Error(freshness.lastError || t("tasks.errors.refresh_failed"));
        }
      }

      function pickInitialBoard(resp: BoardsResponse): string {
        return pickBoardID(resp.boards, {
          fromURL: new URLSearchParams(window.location.search).get("board"),
          remembered: localStorage.getItem("octopus.board"),
          fallback: resp.default,
        });
      }

      function renderStaleBanner() {
        const bar = $("stale-banner") as HTMLElement;
        const msg = staleNotice(freshness);
        bar.hidden = msg === "";
        if (msg) setText($("stale-text"), msg);
      }

      function renderBoardName() {
        const b = boards.find((x) => x.id === currentBoard);
        const el = $("board-title");
        if (document.activeElement !== el) setText(el, b?.label || currentBoard);
        document.dispatchEvent(
          new CustomEvent("octopus:board-changed", { detail: { id: currentBoard } }),
        );
      }

      bindDrawerResize($("drawer"), {
        storageKey: "octopus.drawerw",
        min: 380,
        // Always leave a strip of board visible so the page stays navigable without Esc.
        keep: 160,
        signal,
      });

      (function wireBoardTitleEditor() {
        const el = $("board-title") as HTMLElement;
        let savedValue = "";

        const saveIfChanged = async () => {
          const next = (el.textContent || "").trim();
          if (next === savedValue) {
            el.classList.remove("dirty");
            return;
          }
          if (!next) {
            toast(t("tasks.toasts.board_name_empty"), "err");
            el.textContent = savedValue;
            el.classList.remove("dirty");
            return;
          }
          const id = currentBoard;
          el.classList.add("saving");
          try {
            await api.patch(`/boards/${encodeURIComponent(id)}`, { label: next });
            savedValue = next;
            const b = boards.find((x) => x.id === id);
            if (b) b.label = next;
            document.dispatchEvent(new CustomEvent("octopus:boards-changed"));
            toast(t("tasks.toasts.board_renamed"), "ok", 1400);
          } catch (err) {
            toast(
              err instanceof ApiError
                ? t("tasks.toasts.board_rename_failed")
                : t("tasks.errors.network"),
              "err",
            );
            el.textContent = savedValue;
          } finally {
            el.classList.remove("saving", "dirty");
          }
        };

        el.addEventListener("focus", () => {
          savedValue = (el.textContent || "").trim();
          const r = document.createRange();
          r.selectNodeContents(el);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(r);
        });

        el.addEventListener("input", () => {
          el.classList.toggle("dirty", (el.textContent || "").trim() !== savedValue);
        });

        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            el.blur();
          } else if (e.key === "Escape") {
            e.preventDefault();
            el.textContent = savedValue;
            el.classList.remove("dirty");
            el.blur();
          }
        });

        el.addEventListener("blur", () => {
          if (el.classList.contains("dirty")) void saveIfChanged();
        });

        el.addEventListener("paste", (e) => {
          e.preventDefault();
          const text = (e.clipboardData?.getData("text/plain") || "").replace(/\s+/g, " ");
          document.execCommand("insertText", false, text);
        });
      })();

      async function switchBoard(id: string) {
        if (id === currentBoard) return;
        currentBoard = id;
        localStorage.setItem("octopus.board", id);
        const url = new URL(window.location.href);
        url.searchParams.set("board", id);
        replaceURL(url);
        renderBoardName();
        closeDrawer();
        closeCardMenu(false);
        cancelLift(false);
        loadView();
        blockerCache.clear();
        await loadBoardFlow(id);
        await refresh(true);
      }

      // Stages and types load together: a type's skips are stage ids of this board.
      async function loadBoardFlow(id: string) {
        stages = await api.get<Stage[]>(`/boards/${encodeURIComponent(id)}/stages`);
        colEd?.reset(id, stages);
        try {
          const resp = await api.get<{ task_types: TaskType[] }>(
            `/boards/${encodeURIComponent(id)}/types`,
          );
          taskTypes = (resp.task_types || []).map((t) => ({ ...t, skips: t.skips || [] }));
        } catch (err: unknown) {
          // "No types" changes the board (no icons, every column accepts every card), so mark it
          // stale instead.
          taskTypes = [];
          freshness.stale = true;
          freshness.lastError = err instanceof Error ? err.message : String(err);
          renderStaleBanner();
        }
        pruneViewTypes();
        renderToolbar();
      }

      function loadView() {
        let raw: string | null = null;
        try {
          raw = localStorage.getItem(viewKey(currentBoard));
        } catch {
          // No storage: the default view.
        }
        view = parseView(raw);
      }
      function saveView() {
        try {
          localStorage.setItem(viewKey(currentBoard), JSON.stringify(view));
        } catch {
          // Not remembered; the board still filters.
        }
      }
      function setView(patch: Partial<BoardView>) {
        view = { ...view, ...patch };
        saveView();
        renderBoard();
      }
      function pruneViewTypes() {
        const known = (id: string) =>
          id === "" ? taskTypes.length > 0 : taskTypes.some((x) => x.id === id);
        const types = view.types.filter(known);
        if (types.length !== view.types.length) view = { ...view, types };
      }

      // ── Layout: the board's columns or a list ─────────────────────────────────────────────────
      // The choice belongs to the person (GET/PUT /me/preferences) and this browser keeps a copy,
      // so the page opens in it even before, or without, the daemon's answer.
      const localStore: Storage | null = (() => {
        try {
          return window.localStorage;
        } catch {
          return null;
        }
      })();
      let tasksView: TasksViewPref = readCachedTasksView(localStore);
      let tasksViewSaveWarned = false;
      const tasksViewSaver = preferenceSaver<TasksViewPref>(TASKS_VIEW_PREF, {
        onError: (err) => {
          // A key session has no person to remember it for; the page still shows the choice.
          if (err instanceof ApiError && err.status === 403) return;
          if (tasksViewSaveWarned) return;
          tasksViewSaveWarned = true;
          toast(
            t("tasks.list.save_failed", {
              error: err instanceof Error ? err.message : String(err),
            }),
            "err",
          );
        },
      });
      window.addEventListener("pagehide", () => tasksViewSaver.flush(), { signal });

      function adoptTasksView(res: PromiseSettledResult<Record<string, unknown>>) {
        // Unreachable: keep this browser's copy.
        if (res.status !== "fulfilled") return;
        const stored = res.value[TASKS_VIEW_PREF];
        if (stored === undefined) {
          // Chosen in this browser before the account kept it: the account takes it over.
          if (!sameTasksView(tasksView, defaultTasksView())) tasksViewSaver.save(tasksView);
          return;
        }
        tasksView = parseTasksView(stored);
        cacheTasksView(localStore, tasksView);
      }

      function listLayout(): boolean {
        return tasksView.layout === "list";
      }

      function setTasksView(patch: Partial<TasksViewPref>) {
        const next = { ...tasksView, ...patch };
        // Grouped by stage, a stage sort changes nothing; drop it rather than keep a dead arrow.
        if (next.group === "stage" && next.sort === "stage") {
          next.sort = "";
          next.dir = "asc";
        }
        if (sameTasksView(next, tasksView)) return;
        const layoutChanged = next.layout !== tasksView.layout;
        tasksView = next;
        cacheTasksView(localStore, next);
        tasksViewSaver.save(next);
        if (layoutChanged) applyLayout();
        renderBoard();
      }

      function toggleLayout() {
        const next = listLayout() ? "board" : "list";
        setTasksView({ layout: next });
        boardSay(next === "list" ? t("tasks.list.live.list") : t("tasks.list.live.board"));
      }

      let boardsEditable = false;
      function applyLayout() {
        const list = listLayout();
        if (list && colEd?.editing) setBoardEditing(false);
        $("board-page").dataset.layout = tasksView.layout;
        setSegmentedValue($("layout-switch"), tasksView.layout);
        $("group-wrap").hidden = !list;
        $("stage-tabs").hidden = list;
        $("edit-board-btn").hidden = list || !boardsEditable;
        const hmEdit = $("head-menu").querySelector<HTMLElement>('[data-hm="edit"]');
        if (hmEdit) hmEdit.hidden = list || !boardsEditable;
      }

      // The board's cards or the list's rows: whichever is on screen.
      function surface(): HTMLElement {
        return listLayout() ? $("task-list") : $("board");
      }
      function itemSelector(id: string): string {
        return listLayout()
          ? `.tl-row[data-id="${CSS.escape(id)}"] .tl-open`
          : `.task-card[data-id="${CSS.escape(id)}"]`;
      }

      function groupMenuHTML(): string {
        const item = (group: "stage" | "none", title: string, sub: string): MenuEntry => ({
          title,
          sub,
          checked: tasksView.group === group,
          attrs: { "data-group": group },
        });
        return menuItemsHTML([
          item("none", t("tasks.toolbar.group_none"), t("tasks.toolbar.group_none_sub")),
          item("stage", t("tasks.toolbar.group_stage"), t("tasks.toolbar.group_stage_sub")),
        ]);
      }

      let listWired = false;
      function listTable(): HTMLTableElement {
        const root = $("task-list");
        let table = root.querySelector<HTMLTableElement>(":scope > table");
        if (!table) {
          root.innerHTML =
            `<table class="list-table tl-table" aria-label="${esc(t("tasks.list.label"))}"><thead></thead></table>` +
            emptyStateHTML({
              icon: "list",
              body: t("tasks.list.empty"),
              cls: "tl-empty",
              attrs: { hidden: true },
            });
          table = root.querySelector<HTMLTableElement>(":scope > table") as HTMLTableElement;
        }
        return table;
      }

      function renderList() {
        ensureListWired();
        const table = listTable();
        table.classList.toggle("tl-grouped", tasksView.group === "stage");
        paint(table.tHead, listHeadHTML(tasksView));
        const groups = listGroups(cardsOnBoard(), stages, tasksView, onBoard, {
          stageIndex: (id) => stages.findIndex((s) => s.id === id),
          isTerminal: isTerminalStage,
        });
        // A filter that leaves nothing is #board-empty's; this is a board with no tasks at all.
        table.hidden = groups.length === 0;
        const empty = $("task-list").querySelector<HTMLElement>(".tl-empty");
        if (empty) empty.hidden = groups.length > 0;
        const hits = narrowing(view, searchQuery) ? boardMatch.kids : null;
        const expanded = new Set(view.expanded);
        const refocus = rememberRowFocus();
        reconcile<ListGroupModel<Task>>({
          container: table,
          items: groups,
          key: (g) => g.id,
          create: (g) => {
            const body = document.createElement("tbody");
            updateListGroup(body, g, hits, expanded);
            return body;
          },
          update: (body, g) => updateListGroup(body, g, hits, expanded),
        });
        refocus?.();
      }

      function updateListGroup(
        body: HTMLElement,
        g: ListGroupModel<Task>,
        hits: ReadonlyMap<string, ReadonlySet<string>> | null,
        expanded: ReadonlySet<string>,
      ) {
        const folded = g.stage ? groupFolded(view.listFolded, g) : false;
        let head = body.querySelector<HTMLElement>(":scope > .tl-group-row");
        if (g.stage) {
          if (!head) {
            head = document.createElement("tr");
            head.className = "group-head-row tl-group-row";
            body.prepend(head);
          }
          keepFocus(head, () =>
            paint(
              head,
              listGroupHeadHTML({
                id: g.id,
                label: g.stage?.label || g.id,
                color: g.stage?.color,
                count: g.tasks.length,
                folded,
              }),
            ),
          );
        } else head?.remove();
        reconcile<ListRowModel<Task>>({
          container: body,
          items: folded ? [] : listRows(g.tasks, grouped.children, view.mode, expanded, hits),
          key: rowKey,
          create: (r) => {
            const tr = document.createElement("tr");
            updateListRow(tr, r);
            return tr;
          },
          update: (tr, r) => updateListRow(tr, r),
        });
      }

      function updateListRow(tr: HTMLElement, r: ListRowModel<Task>) {
        const x = r.task;
        const stage = stageInfo(x.stage);
        const terminal = !!stage?.terminal;
        const init = initialStage();
        const kids = grouped.children.get(x.id) ?? [];
        const parent = x.parent_id ? taskByID(x.parent_id) : undefined;
        const kidStates =
          view.mode === "nested" && r.depth === 0
            ? kids.map((c) => subtaskState(c, isTerminalStage, init))
            : [];
        const stateRow = cardStateRow(x, {
          terminal,
          kids: kidStates.length
            ? {
                question: kidStates.filter((k) => k === "question").length,
                failed: kidStates.filter((k) => k === "failed").length,
                blocked: kidStates.filter((k) => k === "blocked").length,
              }
            : undefined,
        });
        const n = Number(x.blocked_by_count) || 0;
        const blockers = blockerCache.get(x.id)?.blockers ?? [];
        const when = x.updated_at || x.created_at || "";
        const row = {
          id: x.id,
          href: taskLink(x.id),
          title: x.title,
          depth: r.depth,
          kids: r.kids,
          open: r.open,
          match: r.match,
          typeHTML: typeIconHTML(taskTypes, x.type_id),
          partOf: view.mode === "cards" && parent ? parent.title : "",
          blocked: isBlockedCard(x, init)
            ? blockedLabel(
                n,
                blockers.map((b) => b.title || shortId(b.task_id)),
              )
            : "",
          stage: { id: x.stage, label: stage?.label ?? x.stage, color: stage?.color },
          canMove: mayWriteTasks,
          // The reason is a sentence; the list keeps the row to one line and the drawer says it.
          stateHTML: cardStateHTML(stateRow ? { ...stateRow, reason: "" } : null),
          priority: x.priority,
          agent: terminal ? "" : (x.stage_assignments?.[x.stage] ?? ""),
          repos: (x.project_ids || []).map(projectName),
          tags: x.tags ?? [],
          progressHTML: cardProgressHTML(
            kids.length ? subtaskProgress(kids, isTerminalStage, init) : null,
          ),
          age: agoLabel(when),
          updatedISO: when,
        };
        tr.className = listRowClasses(row);
        tr.dataset.id = x.id;
        keepFocus(tr, () => paint(tr, listRowCellsHTML(row)));
        setAttr(
          tr.querySelector("[data-card-menu]"),
          "aria-expanded",
          String(cmTask === x.id && !cmFromStage),
        );
        setAttr(
          tr.querySelector("[data-row-stage]"),
          "aria-expanded",
          String(cmTask === x.id && cmFromStage),
        );
      }

      // A new stage or sort moves the row, and moving an element drops its focus: note which control
      // of which row had it and put it back once the list is painted.
      function rememberRowFocus(): (() => void) | null {
        const active = document.activeElement as HTMLElement | null;
        const tr = active?.closest<HTMLElement>("tr.tl-row");
        if (!active || !tr || !$("task-list").contains(tr)) return null;
        const id = tr.dataset.id ?? "";
        const which = focusKeyOf(active);
        return () => {
          const row = $("task-list").querySelector<HTMLElement>(
            `tr.tl-row[data-id="${CSS.escape(id)}"]`,
          );
          const target = row?.querySelector<HTMLElement>(which) ?? row?.querySelector("a");
          if (!target || document.activeElement === target) return;
          target.focus({ preventScroll: true });
          target.scrollIntoView({ block: "nearest" });
        };
      }

      // A live update repaints a row while someone is on it; put them back on the same control.
      function keepFocus(el: HTMLElement, repaint: () => boolean) {
        const active = document.activeElement as HTMLElement | null;
        const inside = !!active && el.contains(active);
        const which = inside ? focusKeyOf(active as HTMLElement) : "";
        if (!repaint() || !inside) return;
        const target =
          el.querySelector<HTMLElement>(which) ?? el.querySelector<HTMLElement>(FOCUSABLE);
        target?.focus({ preventScroll: true });
      }
      const FOCUSABLE = "a, button"; // i18n-ignore a CSS selector
      function focusKeyOf(el: HTMLElement): string {
        for (const a of [
          "data-open-row",
          "data-row-stage",
          "data-card-menu",
          "data-row-expand",
          "data-fold",
        ]) {
          if (el.hasAttribute(a)) return `[${a}]`;
        }
        return FOCUSABLE;
      }

      function listRowIDs(): string[] {
        return Array.from(
          $("task-list").querySelectorAll<HTMLElement>("tbody > tr.tl-row[data-id]"),
        ).map((tr) => tr.dataset.id ?? "");
      }

      function toggleListGroup(id: string) {
        const g = { id, stage: stageInfo(id) ?? null, tasks: [] };
        setView({ listFolded: { ...view.listFolded, [id]: !groupFolded(view.listFolded, g) } });
      }

      function ensureListWired() {
        if (listWired) return;
        listWired = true;
        const root = $("task-list");
        root.addEventListener(
          "click",
          (e) => {
            const el = e.target as HTMLElement;
            const fold = el.closest<HTMLElement>("[data-fold]");
            if (fold) return toggleListGroup(fold.dataset.fold ?? "");
            const sortBtn = el.closest<HTMLElement>("th[data-sort] > button");
            if (sortBtn) {
              const key = (sortBtn.parentElement as HTMLElement).dataset.sort as ListSortKey;
              setTasksView(nextSort(tasksView, key));
              root
                .querySelector<HTMLElement>(`th[data-sort="${CSS.escape(key)}"] > button`)
                ?.focus();
              return;
            }
            const tr = el.closest<HTMLElement>("tr.tl-row");
            if (!tr) return;
            const id = tr.dataset.id ?? "";
            const menuBtn = el.closest<HTMLElement>("[data-card-menu]");
            if (menuBtn) {
              e.stopPropagation();
              if (cmTask === id && !cmFromStage) closeCardMenu();
              else openCardMenu(id, menuBtn);
              return;
            }
            const stageBtn = el.closest<HTMLElement>("[data-row-stage]");
            if (stageBtn) {
              e.stopPropagation();
              if (cmTask === id && cmFromStage) closeCardMenu();
              else openCardMenu(id, stageBtn, "move", null, { fromStage: true });
              return;
            }
            if (el.closest("[data-row-expand]")) {
              toggleExpanded(id);
              root
                .querySelector<HTMLElement>(
                  `tr.tl-row[data-id="${CSS.escape(id)}"] [data-row-expand]`,
                )
                ?.focus();
              return;
            }
            const link = el.closest<HTMLAnchorElement>("a.tl-open");
            // A modified click is the browser's: a new tab or window on the task's link.
            if (link && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0))
              return;
            if (!link && el.closest("a, button, input, select, textarea")) return;
            e.preventDefault();
            void openFromBoard(id);
          },
          { signal },
        );
        root.addEventListener(
          "contextmenu",
          (e) => {
            const tr = (e.target as HTMLElement).closest<HTMLElement>("tr.tl-row");
            if (!tr) return;
            e.preventDefault();
            const point = e.clientX || e.clientY ? { x: e.clientX, y: e.clientY } : null;
            openCardMenu(
              tr.dataset.id ?? "",
              tr.querySelector<HTMLElement>("[data-card-menu]") ?? tr,
              "main",
              point,
            );
          },
          { signal },
        );
        root.addEventListener(
          "keydown",
          (e) => {
            const link = (e.target as HTMLElement).closest<HTMLElement>("a.tl-open");
            if (!link || e.metaKey || e.ctrlKey || e.altKey) return;
            const id = link.dataset.openRow ?? "";
            const handled = (fn: () => void) => {
              e.preventDefault();
              e.stopPropagation();
              fn();
            };
            const menuBtn =
              link.closest("tr")?.querySelector<HTMLElement>("[data-card-menu]") ?? link;
            if (e.key === "ArrowUp" || e.key === "ArrowDown") {
              const next = neighborRow(listRowIDs(), id, e.key);
              return handled(() => {
                if (next) focusCard(next);
              });
            }
            if (e.key === "." || (e.key === "F10" && e.shiftKey))
              return handled(() => openCardMenu(id, menuBtn));
            if (e.key === "m" || e.key === "M")
              return handled(() => openCardMenu(id, menuBtn, "move"));
            if (e.key === "p" || e.key === "P")
              return handled(() => openCardMenu(id, menuBtn, "priority"));
          },
          { signal },
        );
        root.addEventListener(
          "scroll",
          () => {
            if (cmTask) placeCardMenu();
          },
          { passive: true, signal },
        );
      }

      function regroup() {
        grouped = groupChildren(allTasks);
        tasks = grouped.top;
      }
      function taskByID(id: string): Task | undefined {
        return allTasks.find((x) => x.id === id);
      }
      function cardsOnBoard(): Task[] {
        return boardCards(grouped, allTasks, view.mode);
      }
      let boardMatch: BoardMatch = { cards: new Set(), kids: new Map() };
      function onBoard(x: Task): boolean {
        return boardMatch.cards.has(x.id);
      }
      function stageLabel(id: string): string {
        return stageInfo(id)?.label || id;
      }

      const painted = new WeakMap<Element, string>();
      function paint(el: Element | null, html: string): boolean {
        if (!el || painted.get(el) === html) return false;
        el.innerHTML = html;
        painted.set(el, html);
        return true;
      }

      function stageInfo(id: string): Stage | undefined {
        return stages.find((s) => s.id === id);
      }
      function projectName(id: string): string {
        return projects.find((p) => p.id === id)?.name || "—";
      }
      function uploadProjectIDs(x: Task): string[] {
        return (x.project_ids || []).filter(
          (id) => projects.find((p) => p.id === id)?.source === "upload",
        );
      }
      function hasGitHubProject(x: Task): boolean {
        const ids = x.project_ids || [];
        return ids.length === 0 || uploadProjectIDs(x).length < ids.length;
      }

      function matchesFilters(x: Task): boolean {
        if (!matchesTypeFilter(new Set(view.types), x.type_id)) return false;
        if (view.blocked && !isBlockedCard(x, initialStage())) return false;
        if (view.needsYou && !needsYou(x)) return false;
        return matchesSearch(x);
      }

      function matchesSearch(x: Task): boolean {
        return matchesTaskSearch(searchQuery, {
          title: x.title,
          projectNames: (x.project_ids || []).map(projectName),
          agent: x.stage_assignments?.[x.stage],
          id: x.id,
        });
      }

      function modeMenuHTML(): string {
        const item = (mode: "nested" | "cards", title: string, sub: string): MenuEntry => ({
          title,
          sub,
          checked: view.mode === mode,
          attrs: { "data-mode": mode },
        });
        return menuItemsHTML([
          item("nested", t("tasks.toolbar.mode_nested"), t("tasks.toolbar.mode_nested_sub")),
          item("cards", t("tasks.toolbar.mode_cards"), t("tasks.toolbar.mode_cards_sub")),
        ]);
      }

      function renderToolbar() {
        $("type-wrap").hidden = taskTypes.length === 0;
        setText($("type-btn-label"), typeFilterLabel(taskTypes, view.types));
        $("type-btn").classList.toggle("is-active", view.types.length > 0);
        const typeMenu = $("type-menu");
        const focusedType = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>(
          "#type-menu [data-type]",
        )?.dataset.type;
        if (
          paint(typeMenu, typeFilterItemsHTML(taskTypes, view.types)) &&
          focusedType !== undefined
        )
          typeMenu.querySelector<HTMLElement>(`[data-type="${CSS.escape(focusedType)}"]`)?.focus();

        const init = initialStage();
        const blockedN = allTasks.filter((x) => isBlockedCard(x, init)).length;
        const needsN = allTasks.filter((x) => needsYou(x)).length;
        setAttr($("blocked-btn"), "aria-pressed", String(view.blocked));
        setCount($("blocked-count"), blockedN, { hideZero: true });
        setAttr($("needs-btn"), "aria-pressed", String(view.needsYou));
        setCount($("needs-count"), needsN, { hideZero: true });
        setText(
          $("mode-btn-label"),
          view.mode === "cards"
            ? t("tasks.toolbar.mode_cards_label")
            : t("tasks.toolbar.mode_nested_label"),
        );
        paint($("mode-menu"), modeMenuHTML());
        setText(
          $("group-btn-label"),
          tasksView.group === "none"
            ? t("tasks.toolbar.group_none_label")
            : t("tasks.toolbar.group_stage_label"),
        );
        paint($("group-menu"), groupMenuHTML());
        setSegmentedValue($("layout-switch"), tasksView.layout);
        const n = activeFilterCount(view);
        setCount($("filters-count"), n, { hideZero: true });
        $("filters-btn").classList.toggle("is-active", n > 0);
        if (isModalOpen($("filters-sheet"))) paintFiltersSheet(blockedN, needsN);
      }

      function paintFiltersSheet(blockedN: number, needsN: number) {
        const body = $("fs-body");
        const focused = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>(
          "#fs-body .check-input",
        );
        const focusKey = focused
          ? ["data-fs-type", "data-fs-toggle", "data-fs-mode", "data-fs-group"]
              .map((a) => (focused.hasAttribute(a) ? `[${a}="${focused.getAttribute(a)}"]` : ""))
              .join("")
          : "";
        const group = (id: string, title: string, o: CheckGroupOptions) =>
          `<section class="fs-group"><h3 class="fs-group-title" id="${id}">${esc(title)}</h3>${checkGroupHTML({ layout: "list", labelledBy: id, ...o })}</section>`;
        const count = (n: number) => esc(String(n));
        const types = taskTypes.length
          ? group("fs-types", t("tasks.toolbar.type"), {
              items: [
                ...taskTypes.map((x) => ({ id: x.id, label: x.label })),
                { id: "", label: t("lib.board.labels.untyped") },
              ].map((o) => ({
                label: o.label,
                checked: view.types.includes(o.id),
                inputAttrs: { "data-fs-type": o.id },
              })),
            })
          : "";
        const show = group("fs-show", t("tasks.toolbar.show"), {
          items: [
            {
              label: t("tasks.toolbar.blocked"),
              checked: view.blocked,
              trailingHTML: count(blockedN),
              inputAttrs: { "data-fs-toggle": "blocked" },
            },
            {
              label: t("tasks.toolbar.needs_you"),
              checked: view.needsYou,
              trailingHTML: count(needsN),
              inputAttrs: { "data-fs-toggle": "needs" },
            },
          ],
        });
        const modes = group("fs-modes", t("tasks.toolbar.subtasks"), {
          type: "radio",
          name: "fs-mode",
          items: [
            {
              value: "nested",
              label: t("tasks.toolbar.mode_nested"),
              checked: view.mode === "nested",
              inputAttrs: { "data-fs-mode": "nested" },
            },
            {
              value: "cards",
              label: t("tasks.toolbar.mode_cards"),
              checked: view.mode === "cards",
              inputAttrs: { "data-fs-mode": "cards" },
            },
          ],
        });
        const groupings = listLayout()
          ? group("fs-groups", t("tasks.toolbar.group"), {
              type: "radio",
              name: "fs-group",
              items: [
                {
                  value: "none",
                  label: t("tasks.toolbar.group_none"),
                  checked: tasksView.group === "none",
                  inputAttrs: { "data-fs-group": "none" },
                },
                {
                  value: "stage",
                  label: t("tasks.toolbar.group_stage"),
                  checked: tasksView.group === "stage",
                  inputAttrs: { "data-fs-group": "stage" },
                },
              ],
            })
          : "";
        if (paint(body, types + show + modes + groupings) && focusKey)
          body.querySelector<HTMLElement>(focusKey)?.focus();
      }

      const filtersSheet = bindModal($("filters-sheet"));
      function openFilters() {
        filtersSheet.open();
        renderToolbar();
      }
      function closeFilters(): boolean {
        if (!filtersSheet.isOpen()) return false;
        filtersSheet.close();
        return true;
      }

      function toggleType(id: string) {
        setView({
          types: view.types.includes(id) ? view.types.filter((x) => x !== id) : [...view.types, id],
        });
      }

      let archivedReading = 0;
      async function loadArchived(menu: HTMLElement, handle: MenuHandle, triggers: Element[]) {
        const reading = ++archivedReading;
        let rows: Task[];
        try {
          rows = await api.get<Task[]>(
            `/tasks?board=${encodeURIComponent(currentBoard)}&archived=true`,
          );
        } catch (err) {
          toast(err instanceof ApiError ? err.message : t("tasks.errors.network"), "err");
          if (reading === archivedReading) handle.close();
          return;
        }
        if (reading !== archivedReading || !handle.isOpen()) return;
        const at = document.activeElement;
        const ours = !at || at === document.body || menu.contains(at) || triggers.includes(at);
        menu.innerHTML = archivedMenuHTML(rows);
        if (ours) menuFocusables(menu)[0]?.focus();
      }
      function archivedMenuHTML(rows: Task[]): string {
        const head: MenuEntry = { head: t("tasks.archived.count", { count: rows.length }) };
        if (!rows.length)
          return menuItemsHTML([
            head,
            {
              slot: "empty",
              html: emptyStateHTML({ size: "sm", body: t("tasks.archived.empty") }),
            },
          ]);
        const row = (x: Task) =>
          `<div class="archived-row">${menuItemHTML({
            title: x.title,
            sub: `${stageLabel(x.stage)} · #${x.id.slice(0, 6)}`,
            cls: "archived-open",
            attrs: { "data-arch-open": x.id },
          })}${menuItemHTML({
            title: t("tasks.archived.restore"),
            cls: "archived-restore",
            keepOpen: true,
            attrs: { "data-arch-restore": x.id },
          })}</div>`;
        return menuItemsHTML([head, { slot: "rows", html: rows.map(row).join("") }]);
      }
      async function setArchived(id: string, archived: boolean): Promise<boolean> {
        try {
          suspendRefresh = Date.now() + 5_000;
          const updated = await api.patch<Task>(`/tasks/${id}`, { archived });
          toast(archived ? t("tasks.toasts.archived") : t("tasks.toasts.unarchived"), "ok", 1800);
          if (activeTask?.id === id) {
            if (archived) closeDrawer();
            else activeTask = { ...activeTask, archived_at: updated.archived_at };
          }
          suspendRefresh = 0;
          await refresh(true);
          return true;
        } catch (err) {
          suspendRefresh = 0;
          toast(
            err instanceof ApiError
              ? t("tasks.toasts.archive_failed", { error: err.message })
              : t("tasks.errors.network"),
            "err",
            4500,
          );
          return false;
        }
      }

      function wireToolbar() {
        const headBtn = $("head-menu-btn");
        const archBtn = $("archived-btn");
        const archMenu = $("archived-menu");
        bindMenu($("type-menu"), $("type-btn"), {
          focus: "checked",
          signal,
          onSelect: (item) => toggleType(item.dataset.type ?? ""),
        });
        bindMenu($("mode-menu"), $("mode-btn"), {
          focus: "checked",
          signal,
          onSelect: (item) => setView({ mode: item.dataset.mode === "cards" ? "cards" : "nested" }),
        });
        bindMenu($("group-menu"), $("group-btn"), {
          focus: "checked",
          signal,
          onSelect: (item) =>
            setTasksView({ group: item.dataset.group === "none" ? "none" : "stage" }),
        });
        $("layout-switch").addEventListener(
          "change",
          () => {
            const v = segmentedValue($("layout-switch"));
            if (v === "board" || v === "list") setTasksView({ layout: v });
          },
          { signal },
        );
        let archFromHead = false;
        const archived: MenuHandle = bindMenu(archMenu, archBtn, {
          signal,
          onOpen: () => {
            archMenu.innerHTML = menuItemsHTML([{ note: t("common.status.loading") }]);
            void loadArchived(archMenu, archived, [archBtn, headBtn]);
          },
          onClose: () => {
            if (archFromHead && document.activeElement === document.body) headBtn.focus();
            archFromHead = false;
          },
          onSelect: (item) => {
            const restore = item.dataset.archRestore;
            if (restore) {
              void setArchived(restore, false).then((ok) => {
                if (ok && archived.isOpen())
                  void loadArchived(archMenu, archived, [archBtn, headBtn]);
              });
              return;
            }
            const open = item.dataset.archOpen;
            if (open) void openDrawer(open);
          },
        });
        bindMenu($("head-menu"), headBtn, {
          signal,
          onSelect: (item) => {
            const hm = item.dataset.hm;
            if (hm === "edit") setBoardEditing(!colEd?.editing);
            else if (hm === "archived") {
              archFromHead = true;
              archived.open();
            } else if (hm === "kbd") openHelp();
          },
        });
        $("blocked-btn").addEventListener("click", () => setView({ blocked: !view.blocked }), {
          signal,
        });
        $("needs-btn").addEventListener("click", () => setView({ needsYou: !view.needsYou }), {
          signal,
        });
        $("filters-btn").addEventListener("click", openFilters, { signal });
        $("board-empty-clear").addEventListener(
          "click",
          () => {
            ($("search") as HTMLInputElement).value = "";
            searchQuery = "";
            setView({ types: [], blocked: false, needsYou: false });
          },
          { signal },
        );
        $("fs-body").addEventListener(
          "change",
          (e) => {
            const input = e.target as HTMLInputElement;
            const d = input.dataset;
            if (d.fsType !== undefined) {
              const rest = view.types.filter((x) => x !== d.fsType);
              setView({ types: input.checked ? [...rest, d.fsType] : rest });
            } else if (d.fsToggle === "blocked") setView({ blocked: input.checked });
            else if (d.fsToggle === "needs") setView({ needsYou: input.checked });
            else if (d.fsMode && input.checked)
              setView({ mode: d.fsMode === "cards" ? "cards" : "nested" });
            else if (d.fsGroup && input.checked)
              setTasksView({ group: d.fsGroup === "none" ? "none" : "stage" });
          },
          { signal },
        );
      }

      let boardWired = false;
      function ensureBoardWired() {
        if (boardWired) return;
        boardWired = true;
        const board = $("board");
        board.addEventListener("dragover", autoScrollOnDrag, { signal });
        board.addEventListener("click", onBoardClick, { signal });
        board.addEventListener("keydown", onBoardKey, { signal });
        board.addEventListener("contextmenu", onBoardContextMenu, { signal });
        board.addEventListener("mouseover", (e) => setGroupHL(groupOf(e.target as HTMLElement)), {
          signal,
        });
        board.addEventListener(
          "mouseleave",
          () => setGroupHL(groupOf(document.activeElement as HTMLElement | null)),
          { signal },
        );
        board.addEventListener("focusin", (e) => setGroupHL(groupOf(e.target as HTMLElement)), {
          signal,
        });
        board.addEventListener(
          "focusout",
          (e) => {
            if (!board.contains(e.relatedTarget as Node | null)) setGroupHL("");
          },
          { signal },
        );
        board.addEventListener(
          "scroll",
          () => {
            if (cmTask) placeCardMenu();
          },
          { capture: true, passive: true, signal },
        );
        board.addEventListener("scroll", onBoardScroll, { passive: true, signal });
        let lastW = 0;
        const ro = new ResizeObserver(() => {
          if (board.clientWidth === lastW) return;
          lastW = board.clientWidth;
          renderBoard();
        });
        ro.observe(board);
        signal.addEventListener("abort", () => ro.disconnect());
        phoneMQ.addEventListener("change", () => renderBoard(), { signal });
        $("stage-tabs").addEventListener(
          "click",
          (e) => {
            const tab = (e.target as HTMLElement).closest<HTMLElement>('[role="tab"]');
            if (tab) scrollToStage(tab.dataset.tab ?? "");
          },
          { signal },
        );
        $("stage-tabs").addEventListener(
          "keydown",
          (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            const ids = stages.map((s) => s.id);
            const at = ids.indexOf(tabStage);
            const next = ids[at + (e.key === "ArrowLeft" ? -1 : 1)];
            if (!next) return;
            e.preventDefault();
            scrollToStage(next);
            $("stage-tabs")
              .querySelector<HTMLElement>(`[role="tab"][data-tab="${CSS.escape(next)}"]`)
              ?.focus();
          },
          { signal },
        );
      }

      let colEd: ColumnEditor | null = null;

      async function mountBoardEditor() {
        const canEdit = await sessionMayEditBoards();
        const btn = $("edit-board-btn") as HTMLButtonElement;
        // Columns are edited on the board; applyLayout hides the button in the list.
        boardsEditable = canEdit;
        applyLayout();
        colEd = mountColumnEditor({
          root: $("board"),
          board: currentBoard,
          stages,
          signal,
          canEdit,
          render: (next) => {
            stages = next;
            renderBoard();
          },
          taskCount: (id) => allTasks.filter((x) => x.stage === id).length,
          agentPicker: projectAgentPicker({
            board: () => currentBoard,
            defaultBoard: defaultBoardID,
            projects: () => projects,
            setProjects: (list) => (projects = list as Project[]),
            agents: () => agentTypes,
            onChange: renderBoard,
          }),
          taskTypes: () => taskTypes.map((x) => ({ id: x.id, label: x.label })),
          toast,
          warnings: $("board-warnings"),
        });
        btn.addEventListener("click", () => setBoardEditing(!colEd?.editing));
      }

      function defaultBoardID(): string {
        return boards.find((b) => b.default)?.id ?? "";
      }

      function skipsOf(x: Task): Set<string> {
        return new Set(taskTypeOf(taskTypes, x.type_id)?.skips ?? []);
      }

      function boardProjectList(): Project[] {
        return boardProjects(projects, currentBoard, defaultBoardID());
      }

      function setBoardEditing(on: boolean) {
        if (!colEd) return;
        colEd.setEditing(on);
        const btn = $("edit-board-btn");
        btn.setAttribute("aria-pressed", String(on));
        const label = on ? t("lib.board_editor.board.done") : t("lib.board_editor.board.edit");
        setText($("edit-board-label"), label);
        setText($("head-menu-edit-title"), label);
        $("board-sub").hidden = !on;
        $("board-stats").hidden = on;
        renderBoard();
      }

      const phoneMQ = window.matchMedia("(max-width: 640px)");
      let boardDragging = false;
      let boardTight = false;

      function computeTight(visible: Map<string, number>): boolean {
        const board = $("board");
        const gap = parseFloat(getComputedStyle(board).columnGap) || 0;
        let strips = 0;
        for (const s of stages) {
          if (s.terminal) continue;
          const manual = view.collapsed[s.id];
          if (manual ?? ((visible.get(s.id) ?? 0) === 0 && !boardDragging)) strips++;
        }
        const open = stages.length - strips;
        return boardIsTight(board.clientWidth - strips * (COL_STRIP + gap), open, gap);
      }

      let staffed = new Set<string>();

      let reportedOpen = "";
      function reportOpenCount(open: number) {
        const key = `${currentBoard}:${open}`;
        if (key === reportedOpen) return;
        reportedOpen = key;
        document.dispatchEvent(
          new CustomEvent("octopus:board-count", { detail: { id: currentBoard, open } }),
        );
      }

      function renderBoard() {
        ensureBoardWired();
        const board = $("board");
        const wip = wipCounts(tasks, stageInfo);
        paint($("board-stats"), wipStatsHTML(wip));
        reportOpenCount(wip.open);
        board.classList.toggle("board-editing", !!colEd?.editing);

        loadCardBlockers();
        blocksMap = blocksCounts(blockerCache, allTasks);
        staffed = staffedColumns(
          allTasks,
          boardProjectList().map((p) => p.stage_template),
        );
        boardMatch = boardMatches(cardsOnBoard(), grouped.children, view.mode, matchesFilters);
        const visible = new Map<string, number>();
        for (const x of cardsOnBoard())
          if (onBoard(x)) visible.set(x.stage, (visible.get(x.stage) ?? 0) + 1);
        boardTight = computeTight(visible);
        const none =
          boardMatch.cards.size === 0 &&
          allTasks.length > 0 &&
          (activeFilterCount(view) > 0 || searchQuery !== "");
        const list = listLayout();
        board.hidden = none || list;
        $("task-list").hidden = none || !list;
        $("board-empty").hidden = !none;
        $("stage-tabs").classList.toggle("is-empty", none);

        if (list) {
          renderList();
          renderToolbar();
          return;
        }
        reconcile<Stage>({
          container: board,
          items: stages,
          key: (s) => s.id,
          create: createColumn,
          update: updateColumn,
        });
        colEd?.sync();
        renderToolbar();
        renderStageTabs(visible);
        applyGroupHL();
        markLiftTarget();
      }

      function createColumn(s: Stage): HTMLElement {
        const col = document.createElement("div");
        col.className = "col";
        col.dataset.stage = s.id;
        col.style.setProperty("--col-color", s.color);
        col.innerHTML = columnShellHTML(s);
        attachColumnDrop(col, s.id);
        attachColumnResize(col, s.id);
        updateColumn(col, s, null);
        return col;
      }

      const colWidthKey = () => `octopus.colw.${currentBoard}`;

      function colWidths(): Record<string, number> {
        try {
          return parseColumnWidths(localStorage.getItem(colWidthKey()));
        } catch {
          return {};
        }
      }

      function saveColWidth(stageID: string, w: number | null) {
        try {
          localStorage.setItem(
            colWidthKey(),
            JSON.stringify(withColumnWidth(colWidths(), stageID, w)),
          );
        } catch {
          // Not remembered; the column keeps its width until the page reloads.
        }
      }

      function applyColWidth(col: HTMLElement, stageID: string, collapsed: boolean) {
        if (col.dataset.resizing === "true") return;
        // The inline flex-basis would beat .collapsed, so a folded column drops its saved width.
        const w = collapsed ? undefined : colWidths()[stageID];
        col.classList.toggle("sized", w !== undefined);
        col.style.flexBasis = w !== undefined ? `${w}px` : "";
      }

      function attachColumnResize(col: HTMLElement, stageID: string) {
        const grip = document.createElement("div");
        grip.className = "col-resizer";
        grip.title = t("tasks.hints.drag_to_resize");
        grip.tabIndex = 0;
        grip.setAttribute("role", "separator");
        grip.setAttribute("aria-orientation", "vertical");
        grip.setAttribute("aria-label", t("tasks.board.resize_column"));
        col.appendChild(grip);

        let startX = 0;
        let startW = 0;
        const setWidth = (w: number) => {
          col.classList.add("sized");
          col.style.flexBasis = `${w}px`;
        };

        grip.addEventListener("pointerdown", (e: PointerEvent) => {
          e.preventDefault();
          e.stopPropagation();
          startX = e.clientX;
          startW = col.getBoundingClientRect().width;
          col.dataset.resizing = "true";
          document.body.classList.add("col-resizing");
          grip.setPointerCapture(e.pointerId);
        });

        grip.addEventListener("pointermove", (e: PointerEvent) => {
          if (col.dataset.resizing !== "true") return;
          setWidth(clampColumnWidth(startW + (e.clientX - startX)));
        });

        const endResize = (e: PointerEvent) => {
          if (col.dataset.resizing !== "true") return;
          delete col.dataset.resizing;
          document.body.classList.remove("col-resizing");
          if (grip.hasPointerCapture(e.pointerId)) grip.releasePointerCapture(e.pointerId);
          saveColWidth(stageID, clampColumnWidth(col.getBoundingClientRect().width));
        };
        grip.addEventListener("pointerup", endResize);
        grip.addEventListener("pointercancel", endResize);

        grip.addEventListener("dblclick", (e) => {
          e.stopPropagation();
          saveColWidth(stageID, null);
          col.classList.remove("sized");
          col.style.flexBasis = "";
        });

        grip.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
          e.preventDefault();
          const step = e.shiftKey ? 48 : 16;
          const w = clampColumnWidth(
            col.getBoundingClientRect().width + (e.key === "ArrowRight" ? step : -step),
          );
          setWidth(w);
          saveColWidth(stageID, w);
        });
      }

      function updateColumn(col: HTMLElement, s: Stage, _prev: Stage | null) {
        col.style.setProperty("--col-color", s.color);
        setText(col.querySelector<HTMLElement>(".col-title"), s.label);
        setText(col.querySelector<HTMLElement>(".col-strip-name"), s.label);

        const all = cardsOnBoard().filter((x) => x.stage === s.id);
        const visible = all.filter(onBoard);
        const count = columnCount(visible.length, all.length);
        setText(col.querySelector(".col-count"), count);

        const collapsed =
          !colEd?.editing &&
          !phoneMQ.matches &&
          columnCollapsed({
            manual: view.collapsed[s.id],
            visible: visible.length,
            terminal: !!s.terminal,
            dragging: boardDragging,
            tight: boardTight,
          });
        col.classList.toggle("collapsed", collapsed);
        applyColWidth(col, s.id, collapsed);
        const strip = col.querySelector<HTMLElement>(".col-strip");
        if (strip) {
          strip.hidden = !collapsed;
          setText(strip.querySelector(".col-strip-count"), String(visible.length));
          const name = columnStripLabel(s.label, visible.length);
          setAttr(strip, "aria-label", name);
          setAttr(strip, "title", name);
        }

        const addBtn = col.querySelector<HTMLElement>(".col-add");
        if (addBtn) addBtn.hidden = !mayWriteTasks || col.querySelector(".col-adding") !== null;

        const list = col.querySelector<HTMLElement>(".col-list");
        const cardsCt = col.querySelector<HTMLElement>(".col-cards");
        if (!list || !cardsCt) return;
        reconcile<Task>({
          container: list,
          items: visible,
          key: (x) => x.id,
          create: (x) => createCard(x, s),
          update: (el, x) => updateCard(el, x, s),
          skip: (el) => hasTaskCardFlag(el, "dragging"),
        });

        let empty = cardsCt.querySelector<HTMLElement>(":scope > .col-empty");
        if (visible.length === 0) {
          if (!empty) {
            const tpl = document.createElement("template");
            tpl.innerHTML = emptyStateHTML({
              size: "sm",
              dashed: true,
              body: "",
              cls: "col-empty",
            });
            empty = tpl.content.firstElementChild as HTMLElement;
            cardsCt.insertBefore(empty, list.nextSibling);
          }
          setText(empty.querySelector(".empty-state-body"), columnEmptyLabel(all.length, s.label));
        } else if (empty) {
          empty.remove();
        }
      }

      function createCard(x: Task, stage: Stage): HTMLElement {
        const card = taskCardEl({ id: x.id });
        attachCardDrag(card, x.id);
        updateCard(card, x, stage);
        return card;
      }

      function updateCard(card: HTMLElement, x: Task, stage: Stage) {
        const init = initialStage();
        const kids = grouped.children.get(x.id) ?? [];
        const parent = x.parent_id ? taskByID(x.parent_id) : undefined;

        const part = card.querySelector<HTMLElement>(".task-card-part");
        const partHTML = view.mode === "cards" && parent ? partOfHTML(parent.title) : "";
        paint(part, partHTML);
        if (part) part.hidden = partHTML === "";

        const typeSlot = card.querySelector<HTMLElement>(".task-card-type");
        paint(typeSlot, typeIconHTML(taskTypes, x.type_id));
        setText(card.querySelector(".task-card-title"), x.title);
        paint(card.querySelector(".task-card-prio"), priorityIconHTML(x.priority));

        const kidStates = kids.map((c) => subtaskState(c, isTerminalStage, init));
        const kidsNeed =
          view.mode === "nested" && kids.length
            ? {
                question: kidStates.filter((k) => k === "question").length,
                failed: kidStates.filter((k) => k === "failed").length,
                blocked: kidStates.filter((k) => k === "blocked").length,
              }
            : undefined;
        const state = card.querySelector<HTMLElement>(".task-card-state");
        const stateRow = cardStateRow(x, {
          terminal: !!stage.terminal,
          agent: x.stage_assignments?.[x.stage],
          kids: kidsNeed,
        });
        const stateHTML = cardStateHTML(stateRow);
        paint(state, stateHTML);
        if (state) state.hidden = stateHTML === "";

        const n = Number(x.blocked_by_count) || 0;
        const blockers = blockerCache.get(x.id)?.blockers ?? [];
        const meta = card.querySelector<HTMLElement>(".task-card-meta");
        const metaHTML = cardMetaHTML({
          repos: (x.project_ids || []).map(projectName),
          tags: x.tags ?? [],
          blocked: isBlockedCard(x, init)
            ? blockedLabel(
                n,
                blockers.map((b) => b.title || shortId(b.task_id)),
              )
            : "",
          blocks: blocksMap.get(x.id) ?? 0,
          next: showsNextAgent(stateRow) ? nextAgent(x, stages, staffed, skipsOf(x)) : null,
        });
        paint(meta, metaHTML);
        if (meta) meta.hidden = metaHTML === "";

        paint(
          card.querySelector(".task-card-progress"),
          cardProgressHTML(kids.length ? subtaskProgress(kids, isTerminalStage, init) : null),
        );
        const expand = card.querySelector<HTMLElement>(".task-card-expand");
        const rowsEl = card.querySelector<HTMLElement>(".task-card-kids");
        const canExpand = view.mode === "nested" && kids.length > 0;
        const hits = narrowing(view, searchQuery) ? boardMatch.kids.get(x.id) : undefined;
        const open = canExpand && (view.expanded.includes(x.id) || !!hits);
        if (expand) {
          expand.hidden = !canExpand;
          setAttr(expand, "aria-expanded", String(open));
          const name = open
            ? t("lib.task_card.labels.hide_subtasks")
            : t("lib.task_card.labels.show_subtasks", { count: kids.length });
          setAttr(expand, "aria-label", name);
          setAttr(expand, "title", name);
        }
        if (rowsEl) {
          rowsEl.hidden = !open;
          paint(
            rowsEl,
            open
              ? nestedRowsHTML(
                  kids.map((c, i) => {
                    const st = kidStates[i];
                    const si = stageInfo(c.stage);
                    return {
                      id: c.id,
                      title: c.title,
                      state: st,
                      iconHTML: subtaskStateIconHTML(st),
                      stateLabel: subtaskStateLabel(st),
                      stageLabel: si?.label ?? c.stage,
                      stageColor: si?.color ?? "",
                      match: !!hits?.has(c.id),
                    };
                  }),
                )
              : "",
          );
        }
        paint(
          card.querySelector(".task-card-foot-rest"),
          cardFootHTML({
            id: x.id,
            prs: cardPRs(x.pr_urls),
            age: agoLabel(x.updated_at || x.created_at),
          }),
        );

        setAttr(
          card.querySelector(".task-card-menu-btn"),
          "aria-label",
          t("lib.task_card.labels.actions_for", { title: x.title }),
        );
        card.dataset.group = parent ? parent.id : kids.length ? x.id : "";
        setTaskCardFlag(card, "lifted", lift?.id === x.id);
      }

      const blockerCache: BlockerCache = new Map();
      const blockerAsked = new Set<string>();
      let blocksMap = new Map<string, number>();
      function loadCardBlockers() {
        pruneBlockers(blockerCache, new Set(allTasks.map((x) => x.id)));
        const init = initialStage();
        for (const x of allTasks) {
          if (!isBlockedCard(x, init) || !needsBlockerFetch(blockerCache, x)) continue;
          const n = Number(x.blocked_by_count) || 0;
          const ask = `${currentBoard}:${x.id}:${n}`;
          if (blockerAsked.has(ask)) continue;
          blockerAsked.add(ask);
          api
            .get<{ blocked_by?: DepRef[] }>(`/tasks/${x.id}/dependencies`)
            .then((res) => {
              blockerCache.set(x.id, blockerEntry(n, res.blocked_by, isTerminalStage));
              renderBoard();
            })
            .catch(() => {
              // The card says "Blocked by 1 task" without the name.
            });
        }
      }

      let hlGroup = "";
      function groupOf(el: HTMLElement | null): string {
        return el?.closest<HTMLElement>("#board .task-card")?.dataset.group ?? "";
      }
      function applyGroupHL() {
        const on = view.mode === "cards" && hlGroup !== "";
        $("board")
          .querySelectorAll<HTMLElement>(".task-card")
          .forEach((c) => {
            const inGroup = c.dataset.group === hlGroup;
            setTaskCardFlag(c, "hl", on && inGroup);
            setTaskCardFlag(c, "dim", on && !inGroup);
          });
      }
      function setGroupHL(g: string) {
        if (g === hlGroup) return;
        hlGroup = g;
        applyGroupHL();
      }

      let tabStage = "";
      function renderStageTabs(visible: Map<string, number>) {
        if (!stages.some((s) => s.id === tabStage)) tabStage = stages[0]?.id ?? "";
        paint($("stage-tabs"), stageTabsHTML(stages, Object.fromEntries(visible), tabStage));
      }
      function scrollToStage(id: string) {
        tabStage = id;
        renderBoard();
        $("board")
          .querySelector<HTMLElement>(`.col[data-stage="${CSS.escape(id)}"]`)
          ?.scrollIntoView({ inline: "start", block: "nearest", behavior: scrollBehavior() });
      }
      let scrollFrame = 0;
      function onBoardScroll() {
        if (!phoneMQ.matches || scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
          scrollFrame = 0;
          const board = $("board");
          const left =
            board.getBoundingClientRect().left + parseFloat(getComputedStyle(board).paddingLeft);
          let best = "";
          let dist = Infinity;
          board.querySelectorAll<HTMLElement>(":scope > .col").forEach((c) => {
            const d = Math.abs(c.getBoundingClientRect().left - left);
            if (d < dist) {
              dist = d;
              best = c.dataset.stage ?? "";
            }
          });
          if (!best || best === tabStage) return;
          tabStage = best;
          renderStageTabs(
            new Map(
              stages.map((s) => [
                s.id,
                cardsOnBoard().filter((x) => x.stage === s.id && onBoard(x)).length,
              ]),
            ),
          );
          $("stage-tabs")
            .querySelector<HTMLElement>(`[role="tab"][data-tab="${CSS.escape(best)}"]`)
            ?.scrollIntoView({ inline: "nearest", block: "nearest" });
        });
      }

      let returnFocus = "";
      function openFromBoard(id: string, sel = ""): Promise<void> {
        returnFocus = sel || itemSelector(id);
        return openDrawer(id);
      }
      function focusCard(id: string) {
        const el = surface().querySelector<HTMLElement>(itemSelector(id));
        if (!el) return;
        el.focus({ preventScroll: true });
        el.scrollIntoView({ block: "nearest", inline: "nearest", behavior: scrollBehavior() });
      }

      function toggleColumn(col: HTMLElement, fold: boolean) {
        const id = col.dataset.stage ?? "";
        setView({ collapsed: { ...view.collapsed, [id]: fold } });
        col.querySelector<HTMLElement>(fold ? ".col-strip" : ".col-fold")?.focus();
      }

      function toggleExpanded(id: string) {
        const on = !view.expanded.includes(id);
        setView({
          expanded: on ? [...view.expanded, id] : view.expanded.filter((x) => x !== id),
        });
      }

      function onBoardClick(e: MouseEvent) {
        const el = e.target as HTMLElement;
        const col = el.closest<HTMLElement>(".col");
        if (el.closest("[data-col-fold]") && col) return toggleColumn(col, true);
        if (el.closest("[data-col-unfold]") && col) return toggleColumn(col, false);
        const add = el.closest<HTMLElement>(".col-add");
        if (add) {
          e.stopPropagation();
          if (mayWriteTasks) startInlineCreate(add.dataset.addStage ?? "", add);
          return;
        }
        const card = el.closest<HTMLElement>(".task-card");
        if (!card || lift) return;
        const id = card.dataset.id ?? "";
        const menuBtn = el.closest<HTMLElement>("[data-card-menu]");
        if (menuBtn) {
          e.stopPropagation();
          if (cmTask === id) closeCardMenu();
          else openCardMenu(id, menuBtn);
          return;
        }
        if (el.closest("[data-card-expand]")) return toggleExpanded(id);
        const sub = el.closest<HTMLElement>("[data-open-sub]");
        if (sub) {
          const subID = sub.dataset.openSub ?? "";
          void openFromBoard(subID, `[data-open-sub="${CSS.escape(subID)}"]`);
          return;
        }
        if (el.closest("a, .task-card-tools")) return;
        void openFromBoard(id);
      }

      function onBoardContextMenu(e: MouseEvent) {
        const card = (e.target as HTMLElement).closest<HTMLElement>(".task-card");
        if (!card || lift) return;
        e.preventDefault();
        const point = e.clientX || e.clientY ? { x: e.clientX, y: e.clientY } : null;
        openCardMenu(
          card.dataset.id ?? "",
          card.querySelector<HTMLElement>("[data-card-menu]") ?? card,
          "main",
          point,
        );
      }

      function boardColumnIDs(): string[][] {
        return Array.from($("board").querySelectorAll<HTMLElement>(":scope > .col")).map((c) =>
          c.classList.contains("collapsed")
            ? []
            : Array.from(c.querySelectorAll<HTMLElement>(".col-list > .task-card")).map(
                (x) => x.dataset.id ?? "",
              ),
        );
      }

      function onBoardKey(e: KeyboardEvent) {
        const card = e.target as HTMLElement;
        if (!card.classList.contains("task-card") || e.metaKey || e.ctrlKey || e.altKey) return;
        const id = card.dataset.id ?? "";
        const handled = (fn: () => void) => {
          e.preventDefault();
          e.stopPropagation();
          fn();
        };
        const key = e.key;
        if (lift) {
          if (key === "ArrowLeft" || key === "ArrowRight")
            return handled(() => stepLift(key === "ArrowLeft" ? -1 : 1));
          if (key === " ") return handled(() => void dropLift());
          if (key === "Escape") return handled(() => void cancelLift());
          if (key === "ArrowUp" || key === "ArrowDown" || key === "Enter") return handled(() => {});
          if (key === "Tab") cancelLift();
          return;
        }
        const menuBtn = card.querySelector<HTMLElement>("[data-card-menu]") ?? card;
        if (
          key === "ArrowUp" ||
          key === "ArrowDown" ||
          key === "ArrowLeft" ||
          key === "ArrowRight"
        ) {
          const next = neighborCard(boardColumnIDs(), id, key);
          return handled(() => {
            if (next) focusCard(next);
          });
        }
        if (key === " ") return handled(() => startLift(card));
        if (key === "Enter") return handled(() => void openFromBoard(id));
        if (key === "." || (key === "F10" && e.shiftKey))
          return handled(() => openCardMenu(id, menuBtn));
        if (key === "m" || key === "M") return handled(() => openCardMenu(id, menuBtn, "move"));
        if (key === "p" || key === "P") return handled(() => openCardMenu(id, menuBtn, "priority"));
      }

      let lift: { id: string; from: string; at: string } | null = null;
      let liveTimer = 0;
      function boardSay(msg: string, keep = false) {
        const el = $("board-live");
        el.textContent = msg;
        el.classList.toggle("show", msg !== "");
        window.clearTimeout(liveTimer);
        if (msg && !keep) liveTimer = window.setTimeout(() => el.classList.remove("show"), 4000);
      }
      function startLift(card: HTMLElement) {
        const x = taskByID(card.dataset.id ?? "");
        if (!x || !mayWriteTasks) return;
        closeCardMenu(false);
        lift = { id: x.id, from: x.stage, at: x.stage };
        suspendRefresh = Date.now() + 120_000;
        setTaskCardFlag(card, "lifted", true);
        boardSay(
          t("tasks.board.live.picked", { title: x.title, stage: stageLabel(x.stage) }),
          true,
        );
      }
      function stepLift(dir: -1 | 1) {
        if (!lift) return;
        const x = taskByID(lift.id);
        if (!x) return;
        const next = liftTarget(
          flowOf(x).map((s) => s.id),
          lift.at,
          dir,
        );
        if (!next) {
          boardSay(t("tasks.board.live.edge", { stage: stageLabel(lift.at) }), true);
          return;
        }
        lift.at = next;
        markLiftTarget();
        boardSay(t("tasks.board.live.over", { title: x.title, stage: stageLabel(next) }), true);
        $("board")
          .querySelector<HTMLElement>(`.col[data-stage="${CSS.escape(next)}"]`)
          ?.scrollIntoView({ inline: "nearest", block: "nearest", behavior: scrollBehavior() });
      }
      function markLiftTarget() {
        $("board")
          .querySelectorAll<HTMLElement>(":scope > .col")
          .forEach((c) =>
            c.classList.toggle(
              "kbd-target",
              !!lift && lift.at !== lift.from && c.dataset.stage === lift.at,
            ),
          );
      }
      function endLift() {
        lift = null;
        suspendRefresh = 0;
        $("board")
          .querySelectorAll(".task-card-lifted")
          .forEach((c) => setTaskCardFlag(c, "lifted", false));
        markLiftTarget();
      }
      async function dropLift() {
        if (!lift) return;
        const { id, from, at } = lift;
        endLift();
        const x = taskByID(id);
        if (!x) return;
        const title = x.title;
        if (at === from) {
          boardSay(t("tasks.board.live.canceled", { title, stage: stageLabel(from) }));
          focusCard(id);
          return;
        }
        const moved = await moveTaskToStage(id, at, { keepFocus: true });
        if (moved) boardSay(t("tasks.board.live.dropped", { title, stage: stageLabel(at) }));
        else {
          boardSay(t("tasks.board.live.canceled", { title, stage: stageLabel(from) }));
          focusCard(id);
        }
      }
      function cancelLift(say = true): boolean {
        if (!lift) return false;
        const { id, from } = lift;
        endLift();
        const x = taskByID(id);
        if (say && x)
          boardSay(t("tasks.board.live.canceled", { title: x.title, stage: stageLabel(from) }));
        if (say) focusCard(id);
        return true;
      }

      const cardMenu = $("card-menu");
      let cmTask = "";
      let cmAnchor: HTMLElement | null = null;
      let cmPoint: { x: number; y: number } | null = null;
      let cmRelease: (() => void) | null = null;
      // The list's stage cell opened the stage choices by themselves: no Back, and focus returns to
      // the cell.
      let cmFromStage = false;
      type CardMenuView = "main" | "move" | "priority";

      function cardMenuBtn(id: string): HTMLElement | null {
        const item = listLayout() ? "tr.tl-row" : ".task-card";
        return surface().querySelector<HTMLElement>(
          `${item}[data-id="${CSS.escape(id)}"] [data-card-menu]`,
        );
      }
      function openCardMenu(
        id: string,
        anchor: HTMLElement,
        which: CardMenuView = "main",
        point: { x: number; y: number } | null = null,
        opts: { fromStage?: boolean } = {},
      ) {
        if (!taskByID(id)) return;
        closeCardMenu(false);
        cmTask = id;
        cmAnchor = anchor;
        cmPoint = point;
        cmFromStage = !!opts.fromStage;
        setAttr(cmFromStage ? anchor : cardMenuBtn(id), "aria-expanded", "true");
        cardMenu.hidden = false;
        cmRelease = dismissLayer(cardMenu, anchor, (restore) => closeCardMenu(restore));
        paintCardMenu(which);
      }
      function paintCardMenu(which: CardMenuView) {
        const x = taskByID(cmTask);
        if (!x) {
          closeCardMenu(false);
          return;
        }
        cardMenu.dataset.view = which;
        cardMenu.setAttribute(
          "aria-label",
          t("lib.task_card.labels.actions_for", { title: x.title }),
        );
        if (which === "move")
          cardMenu.innerHTML = stageChoicesHTML(
            flowOf(x).map((s) => ({ id: s.id, label: s.label, color: s.color })),
            x.stage,
            { back: !cmFromStage },
          );
        else if (which === "priority") cardMenu.innerHTML = priorityChoicesHTML(x.priority ?? "");
        else
          cardMenu.innerHTML = cardMenuHTML(
            cardMenuItems({
              parent_id: x.parent_id,
              childCount: (grouped.children.get(x.id) ?? []).length || Number(x.child_count) || 0,
              archived: !!x.archived_at,
              canDelete: mayDeleteTasks,
              canWrite: mayWriteTasks,
              status: x.status,
            }),
          );
        placeCardMenu();
        const items = menuFocusables(cardMenu).filter((b) => !b.hasAttribute("data-cm-back"));
        (cardMenu.querySelector<HTMLElement>('[aria-checked="true"]') ?? items[0])?.focus();
      }
      function placeCardMenu() {
        const r = cmPoint
          ? { left: cmPoint.x, top: cmPoint.y, right: cmPoint.x, bottom: cmPoint.y }
          : cmAnchor?.isConnected
            ? cmAnchor.getBoundingClientRect()
            : null;
        if (r) floatAt(cardMenu, r);
      }
      function closeCardMenu(restore = true): boolean {
        if (!cmTask) return false;
        const id = cmTask;
        const anchor = cmAnchor;
        const fromStage = cmFromStage;
        const hadFocus = cardMenu.contains(document.activeElement);
        cmTask = "";
        cmAnchor = null;
        cmPoint = null;
        cmFromStage = false;
        cmRelease?.();
        cmRelease = null;
        cardMenu.hidden = true;
        cardMenu.innerHTML = "";
        setAttr(cardMenuBtn(id), "aria-expanded", "false");
        if (fromStage) setAttr(anchor, "aria-expanded", "false");
        if (restore && hadFocus) {
          if (fromStage && anchor?.isConnected) anchor.focus();
          else focusCard(id);
        }
        return true;
      }

      async function setTaskPriority(x: Task, p: string) {
        if ((x.priority ?? "") === p) return;
        const prev = x.priority;
        x.priority = p;
        renderBoard();
        try {
          await api.patch(`/tasks/${x.id}`, { priority: p });
        } catch {
          x.priority = prev;
          renderBoard();
          toast(t("tasks.drawer.priority.set_failed"), "err");
          return;
        }
        if (activeTask?.id === x.id) {
          activeTask.priority = p;
          repaintProps();
        }
        void refresh(true);
      }

      cardMenu.addEventListener(
        "keydown",
        (e) => {
          if (menuStep(e, cardMenu)) return;
          if (e.key === "Tab") {
            e.preventDefault();
            closeCardMenu();
            return;
          }
          if (e.key === "ArrowLeft" && cardMenu.dataset.view !== "main") {
            e.preventDefault();
            e.stopPropagation();
            paintCardMenu("main");
            return;
          }
          if (e.metaKey || e.ctrlKey || e.altKey || cardMenu.dataset.view !== "main") return;
          const key = menuKeyOf(e);
          if (!key) return;
          const hit = menuFocusables(cardMenu).find((b) => b.dataset.key === key);
          if (!hit) return;
          e.preventDefault();
          e.stopPropagation();
          hit.click();
        },
        { signal },
      );

      cardMenu.addEventListener(
        "click",
        (e) => {
          const el = e.target as HTMLElement;
          const id = cmTask;
          const x = taskByID(id);
          if (!x) return;
          if (el.closest("[data-cm-back]")) {
            paintCardMenu("main");
            return;
          }
          const st = el.closest<HTMLElement>("[data-cm-stage]");
          if (st) {
            closeCardMenu();
            void moveTaskToStage(id, st.dataset.cmStage ?? "", { keepFocus: true });
            return;
          }
          const pr = el.closest<HTMLElement>("[data-cm-priority]");
          if (pr) {
            closeCardMenu();
            void setTaskPriority(x, pr.dataset.cmPriority ?? "");
            return;
          }
          const item = el.closest<HTMLElement>("[data-cm]");
          if (!item) return;
          const act = item.dataset.cm;
          if (item.getAttribute("aria-disabled") === "true") return;
          if (act === "move" || act === "priority") {
            paintCardMenu(act);
            return;
          }
          const opensDrawer = act === "open" || act === "add-subtask" || act === "delete";
          closeCardMenu(!opensDrawer);
          if (act === "open") void openFromBoard(id);
          else if (act === "add-subtask") void openFromBoard(id).then(focusSubtaskAdd);
          else if (act === "copy-link") void copyText(taskLink(id), "tasks.toasts.link_copied");
          else if (act === "clone") void cloneTask(x);
          else if (act === "fork") void forkTask(x);
          else if (act === "more-turns") void relaunchTask(x);
          else if (act === "archive") void setArchived(id, !x.archived_at);
          else if (act === "delete") {
            focusCard(id);
            void deleteTask(x);
          }
        },
        { signal },
      );

      wireToolbar();

      const LAST_PROJECT_KEY = "octopus.lastProject";
      function rememberProject(id: string) {
        try {
          localStorage.setItem(LAST_PROJECT_KEY, id);
        } catch {}
      }
      function rememberedProject(): string | null {
        try {
          return localStorage.getItem(LAST_PROJECT_KEY);
        } catch {
          return null;
        }
      }
      function startInlineCreate(stageID: string, btn: HTMLElement) {
        const col = btn.closest<HTMLElement>(".col");
        if (!col) return;
        document
          .querySelectorAll<HTMLElement>(".col-adding")
          .forEach((el) => closeInlineCreate(el));

        const projectsOpts =
          `<option value="">${esc(t("tasks.board.inline.no_repo"))}</option>` +
          projects.map((p) => `<option value="${esc(p.id)}">${esc(p.name)}</option>`).join("");
        const wrap = document.createElement("div");
        wrap.className = "col-adding";
        wrap.dataset.stage = stageID;
        wrap.innerHTML = `
          <textarea class="col-add-input" rows="1" placeholder="${esc(t("tasks.board.inline.placeholder"))}" aria-label="${esc(t("tasks.board.inline.placeholder"))}" autocomplete="off"></textarea>
          <div class="col-add-meta">
            <select class="col-add-proj" title="${esc(t("tasks.board.inline.repo_title"))}">${projectsOpts}</select>
            <span class="col-add-hint">${t("tasks.board.inline.hint_html")}</span>
          </div>`;
        btn.hidden = true;
        btn.parentElement!.insertBefore(wrap, btn);

        const input = wrap.querySelector<HTMLTextAreaElement>(".col-add-input")!;
        const proj = wrap.querySelector<HTMLSelectElement>(".col-add-proj")!;
        proj.value = preferredProject(
          rememberedProject(),
          projects.map((p) => p.id),
        );
        const grow = () => {
          input.style.height = "auto";
          input.style.height = `${input.scrollHeight}px`;
        };
        let refused = false;
        input.addEventListener("input", () => {
          refused = false;
          grow();
        });
        input.focus();

        let submitted = false;
        const submit = async () => {
          if (submitted) return;
          const title = input.value.replace(/\s*\n\s*/g, " ").trim();
          const projectID = proj.value;
          if (!title) {
            closeInlineCreate(wrap);
            return;
          }
          submitted = true;
          if (projectID) rememberProject(projectID);
          input.disabled = true;
          proj.disabled = true;
          const created = await submitInlineCreate(stageID, title, projectID);
          if (!wrap.isConnected) return;
          if (created) {
            closeInlineCreate(wrap);
            return;
          }
          submitted = false;
          refused = true;
          input.disabled = false;
          proj.disabled = false;
          input.focus();
        };
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter" && !e.isComposing) {
            e.preventDefault();
            void submit();
          } else if (e.key === "Escape") {
            e.preventDefault();
            closeInlineCreate(wrap);
          } else if (e.key === "Tab") {
            /* let default behavior focus the project select */
          }
        });
        const onDocClick = (e: MouseEvent) => {
          if (wrap.contains(e.target as Node) || submitted || refused) return;
          if (input.value.trim()) void submit();
          else closeInlineCreate(wrap);
        };
        // Deferred so the click that opened the form doesn't close it.
        setTimeout(() => document.addEventListener("mousedown", onDocClick), 0);
        (wrap as any).__teardown = () => document.removeEventListener("mousedown", onDocClick);
      }

      function closeInlineCreate(wrap: HTMLElement) {
        const teardown = (wrap as any).__teardown;
        if (typeof teardown === "function") teardown();
        const btn = wrap.parentElement?.querySelector<HTMLElement>(".col-add");
        if (btn) btn.hidden = false;
        wrap.remove();
      }

      async function submitInlineCreate(
        stageID: string,
        title: string,
        projectID: string,
      ): Promise<boolean> {
        suspendRefresh = Date.now() + 5_000;
        try {
          await api.post("/tasks", {
            title,
            project_ids: projectID ? [projectID] : [],
            stage: stageID,
            board_id: currentBoard,
          });
          const stage = stageInfo(stageID);
          toast(t("tasks.toasts.created_in", { stage: stage?.label || stageID }), "ok", 1800);
          suspendRefresh = 0;
          await refresh(true);
          return true;
        } catch (err) {
          toast(
            err instanceof ApiError
              ? t("tasks.toasts.create_failed_detail", { error: err.message })
              : t("tasks.errors.network"),
            "err",
          );
          suspendRefresh = 0;
          return false;
        }
      }

      function wireBodyEditor() {
        const ta = $("ov-body") as HTMLTextAreaElement;
        const editBtn = $("ov-edit-body") as HTMLButtonElement;
        const doneBtn = $("ov-done-body") as HTMLButtonElement;
        const discardBtn = $("ov-discard-body") as HTMLButtonElement;
        const sectionsBtn = $("ov-sections-body") as HTMLButtonElement;
        const status = $("ov-body-status") as HTMLElement;
        const display = $("ov-display") as HTMLElement;
        const writePane = $("ov-write") as HTMLElement;
        let started = "";
        let original = activeTask?.body || "";
        const editorTask = activeTask?.id || "";
        const alive = () => ta.isConnected && shellTask === editorTask;

        const AUTOSAVE_DELAY = 800;
        let autosaveTimer: number | null = null;
        let autosaveInflight = false;
        let savedAt = 0;
        let savedTick: number | null = null;

        const paintSaved = () => {
          const sec = Math.round((Date.now() - savedAt) / 1000);
          status.textContent =
            sec < 5
              ? t("tasks.drawer.brief.saved")
              : sec < 60
                ? t("tasks.drawer.brief.saved_seconds", { count: sec })
                : t("tasks.drawer.brief.saved_ago", {
                    ago: agoLabel(new Date(savedAt).toISOString()),
                  });
        };
        const setStatus = (
          state: "idle" | "dirty" | "saving" | "saved" | "error",
          text?: string,
        ) => {
          status.classList.remove("dirty", "saving", "saved", "error");
          if (savedTick !== null) {
            clearInterval(savedTick);
            savedTick = null;
          }
          if (state === "idle") {
            status.textContent = "";
            return;
          }
          status.classList.add(state);
          if (state === "dirty") status.textContent = text || t("tasks.drawer.brief.unsaved");
          else if (state === "saving") status.textContent = text || t("tasks.drawer.brief.saving");
          else if (state === "error") {
            status.innerHTML = `<span>${esc(text || t("tasks.drawer.brief.not_saved"))}</span> <button class="link-btn" type="button" data-brief-retry>${esc(t("tasks.drawer.brief.retry"))}</button>`;
          } else {
            savedAt = Date.now();
            paintSaved();
            savedTick = window.setInterval(paintSaved, 5000);
          }
        };
        status.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("[data-brief-retry]")) void runAutosave();
        });

        const autosize = () => {
          const body = drawerBody();
          const keep = body?.scrollTop ?? 0;
          ta.style.setProperty("--ta-h", "auto");
          ta.style.setProperty("--ta-h", `${ta.scrollHeight + 2}px`);
          if (body) body.scrollTop = keep;
        };

        const repaintBrief = () => {
          delete display.dataset.sig;
          renderBrief();
        };

        // Checklist toggles must use the section endpoint (server-side read-modify-write), never a
        // raw body PATCH,
        // or a click can clobber an agent writing another section.
        display.addEventListener("change", async (ev) => {
          const cb = ev.target as HTMLInputElement;
          if (!cb.classList.contains("md-task-check") || cb.disabled) return;
          const sec = cb.dataset.sec;
          const idx = cb.dataset.idx;
          if (!sec || !idx || !activeTask) return;
          const taskId = activeTask.id;
          cb.disabled = true;
          try {
            await api.patch(`/tasks/${taskId}/sections/${encodeURIComponent(sec)}/items/${idx}`, {
              checked: cb.checked,
            });
            const fresh = await api.get<Task>(`/tasks/${taskId}`);
            if (activeTask && activeTask.id === taskId) {
              activeTask.body = fresh.body || "";
              original = activeTask.body;
            }
          } catch {
            setStatus("error", t("tasks.drawer.body.checklist_failed"));
          }
          repaintBrief();
        });

        const cancelAutosave = () => {
          if (autosaveTimer !== null) {
            clearTimeout(autosaveTimer);
            autosaveTimer = null;
          }
        };

        const scheduleAutosave = () => {
          cancelAutosave();
          if (ta.value === original) return;
          autosaveTimer = window.setTimeout(runAutosave, AUTOSAVE_DELAY);
        };

        const runAutosave = async () => {
          autosaveTimer = null;
          if (!alive() || !editorTask) return;
          if (autosaveInflight) {
            scheduleAutosave();
            return;
          }
          if (ta.value === original) return;
          const pending = ta.value;
          const taskId = editorTask;
          autosaveInflight = true;
          setStatus("saving");
          try {
            await api.patch(`/tasks/${taskId}`, { body: pending });
            original = pending;
            if (activeTask && activeTask.id === taskId) activeTask.body = original;
            if (ta.value !== original) {
              setStatus("dirty");
              scheduleAutosave();
            } else {
              setStatus("saved");
            }
          } catch {
            if (!alive()) return;
            setStatus("error");
            autosaveTimer = window.setTimeout(runAutosave, 2500);
          } finally {
            autosaveInflight = false;
          }
        };

        teardownBrief = () => {
          cancelAutosave();
          if (savedTick !== null) {
            clearInterval(savedTick);
            savedTick = null;
          }
          teardownBrief = () => {};
          if (editorTask && briefEditing() && ta.value !== original && !autosaveInflight) {
            void api.patch(`/tasks/${editorTask}`, { body: ta.value }).catch(() => {
              // The edit is lost; the brief shows the last saved text.
            });
          }
        };

        const flush = async () => {
          cancelAutosave();
          const start = Date.now();
          while (autosaveInflight && Date.now() - start < 2000) {
            await new Promise((r) => setTimeout(r, 50));
          }
          if (ta.value !== original) await runAutosave();
          return ta.value === original;
        };

        const enterEdit = () => {
          if (refuseReadOnly()) return;
          if (!activeTask || briefEditing()) {
            ta.focus();
            return;
          }
          original = activeTask.body || "";
          started = original;
          ta.value = original;
          display.hidden = true;
          writePane.hidden = false;
          editBtn.hidden = true;
          doneBtn.hidden = false;
          discardBtn.hidden = false;
          paintSectionsBtn();
          setStatus("idle");
          autosize();
          ta.focus({ preventScroll: true });
          ta.selectionStart = ta.selectionEnd = ta.value.length;
          $("ov-brief").scrollIntoView({ block: "start", behavior: scrollBehavior() });
        };
        enterBriefEdit = () => {
          showTab("overview");
          enterEdit();
        };

        const exitEdit = () => {
          cancelAutosave();
          writePane.hidden = true;
          display.hidden = false;
          editBtn.hidden = false;
          doneBtn.hidden = true;
          discardBtn.hidden = true;
          sectionsBtn.hidden = true;
          if (!status.classList.contains("error")) setStatus("idle");
          repaintBrief();
          editBtn.focus({ preventScroll: true });
        };

        const done = async () => {
          if (await flush()) exitEdit();
        };

        const discard = async () => {
          if (ta.value !== started) {
            const ok = await confirmDialog({
              title: t("tasks.drawer.brief.discard_title"),
              message: t("tasks.drawer.brief.discard_message"),
              confirmLabel: t("tasks.drawer.brief.discard"),
              danger: true,
            });
            if (!ok) return;
          }
          cancelAutosave();
          ta.value = started;
          if (started !== original) await flush();
          exitEdit();
        };

        function paintSectionsBtn() {
          sectionsBtn.hidden = writePane.hidden || missingBriefSections(ta.value).length === 0;
        }
        sectionsBtn.addEventListener("click", () => {
          const next = withBriefSections(ta.value);
          if (next === ta.value) return;
          ta.value = next;
          ta.dispatchEvent(new Event("input"));
          ta.focus({ preventScroll: true });
          ta.selectionStart = ta.selectionEnd = ta.value.length;
        });

        editBtn.addEventListener("click", enterEdit);
        doneBtn.addEventListener("click", () => void done());
        discardBtn.addEventListener("click", () => void discard());

        display.addEventListener("click", (ev) => {
          const el = ev.target as HTMLElement | null;
          if (!el || el.closest("a, img, video, audio, input, button, label")) return;
          if ((window.getSelection()?.toString() ?? "") !== "") return;
          if (!(activeTask?.body || "").trim()) return;
          enterEdit();
        });
        ta.addEventListener("input", () => {
          autosize();
          paintSectionsBtn();
          if (ta.value !== original) setStatus("dirty");
          else if (!autosaveInflight) setStatus("idle");
          scheduleAutosave();
        });
        ta.addEventListener("blur", () => {
          if (autosaveTimer !== null && ta.value !== original) {
            cancelAutosave();
            void runAutosave();
          }
        });

        ta.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "s") {
            e.preventDefault();
            void flush();
          } else if (e.key === "Escape") {
            e.preventDefault();
            e.stopPropagation();
            void done();
          }
        });

        ta.addEventListener("paste", async (e) => {
          if (!e.clipboardData || !activeTask) return;
          const files = Array.from(e.clipboardData.items)
            .filter((it) => it.kind === "file")
            .map((it) => it.getAsFile())
            .filter((f): f is File => f !== null);
          if (files.length === 0) return;
          e.preventDefault();
          for (const f of files) await uploadAndInsert(ta, f, status, writePane);
        });

        ta.addEventListener("dragover", (e) => {
          if (e.dataTransfer && Array.from(e.dataTransfer.items).some((it) => it.kind === "file")) {
            e.preventDefault();
            writePane.classList.add("drag-over");
          }
        });
        ta.addEventListener("dragleave", () => writePane.classList.remove("drag-over"));
        ta.addEventListener("drop", async (e) => {
          writePane.classList.remove("drag-over");
          if (!e.dataTransfer || !activeTask) return;
          const files = Array.from(e.dataTransfer.files);
          if (files.length === 0) return;
          e.preventDefault();
          for (const f of files) await uploadAndInsert(ta, f, status, writePane);
        });
      }

      function insertAtCursor(
        ta: HTMLTextAreaElement,
        text: string,
      ): { start: number; end: number } {
        const start = ta.selectionStart;
        const edit = spliceText(ta.value, start, ta.selectionEnd, text);
        ta.value = edit.value;
        ta.selectionStart = ta.selectionEnd = edit.caret;
        ta.dispatchEvent(new Event("input"));
        return { start, end: edit.caret };
      }

      async function uploadAttachment(
        taskID: string,
        blob: File | Blob,
        filename: string,
        commentID?: string,
      ): Promise<Attachment> {
        const fd = new FormData();
        fd.append("file", blob, filename);
        if (commentID) fd.append("comment_id", commentID);
        // api.* only speaks JSON; this raw fetch still needs the CSRF header and session cookies.
        const res = await fetch(`${API}/tasks/${taskID}/attachments`, {
          method: "POST",
          headers: csrfHeaders(),
          credentials: "include",
          body: fd,
        });
        if (!res.ok) throw new Error(t("tasks.errors.http_status", { status: res.status }));
        return (await res.json()) as Attachment;
      }

      async function uploadAndInsert(
        ta: HTMLTextAreaElement,
        blob: File | Blob,
        status: HTMLElement,
        writePane: HTMLElement,
      ) {
        if (!activeTask) return;
        const filename = pastedName(blob);
        const placeholder = uploadPlaceholder(filename);
        const { end } = insertAtCursor(ta, placeholder);
        writePane.classList.add("uploading");
        status.classList.add("uploading");
        status.textContent = t("tasks.drawer.body.uploading", { file: filename });
        try {
          const att = await uploadAttachment(activeTask.id, blob, filename);
          const edit = replacePlaceholder(ta.value, end, placeholder, attachmentMarkdown(att));
          ta.value = edit.value;
          ta.selectionStart = ta.selectionEnd = edit.caret;
          ta.dispatchEvent(new Event("input"));
          toast(t("tasks.toasts.uploaded", { file: att.filename }), "ok", 1500);
        } catch (err) {
          ta.value = ta.value.replace(placeholder, UPLOAD_FAILED);
          ta.dispatchEvent(new Event("input"));
          toast(t("tasks.toasts.image_upload_failed", { error: (err as Error).message }), "err");
        } finally {
          writePane.classList.remove("uploading");
          status.classList.remove("uploading");
          status.textContent =
            ta.value !== (activeTask?.body || "")
              ? t("tasks.drawer.body.unsaved")
              : t("tasks.drawer.body.saved");
        }
      }

      let dragState: {
        taskID: string;
        sourceStage: string;
        el: HTMLElement;
        typeID: string;
      } | null = null;

      function dropAllowed(stageID: string): boolean {
        if (!dragState) return false;
        return typeAllowsStage(taskTypes, dragState.typeID, stageID);
      }

      function attachCardDrag(el: HTMLElement, id: string) {
        el.draggable = mayWriteTasks;
        el.addEventListener("dragstart", (e) => {
          const cur = taskByID(id);
          if (!cur || lift || !mayWriteTasks) {
            e.preventDefault();
            return;
          }
          closeCardMenu(false);
          dragState = { taskID: id, sourceStage: cur.stage, el, typeID: cur.type_id || "" };
          setTaskCardFlag(el, "dragging", true);
          document.querySelectorAll<HTMLElement>(".col").forEach((c) => {
            c.classList.toggle("drop-forbidden", !dropAllowed(c.dataset.stage || ""));
          });
          if (e.dataTransfer) {
            e.dataTransfer.effectAllowed = "move";
            e.dataTransfer.setData("text/plain", id);
            const ghost = el.cloneNode(true) as HTMLElement;
            setTaskCardFlag(ghost, "dragging", false);
            setTaskCardFlag(ghost, "ghost", true);
            ghost.style.width = `${el.offsetWidth}px`;
            ghost.style.left = "-1000px";
            ghost.style.top = "-1000px";
            document.body.appendChild(ghost);
            e.dataTransfer.setDragImage(ghost, 16, 18);
            // Remove the ghost only after the browser has captured it for setDragImage.
            setTimeout(() => ghost.remove(), 0);
          }
          // A re-render during a drag cancels it.
          suspendRefresh = Date.now() + 60_000;
          // Deferred: a layout change inside dragstart can cancel the drag.
          setTimeout(() => {
            if (!dragState) return;
            boardDragging = true;
            renderBoard();
            paintDropHints(id);
          }, 0);
        });
        el.addEventListener("dragend", () => {
          document
            .querySelectorAll(".col")
            .forEach((c) => c.classList.remove("drop-active", "drop-forbidden"));
          document.querySelectorAll(".col-drop-hint").forEach((i) => i.remove());
          setTaskCardFlag(el, "dragging", false);
          dragState = null;
          suspendRefresh = 0;
          if (boardDragging) {
            boardDragging = false;
            renderBoard();
          }
        });
      }

      function paintDropHints(taskID: string) {
        const x = taskByID(taskID);
        if (!x) return;
        const blocked = isBlockedCard(x, initialStage());
        document.querySelectorAll<HTMLElement>("#board .col[data-stage]").forEach((col) => {
          col.querySelector(".col-drop-hint")?.remove();
          const st = stageInfo(col.dataset.stage || "");
          if (!st || st.id === x.stage || col.classList.contains("drop-forbidden")) return;
          const text = dropHint(x, st, blocked);
          if (!text) return;
          const runs = !blocked && Boolean(x.stage_assignments?.[st.id]);
          const hint = document.createElement("div");
          hint.className = `col-drop-hint${runs ? "" : " is-none"}`;
          hint.innerHTML = `${runs ? icoSvg("bot") : ""}<span>${esc(text)}</span>`;
          col.querySelector(".col-head")?.insertAdjacentElement("afterend", hint);
        });
      }

      function attachColumnDrop(col: HTMLElement, stageID: string) {
        col.addEventListener("dragover", (e) => {
          if (!dragState || !dropAllowed(stageID)) return;
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
          col.classList.toggle("drop-active", dragState.sourceStage !== stageID);
        });
        col.addEventListener("dragleave", (e) => {
          if (col.contains(e.relatedTarget as Node)) return;
          col.classList.remove("drop-active");
        });
        col.addEventListener("drop", async (e) => {
          e.preventDefault();
          col.classList.remove("drop-active");
          if (!dragState) return;
          const { taskID, sourceStage } = dragState;
          if (sourceStage === stageID) return;
          if (!dropAllowed(stageID)) {
            const ty = taskTypeOf(taskTypes, dragState.typeID);
            const stage = stageInfo(stageID)?.label || stageID;
            toast(
              ty?.label
                ? t("tasks.toasts.type_skips", { type: ty.label, stage })
                : t("tasks.toasts.this_type_skips", { stage }),
              "err",
            );
            return;
          }
          await moveTaskToStage(taskID, stageID);
        });
      }

      function autoScrollOnDrag(e: DragEvent) {
        if (!dragState) return;
        const board = $("board") as HTMLElement;
        board.scrollLeft += autoScrollDelta(e.clientX, board.getBoundingClientRect());
      }

      const START_UNDO_MS = 6000;

      let pendingStart: {
        taskID: string;
        timer: number;
        offer: AbortController;
        send: () => Promise<boolean>;
      } | null = null;

      function flushPendingStart() {
        const p = pendingStart;
        if (!p) return;
        pendingStart = null;
        window.clearTimeout(p.timer);
        p.offer.abort();
        void p.send();
      }
      window.addEventListener("pagehide", flushPendingStart, { signal });
      signal.addEventListener("abort", flushPendingStart);

      // A move into a column with an agent is held behind Undo: once the daemon has it the run
      // starts,
      // and moving back does not stop it.
      async function moveTaskToStage(
        taskID: string,
        stageID: string,
        opts: { keepFocus?: boolean; confirmed?: boolean } = {},
      ): Promise<boolean> {
        flushPendingStart();
        const task = taskByID(taskID);
        if (!task || task.stage === stageID) return false;
        const open = (grouped.children.get(task.id) ?? []).filter((c) => !isTerminalStage(c.stage));
        if (!opts.confirmed && isTerminalStage(stageID) && open.length > 0) {
          const ok = await confirmDialog({
            title: t("tasks.confirm.finish_parent_title", {
              title: task.title,
              count: open.length,
            }),
            message: t("tasks.confirm.finish_parent_message"),
            confirmLabel: t("lib.task_detail.move_to", { stage: stageLabel(stageID) }),
          });
          if (!ok) return false;
        }
        const prev = task.stage;
        // Read before the optimistic update: a blocking dependency only holds the card in the first
        // column.
        const blocked = isBlockedCard(task, initialStage());
        task.stage = stageID;
        renderBoard();
        const destCol = $("board").querySelector(`.col[data-stage="${stageID}"]`);
        if (destCol) {
          destCol.classList.add("col-just-received");
          setTimeout(() => destCol.classList.remove("col-just-received"), 700);
        }
        if (opts.keepFocus) {
          const newEl = $("board").querySelector<HTMLElement>(
            `.task-card[data-id="${CSS.escape(taskID)}"]`,
          );
          newEl?.focus();
        }
        const stage = stageInfo(stageID);
        const label = stage?.label || stageID;
        const agent =
          stage && agentColumns([stage]).length ? (task.stage_assignments?.[stageID] ?? "") : "";
        const send = () => sendMove(task, stageID, prev);
        if (!holdsForUndo(agent, blocked)) {
          const ok = await send();
          if (ok)
            toast(
              agent
                ? t("lib.stage_agents.moved_started", { stage: label, agent })
                : t("lib.stage_agents.moved", { stage: label }),
              "ok",
              2200,
            );
          return ok;
        }
        suspendRefresh = Date.now() + START_UNDO_MS + 5000;
        const offer = new AbortController();
        toast(
          t("lib.stage_agents.moved_runs", {
            stage: label,
            agent,
            seconds: Math.round(START_UNDO_MS / 1000),
          }),
          "ok",
          START_UNDO_MS,
          null,
          {
            label: t("lib.stage_agents.undo"),
            signal: offer.signal,
            run: () => {
              if (pendingStart?.taskID !== taskID) return;
              window.clearTimeout(pendingStart.timer);
              pendingStart = null;
              task.stage = prev;
              suspendRefresh = 0;
              renderBoard();
              announce(t("lib.stage_agents.undone", { stage: stageLabel(prev) }));
            },
          },
        );
        pendingStart = {
          taskID,
          offer,
          send,
          timer: window.setTimeout(() => {
            if (pendingStart?.taskID !== taskID) return;
            pendingStart = null;
            void send();
          }, START_UNDO_MS),
        };
        return true;
      }

      async function sendMove(task: Task, stageID: string, prev: string): Promise<boolean> {
        const taskID = task.id;
        try {
          // Raw fetch: the 409 body's blocked_by / blocking_flags are lost by ApiError.
          // keepalive lets a move held for Undo still land when the page goes.
          const res = await fetch(`${API}/tasks/${taskID}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json", ...csrfHeaders() },
            credentials: "include",
            keepalive: true,
            body: JSON.stringify({ stage: stageID }),
          });
          if (res.status === 409) {
            toast(
              t("tasks.toasts.move_blocked", { reason: blockedMoveMessage(await res.json()) }),
              "err",
              4500,
            );
            task.stage = prev;
            suspendRefresh = 0;
            renderBoard();
            return false;
          }
          if (!res.ok) {
            toast(t("tasks.toasts.move_failed"), "err");
            task.stage = prev;
            suspendRefresh = 0;
            renderBoard();
            return false;
          }
          suspendRefresh = 0;
          void refresh(true);
          return true;
        } catch {
          toast(t("tasks.toasts.move_network_error"), "err");
          task.stage = prev;
          suspendRefresh = 0;
          renderBoard();
          return false;
        }
      }

      const ntPicked = new Set<string>();
      let ntProjPicker: PickerHandle | null = null;
      const ntPickedProjects = () =>
        [...ntPicked]
          .map((id) => projects.find((p) => p.id === id))
          .filter((p): p is Project => Boolean(p));

      function renderNewAgents() {
        const el = $("nt-agents");
        const picked = ntPickedProjects();
        const links = picked
          .map(
            (p) =>
              ` <a href="/project/?id=${encodeURIComponent(p.id)}#settings">${esc(t("lib.stage_agents.template_link", { project: p.name }))}</a>`,
          )
          .join("");
        el.innerHTML = esc(newTaskAgentsText(picked, stages)) + links;
        el.hidden = projects.length === 0;
      }

      function boardLabel(id: string): string {
        return boards.find((b) => b.id === id)?.label || id;
      }

      function syncNtBoardNote() {
        const note = $("nt-board-note") as HTMLElement;
        const picked = ntPickedProjects();
        const other = otherDefaultBoard(picked, currentBoard);
        if (!other || !boards.some((b) => b.id === other)) {
          note.hidden = true;
          return;
        }
        note.innerHTML = calloutHTML({
          tone: "info",
          icon: "i-info",
          body: t("tasks.new_task.board_note.here", {
            projects: picked
              .filter((p) => p.default_board_id === other)
              .map((p) => p.name)
              .join(", "),
            board: boardLabel(other),
            current: boardLabel(currentBoard),
          }),
          actionsHTML: buttonHTML({
            label: t("tasks.new_task.board_note.use", { board: boardLabel(other) }),
            size: "sm",
            attrs: { "data-nt-board": other },
          }),
        });
        note.hidden = false;
        note.querySelector<HTMLButtonElement>("[data-nt-board]")?.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLButtonElement).dataset.ntBoard;
          if (id) void pickNtBoard(id);
        });
      }

      function openNewModal() {
        if (!mayWriteTasks) return;
        ntPicked.clear();
        if (projects.length === 0) {
          $("nt-projects").innerHTML =
            `<div class="muted" style="padding:8px 4px">${t("tasks.new_task.no_projects_html")}</div>`;
        } else {
          const failed = projects.filter((p) => p.clone_status === "failed");
          const offered = projects.filter((p) => p.clone_status !== "failed");
          const last = preferredProject(
            rememberedProject(),
            offered.map((p) => p.id),
          );
          if (last) ntPicked.add(last);
          const items = (): PickerItem[] =>
            offered.map((p) => ({
              value: p.id,
              label: p.name,
              labelHTML: repoChipHTML(p.name),
              selected: ntPicked.has(p.id),
            }));
          $("nt-projects").innerHTML =
            pickerHTML({
              id: "nt-proj",
              label: t("tasks.new_task.labels.repos"),
              items: items(),
              multi: true,
              place: "inline",
            }) +
            (failed.length
              ? `<p class="field-help nt-unavailable">${esc(
                  t("tasks.new_task.clone_failed", {
                    projects: failed.map((p) => p.name).join(", "),
                  }),
                )}</p>`
              : "");
          ntProjPicker?.close();
          ntProjPicker = bindPicker($("nt-proj"), {
            items,
            onSelect: (item) => {
              if (ntPicked.has(item.value)) ntPicked.delete(item.value);
              else ntPicked.add(item.value);
              ntProjPicker?.refresh();
              renderNewAgents();
              syncNtBoardNote();
            },
          });
        }
        renderNewAgents();
        fillBoardPicker();
        fillTypePicker();
        ($("nt-title") as HTMLInputElement).value = "";
        ($("nt-body") as HTMLTextAreaElement).value = "";
        ($("nt-priority") as HTMLSelectElement).innerHTML = PRIORITY_OPTIONS.map(
          (opt) => `<option value="${esc(opt.value)}">${esc(t(opt.labelKey))}</option>`,
        ).join("");
        ($("nt-tags") as HTMLInputElement).value = "";
        clearNewTaskErrors();
        syncNtBoardNote();
        newModal.open($("nt-title"));
      }
      function fillBoardPicker() {
        const sel = $("nt-board") as HTMLSelectElement;
        sel.innerHTML = boards
          .map((b) => `<option value="${esc(b.id)}">${esc(b.label || b.id)}</option>`)
          .join("");
        sel.value = currentBoard;
        sel.disabled = boards.length < 2;
      }
      async function pickNtBoard(id: string) {
        const sel = $("nt-board") as HTMLSelectElement;
        const fromNote = $("nt-board-note").contains(document.activeElement);
        sel.value = id;
        sel.disabled = true;
        try {
          await switchBoard(id);
        } finally {
          fillBoardPicker();
          fillTypePicker();
          syncNtBoardNote();
          const modal = $("new-modal");
          if (isModalOpen(modal) && (fromNote || !modal.contains(document.activeElement))) {
            sel.focus();
          }
        }
      }
      $("nt-board").addEventListener("change", () => {
        void pickNtBoard(($("nt-board") as HTMLSelectElement).value);
      });
      function fillTypePicker() {
        const typeRow = $("nt-type-row") as HTMLElement;
        typeRow.hidden = taskTypes.length === 0;
        if (!typeRow.hidden) {
          const sel = $("nt-type") as HTMLSelectElement;
          sel.innerHTML =
            taskTypes
              .map(
                (t) =>
                  `<option value="${esc(t.id)}"${t.default ? " selected" : ""}>${esc(t.label)}</option>`,
              )
              .join("") + `<option value="">${esc(t("tasks.types.untyped_option"))}</option>`;
          if (!taskTypes.some((t) => t.default)) sel.value = "";
        }
      }
      const newModal = bindModal($("new-modal"));
      function closeNewModal() {
        newModal.close();
      }
      function showNewTaskError(text: string) {
        setFormError($("nt-err"), text);
      }
      function clearNewTaskErrors() {
        setFieldError($("nt-title"), "");
        showNewTaskError("");
      }
      // The sidebar calls this to swap boards in place instead of reloading the page.
      (window as any).octopusSwitchBoard = (id: string) => void switchBoard(id);
      // The drawer is still in the document here (astro:before-swap runs before the swap).
      signal.addEventListener("abort", () => {
        delete (window as any).octopusSwitchBoard;
        closeAllInlineLogs(document);
        closeLiveView();
        stopPullRequests();
      });

      $("new-task-btn").addEventListener("click", openNewModal);
      registerCreate("task", openNewModal);
      $("nt-title").addEventListener("input", (e) => {
        const titleEl = e.currentTarget as HTMLInputElement;
        if (titleEl.getAttribute("aria-invalid") !== "true" || !titleEl.value.trim()) return;
        setFieldError(titleEl, "");
      });
      $("nt-create").addEventListener("click", async () => {
        const project_ids = [...ntPicked];
        const title = ($("nt-title") as HTMLInputElement).value.trim();
        const body = ($("nt-body") as HTMLTextAreaElement).value.trim();
        const titleEl = $("nt-title") as HTMLInputElement;
        if (!title) {
          setFieldError(titleEl, t("tasks.toasts.title_required"), { focus: true });
          return;
        }
        setFieldError(titleEl, "");
        const typeSel = $("nt-type") as HTMLSelectElement;
        const board_id = currentBoard;
        const type_id = ($("nt-type-row") as HTMLElement).hidden ? "" : typeSel.value;
        const priority = ($("nt-priority") as HTMLSelectElement).value;
        const tags = parseTags(($("nt-tags") as HTMLInputElement).value);
        const btn = $("nt-create") as HTMLButtonElement;
        btn.disabled = true;
        showNewTaskError("");
        let created: Task;
        try {
          created = await api.post<Task>("/tasks", {
            project_ids,
            title,
            body,
            board_id,
            type_id,
            priority,
            tags,
          });
        } catch (err) {
          showNewTaskError(
            err instanceof ApiError
              ? t("tasks.toasts.create_failed_detail", { error: err.message })
              : t("tasks.errors.network"),
          );
          return;
        } finally {
          btn.disabled = false;
        }
        closeNewModal();
        toast(t("tasks.toasts.task_created"), "ok");
        if (project_ids[0]) rememberProject(project_ids[0]);
        await refresh(true);
        if (board_id === currentBoard) await openDrawer(created.id);
      });

      const mergeModal = bindModal($("merge-modal"));
      async function openMergeModal() {
        const task = activeTask;
        if (!task) return;
        const ids = uploadProjectIDs(task);
        if (ids.length === 0) return;
        const sel = $("mg-project") as HTMLSelectElement;
        sel.innerHTML = ids
          .map((id) => `<option value="${esc(id)}">${esc(projectName(id))}</option>`)
          .join("");
        ($("mg-project-row") as HTMLElement).hidden = ids.length < 2;
        showMergeConflict(false);
        mergeModal.open();
        await loadMergeTargets();
      }
      async function loadMergeTargets() {
        const id = ($("mg-project") as HTMLSelectElement).value;
        const sel = $("mg-target") as HTMLSelectElement;
        const branch = (activeTask && (activeTask.branch_name || "")) || "";
        let def = projects.find((p) => p.id === id)?.default_branch || "main";
        let branches = [def];
        try {
          const r = await api.get<{ default_branch: string; branches: string[] }>(
            `/projects/${encodeURIComponent(id)}/branches`,
          );
          def = r.default_branch || def;
          branches = (r.branches || []).filter((b) => b !== branch);
          if (!branches.includes(def)) branches.unshift(def);
        } catch {
          /* fall back to the default branch alone */
        }
        sel.innerHTML = branches
          .map((b) => `<option value="${esc(b)}"${b === def ? " selected" : ""}>${esc(b)}</option>`)
          .join("");
        syncMergeNote();
      }
      function showMergeConflict(on: boolean) {
        ($("mg-conflict-actions") as HTMLElement).hidden = !on;
        if (!on) ($("mg-conflicts") as HTMLElement).hidden = true;
        const merge = $("mg-merge") as HTMLButtonElement;
        merge.disabled = on;
        merge.classList.toggle("btn-primary", !on);
        $("mg-redo").classList.toggle("btn-primary", on);
        if (!on) mergeConflict = null;
      }
      function syncMergeNote() {
        setText(
          $("mg-note"),
          t("tasks.merge.note", {
            branch: activeTask?.branch_name || "",
            target: ($("mg-target") as HTMLSelectElement).value,
          }),
        );
      }
      async function mergeActiveTask() {
        const task = activeTask;
        if (!task) return;
        const btn = $("mg-merge") as HTMLButtonElement;
        const target = ($("mg-target") as HTMLSelectElement).value;
        const box = $("mg-conflicts") as HTMLElement;
        showMergeConflict(false);
        btn.disabled = true;
        try {
          const r = await api.post<{ status: string; target: string; commit?: string }>(
            `/tasks/${task.id}/merge`,
            { project_id: ($("mg-project") as HTMLSelectElement).value, target },
          );
          mergeModal.close();
          toast(
            r.status === "up_to_date"
              ? t("tasks.merge.up_to_date", { target: r.target })
              : t("tasks.merge.merged", { target: r.target, commit: (r.commit || "").slice(0, 7) }),
            "ok",
            4000,
          );
          await refresh(true);
        } catch (err) {
          const conflicts = (err instanceof ApiError && (err.body as any)?.conflicts) || null;
          if (Array.isArray(conflicts) && conflicts.length > 0) {
            box.innerHTML =
              `<p>${esc(t("tasks.merge.conflicts", { count: conflicts.length, target }))}</p>` +
              `<ul>${conflicts.map((f: string) => `<li><code>${esc(f)}</code></li>`).join("")}</ul>`;
            box.hidden = false;
            const projectID = ($("mg-project") as HTMLSelectElement).value;
            const base = projects.find((p) => p.id === projectID)?.default_branch || "main";
            mergeConflict = { task, target, base, files: conflicts.map(String) };
            $("mg-redo").textContent = t("tasks.merge.redo", { branch: base });
            ($("mg-return") as HTMLElement).hidden = !agentCanResolve((err as ApiError).body);
          } else if (err instanceof ApiError)
            toast(t("tasks.merge.failed", { error: err.message }), "err", 6000);
          else toast(t("tasks.errors.network"), "err");
        } finally {
          showMergeConflict(mergeConflict !== null);
        }
      }
      let mergeConflict: { task: Task; target: string; base: string; files: string[] } | null =
        null;

      async function redoOnTarget() {
        const c = mergeConflict;
        if (!c) return;
        try {
          const copy = await api.post<Task>(`/tasks/${c.task.id}/clone`);
          await api.patch(`/tasks/${copy.id}`, {
            title: t("tasks.merge.redo_title", { title: c.task.title, branch: c.base }),
            body: redoBody(c.task.body || "", c.base, c.files),
          });
          mergeModal.close();
          toast(t("tasks.merge.redo_done", { branch: c.base }), "ok", 3000);
          await refresh(true);
          void openDrawer(copy.id);
        } catch (err) {
          toast(
            err instanceof ApiError
              ? t("tasks.toasts.clone_failed", { error: err.message })
              : t("tasks.errors.network"),
            "err",
          );
        }
      }

      async function returnToAgent() {
        const c = mergeConflict;
        if (!c) return;
        try {
          await api.post(`/tasks/${c.task.id}/comments`, {
            body: conflictComment(c.target, c.files),
            notify_agent: true,
          });
          mergeModal.close();
          toast(t("tasks.merge.returned"), "ok", 3500);
          await refresh(true);
        } catch (err) {
          toast(
            err instanceof ApiError
              ? t("tasks.merge.failed", { error: err.message })
              : t("tasks.errors.network"),
            "err",
          );
        }
      }
      $("mg-redo").addEventListener("click", () => void redoOnTarget());
      $("mg-return").addEventListener("click", () => void returnToAgent());
      $("mg-project").addEventListener("change", () => {
        showMergeConflict(false);
        void loadMergeTargets();
      });
      $("mg-target").addEventListener("change", () => {
        showMergeConflict(false);
        syncMergeNote();
      });
      $("mg-merge").addEventListener("click", () => void mergeActiveTask());

      const drawerCtl = bindDrawer($("drawer"));
      function revealHashKey(key: string) {
        if (key === APPROVALS_KEY) showTab("approvals");
        else revealTestCase(key);
      }

      async function openDrawer(taskID: string, caseKey: string | null = null) {
        try {
          closeLiveView();
          if (activeTask && activeTask.id !== taskID) {
            pendingReplyAtts = [];
            resetThreadUI();
            resetTaskUI();
            $("drawer").classList.remove("compact");
          }
          activeTask = await api.get<Task>(`/tasks/${taskID}`);
          if (activeTask.parent_id !== parentTask?.id) parentTask = null;
          if (activeTask.parent_id) await loadParent(activeTask.parent_id);
          const drawerEl = $("drawer");
          drawerCtl.open();
          // Under 1100px ChatDrawer closes on this event; otherwise its overlay covers the drawer's
          // tabs.
          document.dispatchEvent(new CustomEvent("octopus:task-drawer-open"));
          renderDrawerContents();
          // Focus left on the card would send "." and P to the card menu instead of the drawer.
          if (!drawerEl.contains(document.activeElement)) drawerEl.focus({ preventScroll: true });
          if (drawerTabs?.current() === "liveview") openLiveView();
          // Through the router so Back from another page lands here (lib/page.ts bridges the
          // hashchange).
          void navigate(`#task-${taskID}` + (caseKey ? `/${caseKey}` : ""));
          if (caseKey) revealHashKey(caseKey);
        } catch (e) {
          toast(t("tasks.toasts.load_failed"), "err");
        }
      }

      async function loadParent(parentID: string) {
        const listed = tasks.find((x) => x.id === parentID);
        const onBoard = grouped.children.get(parentID);
        const ids = (xs: Array<{ id: string }>) => xs.map((x) => x.id).join(",");
        const fresh =
          parentTask?.id === parentID &&
          (!listed ||
            ((!listed.updated_at || listed.updated_at === parentTask.updated_at) &&
              (!onBoard || ids(onBoard) === ids(parentTask.children || []))));
        if (fresh) return;
        try {
          parentTask = await api.get<Task>(`/tasks/${parentID}`);
        } catch {
          // Without the parent the breadcrumb falls back to its short id.
        }
      }

      function closeDrawer() {
        closeAllInlineLogs($("drawer"));
        closeLiveView();
        drMenuCtl.close(false);
        closeRowMenu();
        teardownBrief();
        drawerCtl.close(true);
        $("drawer").classList.remove("compact");
        if (returnFocus) {
          const board = $("board");
          const own = activeTask
            ? board.querySelector<HTMLElement>(`.task-card[data-id="${CSS.escape(activeTask.id)}"]`)
            : null;
          (own ?? board.querySelector<HTMLElement>(returnFocus))?.focus({ preventScroll: true });
          returnFocus = "";
        }
        if ($("drawer").contains(document.activeElement))
          (document.activeElement as HTMLElement).blur();
        activeTask = null;
        parentTask = null;
        stopPullRequests();
        pendingReplyAtts = [];
        resetThreadUI();
        resetTaskUI();
        // replaceURL keeps the router's state; a pushState("") entry made Back land on a state the
        // router can't read.
        if (window.location.hash) replaceURL(window.location.pathname + window.location.search);
      }
      $("dr-close").addEventListener("click", closeDrawer);

      const EXPAND_KEY = "octopus.taskDrawer.expanded";
      function setExpanded(on: boolean, remember = true) {
        $("drawer").classList.toggle("expanded", on);
        const btn = $("dr-expand");
        btn.setAttribute("aria-pressed", String(on));
        btn.setAttribute(
          "aria-label",
          on ? t("tasks.drawer.labels.shrink") : t("tasks.drawer.labels.expand"),
        );
        btn.title = on ? t("tasks.drawer.labels.shrink_key") : t("tasks.drawer.labels.expand_key");
        btn.innerHTML = icoSvg(on ? "minimize" : "maximize");
        if (!remember) return;
        try {
          if (on) localStorage.setItem(EXPAND_KEY, "1");
          else localStorage.removeItem(EXPAND_KEY);
        } catch {
          // Not remembered; the drawer still expands.
        }
      }
      try {
        setExpanded(localStorage.getItem(EXPAND_KEY) === "1", false);
      } catch {
        setExpanded(false, false);
      }
      $("dr-expand").addEventListener("click", () =>
        setExpanded(!$("drawer").classList.contains("expanded")),
      );

      const drMenu = $("dr-menu") as HTMLElement;
      const drMenuCtl = bindMenu(drMenu, $("dr-menu-btn"), {
        signal,
        onOpen: () => paintDrawerMenu(),
        onSelect: (item) => void runDrawerAction(item.dataset.act ?? ""),
      });
      function paintDrawerMenu() {
        const task = activeTask;
        if (!task) return;
        const add = drMenu.querySelector<HTMLButtonElement>('[data-act="add-subtask"]')!;
        add.hidden = !!task.parent_id;
        drMenu.querySelector<HTMLButtonElement>('[data-act="more-turns"]')!.hidden = !ranOutOfTurns(
          task.status,
        );
        drMenu.querySelector<HTMLButtonElement>('[data-act="ensure-pr"]')!.hidden =
          !hasGitHubProject(task);
        const kids = (task.children || []).length;
        drMenu.querySelector<HTMLButtonElement>('[data-act="archive"]')!.hidden = !!task.parent_id;
        setText(
          $("dr-menu-archive-title"),
          task.archived_at ? t("tasks.drawer.menu.unarchive") : t("tasks.drawer.menu.archive"),
        );
        setText(
          $("dr-menu-archive-sub"),
          task.archived_at
            ? t("tasks.drawer.menu.unarchive_sub")
            : kids > 0
              ? t("tasks.drawer.menu.archive_sub_kids", { count: kids })
              : t("tasks.drawer.menu.archive_sub"),
        );
        $("dr-menu-readonly").hidden = mayWriteTasks;
        drMenu.querySelectorAll<HTMLElement>("[data-act]").forEach((b) => {
          if (b.dataset.act !== "copy-link")
            b.setAttribute("aria-disabled", mayWriteTasks ? "false" : "true");
        });
        const del = drMenu.querySelector<HTMLButtonElement>('[data-act="delete"]')!;
        if (mayWriteTasks) del.setAttribute("aria-disabled", mayDeleteTasks ? "false" : "true");
        setText(
          $("dr-menu-delete-sub"),
          mayWriteTasks && !mayDeleteTasks
            ? t("tasks.drawer.menu.delete_admin_only")
            : kids > 0
              ? t("tasks.drawer.menu.delete_sub_kids", { count: kids })
              : t("tasks.drawer.menu.delete_sub"),
        );
      }
      async function runDrawerAction(act: string) {
        if (act === "clone") await cloneTask();
        else if (act === "fork") await forkTask();
        else if (act === "more-turns") await relaunchTask();
        else if (act === "ensure-pr") await ensureActiveTaskPR();
        else if (act === "copy-link") await copyTaskLink();
        else if (act === "add-subtask") focusSubtaskAdd();
        else if (act === "archive" && activeTask)
          await setArchived(activeTask.id, !activeTask.archived_at);
        else if (act === "delete") await deleteTask();
      }

      async function copyText(text: string, okKey: string) {
        if (await copyToClipboard(text)) toast(t(okKey), "ok", 1600);
        else toast(t("tasks.toasts.copy_failed"), "err");
      }

      function taskLink(id: string): string {
        const board = currentBoard ? `?board=${encodeURIComponent(currentBoard)}` : "";
        return `${window.location.origin}/tasks/${board}#task-${id}`;
      }

      async function copyTaskLink() {
        if (activeTask) await copyText(taskLink(activeTask.id), "tasks.toasts.link_copied");
      }

      async function forkTask(src: Task | null = activeTask) {
        if (!src) return;
        const srcID = src.id;
        const wasRunning = (src.status || "idle") === "running";
        if (wasRunning) {
          const ok = await confirmDialog({
            title: t("tasks.confirm.fork_running_title"),
            message: t("tasks.confirm.fork_running_message"),
            confirmLabel: t("tasks.confirm.fork_button"),
          });
          if (!ok) return;
        }
        try {
          const fork = await api.post<Task>(`/tasks/${srcID}/fork`);
          toast(t("tasks.toasts.forked"), "ok", 1800);
          await refresh(true);
          openDrawer(fork.id);
        } catch (err) {
          if (err instanceof ApiError)
            toast(t("tasks.toasts.fork_failed", { error: err.message }), "err", 4500);
          else toast(t("tasks.errors.network"), "err");
        }
      }

      async function ensureActiveTaskPR() {
        if (!activeTask) return;
        const id = activeTask.id;
        try {
          const out = await api.post<any>(`/tasks/${id}/ensure-pr`, {});
          const opened = out && typeof out.opened === "number" ? out.opened : 0;
          const results: Array<{
            project_name?: string;
            project_id: string;
            status: string;
            message?: string;
            pr_url?: string;
          }> = out?.results || [];
          if (opened > 0) {
            toast(t("tasks.toasts.force_pr.opened", { count: opened }), "ok", 3200);
          } else {
            const priority = [
              "no_token",
              "no_secrets_store",
              "bad_remote",
              "project_missing",
              "open_failed",
              "already_open",
            ];
            const sorted = results
              .slice()
              .sort((a, b) => priority.indexOf(a.status) - priority.indexOf(b.status));
            const r = sorted[0];
            if (!r) {
              toast(t("tasks.toasts.force_pr.no_projects"), "ok", 4000);
            } else {
              const name = r.project_name || r.project_id;
              const error = r.message || t("tasks.errors.unknown");
              const reason: Record<string, string> = {
                no_token: t("tasks.toasts.force_pr.no_token", { name }),
                no_secrets_store: t("tasks.toasts.force_pr.no_secrets_store"),
                bad_remote: t("tasks.toasts.force_pr.bad_remote", { name }),
                project_missing: t("tasks.toasts.force_pr.project_missing", { name, error }),
                open_failed: t("tasks.toasts.force_pr.open_failed", { name, error }),
                already_open: t("tasks.toasts.force_pr.already_open"),
              };
              const msg =
                reason[r.status] ||
                t("tasks.toasts.force_pr.unknown_status", { status: r.status, name });
              const tone = r.status === "already_open" ? "ok" : "err";
              const link =
                r.status === "no_token" && r.project_id
                  ? {
                      href: `/project/?id=${encodeURIComponent(r.project_id)}#repo`,
                      label: t("tasks.toasts.force_pr.open_project"),
                    }
                  : undefined;
              toast(msg, tone, link ? 10000 : 6000, link);
            }
          }
          await refresh(true);
        } catch (err) {
          if (err instanceof ApiError)
            toast(t("tasks.toasts.force_pr.failed", { error: err.message }), "err", 4500);
          else toast(t("tasks.errors.network"), "err");
        }
      }

      async function relaunchTask(task: Task | null = activeTask) {
        if (!task) return;
        const id = task.id;
        try {
          const out = await api.post<{ turns: number }>(`/tasks/${id}/relaunch`, {});
          toast(t("tasks.toasts.relaunched", { count: out.turns }), "ok", 2200);
          await refresh(true);
        } catch (err) {
          if (err instanceof ApiError) {
            const cause = (err.body as { cause?: string } | undefined)?.cause;
            toast(
              t("tasks.toasts.relaunch_failed", { error: err.message }),
              "err",
              7000,
              causeLink(cause),
            );
            if (cause) await refresh(true);
          } else toast(t("tasks.errors.network"), "err");
        }
      }

      async function reviewAndRetry(task: Task | null = activeTask) {
        if (!task) return;
        showTab("reports");
        const ok = await confirmDialog({
          title: t("tasks.confirm.retry_after_audit_title"),
          message: t("tasks.confirm.retry_after_audit_message"),
          confirmLabel: t("tasks.drawer.header.retry"),
        });
        if (ok) await relaunchTask(task);
      }

      async function cloneTask(src: Task | null = activeTask) {
        if (!src) return;
        const srcID = src.id;
        try {
          const clone = await api.post<Task>(`/tasks/${srcID}/clone`);
          toast(t("tasks.toasts.cloned"), "ok", 1800);
          await refresh(true);
          openDrawer(clone.id);
        } catch (err) {
          if (err instanceof ApiError)
            toast(t("tasks.toasts.clone_failed", { error: err.message }), "err");
          else toast(t("tasks.errors.network"), "err");
        }
      }

      async function deleteTask(task: Task | null = activeTask, known?: string[]) {
        if (!task) return;
        const id = task.id;
        const title = task.title;
        const kids = task.parent_id
          ? []
          : (known ?? (task.children ?? grouped.children.get(id) ?? []).map((c) => c.title));
        const ok = await confirmDialog(
          task.parent_id
            ? {
                title: t("tasks.confirm.delete_subtask_title", { title }),
                message: t("tasks.confirm.delete_subtask_message"),
                confirmLabel: t("tasks.confirm.delete_subtask_button"),
                danger: true,
              }
            : {
                title: title
                  ? t("tasks.confirm.delete_task_title", { title })
                  : t("tasks.confirm.delete_this_task_title"),
                ...(kids.length
                  ? deleteWithSubtasks(kids)
                  : { message: t("tasks.confirm.delete_task_message") }),
                confirmLabel: kids.length
                  ? t("tasks.confirm.delete_with_subtasks_button", { count: kids.length + 1 })
                  : t("common.buttons.delete"),
                danger: true,
              },
        );
        if (!ok) return;
        try {
          suspendRefresh = Date.now() + 5_000;
          await api.del(`/tasks/${id}${kids.length ? "?subtasks=delete" : ""}`);
          toast(t("tasks.toasts.task_deleted"), "ok", 1800);
          if (activeTask && (activeTask.id === id || activeTask.parent_id === id)) closeDrawer();
          suspendRefresh = 0;
          await refresh(true);
        } catch (err) {
          if (!known && !task.parent_id && refusedForSubtasks(err)) {
            suspendRefresh = 0;
            const rows = await api
              .get<Task[]>(`/tasks?parent_id=${encodeURIComponent(id)}`)
              .catch(() => [] as Task[]);
            if (rows.length)
              return deleteTask(
                task,
                rows.map((c) => c.title),
              );
          }
          if (err instanceof ApiError)
            toast(t("tasks.toasts.delete_failed", { error: err.message }), "err", 4500);
          else toast(t("tasks.errors.network"), "err");
        }
      }

      (function wireTitleEditor() {
        const el = $("dr-title") as HTMLElement;
        let savedValue = "";

        const saveIfChanged = async () => {
          if (!activeTask) return;
          const next = (el.textContent || "").trim();
          if (next === savedValue) {
            el.classList.remove("dirty");
            return;
          }
          if (!next) {
            toast(t("tasks.toasts.title_empty"), "err");
            el.textContent = savedValue;
            el.classList.remove("dirty");
            return;
          }
          const id = activeTask.id;
          el.classList.add("saving");
          try {
            suspendRefresh = Date.now() + 5_000;
            await api.patch(`/tasks/${id}`, { title: next });
            savedValue = next;
            if (activeTask && activeTask.id === id) activeTask.title = next;
            const task = taskByID(id);
            if (task) {
              task.title = next;
              renderBoard();
            }
            toast(t("tasks.toasts.title_saved"), "ok", 1400);
            suspendRefresh = 0;
            refresh(true);
          } catch (err) {
            toast(
              err instanceof ApiError
                ? t("tasks.toasts.title_save_failed")
                : t("tasks.errors.network"),
              "err",
            );
            el.textContent = savedValue;
          } finally {
            el.classList.remove("saving", "dirty");
          }
        };

        el.addEventListener("focus", () => {
          $("dr-title-hint").hidden = false;
          savedValue = (el.textContent || "").trim();
          const r = document.createRange();
          r.selectNodeContents(el);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(r);
        });

        el.addEventListener("input", () => {
          const cur = (el.textContent || "").trim();
          el.classList.toggle("dirty", cur !== savedValue);
        });

        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            el.blur();
          } else if (e.key === "Escape") {
            e.preventDefault();
            e.stopPropagation();
            el.textContent = savedValue;
            el.classList.remove("dirty");
            el.blur();
          }
        });

        el.addEventListener("blur", () => {
          $("dr-title-hint").hidden = true;
          if (el.classList.contains("dirty")) saveIfChanged();
        });

        // plaintext-only isn't supported everywhere; this keeps pasted HTML out on older browsers.
        el.addEventListener("paste", (e) => {
          e.preventDefault();
          const text = (e.clipboardData?.getData("text/plain") || "").replace(/\s+/g, " ");
          document.execCommand("insertText", false, text);
        });
      })();

