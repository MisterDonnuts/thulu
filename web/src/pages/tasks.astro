      const scrollBehavior = (): ScrollBehavior =>
        // i18n-ignore a media query
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

      function flowOf(task: Pick<Task, "type_id">): Stage[] {
        return stages.filter((s) => typeAllowsStage(taskTypes, task.type_id, s.id));
      }
      function nextStageOf(task: Pick<Task, "type_id" | "stage">): Stage | undefined {
        const id = nextStageInFlow(flowOf(task), task.stage, 1);
        return id ? stageInfo(id) : undefined;
      }
      const isTerminalStage = (id: string) => !!stageInfo(id)?.terminal;
      function initialStage(): string {
        return stages.find((s) => s.initial)?.id || stages[0]?.id || "";
      }
      function isAgentName(name: string): boolean {
        if (agentTypes.some((a) => a.type === name || a.name === name)) return true;
        return Object.values(activeTask?.stage_assignments || {}).includes(name);
      }

      function announce(msg: string) {
        const el = $("dr-live");
        el.textContent = "";
        window.setTimeout(() => (el.textContent = msg), 30);
      }

      function showTab(name: string) {
        drawerTabs?.select(name);
      }

      function applyDrawerWriteGate() {
        $("drawer").toggleAttribute("data-readonly", !mayWriteTasks);
        const titleEl = $("dr-title");
        titleEl.contentEditable = mayWriteTasks ? "plaintext-only" : "false";
        titleEl.title = mayWriteTasks ? t("tasks.hints.click_to_edit") : "";
        const composer = document.getElementById("act-composer");
        const note = document.getElementById("act-readonly");
        if (composer) composer.hidden = !mayWriteTasks;
        if (note) note.hidden = mayWriteTasks;
      }

      function refuseReadOnly(): boolean {
        if (mayWriteTasks) return false;
        toast(t("tasks.readonly.menu"));
        return true;
      }

      function renderDrawerContents(opts: DrawerRenderOpts = {}) {
        if (!activeTask) return;
        const task = activeTask;
        const titleEl = $("dr-title") as HTMLElement;
        const titleDirty = titleEl.classList.contains("dirty");
        const titleFocused = document.activeElement === titleEl;
        if (!titleDirty && !titleFocused) setText(titleEl, task.title);

        applyDrawerWriteGate();
        renderHeader();
        renderAttention();
        renderTabCounts();
        renderOverview(!!opts.skipOverviewIfDirty);

        const approvalsPane = $("pane-approvals");
        const focusInApprovals = approvalsPane.contains(document.activeElement);
        if (!opts.focusInsideDrawer || !focusInApprovals) renderApprovals();

        renderTimeline();

        renderTypingIndicators();

        renderReports();
      }

      function renderHeader() {
        const task = activeTask!;
        const parent = task.parent_id ? parentTask : null;
        const board = boards.find((b) => b.id === (task.board_id || currentBoard));

        const crumbs = $("dr-crumbs");
        const crumbSig = JSON.stringify([board?.label, task.parent_id, parent?.title, task.id]);
        if (crumbs.dataset.sig !== crumbSig) {
          const boardID = task.board_id || currentBoard;
          const trail: Crumb[] = [
            {
              label: board?.label || boardID,
              href: `/tasks/?board=${encodeURIComponent(boardID)}`,
              attrs: { "data-crumb-board": boardID },
              hideNarrow: !!task.parent_id,
            },
          ];
          if (task.parent_id) {
            trail.push({
              label: parent?.title || shortId(task.parent_id),
              href: `#task-${task.parent_id}`,
              attrs: {
                "data-open-task": task.parent_id,
                title: t("tasks.drawer.header.open_parent_key"),
              },
            });
          }
          trail.push({ label: shortId(task.id), mono: true });
          crumbs.innerHTML = crumbsHTML(trail, {
            label: t("tasks.drawer.labels.breadcrumb"),
            size: "sm",
            line: true,
            actionHTML: buttonHTML({
              iconOnly: true,
              icon: "link",
              label: t("tasks.drawer.header.copy_link"),
              size: "sm",
              variant: "ghost",
              cls: "copy-btn",
              attrs: { "data-copy-link": true },
            }),
          });
          crumbs.dataset.sig = crumbSig;
        }

        const nav = parent
          ? siblingNav(
              (parent.children || []).map((c) => c.id),
              task.id,
            )
          : null;
        $("dr-sibs").hidden = !nav;
        if (nav) {
          setText(
            $("dr-sib-pos"),
            t("tasks.drawer.header.sibling_pos", { index: nav.index, total: nav.total }),
          );
          const prev = $("dr-sib-prev") as HTMLButtonElement;
          const next = $("dr-sib-next") as HTMLButtonElement;
          prev.disabled = !nav.prev;
          next.disabled = !nav.next;
          prev.dataset.go = nav.prev;
          next.dataset.go = nav.next;
        }

        const st = stageInfo(task.stage);
        const terminal = !!st?.terminal;
        const kids = task.children || [];
        const kidsProg = subtaskProgress(kids, isTerminalStage, initialStage());
        const kidsDone = kidsProg.done;
        const pending = pendingApprovalCount(task);
        const next = nextStageOf(task);
        const type = taskTypeOf(taskTypes, task.type_id);

        const state = $("dr-state");
        const stateSig = JSON.stringify([
          task.stage,
          st?.label,
          st?.color,
          task.status,
          task.status_reason,
          task.priority,
          type?.id,
          kidsProg.segments,
          !!task.archived_at,
        ]);
        if (state.dataset.sig !== stateSig && !state.querySelector(".nselect")) {
          const label = st?.label || task.stage;
          state.innerHTML = [
            stagePillHTML(task.stage, st, {
              button: true,
              id: "dr-stage",
              title: t("tasks.drawer.header.stage_key"),
              attrs: {
                "aria-haspopup": "true",
                "aria-label": t("tasks.drawer.header.stage_label", { stage: label }),
              },
            }),
            task.archived_at
              ? badgeHTML(t("tasks.drawer.header.archived"), "muted", {
                  shape: "pill",
                  icon: "i-box",
                  title: t("tasks.drawer.header.archived_title"),
                  attrs: { "data-archived": true },
                })
              : "",
            runPillHTML(runWord(task.status, terminal), task.status_reason),
            taskPriorityTagHTML(task.priority),
            typeTagHTML(taskTypes, type?.id),
            subtaskProgressHTML(kidsProg, {
              text: "long",
              cls: "dh-rollup",
              attrs: {
                title: t("tasks.drawer.header.rollup", { done: kidsDone, total: kids.length }),
              },
            }),
          ].join("");
          state.dataset.sig = stateSig;
        }

        const kind = primaryAction({
          status: task.status,
          pendingApprovals: pending,
          children: kids.length,
          childrenDone: kidsDone,
          terminal,
          next: next?.id || "",
          waitCanceled: waitCanceled(streamEventsTask === task.id ? streamEvents : []),
        });
        const held =
          !!st?.initial &&
          (task.blocked_by || []).some(
            (d: { kind?: string; stage?: string }) =>
              d.kind === "hard" && !isTerminalStage(d.stage || ""),
          );
        const archived = !!task.archived_at;
        const acts = $("dr-actions");
        const actSig = JSON.stringify([
          kind,
          next?.id,
          next?.label,
          terminal,
          held,
          archived,
          mayWriteTasks,
        ]);
        if (acts.dataset.sig !== actSig && !mayWriteTasks) {
          acts.replaceChildren();
          acts.hidden = true;
          acts.dataset.sig = actSig;
        } else if (acts.dataset.sig !== actSig) {
          const moveLabel = next ? t("lib.task_detail.move_to", { stage: next.label }) : "";
          const secondary =
            next && !terminal && !held && !archived && kind !== "move_parent"
              ? buttonHTML({
                  label: moveLabel,
                  icon: "arrow-right",
                  size: "sm",
                  attrs: { "data-move-to": next.id },
                })
              : "";
          const PRIMARY = {
            answer: "tasks.drawer.header.answer",
            review: "tasks.drawer.header.review",
            more_turns: "tasks.drawer.header.more_turns",
            retry: "tasks.drawer.header.retry",
            review_retry: "tasks.drawer.header.review_retry",
            relaunch_stage: "tasks.drawer.header.relaunch_stage",
            credentials: "tasks.drawer.header.credentials",
            pick_agent: "tasks.drawer.header.pick_agent",
          } as const;
          let primary = "";
          if (kind === "move_parent" && next && !archived) {
            primary = buttonHTML({
              label: moveLabel,
              size: "sm",
              variant: "primary",
              attrs: { "data-move-to": next.id },
            });
          } else if (kind && kind !== "move_parent") {
            primary = buttonHTML({
              label: t(PRIMARY[kind]),
              size: "sm",
              variant: "primary",
              attrs: { "data-primary": kind },
            });
          }
          acts.innerHTML = secondary + primary;
          acts.hidden = !secondary && !primary;
          acts.dataset.sig = actSig;
        }
      }

      function renderAttention() {
        const task = activeTask!;
        const kids = task.children || [];
        const next = nextStageOf(task);
        const init = initialStage();
        const items = attentionItems({
          questions: (task.questions || []).map((q) => ({
            id: q.id,
            status: q.status,
            agent: q.agent,
            created_at: q.created_at,
            blocking: isBlocking(q),
            blocker: isBlocker(q),
          })),
          pendingApprovals: approvalsOf(task)
            .filter((a) => a.status === "pending")
            .map((a) => ({ id: a.id, label: a.label, created_at: a.created_at })),
          changesRequested: approvalsOf(task)
            .filter((a) => a.status === "changes_requested")
            .map((a) => ({ id: a.id, label: a.label, decided_at: a.decided_at })),
          failingCases: (task.test_cases || [])
            .filter((c) => c.status === "fail")
            .map((c) => ({ key: c.key, title: c.title })),
          unmetHard: (task.blocked_by || []).filter(
            (d: any) => d.kind === "hard" && !isTerminalStage(d.stage),
          ),
          subtasks: kids.length
            ? {
                total: kids.length,
                done: kids.filter((c) => isTerminalStage(c.stage)).length,
                parentTerminal: isTerminalStage(task.stage),
                nextLabel: next?.label || "",
              }
            : undefined,
          kids: kids
            .map((c) => ({
              id: c.id,
              title: c.title,
              state: subtaskState(c, isTerminalStage, init),
              blocker: stBlockers.get(c.id)?.titles[0],
            }))
            .filter((k) => k.state === "question" || k.state === "failed" || k.state === "blocked"),
        });
        const box = $("dr-attention");
        const folded = items.length > 1 && !attnOpen;
        const sig = JSON.stringify([
          items.map((i) => [i.kind, i.text, i.age, i.action, i.target]),
          folded,
        ]);
        if (box.dataset.sig === sig) return;
        box.dataset.sig = sig;
        box.hidden = items.length === 0;
        const toggle =
          items.length > 1
            ? buttonHTML({
                label: folded
                  ? t("tasks.drawer.attention_more", { count: items.length - 1 })
                  : t("tasks.drawer.attention_less"),
                icon: "chevron-down",
                size: "sm",
                variant: "ghost",
                cls: "attn-toggle",
                attrs: {
                  "data-attn-toggle": true,
                  "aria-expanded": String(!folded),
                  "aria-controls": "dr-attention",
                },
              })
            : "";
        box.innerHTML = (folded ? items.slice(0, 1) : items)
          .map((i: AttentionItem, n) => attentionRowHTML(i, n === 0 ? toggle : ""))
          .join("");
      }

      function revealQuestion(id: string) {
        showTab("overview");
        const card = document.querySelector<HTMLElement>(
          `#pane-overview [data-question="${CSS.escape(id)}"]`,
        );
        if (!card) return;
        card.scrollIntoView({ block: "center", behavior: scrollBehavior() });
        card
          .querySelector<HTMLElement>("input:not([disabled]), textarea")
          ?.focus({ preventScroll: true });
      }

      async function runAttention(kind: string, target: string) {
        const task = activeTask;
        if (!task) return;
        if (kind === "question") revealQuestion(target);
        else if (kind === "approval") showTab("approvals");
        else if (kind === "test") revealTestCase(target);
        else if (kind === "blocked" || kind === "subtask") await openDrawer(target);
        else if (kind === "subtasks") {
          const next = nextStageOf(task);
          if (next) await moveActiveTask(next.id);
        }
      }

      function renderTabCounts() {
        const task = activeTask;
        if (!task) return;
        const pending = pendingApprovalCount(task);
        paintTabCount("approvals", pending, approvalsTabName(pending));
        const reports = reportsLastTaskID === task.id ? reportsCache.length : 0;
        paintTabCount("reports", reports, reportsTabName(reports));
      }
      function paintTabCount(tab: string, n: number, name: string) {
        setCount($(`tab-${tab}-count`), n, { pill: true, hideZero: true });
        $(`tab-${tab}`).setAttribute("aria-label", name);
      }

      async function moveTask(id: string, stage: string, title = ""): Promise<boolean> {
        try {
          const res = await fetch(`${API}/tasks/${id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json", ...csrfHeaders() },
            credentials: "include",
            body: JSON.stringify({ stage }),
          });
          if (res.status === 409) {
            toast(
              t("tasks.toasts.move_blocked", { reason: blockedMoveMessage(await res.json()) }),
              "err",
              4500,
            );
            return false;
          }
          if (!res.ok) {
            toast(t("tasks.drawer.move_failed"), "err");
            return false;
          }
        } catch {
          toast(t("tasks.drawer.move_network_error"), "err");
          return false;
        }
        const label = stageInfo(stage)?.label || stage;
        if (title) announce(t("tasks.drawer.moved", { title, stage: label }));
        toast(`→ ${label}`, "ok", 2200);
        suspendRefresh = 0;
        await refresh(true);
        return true;
      }

      async function moveActiveTask(stage: string) {
        const task = activeTask;
        if (!task || task.stage === stage || refuseReadOnly()) return;
        const open = (task.children || []).filter((c) => !isTerminalStage(c.stage));
        if (isTerminalStage(stage) && open.length > 0) {
          const ok = await confirmDialog({
            title: t("tasks.confirm.finish_parent_title", {
              title: task.title,
              count: open.length,
            }),
            message: t("tasks.confirm.finish_parent_message"),
            confirmLabel: t("lib.task_detail.move_to", { stage: stageInfo(stage)?.label || stage }),
          });
          if (!ok) return;
        }
        if (taskByID(task.id)) await moveTaskToStage(task.id, stage, { confirmed: true });
        else await moveTask(task.id, stage, task.title);
      }

