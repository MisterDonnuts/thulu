    "board_empty": "the editor never deletes the last column",
    "too_many_stages": "the editor's add-column form checks the count",
    "duplicate_stage": "the add-column form checks the id against the board",
    "invalid_stage_id": "the add-column form checks the id (validId)",
    "id_reserved_virtual": "the add-column form refuses RESERVED_STAGE_IDS",
    "id_reserved_pseudo": "the add-column form refuses RESERVED_STAGE_IDS",
    "stage_label_required": "the rename field checks the label",
    "stage_label_too_long": "the rename field caps the label length",
    "stage_color_invalid": "the color comes from the swatch picker",
    "stage_virtual": "virtual stages are never part of an edited board",
    "wip_group_invalid": "the WIP group is a radio of WIP_GROUPS",
    "default_agent_invalid": "the agent comes from the picker's list of agent names",
    "skip_unless_too_many": "parseSkipUnless checks it before the save",
    "skip_unless_invalid": "parseSkipUnless checks it before the save",
    "skip_unless_duplicate": "parseSkipUnless drops repeats",
    "too_many_approvals": "the daemon's cap; the approvals editor does not count rows",
    "approval_key_invalid": "normalizeRequiredApprovals checks it before the save",
    "approval_key_duplicate": "normalizeRequiredApprovals checks it before the save",
    "approval_label_required": "normalizeRequiredApprovals checks it before the save",
    "approval_label_too_long": "the label input caps its length",
    "approval_type_duplicate": "normalizeRequiredApprovals drops repeated types",
    "approval_type_unknown": "ValidateApprovalTypes needs the board's task types; the editor offers only those",
    "on_changes_requested_invalid": "the mode is a select of the three valid modes"
  }
