---
// Read before anyone has a session (the login page links here): never load Layout.astro or call an
// authenticated route.
import "@fontsource-variable/inter";
import IconSprite from "../components/IconSprite.astro";
import { locale, SLOT, t, tParts } from "../i18n";

interface Props {
  title: string;
  page: "terms" | "privacy";
}
const { title, page } = Astro.props;
const operatorParts = tParts("legal.operator", { entity: SLOT, contact: SLOT });
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/boot/theme.js"></script>
    <title>{t("layout.page_title", { page: title })}</title>
    <style is:global>
      /* Like the login page, these pages never load Layout.astro, so they
         import the sheets they need into the layers Layout uses: the tokens,
         the reset with the focus ring and the icon sizing, and the callout
         of the draft notice. The rules below are unlayered and win. */
      @layer octopus.tokens, octopus.base, octopus.primitives;
      @import "../styles/tokens.css" layer(octopus.tokens);
      @import "../styles/base.css" layer(octopus.base);
      @import "../styles/primitives/callout.css" layer(octopus.primitives);

      body {
        line-height: 1.6;
      }
      a {
        color: var(--accent);
      }
      .legal {
        max-width: 760px;
        margin: 0 auto;
        padding: var(--s-8) 16px var(--s-8);
      }
      .legal-brand {
        display: inline-block;
        margin-bottom: var(--s-6);
      }
      .legal-brand svg {
        display: block;
        height: 36px;
        width: auto;
      }
      .legal h1 {
        font-size: var(--t-xl);
        letter-spacing: var(--tracking-tight);
        margin-bottom: var(--s-2);
      }
      .legal-meta {
        color: var(--fg-3);
        font-size: var(--t-sm);
        margin-bottom: var(--s-6);
      }
      .legal h2 {
        font-size: var(--t-lg);
        margin: var(--s-7) 0 var(--s-2);
      }
      .legal p,
      .legal ul {
        color: var(--fg-2);
        margin-bottom: var(--s-3);
      }
      .legal ul {
        padding-left: var(--s-5);
      }
      .legal li {
        margin-bottom: var(--s-1);
      }
      .legal-unset {
        color: var(--fg-3);
        font-style: italic;
      }
      .legal-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--t-sm);
        margin-bottom: var(--s-3);
        display: block;
        overflow-x: auto;
      }
      .legal-table th,
      .legal-table td {
        text-align: left;
        vertical-align: top;
        padding: var(--s-2) var(--s-3);
        border-bottom: 1px solid var(--line);
      }
      .legal-table th {
        color: var(--fg-3);
        font-weight: 500;
      }
      .legal-foot {
        margin-top: var(--s-8);
        padding-top: var(--s-4);
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-4);
        font-size: var(--t-sm);
      }
      .legal-foot a[aria-current="page"] {
        color: var(--fg-3);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <IconSprite />
    <main class="legal">
      <a class="legal-brand" href="/" aria-label={t("layout.brand.name")}
        ><svg viewBox="0 0 1636 512" aria-hidden="true"><use href="#i-thulu"></use></svg></a
      >
      <h1>{title}</h1>
      <p class="legal-meta">
        {
          operatorParts.map((p, i) =>
            i % 2 ? (
              p === "entity" ? (
                <span class="legal-unset" data-legal="entity">
                  {t("legal.not_configured")}
                </span>
              ) : (
                <a class="legal-unset" data-legal="contact">
                  {t("legal.not_configured")}
                </a>
              )
            ) : (
              p
            ),
          )
        }
      </p>
      <slot />
      <nav class="legal-foot" aria-label={t("legal.links.nav")}>
        <a href="/legal/terms/" aria-current={page === "terms" ? "page" : undefined}
          >{t("legal.links.terms")}</a
        >
        <a href="/legal/privacy/" aria-current={page === "privacy" ? "page" : undefined}
          >{t("legal.links.privacy")}</a
        >
        <a href="/">{t("legal.links.back")}</a>
      </nav>
    </main>

    <script>
      import { apiBase } from "../lib/auth";
      import { fillLegalIdentity, type AuthConfigLegal } from "../lib/legal";

      (async () => {
        try {
          const r = await fetch(`${apiBase()}/auth/config`);
          if (!r.ok) return;
          fillLegalIdentity(document, (await r.json()) as AuthConfigLegal);
        } catch {
          /* the daemon is unreachable: the page keeps "not configured" */
        }
      })();
    </script>
  </body>
</html>
