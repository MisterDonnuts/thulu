---
import { t } from "../i18n";
import { drawerClasses } from "../lib/ui/drawer";
import Icon from "./Icon.astro";
import Menu from "./Menu.astro";
---

<aside
  id="chat-drawer"
  class={drawerClasses({ side: "left", size: "sm", modal: false, cls: "chat-drawer" })}
  role="complementary"
  aria-label={t("chat.aria.drawer")}
  aria-hidden="true"
  data-size="panel"
  transition:persist="chat-drawer"
>
  <div class="cx-pane" id="chat-pane" data-size="panel">
    <div class="cx-inner">
      <header class="cx-head">
        <button type="button" class="cx-ibtn chat-back" aria-label={t("chat.buttons.back_to_chats")}
          ><Icon name="chevron-left" /></button
        >
        <button
          type="button"
          class="cx-title"
          id="chat-title"
          title={t("chat.conversation.rename_hint")}>{t("chat.new.title")}</button
        >
        <span class="chat-menu-wrap">
          <button
            type="button"
            class="cx-ibtn"
            id="chat-menu-btn"
            aria-label={t("chat.menu.aria")}
            title={t("chat.menu.title")}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="chat-menu"><Icon name="more" /></button
          >
          <Menu
            id="chat-menu"
            labelledBy="chat-menu-btn"
            density="rich"
            class="chat-menu"
            items={[
              {
                id: "chat-reset-btn",
                icon: "refresh",
                title: t("chat.menu.reset"),
                sub: t("chat.menu.reset_sub"),
              },
              {
                id: "chat-archive-btn",
                icon: "box",
                title: t("chat.menu.archive"),
                titleId: "chat-archive-label",
              },
              { id: "chat-delete-btn", icon: "trash", title: t("chat.menu.delete"), danger: true },
            ]}
          />
        </span>
        <button
          type="button"
          class="cx-ibtn chat-expand"
          id="chat-expand"
          aria-label={t("chat.head.expand")}
          title={t("chat.head.expand")}><Icon name="maximize" /></button
        >
        <button
          type="button"
          class="cx-ibtn"
          id="chat-close"
          aria-label={t("chat.head.close")}
          title={t("chat.head.close")}><Icon name="x" /></button
        >
      </header>
      <div class="cx-ctx" id="chat-ctx"></div>
      <div class="cx-inner" id="chat-body"></div>
    </div>
  </div>
</aside>

<style is:global>
  /* ════════════════════════════════════════════════════════════════════
   AGENT CHATS PANEL — the feed and composer are lib/chat/ over
   styles/primitives/chat.css; this file only docks the panel.
   ════════════════════════════════════════════════════════════════════ */
  /* How much this panel adds to the page offset the sidebar computes. Driven
     by `data-chat` on <html> (set by openDrawer/closeDrawer) rather than
     `:root:has(…)`, to match the mechanism the rail already uses. Expanded,
     the panel covers the page instead of pushing it. */
  @media (min-width: 1100px) {
    html[data-chat="open"] {
      --drawer-push: 400px;
    }
  }
  /* The top bar spans the whole viewport, above both the rail and this panel:
     the negative margin cancels exactly what the body pads by. */
  .header {
    margin-left: calc(-1 * (var(--sb-cur) + var(--drawer-push)));
    transition: margin-left var(--dur-normal) var(--ease-out);
  }

  .chat-drawer {
    top: var(--header-h);
    left: var(--sb-cur);
    max-width: calc(100vw - var(--sb-cur));
  }
  .chat-drawer[data-size="page"] {
    width: calc(100vw - var(--sb-cur));
  }
  @media (max-width: 900px) {
    .chat-drawer,
    .chat-drawer[data-size="page"] {
      left: 0;
      width: 100vw;
      max-width: 100vw;
    }
    .chat-expand {
      display: none;
    }
  }
  .chat-back {
    display: none;
  }
  @media (max-width: 640px) {
    .chat-back {
      display: inline-grid;
    }
  }
  .chat-menu-wrap {
    position: relative;
    display: inline-flex;
  }
  .chat-menu {
    width: 280px;
    max-width: calc(100vw - var(--s-8));
  }

  /* ── chat list rows (rendered into the sidebar's slot) ── */
  .chat-rows {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 2px 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
</style>

<script>
  import { api, ApiError } from "../lib/api";
  import { events, CHAT_TOPIC, type Frame } from "../lib/events";
  import { canActOnBoards, ChatDrafts, PREVIEW_CHARS, previewText } from "../lib/chat-drawer";
  import { agentLink } from "../lib/agent-link";
  import { isNewChatKey } from "../lib/keyboard";
  import { taskAnchor } from "../lib/test-cases";
  import {
    bindMenu,
    chatAvatarHTML,
    chatShortID,
    chatShortTitle,
    chatStateHTML,
    chatTaskChipHTML,
    confirmDialog,
    emptyStateHTML,
    esc,
    icoSvg,
    makeToast,
    setCount,
    type ChatRowState,
  } from "../lib/ui";
  import { ChatConversation, type ChatInfo, type ConversationHost } from "../lib/chat/conversation";
  import type { ComposerCommand } from "../lib/chat/composer";
  import {
    agentReady,
    chatTitle,
    lastAgent,
    loadChatAgents,
    loadTaskPicks,
    rememberAgent,
    taskPick,
    type TaskPick,
  } from "../lib/chat/data";
  import { locale, t } from "../i18n";

  const toast = makeToast(4000);

  (function () {
    // chat-rows, chat-new-btn and #sb-chat-badge are rendered by Sidebar.astro; the layout mounts
    // it before this script runs.
    const unreadBadge = document.getElementById("sb-chat-badge") as HTMLElement | null;
    const drawer = document.getElementById("chat-drawer") as HTMLElement;
    const pane = document.getElementById("chat-pane") as HTMLElement;
    const rowsEl = document.getElementById("chat-rows") as HTMLElement;
    const newBtn = document.getElementById("chat-new-btn") as HTMLElement | null;
    const titleBtn = document.getElementById("chat-title") as HTMLButtonElement;
    const ctxEl = document.getElementById("chat-ctx") as HTMLElement;
    const body = document.getElementById("chat-body") as HTMLElement;
    const menuBtn = document.getElementById("chat-menu-btn") as HTMLButtonElement;
    const menu = document.getElementById("chat-menu") as HTMLElement;
    const expandBtn = document.getElementById("chat-expand") as HTMLButtonElement;
    const archiveLabel = document.getElementById("chat-archive-label") as HTMLElement | null;
    if (!drawer || !rowsEl || !body) return;

    const OPEN_KEY = "octopus.chat.open";
    const LAST_KEY = "octopus.chat.lastChat";
    const SIZE_KEY = "octopus.chat.size";
    const UNREAD_KEY = "octopus.chat.unread";

    const store = {
      get(k: string): string | null {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set(k: string, v: string | null) {
        try {
          if (v === null) localStorage.removeItem(k);
          else localStorage.setItem(k, v);
        } catch {}
      },
    };

    const state = {
      chats: [] as ChatInfo[],
      query: "",
      activeChatId: null as string | null,
      unread: new Map<string, number>(),
      showArchived: false,
      conv: null as ChatConversation | null,
      // A new chat before its first message: the agent picked and the task it will carry.
      draft: null as null | {
        agent: string;
        taskId: string;
        handoff?: { id: string; title: string; agent: string };
      },
      drafts: new ChatDrafts(),
      size: (store.get(SIZE_KEY) === "page" ? "page" : "panel") as "panel" | "page",
      pollTimer: 0,
      offs: [] as Array<() => void>,
    };

    try {
      const saved = JSON.parse(store.get(UNREAD_KEY) ?? "{}") as Record<string, number>;
      for (const [k, v] of Object.entries(saved)) if (v > 0) state.unread.set(k, v);
    } catch {}

    function activeChat(): ChatInfo | undefined {
      return state.chats.find((c) => c.id === state.activeChatId);
    }

    function saveUnread() {
      store.set(UNREAD_KEY, JSON.stringify(Object.fromEntries(state.unread)));
    }

    function updateUnreadBadge() {
      if (!unreadBadge) return;
      let total = 0;
      state.unread.forEach((n) => (total += n));
      setCount(unreadBadge, total, {
        pill: true,
        size: "sm",
        tone: "accent",
        max: 9,
        hideZero: true,
        cls: "sb-count",
      });
    }

    function delegated(c: ChatInfo | undefined): boolean {
      return !!c?.delegated_by && !!c.delegated_until && Date.parse(c.delegated_until) > Date.now();
    }

    // Task and thread chats take turns from other people's comments, so they never act for
    // anyone (the daemon refuses it too). Only a person's own chat may change its task.
    function looseChat(c: ChatInfo): boolean {
      return !c.task_id && !c.thread_id;
    }
    function relinkable(c: ChatInfo): boolean {
      return c.created_by !== "system" && !c.thread_id;
    }

    // ── sidebar rows ──

    function shortTime(iso: string): string {
      if (!iso) return "";
      const d = new Date(iso);
      if (d.toDateString() === new Date().toDateString())
        return d.toLocaleTimeString(locale, { hour: "2-digit", minute: "2-digit", hour12: false });
      return d.toLocaleDateString(locale, { day: "2-digit", month: "2-digit" });
    }

    function rowState(c: ChatInfo): ChatRowState {
      return c.status === "running" || c.status === "needs_you" || c.status === "error"
        ? c.status
        : "idle";
    }

    function rowPreview(c: ChatInfo): string {
      const st = rowState(c);
      if (st === "running") return t("chat.rows.preview_running");
      if (st === "needs_you") return t("chat.rows.preview_needs_you");
      if (st === "error") return t("chat.rows.preview_error");
      const last = c.last_message_preview ? previewText(c.last_message_preview) : "";
      if (last) return last;
      return c.task_id
        ? t("chat.subtitle.agent_task", { agent: c.agent_type, task: c.task_title || c.task_id })
        : "@" + c.agent_type;
    }

    function rowHTML(c: ChatInfo): string {
      const st = rowState(c);
      const unread = (state.unread.get(c.id) || 0) > 0;
      const side =
        st !== "idle"
          ? chatStateHTML(st)
          : `<span class="cx-row-time">${esc(shortTime(c.last_message_at || c.updated_at))}</span>` +
            (unread
              ? `<span class="cx-unread" aria-label="${esc(t("chat.aria.unread"))}"></span>`
              : "");
      const current = c.id === state.activeChatId ? ' aria-current="true"' : "";
      const archived = c.archived ? " data-archived" : "";
      return `<button type="button" class="cx-row" data-id="${esc(c.id)}"${current}${archived}>${chatAvatarHTML(c.agent_type, { pulse: st === "running" })}<span class="cx-row-main"><span class="cx-row-title">${esc(chatTitle(c))}</span><span class="cx-row-sub">${esc(rowPreview(c))}</span></span><span class="cx-row-side">${side}</span></button>`;
    }

    function groupOf(c: ChatInfo, now: Date): 0 | 1 | 2 {
      const d = new Date(c.last_message_at || c.updated_at);
      if (d.toDateString() === now.toDateString()) return 0;
      return now.getTime() - d.getTime() < 7 * 86400_000 ? 1 : 2;
    }

    // The sidebar's search keeps the rows whose title, agent or last message hold every word.
    function matches(c: ChatInfo): boolean {
      const words = state.query.toLowerCase().split(/\s+/).filter(Boolean);
      if (!words.length) return true;
      const hay = [chatTitle(c), c.agent_type, c.task_title ?? "", c.last_message_preview ?? ""]
        .join(" ")
        .toLowerCase();
      return words.every((w) => hay.includes(w));
    }

    function renderRows() {
      const live = state.chats.filter((c) => !c.archived && matches(c));
      const now = new Date();
      const parts: string[] = [];
      if (!live.length)
        parts.push(
          emptyStateHTML({
            size: "sm",
            body: state.query ? t("chat.rows.search_empty") : t("chat.empty.no_chats"),
          }),
        );
      const sorted = [...live].sort(
        (a, b) =>
          Date.parse(b.last_message_at || b.updated_at) -
          Date.parse(a.last_message_at || a.updated_at),
      );
      const heads = [t("chat.rows.today"), t("chat.rows.week"), t("chat.rows.older")];
      let group = -1;
      for (const c of sorted) {
        const g = groupOf(c, now);
        if (g !== group) {
          group = g;
          parts.push(`<div class="cx-group">${esc(heads[g])}</div>`);
        }
        parts.push(rowHTML(c));
      }
      if (state.showArchived) {
        const archived = state.chats.filter((c) => c.archived && matches(c));
        if (archived.length)
          parts.push(`<div class="cx-group">${esc(t("chat.rows.archived"))}</div>`);
        parts.push(...archived.map(rowHTML));
      }
      parts.push(
        `<button type="button" class="cx-rows-more" data-archived-toggle aria-pressed="${state.showArchived}">${esc(state.showArchived ? t("chat.archived.hide") : t("chat.archived.show"))}</button>`,
      );
      rowsEl.innerHTML = parts.join("");
      newBtn?.setAttribute("aria-current", state.draft && isOpen() ? "true" : "false");
    }

    const searchBtn = document.getElementById("chat-search-btn");
    const searchEl = document.getElementById("chat-search") as HTMLInputElement | null;
    function closeSearch() {
      if (!searchEl) return;
      searchEl.hidden = true;
      searchEl.value = "";
      searchBtn?.setAttribute("aria-expanded", "false");
      if (state.query) {
        state.query = "";
        renderRows();
      }
    }
    searchBtn?.addEventListener("click", () => {
      if (!searchEl) return;
      if (!searchEl.hidden) return closeSearch();
      searchEl.hidden = false;
      searchBtn.setAttribute("aria-expanded", "true");
      searchEl.focus();
    });
    searchEl?.addEventListener("input", () => {
      state.query = searchEl.value.trim();
      renderRows();
    });
    searchEl?.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      e.stopPropagation();
      closeSearch();
      searchBtn?.focus();
    });

    rowsEl.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el.closest("[data-archived-toggle]")) {
        state.showArchived = !state.showArchived;
        void loadChats();
        return;
      }
      const row = el.closest<HTMLElement>(".cx-row[data-id]");
      if (row) void openChat(row.dataset.id!);
    });

    async function loadChats() {
      try {
        state.chats = await api.get<ChatInfo[]>(
          "/chats" + (state.showArchived ? "?include_archived=true" : ""),
        );
      } catch {
        return;
      }
      renderRows();
      const c = activeChat();
      if (c) {
        state.conv?.update(c);
        renderHead();
      }
    }

    // ── header and context bar ──

    function renderHead() {
      const c = activeChat();
      titleBtn.textContent = c ? chatTitle(c) : t("chat.new.title");
      titleBtn.disabled = !c;
      menuBtn.hidden = !c;
      if (archiveLabel && c)
        archiveLabel.textContent = c.archived ? t("chat.menu.unarchive") : t("chat.menu.archive");
      const page = state.size === "page";
      expandBtn.innerHTML = icoSvg(page ? "minimize" : "maximize");
      const label = page ? t("chat.head.shrink") : t("chat.head.expand");
      expandBtn.setAttribute("aria-label", label);
      expandBtn.title = label;
      renderCtx();
      renderBanner();
    }

    function taskChipFor(id: string, title: string | undefined, removable: boolean): string {
      const p = taskPick(id);
      return chatTaskChipHTML(
        { id, title: p?.title || title || id, board: p?.board, stage: p?.stage, href: p?.href },
        { short: true, removable, removeLabel: t("chat.ctx.remove_task") },
      );
    }

    function renderCtx() {
      const c = activeChat();
      const parts: string[] = [];
      if (c) {
        if (c.task_id)
          parts.push(taskChipFor(c.task_id, c.task_title, relinkable(c) && !c.archived));
        else if (relinkable(c) && !c.archived)
          parts.push(
            `<button type="button" class="cx-chip cx-chip-add" data-ctx="link">${icoSvg("hash")}${esc(t("chat.ctx.link_task"))}</button>`,
          );
        if (looseChat(c) && !c.archived) {
          const on = delegated(c);
          const label = on
            ? t("chat.ctx.delegate_on", {
                time: new Date(c.delegated_until as string).toLocaleTimeString(locale, {
                  hour: "2-digit",
                  minute: "2-digit",
                }),
              })
            : t("chat.ctx.delegate_off");
          parts.push(
            `<button type="button" class="cx-chip${on ? "" : " cx-chip-add"}" data-ctx="delegate" aria-pressed="${on}">${icoSvg("zap")}${esc(label)}</button>`,
          );
        }
      } else if (state.draft?.taskId) {
        // A blank draft shows no bar: the task gets linked once the chat exists, or by a #.
        parts.push(taskChipFor(state.draft.taskId, undefined, true));
      }
      ctxEl.innerHTML = parts.join("");
    }

    function renderBanner() {
      const c = activeChat();
      if (!state.conv) return;
      if (c?.archived) {
        state.conv.setBanner(
          `${esc(t("chat.composer.archived_note"))}<button type="button" data-banner="unarchive">${esc(t("chat.menu.unarchive"))}</button>`,
        );
        state.conv.setDisabled(true);
        return;
      }
      state.conv.setDisabled(false);
      if (c?.thread_id) {
        const link = c.task_id
          ? `<a href="${esc(taskAnchor(c.task_id, c.task_board_id || ""))}">${esc(t("chat.composer.open_task"))}</a>`
          : "";
        state.conv.setBanner(esc(t("chat.composer.thread_note")) + link);
        return;
      }
      state.conv.setBanner("");
    }

    ctxEl.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("button");
      if (!el) return;
      if (el.hasAttribute("data-cx-remove")) return void setTask("");
      if (el.dataset.ctx === "link") return state.conv?.insertToken("#");
      if (el.dataset.ctx === "delegate") return void toggleDelegation();
    });

    body.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-banner]");
      const c = activeChat();
      if (el?.dataset.banner === "unarchive" && c) void setArchived(c, false);
    });

    async function setTask(taskId: string, task?: TaskPick) {
      const c = activeChat();
      if (!c) {
        if (state.draft) {
          state.draft.taskId = taskId;
          renderCtx();
        }
        return;
      }
      try {
        const v = await api.patch<ChatInfo>(`/chats/${c.id}`, { task_id: taskId });
        Object.assign(c, {
          task_id: v.task_id,
          task_title: v.task_title,
          task_board_id: v.task_board_id,
        });
        renderHead();
        renderRows();
        toast(
          taskId
            ? t("chat.ctx.linked", { task: task?.title ?? v.task_title ?? taskId })
            : t("chat.ctx.unlinked"),
          "ok",
        );
      } catch (e) {
        toast(e instanceof ApiError ? e.message : t("chat.errors.offline_send"), "err");
      }
    }

    // A # with the chat still free of a task makes that task the chat's.
    function onTaskPicked(task: TaskPick) {
      const c = activeChat();
      if (c) {
        if (!c.task_id && relinkable(c) && !c.archived) void setTask(task.id, task);
        return;
      }
      if (state.draft && !state.draft.taskId) {
        state.draft.taskId = task.id;
        renderCtx();
      }
    }

    // ── commands ──

    // A draft has no chat to reset, archive or delegate yet; asking for a task creates it first.
    function commands(c: ChatInfo | undefined): ComposerCommand[] {
      const task: ComposerCommand = {
        id: "task",
        word: t("chat.commands.task.word"),
        title: t("chat.commands.task.title"),
        sub: t("chat.commands.task.sub"),
      };
      if (!c) return [task];
      const list: ComposerCommand[] = [];
      if (looseChat(c))
        list.push({
          id: "delegate",
          word: t("chat.commands.delegate.word"),
          title: t("chat.commands.delegate.title"),
          sub: t("chat.commands.delegate.sub"),
        });
      list.push(
        task,
        {
          id: "reset",
          word: t("chat.commands.reset.word"),
          title: t("chat.commands.reset.title"),
          sub: t("chat.commands.reset.sub"),
        },
        {
          id: "archive",
          word: t("chat.commands.archive.word"),
          title: t("chat.commands.archive.title"),
          sub: t("chat.commands.archive.sub"),
        },
      );
      return list;
    }

    function runCommand(id: string) {
      if (id === "delegate") return void toggleDelegation();
      if (id === "task") return void state.conv?.sendText(t("chat.commands.task.prompt"));
      if (id === "reset") return void resetChat();
      if (id === "archive") return void archiveChat();
    }

    // ── mounting a conversation ──

    function leaveConversation() {
      if (state.activeChatId && state.conv)
        state.drafts.stash(state.activeChatId, state.conv.composerValue);
      state.conv?.destroy();
      state.conv = null;
    }

    function noPromptHandler(agentType: string) {
      return (err: { code?: string; message: string }) => {
        if (err.code !== "chatruntime.errors.no_prompt") return false;
        void loadChatAgents().then((agents) => {
          const name = agents.find((a) => a.type === agentType)?.name || agentType;
          state.conv?.setBanner(
            `${esc(t("chat.errors.no_prompt", { agent: name }))}<a href="${esc(agentLink(name, "prompts"))}">${esc(t("chat.errors.no_prompt_link"))}</a>`,
          );
        });
        return true;
      };
    }

    function mount(host: Omit<ConversationHost, "onAgent" | "onTask" | "onError">) {
      leaveConversation();
      const agentType = host.chat?.agent_type ?? host.agent;
      state.conv = new ChatConversation(body, {
        ...host,
        onAgent: (type, started) => {
          rememberAgent(type);
          if (!started) {
            if (state.draft) state.draft.agent = type;
            return;
          }
          const c = activeChat();
          if (!c) return;
          toast(t("chat.handoff.toast", { agent: type }), "info");
          openNew({
            agent: type,
            taskId: c.task_id ?? "",
            handoff: { id: c.id, title: chatTitle(c), agent: c.agent_type },
          });
        },
        onTask: onTaskPicked,
        onError: noPromptHandler(agentType),
      });
      void state.conv.load();
      renderHead();
      setTimeout(() => state.conv?.focus(), 150);
    }

    async function openChat(id: string) {
      if (state.activeChatId === id && state.conv) {
        openDrawer();
        return;
      }
      state.draft = null;
      if (!state.chats.some((c) => c.id === id)) await loadChats();
      const c = state.chats.find((x) => x.id === id);
      if (!c) return;
      state.activeChatId = id;
      state.unread.delete(id);
      saveUnread();
      updateUnreadBadge();
      store.set(LAST_KEY, id);
      openDrawer();
      mount({
        chat: c,
        agent: c.agent_type,
        workspace: c.workspace_id,
        commands: commands(c),
        draft: state.drafts.take(id),
        onCommand: runCommand,
      });
      renderRows();
    }

    // Suggestions carry the task as #id, so a click writes text the agent can resolve.
    async function suggestions(): Promise<string[]> {
      const picks = await loadTaskPicks();
      const blocked = picks.filter((p) => p.status === "blocked").slice(0, 2);
      // The task shows as the chip a # makes; a click writes the plain #id back (data-ref).
      const withTask = (key: string, p: TaskPick) => {
        const id = "#" + chatShortID(p.id);
        const chip = `<span class="cx-it" data-ref="${esc(id)}" title="${esc(p.title)}"><span class="cx-it-id">${esc(id)}</span>${esc(chatShortTitle(p.title))}</span>`;
        return esc(t(key, { task: id })).replace(esc(id), chip);
      };
      const out: string[] = [];
      if (blocked[0]) out.push(withTask("chat.start.sugg_needs", blocked[0]));
      if (blocked[1]) out.push(withTask("chat.start.sugg_next", blocked[1]));
      out.push(esc(t("chat.start.sugg_boards")));
      return out;
    }

    async function openNew(
      opts: {
        agent?: string;
        taskId?: string;
        handoff?: { id: string; title: string; agent: string };
      } = {},
    ) {
      const agents = await loadChatAgents();
      // Without a remembered agent, the one the person talked to last is the likeliest next.
      const recent = [...state.chats]
        .filter((c) => !c.archived)
        .sort((a, b) =>
          (b.last_message_at || b.updated_at).localeCompare(a.last_message_at || a.updated_at),
        )[0]?.agent_type;
      const pick =
        opts.agent ||
        agents.find((a) => a.type === lastAgent() && agentReady(a))?.type ||
        agents.find((a) => a.type === recent && agentReady(a))?.type ||
        agents.find(agentReady)?.type ||
        agents[0]?.type ||
        "";
      state.activeChatId = null;
      store.set(LAST_KEY, null);
      state.draft = { agent: pick, taskId: opts.taskId ?? "", handoff: opts.handoff };
      openDrawer();
      mount({
        chat: null,
        agent: pick,
        commands: commands(undefined),
        handoffFrom: opts.handoff,
        suggestions: opts.handoff ? undefined : suggestions,
        createChat: createChat,
        onCreated: (c) => {
          state.draft = null;
          if (!state.chats.some((x) => x.id === c.id)) state.chats.unshift(c);
          state.activeChatId = c.id;
          store.set(LAST_KEY, c.id);
          renderHead();
          renderRows();
          void loadChats();
        },
      });
      if (!agents.length) {
        state.conv?.setBanner(
          `${esc(t("chat.new.hint_no_agents"))}<a href="/agents/">${esc(t("chat.new.hint_no_agents_link"))}</a>`,
        );
        state.conv?.setDisabled(true);
      }
      renderRows();
    }

    async function createChat(agent: string): Promise<ChatInfo | null> {
      if (!agent) return null;
      try {
        const c = await api.post<ChatInfo & { reused?: boolean }>("/chats", {
          agent_type: agent,
          task_id: state.draft?.taskId || undefined,
        });
        rememberAgent(agent);
        if (c.reused)
          toast(
            t("chat.new.reused", { agent: c.agent_type, task: c.task_title || c.task_id || "" }),
            "info",
            6000,
          );
        return { ...c, status: c.status ?? "idle" };
      } catch (e) {
        toast(e instanceof ApiError ? e.message : t("chat.errors.offline_create"), "err");
        return null;
      }
    }

    // ── list events ──

    function handleEvent(type: string, ev: any) {
      if (!ev) return;
      const chatID: string = ev.chat_id;
      const c = state.chats.find((x) => x.id === chatID);
      switch (type) {
        case "message_added": {
          const m = ev.message;
          if (!m) return;
          if (chatID !== state.activeChatId && m.role !== "user") {
            state.unread.set(chatID, (state.unread.get(chatID) || 0) + 1);
            saveUnread();
            updateUnreadBadge();
          }
          if (c) {
            c.last_message_preview = (m.text || "").slice(0, PREVIEW_CHARS);
            c.last_message_at = m.created_at;
            if (m.role === "assistant")
              c.status =
                m.metadata?.error === "true" && m.metadata?.canceled !== "true"
                  ? "error"
                  : c.status === "running"
                    ? "running"
                    : "idle";
            renderRows();
          }
          return;
        }
        case "turn_started":
          if (c) c.status = "running";
          return renderRows();
        case "turn_finished":
          if (c && c.status === "running") c.status = "idle";
          return renderRows();
        case "turn_failed":
          void loadChats();
          return;
        case "action_pending":
          if (c) c.status = "needs_you";
          return renderRows();
        case "action_decided":
        case "chat_created":
          void loadChats();
          return;
        case "chat_updated":
          if (c && ev.chat) {
            Object.assign(c, ev.chat);
            renderRows();
            if (chatID === state.activeChatId) renderHead();
          } else void loadChats();
          return;
        case "chat_deleted":
          state.chats = state.chats.filter((x) => x.id !== chatID);
          if (state.activeChatId === chatID) closeDrawer();
          else renderRows();
          return;
      }
    }

    // Nothing is replayed across a reconnect gap, so resync over REST on every reconnect.
    function connect() {
      if (state.offs.length) return;
      state.offs.push(
        events.subscribe(CHAT_TOPIC, (f: Frame) => handleEvent(f.type, f.data), { replay: false }),
        events.onReconnect(() => {
          stopPolling();
          void loadChats();
        }),
        events.onStatus((s) => (s === "live" ? stopPolling() : startPolling())),
      );
    }
    window.addEventListener("pagehide", () => {
      for (const off of state.offs) off();
      state.offs = [];
      stopPolling();
    });
    function startPolling() {
      if (state.pollTimer) return;
      state.pollTimer = window.setInterval(() => {
        void loadChats();
        void state.conv?.load();
      }, 5000);
    }
    function stopPolling() {
      if (state.pollTimer) {
        clearInterval(state.pollTimer);
        state.pollTimer = 0;
      }
    }

    // ── menu: rename, delegate, reset, archive, delete ──

    titleBtn.addEventListener("click", async () => {
      const c = activeChat();
      if (!c) return;
      const next = prompt(t("chat.conversation.rename_prompt"), c.title || "");
      if (next === null || !next.trim() || next.trim() === c.title) return;
      try {
        await api.patch(`/chats/${c.id}`, { title: next.trim() });
        c.title = next.trim();
        renderHead();
        renderRows();
      } catch {}
    });

    const chatMenu = bindMenu(menu, menuBtn, {
      onSelect: (item) => {
        if (item.id === "chat-reset-btn") void resetChat();
        else if (item.id === "chat-archive-btn") void archiveChat();
        else if (item.id === "chat-delete-btn") void deleteChat();
      },
    });

    async function setDelegation(c: ChatInfo, enabled: boolean): Promise<void> {
      try {
        const r = await api.post<{ delegated_by?: string; delegated_until?: string }>(
          `/chats/${c.id}/delegation`,
          { enabled },
        );
        Object.assign(c, { delegated_by: r.delegated_by, delegated_until: r.delegated_until });
        renderHead();
        toast(
          enabled
            ? t("chat.ctx.delegate_toast_on", { agent: c.agent_type })
            : t("chat.ctx.delegate_toast_off"),
          "ok",
        );
      } catch (e) {
        toast(e instanceof ApiError ? e.message : t("chat.errors.offline_delegation"), "err");
      }
    }

    async function toggleDelegation(): Promise<void> {
      const c = activeChat();
      if (!c || !looseChat(c)) return;
      if (delegated(c)) return setDelegation(c, false);
      let hours = 8;
      try {
        const q = c.workspace_id ? `?workspace=${encodeURIComponent(c.workspace_id)}` : "";
        const p = await api.get<{ enabled: boolean; ttl_hours: number }>("/chat-delegation" + q);
        if (!p.enabled) {
          toast(t("chat.delegate.disabled_by_owner"), "info");
          return;
        }
        hours = p.ttl_hours || hours;
      } catch {}
      const agent = (await loadChatAgents(c.workspace_id)).find((a) => a.type === c.agent_type);
      const blind = !!agent && !canActOnBoards(agent.mcp);
      const ok = await confirmDialog({
        title: t("chat.delegate.confirm_title", { agent: c.agent_type }),
        message: t("chat.delegate.confirm_message", { count: hours }),
        confirmLabel: t("chat.delegate.confirm_ok"),
        ...(blind && agent
          ? {
              warning: t("chat.delegate.no_write", { agent: agent.name }),
              warningLink: {
                href: agentLink(agent.name, "mcp"),
                label: t("chat.delegate.no_write_link"),
              },
            }
          : {}),
      });
      if (ok) await setDelegation(c, true);
    }

    async function resetChat(): Promise<void> {
      const c = activeChat();
      if (!c) return;
      const ok = await confirmDialog({
        title: t("chat.confirm.reset_title"),
        message: t("chat.confirm.reset_message"),
        confirmLabel: t("chat.confirm.reset_ok"),
        danger: true,
      });
      if (!ok) return;
      try {
        await api.post(`/chats/${c.id}/reset`, {});
        void state.conv?.load();
      } catch (e) {
        toast(
          e instanceof ApiError && e.status === 409
            ? t("chat.errors.busy_reset")
            : t("chat.errors.offline_send"),
          "err",
        );
      }
    }

    async function setArchived(c: ChatInfo, archived: boolean): Promise<void> {
      try {
        await api.patch(`/chats/${c.id}`, { archived });
      } catch (e) {
        toast(e instanceof ApiError ? e.message : t("chat.errors.offline_archive"), "err");
        return;
      }
      c.archived = archived;
      if (archived) {
        closeDrawer();
        void loadChats();
        toast(t("chat.archived.done", { title: chatTitle(c) }), "ok", 6000, null, {
          label: t("chat.archived.undo"),
          run: () => void setArchived(c, false).then(() => openChat(c.id)),
        });
        return;
      }
      await loadChats();
      renderHead();
    }

    async function archiveChat(): Promise<void> {
      const c = activeChat();
      if (!c) return;
      if (c.archived) return setArchived(c, false);
      const ok = await confirmDialog({
        title: t("chat.confirm.archive_title"),
        message: t("chat.confirm.archive_message"),
        confirmLabel: t("chat.confirm.archive_ok"),
      });
      if (ok) await setArchived(c, true);
    }

    async function deleteChat(): Promise<void> {
      const c = activeChat();
      if (!c) return;
      const ok = await confirmDialog({
        title: t("chat.confirm.delete_title"),
        message: t("chat.confirm.delete_message"),
        confirmLabel: t("chat.confirm.delete_ok"),
        danger: true,
      });
      if (!ok) return;
      try {
        await api.del(`/chats/${c.id}`);
      } catch {}
      state.chats = state.chats.filter((x) => x.id !== c.id);
      closeDrawer();
    }

    // ── open, close, expand ──

    // The drawer persists across navigation, but the router replaces <html>'s attributes; carry
    // data-chat over or the page loses its padding.
    document.addEventListener("astro:before-swap", (e: Event) => {
      const next = (e as Event & { newDocument: Document }).newDocument.documentElement;
      const chat = document.documentElement.dataset.chat;
      if (chat) next.dataset.chat = chat;
    });

    function isOpen(): boolean {
      return drawer.classList.contains("open");
    }

    function applySize() {
      drawer.dataset.size = state.size;
      pane.dataset.size = state.size;
      if (isOpen()) document.documentElement.dataset.chat = state.size === "page" ? "page" : "open";
      renderHead();
    }

    function openDrawer() {
      drawer.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      document.documentElement.dataset.chat = state.size === "page" ? "page" : "open";
      store.set(OPEN_KEY, "1");
    }

    function closeDrawer() {
      drawer.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
      document.documentElement.dataset.chat = "closed";
      leaveConversation();
      state.activeChatId = null;
      state.draft = null;
      store.set(OPEN_KEY, "0");
      store.set(LAST_KEY, null);
      renderRows();
      void loadChats();
    }

    expandBtn.addEventListener("click", () => {
      state.size = state.size === "page" ? "panel" : "page";
      store.set(SIZE_KEY, state.size);
      applySize();
    });
    document.getElementById("chat-close")?.addEventListener("click", closeDrawer);
    drawer.querySelector(".chat-back")?.addEventListener("click", closeDrawer);
    newBtn?.addEventListener("click", () => void openNew());

    document.addEventListener("octopus:open-chat", (e) => {
      const id = (e as CustomEvent<{ id?: string }>).detail?.id;
      if (id) void openChat(id);
    });

    document.addEventListener("keydown", (e) => {
      if (!isNewChatKey(e)) return;
      e.preventDefault();
      void openNew();
    });

    // 1100px must match the --drawer-push media query: wider, this panel pushes the page;
    // narrower, it overlays and would cover the task drawer.
    const pushesPage = window.matchMedia("(min-width: 1100px)");
    const wouldCoverTask = () => !pushesPage.matches && !!document.querySelector("#drawer.open");
    document.addEventListener("octopus:task-drawer-open", () => {
      if ((!pushesPage.matches || state.size === "page") && isOpen()) closeDrawer();
    });

    drawer.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key !== "Escape" || chatMenu.isOpen() || e.defaultPrevented) return;
      closeDrawer();
    });

    applySize();
    updateUnreadBadge();
    connect();
    void loadChats().then(() => {
      if (store.get(OPEN_KEY) !== "1" || wouldCoverTask()) return;
      const last = store.get(LAST_KEY);
      if (last && state.chats.some((c) => c.id === last)) void openChat(last);
    });
  })();
</script>
