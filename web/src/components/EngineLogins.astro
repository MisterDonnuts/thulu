---
// The personal sign-in lives inside each engine's card in Settings → AI engines (lib/engine-logins.ts
// fills the card's [data-el-slot]); this holds only the dialog that walks through the sign-in.
import Field from "./Field.astro";
import FormError from "./FormError.astro";
import Modal from "./Modal.astro";
import { t } from "../i18n";
---

<Modal
  id="el-modal"
  title={t("settings.engine_login.modal.title", { engine: "" })}
  icon="lock"
  size="sm"
  cancel
  primary={{
    label: t("settings.engine_login.modal.submit"),
    id: "el-submit",
    type: "submit",
    form: "el-form",
  }}
>
  <form id="el-form" class="form-stack" novalidate>
    <div id="el-steps" aria-live="polite"></div>
    <div id="el-code-field" hidden>
      <Field label={t("settings.engine_login.modal.code")} for="el-code">
        <input
          id="el-code"
          type="text"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          disabled
        />
      </Field>
    </div>
    <FormError id="el-error" />
  </form>
</Modal>

<style is:global>
  .el-slot:empty {
    display: none;
  }
  .el-lede {
    margin: 0 0 var(--s-3);
    font-size: var(--t-sm);
  }
  .el-warning {
    margin-top: var(--s-3);
  }
</style>
