---
import Icon from "./Icon.astro";
import Kbd from "./Kbd.astro";
import {
  searchA11y,
  searchClasses,
  searchKbd,
  searchPlaceholder,
  searchStyle,
} from "../lib/ui/toolbar";

interface Props {
  id: string;
  placeholder?: string;
  width?: number;
  fluid?: boolean;
  label?: string;
  kbd?: string | false;
  type?: "text" | "search";
  value?: string;
  class?: string;
  [key: string]: unknown;
}
const {
  id,
  placeholder = searchPlaceholder(),
  width,
  fluid = false,
  label,
  kbd,
  type,
  value,
  class: extra,
  ...rest
} = Astro.props;
const cap = searchKbd(kbd);
---

<div class={searchClasses({ fluid, cls: extra })} style={searchStyle(width)}>
  <Icon name="search" class="search-icon" />
  <input
    {id}
    class="search-input"
    type={type === "search" ? "search" : undefined}
    {placeholder}
    {value}
    {...searchA11y({ placeholder, label, kbd })}
    autocomplete="off"
    {...rest}
  />
  {cap && <Kbd keys={cap} size="sm" inset decorative />}
</div>
