---
// Markup must match icoSvg() in lib/ui/icon.ts.
import { iconClasses, iconHref, type IconSize } from "../lib/ui/icon";

interface Props {
  name: string;
  size?: IconSize;
  label?: string;
  class?: string;
}
const { name, size = "md", label, class: extra } = Astro.props;
---

<svg
  class={iconClasses(size, extra)}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <use href={iconHref(name)}></use>
</svg>
