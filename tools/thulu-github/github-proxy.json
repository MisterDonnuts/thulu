    {"octokit": "pulls.update", "method": "PATCH", "path": "/repos/{owner}/{repo}/pulls/{pull_number}", "tools": ["pr_update"]},
    {"octokit": "pulls.create", "method": "POST", "path": "/repos/{owner}/{repo}/pulls", "tools": ["pr_create"]},
