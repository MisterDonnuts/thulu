    {"octokit": "actions.downloadJobLogsForWorkflowRun", "method": "GET", "path": "/repos/{owner}/{repo}/actions/jobs/{job_id}/logs", "tools": ["run_logs"], "download": true},
    {"octokit": "actions.downloadWorkflowRunLogs", "method": "GET", "path": "/repos/{owner}/{repo}/actions/runs/{run_id}/logs", "tools": ["run_logs"], "download": true}
  ],
  "graphql": {
    "review_threads": {
      "tools": ["pr_review_threads"],
      "variables": ["owner", "repo", "number", "after"],
      "repo_variables": {"owner": "owner", "name": "repo"},
      "query": "query ($owner: String!, $repo: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $repo) { pullRequest(number: $number) { reviewThreads(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { id isResolved isOutdated path line originalLine diffSide comments(first: 50) { totalCount nodes { databaseId author { login } body createdAt url diffHunk replyTo { databaseId } } } } } } } }"
    },
    "thread": {
      "tools": ["pr_review_thread_resolve", "pr_review_thread_unresolve"],
      "variables": ["id"],
      "node_variable": "id",
      "query": "query($id: ID!) { node(id: $id) { ... on PullRequestReviewThread { id isResolved pullRequest { number repository { nameWithOwner } } } } }"
    },
    "resolve_thread": {
      "tools": ["pr_review_thread_resolve"],
      "variables": ["id"],
      "node_variable": "id",
      "query": "mutation($id: ID!) { resolveReviewThread(input: { threadId: $id }) { thread { id isResolved } } }"
    },
    "unresolve_thread": {
      "tools": ["pr_review_thread_unresolve"],
      "variables": ["id"],
      "node_variable": "id",
      "query": "mutation($id: ID!) { unresolveReviewThread(input: { threadId: $id }) { thread { id isResolved } } }"
    },
    "mark_ready": {
      "tools": ["pr_ready_for_review"],
      "variables": ["id"],
      "node_variable": "id",
      "query": "mutation($id: ID!) { markPullRequestReadyForReview(input: { pullRequestId: $id }) { pullRequest { number isDraft } } }"
    },
    "convert_to_draft": {
      "tools": ["pr_ready_for_review"],
      "variables": ["id"],
      "node_variable": "id",
      "query": "mutation($id: ID!) { convertPullRequestToDraft(input: { pullRequestId: $id }) { pullRequest { number isDraft } } }"
    }
  }
}
